<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 绮罗外套修改-重量 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_ShellBase"
		]/statBases/Mass</xpath>
		<value>
			<Mass>2</Mass>
		</value>
	</Operation>
	<!-- 绮罗外套修改-重量-体积 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_ShellBase"
		]/statBases</xpath>
		<value>
			<Bulk>3</Bulk>
			<WornBulk>2</WornBulk>
		</value>
	</Operation>
	
	<!-- 绮罗简易披肩  -->
