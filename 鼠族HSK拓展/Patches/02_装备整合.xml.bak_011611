<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- 鼠族HSK拓展 - 功能2: 拓展装备整合(44件,全部集中于此文件) -->
    <!-- 研究并入HSK科技树: 极致武器→近战武器VI, 太空装甲→护甲VI -->
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <ResearchProjectDef ParentName="HitechLabStationBase">
            <defName>Melee_Ultra</defName>
            <label>近战武器 VI</label>
            <description>极致时代武器研究,前置心灵武器(Melee_E1),位于近战武器 V 与近战武器 VII 之间,数值取两档中间值。</description>
            <baseCost>3000</baseCost>
            <techLevel>Ultra</techLevel>
            <prerequisites><li>Melee_E1</li></prerequisites>
            <researchViewX>23.00</researchViewX>
            <researchViewY>29.00</researchViewY>
            <tab>Weapon_SK</tab>
        </ResearchProjectDef>
    </value>
</Operation>
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Melee_Archotech"]/label</xpath>
    <value><label>近战武器 VII</label></value>
</Operation>
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Melee_Archotech"]/researchViewX</xpath>
    <value><researchViewX>25.00</researchViewX></value>
</Operation>
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Melee_Archotech"]/prerequisites</xpath>
    <value><prerequisites><li>Melee_Ultra</li></prerequisites></value>
</Operation>
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="Melee_Archotech"]/researchViewY</xpath>
    <value><researchViewY>29.00</researchViewY></value>
</Operation>
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <ResearchProjectDef ParentName="HitechMultiBase">
            <defName>Ratkin_Armor_D2</defName>
            <label>鼠族盔甲 III</label>
            <description>极致时代鼠族装甲研究: 纳米合金战甲/麦克斯韦MK/先驱者/矿业动力服等,填补鼠族装甲在极致时代的空缺。</description>
            <baseCost>2500</baseCost>
            <techLevel>Ultra</techLevel>
            <prerequisites><li>Ratkin_Armor_D1</li></prerequisites>
            <researchViewX>23.00</researchViewX>
            <researchViewY>41.00</researchViewY>
            <tab>Apparel_SK</tab>
        </ResearchProjectDef>
    </value>
</Operation>
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <ResearchProjectDef ParentName="MedievalBase">
            <defName>Ratkin_Armor_Medieval</defName>
            <label>鼠族中世纪装甲</label>
            <description>鼠族中世纪装甲研究: 格鲁斯之铠/十字军护甲/十字军护盔。</description>
            <baseCost>800</baseCost>
            <techLevel>Medieval</techLevel>
            <prerequisites><li>PlateArmor</li></prerequisites>
            <researchViewX>5.00</researchViewX>
            <researchViewY>45.00</researchViewY>
            <tab>Apparel_SK</tab>
        </ResearchProjectDef>
    </value>
</Operation>
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <ResearchProjectDef ParentName="IndustrialBase">
            <defName>Ratkin_Apparel_C3</defName>
            <label>鼠族衣物 IV</label>
            <description>后石化时代鼠族维多利亚服饰研究: 古堡夫人/宫廷长裙/女王披风/灵能皇冠等贵族装,依赖石油化工产品(复合粘剂/人造纤维/塑料/橡胶)+毛类,属性符合后工业时代。</description>
            <baseCost>1800</baseCost>
            <techLevel>Industrial</techLevel>
            <prerequisites><li>Oil_Industry_C6</li><li>Ratkin_Apparel_C1</li></prerequisites>
            <researchViewX>13.00</researchViewX>
            <researchViewY>43.00</researchViewY>
            <tab>Apparel_SK</tab>
        </ResearchProjectDef>
    </value>
</Operation>
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <ResearchProjectDef ParentName="IndustrialBase">
            <defName>Ratkin_Apparel_C5</defName>
            <label>鼠族衣物 V</label>
            <description>后工业时代鼠族服饰研究: 毛绒大衣/毛绒风雪大衣/授勋披风/大容量跳跃背包/可爱毛绒小羊帽(自鼠族衣物 II 独立,材料为工业/后工业产物),位于鼠族衣物 IV 之后,后续后工业装备研究顺延至此。</description>
            <baseCost>1600</baseCost>
            <techLevel>Industrial</techLevel>
            <prerequisites><li>Ratkin_Apparel_C3</li></prerequisites>
            <researchViewX>17.00</researchViewX>
            <researchViewY>43.00</researchViewY>
            <tab>Apparel_SK</tab>
        </ResearchProjectDef>
    </value>
</Operation>
<Operation Class="PatchOperationFindMod">
    <mods><li>Research Tree SK</li></mods>
    <match Class="PatchOperationAddModExtension">
        <xpath>Defs/ResearchProjectDef[(defName="Melee_Ultra" or defName="Ratkin_Armor_D2" or defName="Ratkin_Armor_Medieval" or defName="Ratkin_Apparel_C3" or defName="Ratkin_Apparel_C5") and not(modExtensions/li[@Class="ResearchTreeSK.ResearchTreeSKModExtension"])]</xpath>
        <value><li Class="ResearchTreeSK.ResearchTreeSKModExtension" /></value>
    </match>
</Operation>
