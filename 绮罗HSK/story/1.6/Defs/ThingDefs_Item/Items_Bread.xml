<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 玉米糕 -->
  <ThingDef ParentName="Kiiro_MealBase">
    <defName>Kiiro_CornCake</defName>
    <label>corn cake</label>
    <description>A delicate pastry made from finely ground cornmeal, easy to digest and suitable even for babys.</description>
    <graphicData>
      <texPath>Kiiro_Event/Meal/CornCake</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>6</MarketValue>
      <Nutrition>0.3</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetHumanlikes>-2</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
      <babiesCanIngest>true</babiesCanIngest>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>7</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients">
        <performMergeCompatibilityChecks>false</performMergeCompatibilityChecks>
        <noIngredientsFoodKind>NonMeat</noIngredientsFoodKind>
      </li>
    </comps>
  </ThingDef>

  <!-- 农家面包 -->
  <ThingDef ParentName="Kiiro_MealBase">
    <defName>Kiiro_CountryBread</defName>
    <label>country bread</label>
    <description>A coarse, hard bread baked in the simplest manner. Rough in texture and not particularly pleasant to eat, yet it provides a solid sense of fullness. It is never absent from the villages of Kiiro.\n\nCan be stored for long periods of time.</description>
    <graphicData>
      <texPath>Kiiro_Event/Meal/CountryBread</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>8</MarketValue>
      <Nutrition>0.4</Nutrition>
    </statBases>
    <ingestible>
      <preferability>MealSimple</preferability>
      <ingestEffect>EatVegetarian</ingestEffect>
      <ingestSound>Meal_Eat</ingestSound>
      <optimalityOffsetHumanlikes>-2</optimalityOffsetHumanlikes>
      <optimalityOffsetFeedingAnimals>-25</optimalityOffsetFeedingAnimals>
    </ingestible>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>12</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
      <li Class="CompProperties_Ingredients">
        <noIngredientsFoodKind>NonMeat</noIngredientsFoodKind>
      </li>
    </comps>
  </ThingDef>

