    <products><RK_Petro_Synthylene>10</RK_Petro_Synthylene><RK_Petro_Synthamide>5</RK_Petro_Synthamide></products>
  </RecipeDef>

  <!-- ===== 精馏塔: 三烯 / 三苯 ===== -->
