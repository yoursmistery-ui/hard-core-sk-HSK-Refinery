    <!-- ========== 3) B2A 描述移除制服 ========== -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="Ratkin_Apparel_B2A"]/description</xpath>
        <value><description>鼠族衣物 II: 解锁探险家外套/单色外套/褶边连衣裙/修女礼服与头纱/软甲(棉甲)A·B/十字军长裙/冬季外袍/毛绒保暖长衣/皮革斜挎包/鼠族医疗包/厨师帽/厨师服/眼镜/科研服/纯白外套/外板甲/工作背心等中世纪基础衣物与工作服。</description></value>
    </Operation>

    <!-- ========== 4) 制服前工业化材料(布料/皮革 + 原始零部件; 移除电子元件, 普通零部件→原始零部件) ========== -->
