                <totalBleedFactor>0.95</totalBleedFactor>        <!-- 失血量系数 -->
                <naturalHealingFactor>50</naturalHealingFactor> <!-- 自然愈合因子 -->
      </li>
    </stages>
	 <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
  </HediffDef>
  
  <HediffDef>
    <defName>AutoBleeding</defName>
    <label>紧急医疗系统</label>
