			</defaultOutfitTags>
			<layers>
				<li>OuterClothing</li>
			</layers>
			<tags>
				<li>RK_ExoticHeavyShield</li>
				<li>RK_ExoticShooterShield</li>
			</tags>
		</apparel>
		<comps>
			<li Class="RatkinGeneExpanded.CompProperties_ShieldInfos">
				<isShield>true</isShield>
				<canUseRangedWeapon>true</canUseRangedWeapon>
