<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ==========================================================================
	     Knights of Favonius 西风骑士团 装甲整合 (2026-08-26, 后工业档)
	     来源: Steam 创意工坊 3768887719 "Knights of Favonius - Weapon and Armour"
	     适配: 整合 4 件装甲 —— 通用装甲(人类/鼠族均可穿), 不入 79 号鼠族专属限制。
	     - 父类 ApparelMakeableBase (通用服装基类, 同原mod)
	     - 后工业材料 (ComponentIndustrial/SyntheticFibers)
	     - CE 适配: 护甲值按 HSK CE mm 值 + Bulk/WornBulk + CarryBulk/CarryWeight
	     - 工作台: 裁缝台 (HandTailoringBench/ElectricTailoringBench) + 锻造台(板甲)
	     - 研究: RKHSK_FavoniusArmory (后工业档)
	     - 贴图: Textures/Things/Apparel/Favonius/ (含各体型 _Fat/_Thin/_Female/_Male 变体)
	     ========================================================================== -->

	<!-- ============ Favonius Underarmour 西风骑士内衣 (OnSkin) ============ -->
	<ThingDef ParentName="ApparelMakeableBase">
		<defName>RKHSK_Favonius_Underarmour</defName>
		<label>西风骑士内衣</label>
		<description>西风骑士团制式内衬制服，由分层束腰上衣、骑兵长裤与结实军靴组成。既适合日常巡逻，也足以承受守护蒙德的重任。</description>
		<graphicData>
			<texPath>Things/Apparel/Favonius/FavoniusUnderarmour/KOFU</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<techLevel>Industrial</techLevel>
		<tradeability>Sellable</tradeability>
		<costList>
			<Cloth>60</Cloth>
			<SyntheticFibers>20</SyntheticFibers>
		</costList>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToMake>5000</WorkToMake>
			<Mass>1</Mass>
			<Bulk>4</Bulk>
			<WornBulk>2</WornBulk>
			<Insulation_Cold>15</Insulation_Cold>
			<ArmorRating_Sharp>4</ArmorRating_Sharp>
			<ArmorRating_Blunt>3</ArmorRating_Blunt>
			<ArmorRating_Heat>1</ArmorRating_Heat>
			<Flammability>0.3</Flammability>
		</statBases>
		<equippedStatOffsets>
			<CarryBulk>5</CarryBulk>
			<CarryWeight>5</CarryWeight>
		</equippedStatOffsets>
		<thingCategories>
			<li>BodySuitsCat</li>
		</thingCategories>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
				<li>Feet</li>
			</bodyPartGroups>
			<wornGraphicPath>Things/Apparel/Favonius/FavoniusUnderarmour/KOFU</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>MedievalMilitary</li>
				<li>MedievalArmorBasic</li>
			</tags>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
		</apparel>
		<recipeMaker Inherit="False" IsNull="True" />
		<colorGenerator Class="ColorGenerator_StandardApparel"/>
		<tradeTags>
			<li>Clothing</li>
			<li>Armor</li>
		</tradeTags>
	</ThingDef>

	<!-- ============ Favonius Plate armour 西风骑士板甲 (Shell) ============ -->
