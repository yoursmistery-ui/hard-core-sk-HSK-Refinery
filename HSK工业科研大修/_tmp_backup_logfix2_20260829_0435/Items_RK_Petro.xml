  <!-- 石化工业线 · 新增中间物/产物（并入 HSK工业科研大修, 2026-08-28）
       氨=SyntheticAmmonia、中性胺=Neutroamine、乙烯=Polymers、苯=Sulphates、二甲苯=Xylene、
       丙烯=Propylene、丁二烯=Butadiene、化合燃料=Chemfuel、原油桶=OilBarrel、沥青=Asphalt 均为现成 def, 不重造。
       本文件只补真正缺的: 甲苯/石脑油/裂解混合气/合成烯/合成酰胺/天然气。(氢气已并入天然气, 2026-08-28) -->

  <ThingDef ParentName="ResourceBase">
    <defName>RK_Petro_NaturalGas</defName>
    <label>天然气</label>
    <description>常减压蒸馏与裂解产生的可燃气体，主要成分为甲烷。可作燃气发电/锅炉的燃料，也是合成氨与胺化反应的唯一原料气(本线氢气已并入天然气，两者等价通用)。压缩罐装后便于搬运，但受击会剧烈爆炸。</description>
    <graphicData><texPath>Things/Item/Resource/RK_Petro_NaturalGas</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <stackLimit>150</stackLimit>
    <tickerType>Normal</tickerType>
    <statBases><MarketValue>1.5</MarketValue><Mass>0.1</Mass><Flammability>1.0</Flammability><Beauty>-4</Beauty></statBases>
    <thingCategories><li>Manufactured</li>			<li>RK_PetroLiquid</li>
		</thingCategories>
    <tradeability>Sellable</tradeability>
    <comps><li Class="CompProperties_Explosive"><explosiveRadius>2.2</explosiveRadius><explosiveDamageType>Flame</explosiveDamageType><wickTicks><min>70</min><max>150</max></wickTicks><startWickHitPointsPercent>0.4</startWickHitPointsPercent></li></comps>
  </ThingDef>

  <ThingDef ParentName="ResourceBase">
