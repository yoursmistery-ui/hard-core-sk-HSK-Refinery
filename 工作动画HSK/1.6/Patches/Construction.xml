<?xml version="1.0" encoding="utf-8" ?>
<!-- 合并自(保持原执行序): Construction.xml, Crafting.xml, Mining.xml -->
<Patch><!-- ========================= CONSTRUCT METAL ========================
       Continuous build effecter for metal frames. Lean into a welding
       look: bright welder flash, a cone of thrown sparks, a soft heat
       glow, settling dust and an occasional tool glint.
  -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/EffecterDef[defName="ConstructMetal"]/children</xpath>
    <value>
      <children>
        <li>
          <subEffecterClass>SubEffecter_Sustainer</subEffecterClass>
          <soundDef>Interact_ConstructMetal</soundDef>
        </li>
        <!-- settling work dust -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>DustPuff</fleckDef>
          <chancePerTick>0.035</chancePerTick>
          <scale>0.63~0.91</scale>
          <rotationRate>-60~60</rotationRate>
          <speed>0.6~1.8</speed>
        </li>
        <!-- welder flash -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>SparkFlash</fleckDef>
          <spawnLocType>BetweenTouchingCells</spawnLocType>
          <positionLerpFactor>0.49</positionLerpFactor>
          <chancePerTick>0.28</chancePerTick>
          <scale>1.75~2.66</scale>
        </li>
        <!-- yellow-hot core flash -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>YellowSparkFlash</fleckDef>
          <spawnLocType>BetweenTouchingCells</spawnLocType>
          <positionLerpFactor>0.49</positionLerpFactor>
          <chancePerTick>0.16</chancePerTick>
          <scale>1.12~1.82</scale>
        </li>
        <!-- soft heat shimmer -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>HeatGlow_Intense</fleckDef>
          <spawnLocType>BetweenTouchingCells</spawnLocType>
          <positionLerpFactor>0.49</positionLerpFactor>
          <chancePerTick>0.05</chancePerTick>
          <scale>0.56~0.98</scale>
        </li>
        <!-- cone of thrown sparks bouncing off the work -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <moteDef>Mote_SparkThrown</moteDef>
          <spawnLocType>BetweenTouchingCells</spawnLocType>
          <positionLerpFactor>0.49</positionLerpFactor>
          <chancePerTick>0.3</chancePerTick>
          <burstCount>2~4</burstCount>
          <scale>0.168~0.252</scale>
          <airTime>0.08~0.18</airTime>
          <rotationRate>-240~240</rotationRate>
          <speed>7.2~26</speed>
          <angle>120~240</angle>
          <positionRadius>0.02</positionRadius>
        </li>
      </children>
    </value>
  </Operation>

  <!-- ========================= CONSTRUCT WOOD =========================
