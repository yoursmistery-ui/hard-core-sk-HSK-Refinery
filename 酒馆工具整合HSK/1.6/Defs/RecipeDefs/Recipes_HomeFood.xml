<?xml version="1.0" encoding="utf-8" ?>
<Defs>

		<!--========================= MealBase =============================-->

		<RecipeDef Name="TavCookMealBase" Abstract="True">
			<workSpeedStat>CookSpeed</workSpeedStat>
			<requiredGiverWorkType>Cooking</requiredGiverWorkType>
			<effectWorking>Cook</effectWorking>
			<soundWorking>Recipe_CookMeal</soundWorking>
			<workSkill>Cooking</workSkill>
			<recipeUsers>
				<li>Tav_Oven</li>
			</recipeUsers>
		</RecipeDef>

		<RecipeDef>
			<defName>Make_TavTallow</defName>
			<label>提炼油脂</label>
			<!-- 2026-08-29: 产物 TavTallow(尸蜡,已删) 改为 Core_SK 油脂 Tallow, 批次 15 与 HSK MakeTallow(生肉x1→15) 一致 -->
			<description>把腐烂的尸体熬成油脂。过程漫长、脏乱且气味难闻,但能把废弃物变成有用的燃料和原料。</description>
			<workerCounterClass>RecipeWorkerCounter_ButcherAnimals</workerCounterClass>
			<jobString>Rendering tallow.</jobString>
			<workAmount>4000</workAmount>
			<workSpeedStat>ButcheryFleshSpeed</workSpeedStat>
			<workSkill>Cooking</workSkill>
			<efficiencyStat>ButcheryFleshEfficiency</efficiencyStat>
			<effectWorking>Cremate</effectWorking>
			<soundWorking>Recipe_Cremate</soundWorking>
			<uiIconThing>Tallow</uiIconThing>
			<ingredients>
				<li>
					<filter>
						<categories>
							<li>Corpses</li>
						</categories>
						<specialFiltersToDisallow>
							<li>AllowFresh</li>
						</specialFiltersToDisallow>
					</filter>
					<count>1</count>
				</li>
			</ingredients>
			<fixedIngredientFilter>
				<categories>
					<li>Corpses</li>
				</categories>
				<disallowedCategories>
					<li>CorpsesMechanoid</li>
				</disallowedCategories>
				<specialFiltersToAllow>
					<li>AllowRotten</li>
				</specialFiltersToAllow>
				<specialFiltersToDisallow>
					<li>AllowFresh</li>
				</specialFiltersToDisallow>
			</fixedIngredientFilter>
			<products>
				<Tallow>15</Tallow>
			</products>
			<recipeUsers>
				<li>Tav_Oven</li>
			</recipeUsers>
			<displayPriority>0</displayPriority>
		</RecipeDef>

		<!--========================= CornDough =============================-->

		<RecipeDef ParentName="TavCookMealBase">
			<defName>Make_TavCornDough</defName>
			<label>制作玉米面团</label>
			<description>把玉米磨成生面团。</description>
			<jobString>Making corn dough.</jobString>
			<workAmount>1000</workAmount>
			<ingredients>
				<li>
					<filter>
						<thingDefs>
							<li>RawCorn</li>
						</thingDefs>
					</filter>
					<count>40</count>
				</li>
			</ingredients>
			<products>
				<TavCornDough>1</TavCornDough>
			</products>
		</RecipeDef>

		<RecipeDef ParentName="TavCookMealBase">
			<defName>Make_TavCornDough_X4</defName>
			<label>制作玉米面团 (x4)</label>
			<description>把大量玉米磨成面团。</description>
			<jobString>Making corn dough.</jobString>
			<workAmount>2000</workAmount>
			<ingredients>
				<li>
					<filter>
						<thingDefs>
							<li>RawCorn</li>
						</thingDefs>
					</filter>
					<count>160</count>
				</li>
			</ingredients>
			<products>
				<TavCornDough>4</TavCornDough>
			</products>
		</RecipeDef>

