	<ThingDef Name="sbzWeaponRackBase" ParentName="sbzDisplayShelfBase" Abstract="True">
		<graphicData>
			<texPath>Things/Building/Storage/WeaponRack/sbz_WeaponRack</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<thingClass>Building_Storage</thingClass>
		<stuffCategories Inherit="false">
			<li>Metallic</li>
		</stuffCategories>
		<researchPrerequisites Inherit="false">
			<li>Machining</li>
		</researchPrerequisites>		
		<costStuffCount>40</costStuffCount>
		<uiIconScale>0.8</uiIconScale>
		<uiOrder>1100</uiOrder>
		<staticSunShadowHeight>0.4</staticSunShadowHeight>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>6</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Weapons</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
	</ThingDef>

