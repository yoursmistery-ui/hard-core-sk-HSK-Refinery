<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_WR_FieldUniform</defName>
        <label>White Rose Field Uniform</label>
        <description>Regulation field uniform of the White Rose Kingdom’s line infantry during the Great War.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_WR_FieldUniform/RK_WR_FieldUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>10000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.31</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_WR</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <MoveSpeed>0.15</MoveSpeed>
            <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costStuffCount>75</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_WR_FieldUniform/RK_WR_FieldUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>RK_WR_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_WR_TrenchCoat</defName>
        <label>White Rose Trench Coat</label>
        <description>A water-resistant overcoat developed for officers during Great War. Designed for use in the trenches, it featured shoulder straps, D-rings, storm flaps, and a long cut to protect against mud and rain. It later became a staple of civilian fashion.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_WR_TrenchCoat/RK_WR_TrenchCoat</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>5000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.31</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
            <Insulation_Cold>3</Insulation_Cold>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_WR</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <SocialImpact>0.1</SocialImpact>
            <MoveSpeed>0.1</MoveSpeed>
        </equippedStatOffsets>
        <costStuffCount>75</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_WR_TrenchCoat/RK_WR_TrenchCoat</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <tags>
                <li>RK_WR_Officer</li>
                <li>RK_WR_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
    <ThingDef ParentName="RK_HatMakeableBase">
