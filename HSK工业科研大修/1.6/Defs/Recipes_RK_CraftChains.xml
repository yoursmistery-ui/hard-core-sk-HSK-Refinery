<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- ============================================================================
  P2·前置材料链配方(2026-08-28)
  丝绸: 蚕种+草 → 生丝(蚕匾架) → 丝绸(HSK 现有纺织机 TableLoom)   ← 与 HSK 纺织融合点
  纸张: 木头 → 纸浆(沤浆池) → 纸张(造纸台) → 书(抄写台)
  全部显式写 researchPrerequisite(单工作台 + 有门槛 = 不会触发 ResearchTreeSK 重复解锁)。
  织绸这一步 recipeUsers 直接挂 HSK 的 TableLoom, 不新建第二套纺织台。
============================================================================ -->

	<RecipeDef Name="RK_ChainRecipeBase" Abstract="True">
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.25</workSkillLearnFactor>
		<effectWorking>Cook</effectWorking>
		<soundWorking>Recipe_CookMeal</soundWorking>
	</RecipeDef>

	<!-- ============ 养蚕缫丝 ============ -->
	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_RaiseSilkworms</defName>
		<label>养蚕收茧</label>
		<description>照看一匾蚕, 喂桑叶与嫩草, 等它们吐满茧后收下、趁鲜缫出生丝。</description>
		<jobString>养蚕缫丝</jobString>
		<workSpeedStat>TailoringSpeed</workSpeedStat>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>RK_Silkworm</li>
			   </thingDefs>
			  </filter>
			  <count>1</count>
			 </li>
			<li>
			  <filter>
			   <thingDefs>
			    <li>Hay</li>
			   </thingDefs>
			  </filter>
			  <count>12</count>
			 </li>
		</ingredients>
		<products>
			<RK_RawSilk>4</RK_RawSilk>
		</products>
		<recipeUsers>
			<li>RK_SilkwormTray</li>
		</recipeUsers>
		<workAmount>1600</workAmount>
		<researchPrerequisite>RK_Sericulture</researchPrerequisite>
		<uiIconPath>Things/Item/Resource/SilkFabric</uiIconPath>
	</RecipeDef>

	<!-- 织绸: 挂到 HSK 现有纺织机 -->
	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_WeaveSilk</defName>
		<label>织丝绸</label>
		<description>把生丝上机加捻织造, 得到轻薄有光的丝绸。这是丝绸唯一的来路, 也是皇家衣饰与镶金家具的命脉。</description>
		<jobString>织丝绸</jobString>
		<workSpeedStat>TailoringSpeed</workSpeedStat>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>RK_RawSilk</li>
			   </thingDefs>
			  </filter>
			  <count>4</count>
			 </li>
		</ingredients>
		<products>
			<RK_Silk>1</RK_Silk>
		</products>
		<recipeUsers>
			<li>TableLoom</li>
		</recipeUsers>
		<workAmount>2400</workAmount>
		<researchPrerequisite>RK_Sericulture</researchPrerequisite>
		<uiIconPath>Things/Item/Resource/SilkFabric</uiIconPath>
	</RecipeDef>

	<!-- ============ 造纸 ============ -->
	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_MakePaperPulp</defName>
		<label>沤纸浆</label>
		<description>把木头与草木灰泡烂、捣碎成稠浆。气味难闻, 但这是纸的来源。</description>
		<jobString>沤纸浆</jobString>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>WoodLog</li>
			   </thingDefs>
			  </filter>
			  <count>4</count>
			 </li>
		</ingredients>
		<products>
			<RK_PaperPulp>6</RK_PaperPulp>
		</products>
		<recipeUsers>
			<li>RK_PulpVat</li>
		</recipeUsers>
		<workAmount>1400</workAmount>
		<researchPrerequisite>Fabrication</researchPrerequisite>
		<uiIconPath>Things/Item/Resource/PaperMixture/PaperMixtureA</uiIconPath>
	</RecipeDef>

	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_PressPaper</defName>
		<label>压榨成纸</label>
		<description>纸浆上帘床、压去水分、晾干成沓。</description>
		<jobString>压榨纸张</jobString>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>RK_PaperPulp</li>
			   </thingDefs>
			  </filter>
			  <count>2</count>
			 </li>
		</ingredients>
		<products>
			<RK_Paper>8</RK_Paper>
		</products>
		<recipeUsers>
			<li>RK_PaperPress</li>
		</recipeUsers>
		<workAmount>1200</workAmount>
		<researchPrerequisite>Fabrication</researchPrerequisite>
		<uiIconPath>Things/Item/Resource/Paper</uiIconPath>
	</RecipeDef>

	<!-- ============ 抄书(纸 → 书) ============ -->
	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_CopyTale</defName>
		<label>誊写传说书</label>
		<description>抄一部流传已久的传说故事。它没什么实用价值, 但很适合在晚上读。</description>
		<jobString>誊写传说书</jobString>
		<workSkill>Intellectual</workSkill>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>RK_Paper</li>
			   </thingDefs>
			  </filter>
			  <count>12</count>
			 </li>
		</ingredients>
		<products>
			<RK_Book_Tale_Medieval>1</RK_Book_Tale_Medieval>
		</products>
		<recipeUsers>
			<li>RK_ScribeTable</li>
		</recipeUsers>
		<workAmount>12000</workAmount>
		<researchPrerequisite>Fabrication</researchPrerequisite>
	</RecipeDef>

	<RecipeDef ParentName="RK_ChainRecipeBase">
		<defName>RK_CopyTextBook</defName>
		<label>抄写专著</label>
		<description>把某一门手艺系统地整理、誊写成册。一本好的专著能让读者凭空长进不少本事。</description>
		<jobString>抄写专著</jobString>
		<workSkill>Intellectual</workSkill>
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<ingredients>
			<li>
			  <filter>
			   <thingDefs>
			    <li>RK_Paper</li>
			   </thingDefs>
			  </filter>
			  <count>25</count>
			 </li>
		</ingredients>
		<products>
			<TextBook>1</TextBook>
		</products>
		<recipeUsers>
			<li>RK_ScribeTable</li>
		</recipeUsers>
		<workAmount>30000</workAmount>
		<researchPrerequisite>Fabrication</researchPrerequisite>
	</RecipeDef>

	<!-- ============ 工作分配 ============ -->
	<WorkGiverDef>
		<defName>RK_DoBillsCraftChains</defName>
		<label>养蚕造纸抄书</label>
		<giverClass>WorkGiver_DoBill</giverClass>
		<workType>Crafting</workType>
		<priorityInType>100</priorityInType>
		<fixedBillGiverDefs>
			<li>RK_SilkwormTray</li>
			<li>RK_PulpVat</li>
			<li>RK_PaperPress</li>
			<li>RK_ScribeTable</li>
		</fixedBillGiverDefs>
		<verb>加工</verb>
		<gerund>正在加工</gerund>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
		<prioritizeSustains>true</prioritizeSustains>
	</WorkGiverDef>


</Defs>
