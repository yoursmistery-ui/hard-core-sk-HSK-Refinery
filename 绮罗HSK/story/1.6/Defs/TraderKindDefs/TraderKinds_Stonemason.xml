  <TraderKindDef>
    <defName>Kiiro_Merchant_StonemasonA</defName>
    <label>Bare-Bones Stonemason Store</label>
    <requestable>false</requestable>
    <hideThingsNotWillingToTrade>true</hideThingsNotWillingToTrade>
    <stockGenerators>
      <!-- 基础 -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>240~300</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>StoneBlocks</categoryDef>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>45~80</countRange>
        <price>Cheap</price>
      </li>
      <li Class="AncotLibrary.StockGenerator_SingleDefFixedStuff_Category">
        <thingDef>SculptureSmall</thingDef>
        <stuffCategoryDef>StoneBlocks</stuffCategoryDef>
        <countRange>1~2</countRange>
        <price>Cheap</price>
        <excludedThingDefs>
          <li>Jade</li>
        </excludedThingDefs>
      </li>


      <!-- Buying -->
      <li Class="StockGenerator_BuyTradeTag">
        <tag>Art</tag>
      </li>

    </stockGenerators>
  </TraderKindDef>


