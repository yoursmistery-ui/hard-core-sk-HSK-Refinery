	<!-- ===== 宝石材质类别(MO 宝石类别等价新建;HSK 侧无宝石 stuff 类别,玉石 Jade 走 Stony,故不复用以免宝石可当普通石材) ===== -->
	<StuffCategoryDef>
		<defName>RK_Gems</defName>
		<label>宝石</label>
		<destroySoundSmall>BuildingDestroyed_Stone_Small</destroySoundSmall>
		<destroySoundMedium>BuildingDestroyed_Stone_Medium</destroySoundMedium>
		<destroySoundLarge>BuildingDestroyed_Stone_Big</destroySoundLarge>
	</StuffCategoryDef>

	<!-- ===== 5 档宝石(移植自 MO Items_Resources GemBase 系列;暴击来源机制二期自研,首轮来源=P1 藏身处战利品)
	     defName 保留 Citrine/Amber(账单/存档引用不变), 2026-08-30 内容改为 黄玉/紫水晶 并换 TFC 贴图 ===== -->
	<ThingDef ParentName="ResourceBase" Name="RKGemBase" Abstract="True">
		<useHitPoints>false</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<soundInteract>ChunkRock_Drop</soundInteract>
		<soundDrop>ChunkRock_Drop</soundDrop>
		<techLevel>Medieval</techLevel>
		<thingCategories>
			<li>PRS</li>
		</thingCategories>
		<burnableByRecipe>false</burnableByRecipe>
		<smeltable>false</smeltable>
		<deepCountPerPortion>8</deepCountPerPortion>
		<deepLumpSizeRange>1~4</deepLumpSizeRange>
		<stuffProps>
			<categories>
				<li>RK_Gems</li>
			</categories>
			<constructEffect>ConstructMetal</constructEffect>
			<soundMeleeHitSharp>MeleeHit_Stone</soundMeleeHitSharp>
			<soundMeleeHitBlunt>MeleeHit_Stone</soundMeleeHitBlunt>
		</stuffProps>
		<allowedArchonexusCount>80</allowedArchonexusCount>
	</ThingDef>

