<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <WorldObjectDef>
    <defName>BOTR_FactionTradeCaravan</defName>
    <label>faction trade caravan</label>
    <description>A real caravan carrying people and goods between two settlements of the same faction. Player caravans can intercept it to trade peacefully or launch an ambush.</description>
    <worldObjectClass>BordersOfTheRim.WorldObject_FactionTradeCaravan</worldObjectClass>
    <texture>UI/FactionCaravans/Trade</texture>
    <useDynamicDrawer>true</useDynamicDrawer>
    <expandingIcon>true</expandingIcon>
    <expandingIconTexture>UI/FactionCaravans/Trade</expandingIconTexture>
    <expandingIconPriority>95</expandingIconPriority>
    <expandMore>true</expandMore>
    <allowCaravanIncidentsWhichGenerateMap>true</allowCaravanIncidentsWhichGenerateMap>
  </WorldObjectDef>
</Defs>
