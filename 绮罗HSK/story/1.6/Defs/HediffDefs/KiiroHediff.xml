<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>Kiiro_JoinBonfireParty</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>bonfire party aftertaste</label>
    <description>Now I feel more motivated at work.</description>
    <defaultLabelColor>(0.6,0.8,0.6)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.14</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>


  <!-- 饱腹感 -->
  <HediffDef>
    <defName>Kiiro_Satiety</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>Satiety</label>
    <description>I feel full in my stomach.</description>
    <defaultLabelColor>(0.6,0.8,0.6)</defaultLabelColor>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-2</severityPerDay>
        <showHoursToRecover>true</showHoursToRecover>
      </li>
    </comps>
    <stages>
      <li>
        <hungerRateFactor>0.9</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>


</Defs>