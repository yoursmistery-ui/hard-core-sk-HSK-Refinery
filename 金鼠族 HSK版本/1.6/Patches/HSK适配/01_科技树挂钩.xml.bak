    <!-- ========== ③b 金鼠族科技等级对齐 ==========
         金鼠族节点挂靠更高档鼠族科技后,techLevel 低于其前置属链最大档,触发
         ResearchTreeSK "has a lower techlevel than its prerequisites" 警告。
         将 3 个受影响节点 techLevel 提升至不低于其前置闭包最大档。 -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="OA_RK_Oberonia_Aurea_Research"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="OA_RK_Oberonia_Aurea_Research_B"]/techLevel</xpath>
        <value><techLevel>Medieval</techLevel></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="OA_RK_Apparel_F"]/techLevel</xpath>
        <value><techLevel>Ultra</techLevel></value>
    </Operation>
</Patch>