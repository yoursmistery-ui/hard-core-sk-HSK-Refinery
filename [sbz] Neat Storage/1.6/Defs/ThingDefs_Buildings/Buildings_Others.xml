	<ThingDef ParentName="AdaptiveStorageBase">
		<defName>sbz_Drum</defName>
		<label>Drum</label>
		<description>The drum can hold up to 6 items of various kinds.</description>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.4</fillPercent>
		<castEdgeShadows>true</castEdgeShadows>
		<pathCost>50</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<Mass>20</Mass>
			<WorkToBuild>1250</WorkToBuild>
			<Flammability>0.8</Flammability>
		</statBases>
		<size>(1,1)</size>
		<rotatable>false</rotatable>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<researchPrerequisites>
			<li>Machining</li>
		</researchPrerequisites>
		<graphicData>
			<texPath>Things/Building/Storage/Drum/sbz_Drum</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
		</graphicData>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costStuffCount>20</costStuffCount>
		<uiIconScale>0.5</uiIconScale>
		<uiOrder>1170</uiOrder>
		<staticSunShadowHeight>0.33</staticSunShadowHeight>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>6</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Foods</li>
						<li>Manufactured</li>
						<li>ResourcesRaw</li>
						<li>Items</li>
						<li>Weapons</li>
						<li>Apparel</li>
						<li>CorpsesHumanlike</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsNeatStorage</li>
		</thingCategories>
		<uiIconOffset>(0, 0.125)</uiIconOffset>
	</ThingDef>	
</Defs>