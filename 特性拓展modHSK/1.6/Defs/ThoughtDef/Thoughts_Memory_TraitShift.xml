<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- v2 (2026-08-27): 动态特性变化后给本人一条短期想法, 让"性格变了"这件事不只是右上角一封信。
       只在本 mod 授予/退场时注入, 不影响生成期特性。 -->
  <ThoughtDef>
    <defName>HSK_TraitShift</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>recognizing myself</label>
        <description>我忽然意识到，自己已经不是几年前那个人了。这种感觉并不坏——至少现在的我，知道自己会怎么做。</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>HSK_TraitDrift</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>6</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>a part of me slipping away</label>
        <description>有什么东西从我身上退了下去，而我说不清是从哪一天开始的。</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
