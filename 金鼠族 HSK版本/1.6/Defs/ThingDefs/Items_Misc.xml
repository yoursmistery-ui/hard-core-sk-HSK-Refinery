<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="ResourceBase">
        <defName>OAGene_IceCrystal</defName>
        <label>Blizzard shattered crystals</label>
        <description>A very beautiful mineral compound that only forms in extreme blizzard weather and melts and disappears above zero room temperature.\nSome collectors of rare items are enthusiastic about purchasing these rare natural products, while a few believers of the snowstorm regard these things as offerings to the gods.</description>
        <graphicData>
            <texPath>Things/Item/OAGene_IceCrystal</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Metal_Drop</soundDrop>
        <stackLimit>50</stackLimit>
        <useHitPoints>true</useHitPoints>
        <statBases>
            <MarketValue>8</MarketValue>
            <MaxHitPoints>75</MaxHitPoints>
			<Beauty>10</Beauty>
            <Mass>0.4</Mass>
            <Flammability>0</Flammability>
			<DeteriorationRate>6</DeteriorationRate>
        </statBases>
		<healthAffectsPrice>false</healthAffectsPrice>
        <tickerType>Rare</tickerType>
        <thingCategories>
            <li>ItemsMisc</li>
        </thingCategories>
        <tradeability>Sellable</tradeability>
        <tradeTags>
            <li>ExoticMisc</li>
        </tradeTags>
        <comps>
            <li Class="OberoniaAureaGene.Snowstorm.CompProperties_IceCrystal">
                <disappearHours>12</disappearHours>
            </li>
        </comps>
    </ThingDef>

</Defs>