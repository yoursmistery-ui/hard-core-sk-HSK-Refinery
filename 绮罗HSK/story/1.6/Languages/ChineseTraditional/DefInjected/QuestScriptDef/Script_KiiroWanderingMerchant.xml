<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <Kiiro_WanderingMerchant.label>綺羅流浪商人加入</Kiiro_WanderingMerchant.label>
  <!-- EN:
    <li>questDescription->A [merchantPawnKind_label] is wandering outside the colony. [merchantOwner_pronoun] claims to be from a distant town and fled in haste after hometown is attacked by pirates, leaving behind the goods from shop. After a long journey, [merchantOwner_pronoun] has arrived here and is pleading for your colony to take [merchantOwner_pronoun] in. [merchantOwner_pronoun] wishes to use remaining savings and skills to establish a new [merchantDef_label] here.\n\nThe merchant will not perform any work, and you will need to provide a room to serve as their shop. You can trade with [merchantOwner_pronoun] in the shop.</li>
  -->
  <Kiiro_WanderingMerchant.questDescriptionRules.rulesStrings>
    <li>questDescription->一名[merchantPawnKind_label]在殖民地外徘徊著。[merchantOwner_pronoun]聲稱自己來自遠方的城鎮，在家鄉遭遇了海盜的襲擊后[merchantOwner_pronoun]顧不得帶上店裡的貨物就匆忙地逃走，一路流亡至此。[merchantOwner_pronoun]懇請你的殖民地能夠接納[merchantOwner_pronoun]，然後憑藉自己的手藝和僅剩的盤纏在這裡重新開一家[merchantDef_label]。\n\n商戶不會做任何工作，並且你需要為其提供作為商舖的房間。你可以與[merchantOwner_pronoun]在商舖中進行貿易。</li>
  </Kiiro_WanderingMerchant.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->wandering kiiro merchant</li>
  -->
  <Kiiro_WanderingMerchant.questNameRules.rulesStrings>
    <li>questName->流浪綺羅商人</li>
  </Kiiro_WanderingMerchant.questNameRules.rulesStrings>
  <!-- EN: Kiiro merchant owner died: {SUBJECT_definite} -->
  <Kiiro_WanderingMerchant.root.nodes.laborersDestroyed.node.nodes.Letter.label.slateRef>商戶死亡：{SUBJECT_definite}</Kiiro_WanderingMerchant.root.nodes.laborersDestroyed.node.nodes.Letter.label.slateRef>
  <!-- EN: Kiiro merchant owner has dead. -->
  <Kiiro_WanderingMerchant.root.nodes.laborersDestroyed.node.nodes.Letter.text.slateRef>綺羅商戶已經死亡了。</Kiiro_WanderingMerchant.root.nodes.laborersDestroyed.node.nodes.Letter.text.slateRef>
  <!-- EN: Kiiro merchant leaving -->
  <Kiiro_WanderingMerchant.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>綺羅商戶離開</Kiiro_WanderingMerchant.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>
  <!-- EN: Due to the hostile relationship with us, Kiiro merchants has ceased their settling-in. -->
  <Kiiro_WanderingMerchant.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>由於與綺羅派系關係已經變為敵對，商戶已經中止了駐留的計劃。</Kiiro_WanderingMerchant.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>
  
</LanguageData>