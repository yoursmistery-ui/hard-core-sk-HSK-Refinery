<?xml version="1.0" encoding="utf-8"?>
<!--
  20_塑料板描边.xml  —— 现职能已扩展为「材料贴图重制」
  (2026-09-06 建; 2026-09-11 扩展: 新增金刚砂, 4 个塑料改独立美术 + 换独占路径)
  注: 文件名保持不变以免改动补丁执行序(同 20_ 前缀无其它文件, 改名无风险, 仅为减少 churn 而保留)
  目的:
   1) 原贴图是无描边平板, 雪地等浅色地面上几乎隐形 -> 统一补纯黑粗描边
      (64px→1.8px, alpha 平滑剪影后外扩; 脚本 gptch-image-gen/scripts/outline.py)。
   2) VMS 原设计让多个材料复用同一张贴图(ABS 借 ABSBlack/钢蓝, PP 借 HDPEBlue/卡其,
      PVC 借 HDPEGreen/灰白), 导致游戏内多个材料长得一样、分不清。
      -> 5 个材料改为各自独立美术(金刚砂黑 / ABS 暖乳白 / 玻纤乳白带纤维 / PVC 冷灰白 / PP 半透灰)。
   3) 独占文件夹: 贴图放本 mod 自己的 Textures/Things/Item/MaterialHSK/<名>HSK/,
      **不再复用 VMS 的 Material/ 或 MaterialOutlined/ 同名路径**。
      原因: Graphic_Collection.Init 用 ContentFinder.GetAllInFolder -> 遍历全部已启用 mod 且不去重,
      同名文件夹会被"合并"(旧 a,新 a,旧 b,新 b,旧 c,新 c 共 6 张) -> Graphic_StackCount 档位错乱:
      stackCount==1 取下标0(=先加载方的旧图), 中间档位在新旧之间横跳, 只有满堆才取到新图。
   位次: 文件名序 20_ 无既有依赖; 目标 def 属 Vile MS(加载序 157), 本 mod 167 必已在其后。
   门控: 1.6 Operation 级 MayRequire 失效 -> 一律顶层 Conditional xpath 存在性门控。
-->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ABS"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="ABS"]/graphicData/texPath</xpath>
      <value><texPath>Things/Item/MaterialHSK/ABSResinHSK</texPath></value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PPPlastic"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="PPPlastic"]/graphicData/texPath</xpath>
      <value><texPath>Things/Item/MaterialHSK/PPPlasticHSK</texPath></value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="PVCPlastic"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="PVCPlastic"]/graphicData/texPath</xpath>
      <value><texPath>Things/Item/MaterialHSK/PVCPlasticHSK</texPath></value>
    </match>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Fiberglass"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Fiberglass"]/graphicData/texPath</xpath>
      <value><texPath>Things/Item/MaterialHSK/FiberglassHSK</texPath></value>
    </match>
  </Operation>

  <!-- 金刚砂: VMS 原 texPath 指向 Material/Carborundum, 与 VMS 同名文件夹冲突 -> 换独占路径 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Carborundum"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="Carborundum"]/graphicData/texPath</xpath>
      <value><texPath>Things/Item/MaterialHSK/CarborundumHSK</texPath></value>
    </match>
  </Operation>
</Patch>
