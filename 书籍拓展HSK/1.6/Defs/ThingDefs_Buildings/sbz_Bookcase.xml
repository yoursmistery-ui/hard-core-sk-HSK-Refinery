	<!--Bookshelf-->
	<ThingDef ParentName="BookcaseBase">
		<defName>sbz_Bookshelf</defName>
		<label>bookshelf</label>
		<description>A shelf for storing and displaying up to twelve books. Books stored here will passively enhance academic work done nearby, and increase the beauty of the bookshelf. The stored books will never deteriorate. Can also be placed on top of other buildings.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Bookcase/sbz_Bookshelf</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<size>(2,1)</size>
		<costStuffCount>24</costStuffCount>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Mass>4</Mass>
			<WorkToBuild>600</WorkToBuild>
		</statBases>
		<clearBuildingArea>false</clearBuildingArea>
		<building>
			<maxItemsInCell>6</maxItemsInCell>
			<isEdifice>false</isEdifice>
		</building>
		<placeWorkers>
			<li>sbz.PlaceWorker_Bookcase</li>
		</placeWorkers>
		<modExtensions>
			<li Class="sbz.BookcaseModExtension">
				<north>
					<bookOffset>(-0.8, 0.02, 0.18)</bookOffset>
					<bookSpacing>(0.1465, 0, 0)</bookSpacing>
					<booksPerTier>12</booksPerTier>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_BookshelfLayer_north</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 0.6, 0)</offset>
						</li>
					</layers>
				</north>
				<east>
					<bookOffset>(-0.15, 0, -0.6)</bookOffset>
					<bookSpacing>(0, 0, 0.12)</bookSpacing>
					<booksPerTier>12</booksPerTier>
					<tierOffset>(-1, 0, -1)</tierOffset>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_BookshelfLayer_east</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 0.6, 0)</offset>
						</li>
					</layers>						
				</east>
				<south>
					<bookOffset>(-0.8, 0.02, 0.10)</bookOffset>
					<bookRotate>0</bookRotate>
					<bookSpacing>(0.1465, 0, 0)</bookSpacing>
					<booksPerTier>12</booksPerTier>
				</south>
				<west>
					<bookOffset>(0.15, 0, -0.6)</bookOffset>
					<bookSpacing>(0, 0, 0.12)</bookSpacing>
					<booksPerTier>12</booksPerTier>
					<tierOffset>(-1, 0, -1)</tierOffset>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_BookshelfLayer_west</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 0.6, 0)</offset>
						</li>
					</layers>						
				</west>
			</li>
		</modExtensions>
	</ThingDef>

