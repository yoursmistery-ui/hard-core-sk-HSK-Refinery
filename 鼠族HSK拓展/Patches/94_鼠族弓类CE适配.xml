	</Operation><!-- 鼠族钉头锤 RK_Mace 恢复为纯近战武器(用户要求 2026-08-21):
         撤销 35_剪刀与钉头锤工具 / 56_生存工具全面补强 对 RK_Mace 的工具化:
         thingClass=SurvivalToolsLite.SurvivalTool、statBases/ToolEffectivenessFactor、
         modExtensions SurvivalToolProperties、thingCategories=SurvivalToolsMedieval
         全部移除,回退继承 RK_MeleeWeapon 基类(标准近战武器)。
         RK_Mace 已是单手武器(weaponTags 含 RK_WeaponTag_OneHand/OneHandMelee/OneHandMeleeAttack
         + CE_OneHandedWeapon,CompProperties_WeaponGripType OneHand),保持不动。
         条件保护: 仅当 STL 工具属性存在(35 号 MayRequire SurvivalToolsLite 生效)时执行,
         避免 Failed to find a node。 -->

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="RK_Mace"]/modExtensions/li[@Class="SurvivalToolsLite.SurvivalToolProperties"]</xpath>
        <match Class="PatchOperationSequence">
            <success>Normal</success>
            <operations>
                <!-- 1) thingClass 回退继承 RK_MeleeWeapon -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName="RK_Mace"]/thingClass</xpath>
                </li>
                <!-- 2) 工具效能因子 -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName="RK_Mace"]/statBases/ToolEffectivenessFactor</xpath>
                </li>
                <!-- 3) STL 工具属性(工作速度加成/工具分配) -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName="RK_Mace"]/modExtensions/li[@Class="SurvivalToolsLite.SurvivalToolProperties"]</xpath>
                </li>
                <!-- 4) 工具分类(回退继承,不再显示为工具) -->
                <li Class="PatchOperationRemove">
                    <xpath>Defs/ThingDef[defName="RK_Mace"]/thingCategories</xpath>
                </li>
            </operations>
        </match>
    </Operation></Patch>
