<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 书架二级菜单(ArchitectSense 子分类,挂家具一级分类)
	     整合自 [sbz] Bookcase 四种书架 -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>VBE_SubCategory_Bookcases</defName>
		<label>书架</label>
		<description>书籍存储与展示家具,可被动提升附近学术工作。</description>
		<defNames>
			<li>sbz_TwoTierBookcase</li>
			<li>sbz_NarrowTwoTierBookcase</li>
			<li>sbz_Bookshelf</li>
			<li>sbz_BookshelfSmall</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>90</order>
		<types>
			<li>Rooms</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<!-- 写作与印刷二级菜单(挂生产一级分类)
	     写作台/打字机台(VBooksE)+ 手动/电动印刷机(VBEE 移植) -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>VBE_SubCategory_WritingAndPrinting</defName>
		<label>写作与印刷</label>
		<description>写作台、打字机台与印刷机,用于撰写书籍与报纸。</description>
		<defNames>
			<li>VBE_WritersTable</li>
			<li>VBE_TypewritersTable</li>
			<li>VanillaBooksExpandedExpanded_PrintingPressManual</li>
			<li>VanillaBooksExpandedExpanded_PrintingPressElectric</li>
		</defNames>
		<designationCategory>Production</designationCategory>
		<debug>false</debug>
		<order>90</order>
		<types>
			<li>Rooms</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

</Defs>
