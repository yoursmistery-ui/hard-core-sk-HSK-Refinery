<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->The residents of [kiiro_settlement_label] are planning to have a bonfire party in the wilderness and would like to invite you to join.\n\nEven though kiiros life is no longer as peaceful as before, they still choose to engage in some leisurely social activities when it's safe. A simple bonfire party is a perfect choice, allowing participants to relax in meals and enjoy themselves.</li>
  -->
  <Kiiro_OpportunitySite_BonfireParty.questDescriptionRules.rulesStrings>
    <li>questDescription->[kiiro_settlement_label]的居民計劃最近在野外開展一次篝火晚會，想要邀請你一起參加。\n\n儘管綺羅族的生活不再像以前那樣安寧，但她們也還是會在安全的時候選擇開展一些閒適的社會活動，一場簡單的篝火晚會就能夠讓參與者在吃飽喝足的同時愉悅身心，正是絕佳的選擇。</li>
  </Kiiro_OpportunitySite_BonfireParty.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->bonfire party</li>
  -->
  <Kiiro_OpportunitySite_BonfireParty.questNameRules.rulesStrings>
    <li>questName->篝火晚會</li>
  </Kiiro_OpportunitySite_BonfireParty.questNameRules.rulesStrings>
  <!-- EN: Quest expired: [resolvedQuestName] -->
  <Kiiro_OpportunitySite_BonfireParty.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>任務過期：[resolvedQuestName]</Kiiro_OpportunitySite_BonfireParty.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>
  <!-- EN: The bonfire party of [kiiro_settlement_label] has concluded successfully. -->
  <Kiiro_OpportunitySite_BonfireParty.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>[kiiro_settlement_label]的篝火晚會順利結束了。</Kiiro_OpportunitySite_BonfireParty.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>
  <!-- EN: [resolvedQuestName] failed -->
  <Kiiro_OpportunitySite_BonfireParty.root.nodes.factionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>[resolvedQuestName]失效</Kiiro_OpportunitySite_BonfireParty.root.nodes.factionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>
  <!-- EN: Due to the hostile relationship with the kiiros, [resolvedQuestName] cannot be completed further. -->
  <Kiiro_OpportunitySite_BonfireParty.root.nodes.factionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>由於與綺羅族處於敵對關係，[resolvedQuestName]無法繼續完成。</Kiiro_OpportunitySite_BonfireParty.root.nodes.factionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>
  
