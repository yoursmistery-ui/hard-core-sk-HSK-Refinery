		</recipeMaker>
		<costStuffCount>10</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costList>
			<WoodLog>75</WoodLog>
			<Steel>45</Steel>
			<ComponentMedieval>3</ComponentMedieval>
			<ComponentIndustrial>2</ComponentIndustrial>
			<LeadBar>20</LeadBar>
