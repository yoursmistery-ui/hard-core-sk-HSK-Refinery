<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- ============================================================
		2026-08-29 油料六件套加入燃烧设施燃料单
		六件套 = Kindling 引火物 / Pitch 树脂 / FishOil 鱼油 / Tallow 油脂 / PlantWax 蜡 / Turpentine 松节油
		(全部为 Core_SK/Vile 系 ThingWithComps 燃料物品, Unified.xml 终态确认存在;
		 各设施只补缺集, 不重复添加已有项; Tallow 原为本文件主角, 现 TavTallow 已删, 全部为 Core_SK Tallow)

		① HSK 取暖/明火设施(燃料组件按 Unified.xml 终态 = SK.CompFueled_Properties):
		   Campfire 缺 Pitch/FishOil/Tallow/PlantWax/Turpentine
		   Brazier 缺 Kindling/Pitch/FishOil/Tallow/PlantWax/Turpentine
		   Building_Heater / OpenHearth 缺 Pitch/FishOil/Tallow/PlantWax/Turpentine
		② 原版未改设施(CompProperties_Refuelable): DarklightBrazier 缺全部6种, Darktorch 缺5种(有Kindling)
		③ 本 mod Tav_Oven: 已有 Charcoal/Coal/Kindling/Tallow, 补 Pitch/FishOil/PlantWax/Turpentine
		④ 鼠族家具拓展 13 个燃料建筑(CompProperties_Refuelable): 灯9+篝火/壁炉/锻造炉/炉灶, 各补全部6种
		 TorchLamp/TorchWallLamp 终态已含全部六种, 无需补。
		⑤ HSK工业科研大修 10 个(CompProperties_Refuelable): 燃气锅炉(+6, 天然气外兼烧油料),
		   Rustic 乡村照明 9 个 —— 火把x2/路灯(烧煤)各补6种, 油灯x2/蜡烛类x4(烧油脂)各补5种(已有Tallow)。

		门控: 逐 def 顶层 Conditional(xpath 存在性, 1.6 Operation 级 MayRequire 已失效);
		目标 mod 未装/def 不存在时静默 no-op(反编译 PatchOperationConditional.ApplyWorker 实证)。
	============================================================ -->

	<!-- ===== ① Campfire: +5 ===== -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="Campfire"]/comps/li[@Class="SK.CompFueled_Properties"]/fuelFilter/thingDefs</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="Campfire"]/comps/li[@Class="SK.CompFueled_Properties"]/fuelFilter/thingDefs</xpath>
			<value>
				<li>Pitch</li>
				<li>FishOil</li>
				<li>Tallow</li>
				<li>PlantWax</li>
				<li>Turpentine</li>
			</value>
		</match>
	</Operation>

