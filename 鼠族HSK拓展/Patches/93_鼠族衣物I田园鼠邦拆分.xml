      <recipeMaker>
        <researchPrerequisite>Ratkin_Apparel_B1c</researchPrerequisite>
      </recipeMaker>
    </value>
  </Operation>

  <!-- 3. B2A(鼠族衣物II·礼服装) 改完整工业时代 -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ResearchProjectDef[defName="Ratkin_Apparel_B2A"]/techLevel</xpath>
    <value><techLevel>Industrial</techLevel></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ResearchProjectDef[defName="Ratkin_Apparel_B2A"]</xpath>
    <value>
      <requiredResearchFacilities>
        <li>LabTerminal</li>
      </requiredResearchFacilities>
    </value>
