        <xpath>Defs/ThingDef[defName="Crusaders"]/equippedStatOffsets</xpath>
        <value>
            <equippedStatOffsets>
                <MoveSpeed>-0.30</MoveSpeed>
                <PainShockThreshold>0.10</PainShockThreshold>
                <IncomingDamageFactor>-0.08</IncomingDamageFactor>
            </equippedStatOffsets>
