			<texPath>Misc/Item_UnfinishedJewelry</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<comps>
			<!-- <li>
				<compClass>CompColorable</compClass>
			</li> -->
		</comps>
	</ThingDef>

	<ThingCategoryDef>
