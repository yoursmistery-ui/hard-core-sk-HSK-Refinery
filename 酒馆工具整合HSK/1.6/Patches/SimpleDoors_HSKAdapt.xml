<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- ============================================================
        Simple Doors 简单门 —— HSK 门属性对齐补丁
        对齐基准（HSK 原版门数值）：
          木门   → 原版木门 Door：    HP160 / 工时850 / 材料25 / 无科研
          石门   → 金属门 MDoor：     HP280 / 工时800 / 材料15+工业零件1 / 科研Construction_B2 / 建造5
          工业门 → 自动门 Autodoor：  HP160 / 工时1100 / 钢40+工业零件2 / 科研Autodoors / 建造6
        1x2 = 1.5x 基准，1x3 = 2x 基准（按尺寸比例放大）
    ============================================================ -->

    <!-- ==================== 木门（对齐原版木门 Door） ==================== -->

    <!-- SD_1x1WoodDoor -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SD_1x1WoodDoor"]/statBases/MaxHitPoints</xpath>
        <value><MaxHitPoints>160</MaxHitPoints></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SD_1x1WoodDoor"]/statBases/WorkToBuild</xpath>
        <value><WorkToBuild>850</WorkToBuild></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SD_1x1WoodDoor"]/costStuffCount</xpath>
        <value><costStuffCount>25</costStuffCount></value>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="SD_1x1WoodDoor"]/researchPrerequisites</xpath>
    </Operation>

    <!-- SD_2x1WoodDoor -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SD_2x1WoodDoor"]/statBases/MaxHitPoints</xpath>
