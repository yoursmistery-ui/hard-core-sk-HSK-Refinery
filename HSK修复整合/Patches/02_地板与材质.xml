<!-- ================================================================
     Compaste(复合黏剂/环氧树脂) 贴图回退 HSK 原版 (2026-08-24)
     Vile's Materials Science 用 SK.PatchOperationReplaceExtended 把 Compaste
     graphicData.texPath 覆盖成 Things/Item/Chemical/ThermosetResin(环氧树脂贴图),
     Vile 自带 ZZ_RestoreHSKTextures.xml 在生效环境压不过它; 本 mod 加载序 167 后于
     Vile 157, 此处强制改回 HSK 原版贴图 Things/Item/Resource/CompoundPaste。
     ================================================================ -->
<Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Compaste"]/graphicData/texPath</xpath>
    <match Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Compaste"]/graphicData/texPath</xpath>
        <value>
            <texPath>Things/Item/Resource/CompoundPaste</texPath>
        </value>
    </match>
</Operation>

</Patch>
