		<label>Moustate trader</label>
		<trader>true</trader>
		<isFighter>false</isFighter>
		<itemQuality>Good</itemQuality>
		<combatPower>45</combatPower>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>MoustateNoble</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<specificApparelRequirements>
			<li>
				<bodyPartGroup>Torso</bodyPartGroup>
				<apparelLayer>OnSkin</apparelLayer>
				<requiredTag>RK_ExoticNoble</requiredTag>
			</li>
			<li>
				<bodyPartGroup>UpperHead</bodyPartGroup>
				<requiredTag>RK_ExoticNoble</requiredTag>
			</li>
		</specificApparelRequirements>
		<gearHealthRange>
			<min>0.9</min>
			<max>1</max>
		</gearHealthRange>
		<apparelMoney>
			<min>2300</min>
			<max>3500</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_ExoticNoble</li>
			<li>RK_ExoticTier3</li>
			<li>RK_ExoticTier2</li>
			<li>RK_ExoticTier1</li>
		</apparelTags>
		<weaponMoney>
			<min>500</min>
			<max>2000</max>
		</weaponMoney>
		<weaponTags>
			<li>RK_ExoticTrader</li>
		</weaponTags>
		<apparelAllowHeadgearChance>0.8</apparelAllowHeadgearChance>
		<inventoryOptions>
			<skipChance>0</skipChance>
			<subOptionsChooseOne>
				<li>
					<thingDef>MedicineHerbal</thingDef>
					<countRange>4~10</countRange>
				</li>
				<li>
					<thingDef>Silver</thingDef>
					<countRange>200~666</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<skills>
			<li>
				<skill>Social</skill>
				<range>5~15</range>
			</li>
		</skills>
		<requiredWorkTags>
			<li>Social</li>
		</requiredWorkTags>
	</PawnKindDef>


