    <!-- 来源: 06_ModAssistant标记.xml —— 2026-08-28 标记改粉色: 从共享蓝色 NativeAddon 迁到独立类别 HSKFixPack -->
    <!-- 类别颜色定义见 Defs/ModTypeDefs/HSK修复整合标记.xml (AMA.ModTypeDef color=255,105,180); order=7 排序位不变 -->
    <!-- 1.6 起 Operation 级 MayRequire 失效, 改用 PatchOperationConditional 门控 settings def 是否存在 -->
<Operation Class="PatchOperationConditional">
    <xpath>Defs/AMA.ModListerSettingsDef[defName="ModListerSettingsDef"]/modIndicators</xpath>
    <match Class="PatchOperationAdd">
        <xpath>Defs/AMA.ModListerSettingsDef[defName="ModListerSettingsDef"]/modIndicators</xpath>
        <value>
            <HSKFixPack>
                <li>
                    <id>local.hskfixpack</id>
                </li>
            </HSKFixPack>
        </value>
    </match>
</Operation>

    <!-- 来源: 10_Compulsion精神崩溃游荡.xml -->
<Operation Class="PatchOperationReplace" MayRequire="skyarkhangel.HSK">
    <xpath>Defs/ThinkTreeDef[defName="MeltdownMentalStates"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalMentalState" and state="Compulsion"]/subNodes/li[@Class="ThinkNode_Priority"]/subNodes/li[@Class="SK.JobGiver_Compulsion"]</xpath>
    <value>
        <li Class="JobGiver_WanderAnywhere">
            <maxDanger>Deadly</maxDanger>
        </li>
    </value>
</Operation>

