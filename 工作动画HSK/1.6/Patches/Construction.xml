    <xpath>/Defs/EffecterDef[defName="ConstructWood"]/children</xpath>
    <value>
      <children>
        <li>
          <subEffecterClass>SubEffecter_Sustainer</subEffecterClass>
          <soundDef>Interact_ConstructWood</soundDef>
        </li>
        <!-- tan sawdust haze -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>DustPuff</fleckDef>
          <chancePerTick>0.06</chancePerTick>
          <scale>0.56~0.84</scale>
          <color>(202, 168, 112)</color>
          <rotationRate>-50~50</rotationRate>
          <speed>0.5~1.4</speed>
        </li>
        <!-- flying wood splinters -->
        <li>
          <subEffecterClass>SubEffecter_SprayerChance</subEffecterClass>
          <fleckDef>JE_WoodChip</fleckDef>
          <chancePerTick>0.12</chancePerTick>
          <burstCount>1~3</burstCount>
          <scale>0.35~0.63</scale>
          <positionRadius>0.25</positionRadius>
          <fleckUsesAngleForVelocity>true</fleckUsesAngleForVelocity>
          <angle>120~240</angle>
          <speed>5~11</speed>
          <rotation>0~360</rotation>
          <rotationRate>-220~220</rotationRate>
        </li>
        <!-- chunkier vanilla wood bits -->
