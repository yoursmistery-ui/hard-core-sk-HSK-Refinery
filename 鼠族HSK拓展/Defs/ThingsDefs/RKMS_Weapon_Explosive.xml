<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="RK_ExoticGrenadeWeapon">
		<defName>RK_GrenadeMuskmelon</defName>
		<label>muskmelon grenades</label>
		<description>A defensive grenade that can be thrown or filled with a projectile cartridge, causing the enemy to suffer from the resulting fragmentation. Looks like you need to knock it before you throw it.</description>
		<recipeMaker>
			<researchPrerequisite>Machining</researchPrerequisite>
		</recipeMaker>
		<tickerType>Normal</tickerType>
		<graphicData>
			<texPath>Item_Weapon/RK_GrenadePack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<uiIconScale>1.2</uiIconScale>
		<soundInteract>Interact_Grenade</soundInteract>
		<techLevel>Industrial</techLevel>
		<statBases>
			<Mass>1</Mass>
			<RangedWeapon_Cooldown>2.2</RangedWeapon_Cooldown>
			<WorkToMake>12000</WorkToMake>
		</statBases>
		<costList>
			<Steel>30</Steel>
			<Chemfuel>65</Chemfuel>
		
				<ComponentIndustrial>2</ComponentIndustrial>
</costList>
		<weaponTags>
			<li>RK_ExoticGrenadeT2</li>
		</weaponTags>
		<thingCategories>
			<li>Grenades</li>
		</thingCategories>
		<smeltable>true</smeltable>
		<verbs>
			<li>
				<verbClass>Verb_LaunchProjectile</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<range>17.9</range>
				<forcedMissRadius>1.4</forcedMissRadius>
				<warmupTime>1.5</warmupTime>
				<noiseRadius>3</noiseRadius>
				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
				<soundCast>ThrowGrenade</soundCast>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>RK_Proj_Muskmelon</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3.2</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
			</li>
		</comps>
	</ThingDef>


	<ThingDef ParentName="RK_ExoticGrenadeWeapon">
		<defName>RK_LauncherMuskmelon</defName>
		<label>ratkin grenade launcher</label>
		<description>A mini-caliber projectile launcher that can fire converted grenades. \n(this weapon can fire in a curved line)</description>
		<recipeMaker>
			<researchPrerequisite>Mortars</researchPrerequisite>
		</recipeMaker>
		<tickerType>Normal</tickerType>
		<recoilPower>3</recoilPower>
		<graphicData>
			<texPath>Item_Weapon/RK_BombThrower</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Interact_Grenade</soundInteract>
		<techLevel>Industrial</techLevel>
		<statBases>
			<Mass>1</Mass>
			<RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
			<WorkToMake>8000</WorkToMake>
		</statBases>
		<equippedAngleOffset>-30</equippedAngleOffset>
		<costList>
			<Steel>55</Steel>
			<Chemfuel>50</Chemfuel>
			<RK_GrenadeMuskmelon>1</RK_GrenadeMuskmelon>
		
				<ComponentIndustrial>3</ComponentIndustrial>
</costList>
		<weaponTags>
			<li>RK_ExoticGrenadeT2</li>
			<li>RK_ExoticLauncher</li>
		</weaponTags>
		<thingCategories>
			<li>Grenades</li>
		</thingCategories>
		<smeltable>true</smeltable>
		<verbs>
			<li>
				<!-- <verbClass>RatkinGeneExpanded.Verb_ShootAdvanced</verbClass> -->
				<verbClass>Verb_LaunchProjectile</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<!-- <isMortar>true</isMortar> -->
				<requireLineOfSight>true</requireLineOfSight>
				<!-- <underRoofNeedLineOfSight>true</underRoofNeedLineOfSight> -->
				<range>30.9</range>
				<forcedMissRadius>2.2</forcedMissRadius>
				<warmupTime>2.5</warmupTime>
				<noiseRadius>3</noiseRadius>
				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
				<soundCast>ThrowGrenade</soundCast>
				<muzzleFlashScale>12</muzzleFlashScale>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>RK_Proj_Muskmelon_launcher</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3.2</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
			</li>
		</comps>
	</ThingDef>


	<ThingDef ParentName="RK_ExoticGrenadeWeapon">
		<defName>RK_GrenadeRatKing</defName>
		<label>RatKing bombs</label>
