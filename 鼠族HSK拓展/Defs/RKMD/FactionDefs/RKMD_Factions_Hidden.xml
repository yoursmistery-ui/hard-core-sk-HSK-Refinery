		<fixedIdeoWeaponDespised>Neolithic</fixedIdeoWeaponDespised>
    <ignoreDistanceRelationEffect>true</ignoreDistanceRelationEffect>
    
		<categoryTag>Outlander</categoryTag>
		<settlementGenerationWeight>0</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<configurationListOrderPriority>2000</configurationListOrderPriority>
		<displayInFactionSelection>false</displayInFactionSelection>
		<fixedName>Waste Rat</fixedName>
    <canGenerateQuestSites>true</canGenerateQuestSites>
		<factionIconPath>Misc/RK_WasteGangicon</factionIconPath>
		<techLevel>Industrial</techLevel>
    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(700, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>
		<backstoryFilters Inherit="False">
			<li>
				<categories>
					<li>Offworld</li>
				</categories>
			</li>
		</backstoryFilters>
		<hidden>true</hidden>
		<rescueesCanJoin>true</rescueesCanJoin>
		<autoFlee>false</autoFlee>
		<apparelStuffFilter>
			<thingDefs>
				<li>Cloth</li>
				<li>Steel</li>
			</thingDefs>
		</apparelStuffFilter>
