<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <QuestScriptDef>
        <defName>OAGene_EndGame_Homecoming</defName>
        <defaultChallengeRating>4</defaultChallengeRating>
        <isRootSpecial>true</isRootSpecial>
        <rootSelectionWeight>0</rootSelectionWeight>
        <autoAccept>true</autoAccept>
        <questNameRules>
            <rulesStrings>
                <li>questName->Long journey back to hometown</li>
            </rulesStrings>
        </questNameRules>
        <questDescriptionRules>
            <rulesStrings>
                <li>questDescription->I have been away from home for too long\n\nThe previous snowstorm caused [protagonist_nameDef] to lose his hometown and bid farewell to his loved ones without saying goodbye.\nThe sudden separation left too much pain and helplessness for the young [protagonist_nameDef]. As time goes by, the guilt and regret left behind at that time will continue to accumulate in the heart of [protagonist_nameDef], and eventually form an unsolvable knot in [protagonist_nameDef]'s heart.\n\nThis kind of heart disease will accompany [protagonist_nameDef] for a lifetime and cannot be eliminated through normal means. To break free from this obsession, only by returning to where everything started can we make up for the regrets left in the beginning.\n\nWhen you are fully prepared, it's time to go home.</li>
            </rulesStrings>
        </questDescriptionRules>
        <root Class="QuestNode_Sequence">
            <nodes>

                <li Class="QuestNode_QuestUnique">
                    <tag>OAGene_EndGame_Homecoming</tag>
                </li>

                <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_SnowstoryValidator"/>

                <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_GetHometownTile">
                    <storeAs>hometownTile</storeAs>
                </li>

                <li Class="QuestNode_GenerateWorldObject">
                    <def>OAGene_Hometown</def>
                    <tile>$hometownTile</tile>
                    <storeAs>hometown</storeAs>
                </li>

                <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_SpawnHometown">
                    <worldObjects>$hometown</worldObjects>
                    <tile>$hometownTile</tile>
                </li>

                <!-- 地图生成，任务正式开始 -->
                <li Class="QuestNode_Signal">
                    <inSignal>hometown.MapGenerated</inSignal>
                    <outSignals>homecoming.Stage0.Complete</outSignals>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_SnowstoryMapGenerated"/>
                            <li Class="QuestNode_Letter">
                                <letterDef>NeutralEvent</letterDef>
                                <label>被废弃的小镇</label>
                                <text>凭借着残存的记忆，[protagonist_nameDef]最终找到了小镇的方向。\n然而当[protagonist_nameDef]抵达时，却发现镇子早已荒废，昔日的小屋由于缺乏修缮已经倒塌了许多，而曾经的镇民们也已经不知去向。尽管已经对一切都做好了心理准备，但真当这一刻来临时，失望依然充斥在[protagonist_nameDef]的心中。\n\n当失望的[protagonist_nameDef]沿着记忆走到小镇的镇中心时，他意外的发现这里有着一个似乎近期才被垒起来的篝火，也许这意味着有人就在附近不远处居住。若是能够再次点燃这堆篝火，那么当镇民们看见小镇中再次传来炊烟时，或许会主动返回镇上。\n\n尽管心中难以确定，但[protagonist_nameDef]依然将希望寄托给了这个可能。\n点燃镇中的篝火，亦或是静静等待。无论如何，风雪终将到来，风雪也终将离去。</text>
                            </li>
                            <!-- 地图生成两天后进入第二阶段：暴风雪来临 -->
                            <li Class="QuestNode_Delay">
                                <inSignalDisable>hometown.CampfireLighted</inSignalDisable>
                                <delayTicks>$(roundToTicksRough(2 * 60000))</delayTicks>
                                <outSignalComplete>homecoming.Stage1.End</outSignalComplete>
                            </li>
                        </nodes>
                    </node>
                </li>
                <!-- 点燃篝火则直接进入第二阶段  -->
                <li Class="QuestNode_Signal">
                    <inSignal>hometown.CampfireLighted</inSignal>
                    <inSignalDisable>homecoming.Stage1.End</inSignalDisable>
                    <node Class="QuestNode_Letter">
                        <letterDef>PositiveEvent</letterDef>
                        <label>点燃的篝火</label>
                        <text>篝火已经被点燃，这个不知道荒废了多久的镇子，再次飘起了炊烟。\n尽管和远处即将到来的暴风雪相比，这个炊烟是如此的渺小，但它的点燃依然为所有人带来了一种不真实的幸福感。"只要它能够这样继续燃烧下去，那么大家就有回来的可能性。"[protagonist_nameDef]这样想着，尽管她自己也无法相信这个观点。\n\n所有处于这个镇子附近的人，都会通过篝火知道你们的到来。如果有曾经的镇民依然生活在附近，那么他们将会有可能冒着风雪赶回来；但若是附近的海盗们发现这个镇子出现了新的旅人，那么他们也绝不会介意再来劫掠一笔。\n\n这场雪不会结束一切，但足以了却[protagonist_nameDef]所有的心结。</text>
                    </node>
                </li>

                <!-- 地图生成两天后 或 点燃篝火 进入第二阶段 -->
                <li Class="QuestNode_AnySignal">
                    <inSignals>
                        <li>homecoming.Stage1.End</li>
                        <li>hometown.CampfireLighted</li>
                    </inSignals>
                    <outSignals>homecoming.Stage1.Complete</outSignals>
                </li>

                <!-- 第二阶段：暴风雪来临 -->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.Stage1.Complete</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <!-- 12小时后暴风雪前兆，再12小时暴风雪来临 -->
                            <li Class="QuestNode_Delay">
                                <delayTicks>30000</delayTicks>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_EndGame_SnowstormPrecursor</incidentDef>
                                </node>
                            </li>
                            <li Class="QuestNode_Delay">
                                <delayTicks>60000</delayTicks>
                                <outSignalComplete>homecoming.SnowstormStart</outSignalComplete>
                            </li>
                        </nodes>
                    </node>
                </li>


                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.SnowstormStart</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <!-- 暴风雪来临 2小时后第一个白信封 -->
                            <li Class="QuestNode_Delay">
                                <delayTicks>5000</delayTicks>
                                <node Class="QuestNode_Letter">
                                    <letterDef>NeutralEvent</letterDef>
                                    <label>熟悉的风雪</label>
                                    <text>这场风雪对于[protagonist_nameDef]而言，是如此的熟悉而又陌生。它就像数年前的那场风雪一样，来的毫无征兆，荒诞的改变了[protagonist_nameDef]的一切。\n如今这场暴风雪再一次回到了曾经的镇子，然而[protagonist_nameDef]已经不再是曾经那个只会啼哭的孩子了。\n\n[protagonist_nameDef]的直觉告诉他，这场风雪比曾经的任何一场风雪都会猛烈，但这并没有动摇[protagonist_nameDef]的心智。对于[protagonist_nameDef]而言，即便是再极端的风雪，也无法影响他寻回往日的执念。\n\n让篝火燃起，直到风雪离去。</text>
                                </node>
                            </li>
                            <!-- 暴风雪来临 4~6小时 雪雾弥漫-->
                            <li Class="QuestNode_Delay">
                                <delayTicks>$(randInt(10000, 15000))</delayTicks>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormFog</incidentDef>
                                </node>
                            </li>
                            <!-- 暴风雪来临 2天 骤冷-->
                            <li Class="QuestNode_Delay">
                                <delayTicks>$(roundToTicksRough(randFloat(2, 2.5) * 60000))</delayTicks>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormCold</incidentDef>
                                </node>
                            </li>
                            <!-- 暴风雪来临 2天后 颤抖的教徒-->
                            <li Class="QuestNode_Delay">
                                <delayTicks>$(roundToTicksRough(randFloat(2, 2.5) * 60000))</delayTicks>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormCultistBeggars</incidentDef>
                                </node>
                            </li>
                            <!-- 暴风雪来临3天 通信塔倒塌 进入第三阶段：袭击  -->
                            <li Class="QuestNode_Delay">
                                <delayTicks>$(roundToTicksRough(3 * 60000))</delayTicks>
                                <outSignalComplete>homecoming.Stage2.Complete</outSignalComplete>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_CommunicationTowerCollapse</incidentDef>
                                </node>
                            </li>
                        </nodes>

                    </node>
                </li>

                <!-- 第三阶段：袭击，相关袭击创建-->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.Stage2.Complete</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <letterDef>NeutralEvent</letterDef>
                                <label>暴风雪中的异象</label>
                                <text>风雪仍然在肆虐，然而今日的风雪似乎并不同于往日。\n\n[protagonist_nameDef]注意到，远处的风雪似乎冒出了一些星点的火光，但那些火光似乎在刻意地隐藏着自己的存在。\n\n尽管想要尽力去说服自己，告诉自己那只是镇民们担心被海盗发现所做的掩饰，然而[protagonist_nameDef]的理智还是告诉着他，来者并不会是曾经的那些同伴。\n也许该准备好在风雪中作战了。</text>
                            </li>

                            <!-- 随机袭击（平均2天一次）
                            <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_RandomSnowstormRaids">
                                <inSignalDisable>homecoming.Stage3.Complete</inSignalDisable>
                                <parms>
                                    <allowedThreats>Raids</allowedThreats>
                                    <onDays>0.2</onDays>
                                    <offDays>0.1</offDays>
                                    <minSpacingDays>0.04</minSpacingDays>
                                    <numIncidentsRange>1</numIncidentsRange>
                                    <minThreatPoints>8000</minThreatPoints>
                                    <currentThreatPointsFactor>3.0</currentThreatPointsFactor>
                                </parms>
                            </li>
                            -->

                            <!-- 固定袭击 暴风雪后第4天-->
                            <li Class="QuestNode_Delay">
                                <outSignalComplete>homecoming.day.4</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>6500</minPoints>
                                </node>
                            </li>
                            <!-- 固定袭击 暴风雪后第4.5天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.4</inSignalEnable>
                                <delayTicks>$(roundToTicksRough(randFloat(0.5, 0.8) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>7000</minPoints>
                                </node>
                            </li>
                            <!-- 冰晶暴风雪 暴风雪后第5天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.4</inSignalEnable>
                                <outSignalComplete>homecoming.day.5</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                    <worldIncident>true</worldIncident>
                                    <incidentDef>OAGene_ExtremeIceStorm</incidentDef>
                                </node>
                            </li>
                            <!-- 骤冷 暴风雪后第6天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.5</inSignalEnable>
                                <outSignalComplete>homecoming.day.6</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormCold</incidentDef>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedMechBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>RaidEnemy</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>8000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 固定袭击 暴风雪后第7天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.6</inSignalEnable>
                                <outSignalComplete>homecoming.day.7</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>9000</minPoints>
                                </node>
                            </li>
                            <!-- 固定袭击 暴风雪后第8天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.7</inSignalEnable>
                                <outSignalComplete>homecoming.day.8</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>9000</minPoints>
                                </node>
                            </li>

                            <!-- 固定袭击 + 信封 暴风雪后第10天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.8</inSignalEnable>
                                <outSignalComplete>homecoming.day.10</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(2 * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="QuestNode_Letter">
                                            <letterDef>NeutralEvent</letterDef>
                                            <label>仍未消退的风雪</label>
                                            <text>和最初的预计一样，这场风雪的强度远超过了往日的任何一场风雪。尽管现在暴风雪已经肆虐了十天之久，然而这场风雪依然没有任何停歇的迹象。\n\n远处的雪云依然阴沉，呼啸的狂风无时无刻的回响在耳畔，这场风雪似乎决意要将这个镇子的痕迹从世上抹除。偶尔掺杂的冰晶不断的砸在屋顶上作响，让所有人都感到压抑而不安。\n\n壁炉中的火苗仍在燃烧着，对于[protagonist_nameDef]而言，十天的时间已经足够让他放下最后的幻想。如今[protagonist_nameDef]已经开始尝试着接受这一切，但他还需要一段时间。</text>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>10000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 固定袭击 暴风雪后第11天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.10</inSignalEnable>
                                <outSignalComplete>homecoming.day.11</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>10000</minPoints>
                                </node>
                            </li>
                            <!-- 骤冷 暴风雪后第12天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.11</inSignalEnable>
                                <outSignalComplete>homecoming.day.12</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormCold</incidentDef>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedMechBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>RaidEnemy</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>12000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 隐隐约约的人影 暴风雪后第13天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.12</inSignalEnable>
                                <outSignalComplete>homecoming.day.13</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Hard</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>7500</minPoints>
                                </node>
                            </li>
                            <!-- 信封 暴风雪后第15天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.13</inSignalEnable>
                                <outSignalComplete>homecoming.day.15</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(2 * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="QuestNode_Letter">
                                            <letterDef>NeutralEvent</letterDef>
                                            <label>压抑的昏暗</label>
                                            <text>昨日稍晚的时候，风雪似乎有了一丝减弱的迹象，然而今天早上风雪便再次猛烈了起来。\n寒意似乎能够浸透墙壁，即便是处在室内也能感觉到这场风雪正在发生着什么变化，似乎在为它最后的谢幕积蓄着力量。\n\n远方的火光慢慢的聚集了起来，从星星点点的火光逐渐变成了忽明忽暗的光带，并像流动的火海一样朝着向小镇流淌而来。海盗们似乎因为连番的失利而逐渐失去了理性，正准备向小镇倾泄他们那无处发泄的怒火。\n\n[protagonist_nameDef]没有再去看向篝火，他从火堆旁站起身来，视线越过了火光与冰雪交错的夜幕，最终落在了那一路走来的方向。\n窗外，风雪依然在呼啸着。</text>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>14000</minPoints>
                                            </node>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.5, 0.8) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>14000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 骤冷 + 冰晶暴风雪 暴风雪后第16天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.15</inSignalEnable>
                                <outSignalComplete>homecoming.day.16</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                            <worldIncident>true</worldIncident>
                                            <incidentDef>OAGene_ExtremeIceStorm</incidentDef>
                                        </li>
                                        <li Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormCold</incidentDef>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>14000</minPoints>
                                            </node>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.5, 0.8) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedMechBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>RaidEnemy</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>12000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 隐隐约约的人影 暴风雪后第17天 可袭击的第14天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.16</inSignalEnable>
                                <outSignalComplete>homecoming.day.17</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormMaliceRaid_Hard</incidentDef>
                                            <currentPointsFactor>3.0</currentPointsFactor>
                                            <minPoints>10000</minPoints>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>$(roundToTicksRough(randFloat(0.2, 0.5) * 60000))</delayTicks>
                                            <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                                <currentPointsFactor>3.0</currentPointsFactor>
                                                <minPoints>12000</minPoints>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 固定袭击 + 狂信徒 + 骤冷 暴风雪后第18天 可袭击的第15天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.17</inSignalEnable>
                                <outSignalComplete>homecoming.day.18</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormCold</incidentDef>
                                        </li>
                                        <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedMechBreachingRaids">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>RaidEnemy</incidentDef>
                                            <currentPointsFactor>3.0</currentPointsFactor>
                                            <minPoints>10000</minPoints>
                                        </li>
                                        <li Class="QuestNode_Delay">
                                            <delayTicks>1250</delayTicks>
                                            <node Class="OberoniaAurea_Frame.QuestNode_FireIncident">
                                                <mapParent>$hometown</mapParent>
                                                <incidentDef>OAGene_EndGame_SnowstormFanaticalCultis</incidentDef>
                                            </node>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 固定袭击+信封 暴风雪后第19天 可袭击的第16天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.18</inSignalEnable>
                                <delayTicks>$(roundToTicksRough(randFloat(1, 1.5) * 60000))</delayTicks>
                                <node Class="QuestNode_Sequence">
                                    <nodes>
                                        <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                            <mapParent>$hometown</mapParent>
                                            <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                            <currentPointsFactor>3.0</currentPointsFactor>
                                            <minPoints>8500</minPoints>
                                        </li>
                                        <li Class="QuestNode_Letter">
                                            <letterDef>NeutralEvent</letterDef>
                                            <label>黎明前的风雪</label>
                                            <text>在肆虐了将近二十天后，这场席卷了小镇周围数个地区的极端风雪终于走向了尾声。尽管天上的雪云依然把太阳遮盖的严丝合缝，然而每个人都能察觉到，雪云已经淡薄了很多，被封锁了二十天的阳光即将彻底突破这层壁障。\n\n远处的海盗们已经逐渐没了声响，在无数次的失利后，他们似乎已经放弃了对这个小镇的劫掠，只留下了满地的尸体证明了他们曾经所犯下的罪孽。\n\n随着远方的火星的减少，[protagonist_nameDef]最后的心结已经彻底解开。这一场风雪已经让她明白了很多。\n不知从何时起，[protagonist_nameDef]心中的那个心结已经悄然的断开，取而代之的，只有释然与解脱。</text>
                                        </li>
                                    </nodes>
                                </node>
                            </li>
                            <!-- 固定袭击 暴风雪后第19天-->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.18</inSignalEnable>
                                <outSignalComplete>homecoming.day.19</outSignalComplete>
                                <delayTicks>$(roundToTicksRough(randFloat(1.5, 2) * 60000))</delayTicks>
                                <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_FixedSnowstormBreachingRaids">
                                    <mapParent>$hometown</mapParent>
                                    <incidentDef>OAGene_SnowstormMaliceRaid_Reinforce</incidentDef>
                                    <currentPointsFactor>3.0</currentPointsFactor>
                                    <minPoints>7500</minPoints>
                                </node>
                            </li>

                            <!-- 袭击开始20天后进入第四阶段：威胁检测 -->
                            <li Class="QuestNode_Delay">
                                <inSignalEnable>homecoming.day.19</inSignalEnable>
                                <outSignalComplete>homecoming.Stage3.Complete</outSignalComplete>
                                <delayTicks>60000</delayTicks>

                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- 第四阶段：威胁检测 地图上没有威胁进入第五阶段 尾声-->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.Stage3.Complete</inSignal>
                    <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_CheckThreat">
                        <outSignalNoThreat>homecoming.snowstormEnd</outSignalNoThreat>
                    </node>
                </li>

                <!-- 第五阶段：尾声 -->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.snowstormEnd</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_EndEndGameSnowstorm">
                                <snowstormEndDelay>5300</snowstormEndDelay>
                            </li>
                            <li Class="QuestNode_Delay">
                                <outSignalComplete>homecoming.success</outSignalComplete>
                                <delayTicks>5600</delayTicks>
                            </li>
                        </nodes>
                    </node>
                </li>

                <!-- 任务成功信号 -->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.success</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="QuestNode_Letter">
                                <letterDef>PositiveEvent</letterDef>
                                <label TKey="LetterLabelShuttleSentUnsatisfied">风雪后的黎明</label>
                                <text TKey="LetterTextShuttleSentUnsatisfied">暴风雪开始消退了。层叠的雪云不知何时已经露出了几道缝隙，久违的阳光从缝隙之中照出，似乎迫不及待的为这场风雪画上结局。\n远处不再有任何一个海盗徘徊，这个小镇在喧闹了二十多天后，再次回到了曾经的宁静。风雪掩盖了绝大多数战斗的痕迹，仿佛这二十天里的一切只是一场从未发生过的梦。\n\n[protagonist_nameDef]的心结已经不再是她的困扰，这二十天的暴风雪将她心中的遗憾洗涤殆尽。此后，过去的记忆将不再是[protagonist_nameDef]的约束，而会永远的牢牢刻在[protagonist_nameDef]的心底，温柔她的整个余生。\n\n\n\n\n风雪的遗孤.End\n\n鼠族风雪披袍，鼠族风雪发饰，鼠族风雪手杖，风雪树种已解锁制作。\n风雪树种需在精密装配台中加工。</text>
                            </li>
                            <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_Success"/>
                            <li Class="QuestNode_End">
                                <outcome>Success</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>


                <!-- 任务失败信号 -->

                <!-- 第二次没有检测到有效篝火则任务失败 -->
                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.SnowstormStart</inSignal>
                    <node Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_CheckCampfire">
                        <inSignalDisable>homecoming.snowstormEnd</inSignalDisable>
                        <outSignalNoValidCampfire>homecoming.fail</outSignalNoValidCampfire>
                    </node>
                </li>
                <!-- 地图生成之后，主角死亡或离开地图则任务失败 -->
                <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_SignalProtagonistFail">
                    <inSignal>hometown.MapGenerated</inSignal>
                    <protagonistLeftMapSignal>protagonist.LeftMap</protagonistLeftMapSignal>
                    <protagonistDeadSignal>protagonist.Killed</protagonistDeadSignal>
                    <outSignalFail>homecoming.fail</outSignalFail>
                </li>
                <!-- 地图消失或大地图事件点消失，则任务失败 -->
                <li Class="QuestNode_AnySignal">
                    <inSignals>
                        <li>hometown.MapRemoved</li>
                        <li>hometown.Destroyed</li>
                        <li>homecoming.NoValidCampfire</li>
                    </inSignals>
                    <outSignals>homecoming.fail</outSignals>
                </li>

                <li Class="QuestNode_Signal">
                    <inSignal>homecoming.fail</inSignal>
                    <node Class="QuestNode_Sequence">
                        <nodes>
                            <li Class="OberoniaAureaGene.Snowstorm.QuestNode_EndGame_Fail">
                                <snowstormEndDelay>120000</snowstormEndDelay>
                            </li>
                            <li Class="QuestNode_Letter">
                                <letterDef>NegativeEvent</letterDef>
                                <label TKey="LetterLabelShuttleSentUnsatisfied">任务失败：[resolvedQuestName]</label>
                                <text TKey="LetterTextShuttleSentUnsatisfied">[protagonist_nameDef]未能完成归乡。</text>
                            </li>
                            <li Class="QuestNode_End">
                                <outcome>Fail</outcome>
                            </li>
                        </nodes>
                    </node>
                </li>

            </nodes>
        </root>
    </QuestScriptDef>

</Defs>