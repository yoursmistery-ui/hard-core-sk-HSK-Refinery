		<description>镶嵌黄玉的戒指,想提升社会地位的男女都会喜欢它带来的体面。</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/Jewelry/TopazRing</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<statBases>
			<Beauty>8</Beauty>
		</statBases>
	</ThingDef>

	<ThingDef ParentName="Rustic_RingBase">
		<defName>Rustic_Ring_Jade</defName>
		<label>翡翠戒指</label>
		<description>如玉石般坚实而美丽的戒指,为买得起它的人带来中等程度的财富。</description>
		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/Jewelry/JadeRing</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<statBases>
