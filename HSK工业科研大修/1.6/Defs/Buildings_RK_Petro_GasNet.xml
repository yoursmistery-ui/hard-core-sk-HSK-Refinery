  </ThingDef>
  <!-- 出料口: 管网末端把气"落地"成可搬运物品(Deposit 模式), 供无管道条件的工位/灌装点取用 -->
  <ThingDef ParentName="BuildingBase">
    <defName>RK_Petro_GasTap_NG</defName><label>天然气出料口</label>
    <description>接在天然气管网末端的放散出料口: 把管网里的天然气以压缩罐形态放到跟前地面, 供小人搬运到没有管道的工位。周围存罐达到上限即自动停吐。</description>
    <thingClass>Building</thingClass><tickerType>Never</tickerType>
    <graphicData><texPath>Things/Building/RK_Petro_GasTap_NG</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1,1)</drawSize><linkFlags><li>Custom1</li></linkFlags></graphicData>
    <uiIconPath>Things/Building/RK_Petro_GasTap_NG</uiIconPath>
    <size>(1,1)</size><altitudeLayer>Building</altitudeLayer><passability>PassThroughOnly</passability><pathCost>20</pathCost><fillPercent>0.25</fillPercent>
    <statBases><MaxHitPoints>80</MaxHitPoints><WorkToBuild>600</WorkToBuild><Flammability>0.4</Flammability><Beauty>-2</Beauty></statBases>
    <costList><Steel>30</Steel><ComponentIndustrial>1</ComponentIndustrial></costList><rotatable>false</rotatable>
    <researchPrerequisites><li>RK_Petro_AtmosphericDistillation</li></researchPrerequisites><designationCategory>Rimefeller</designationCategory>
    <comps><li Class="BlueprintUnlockHSK.CompProperties_GasPort"><role>Sink</role><gasType>NaturalGas</gasType><mode>Deposit</mode><depositReserve>24</depositReserve></li><li Class="BlueprintUnlockHSK.CompProperties_GasExplosive"><minRadius>1.5</minRadius><perUnit>0.02</perUnit><maxRadius>4</maxRadius><nominalUnits>6</nominalUnits></li></comps>
  </ThingDef>

