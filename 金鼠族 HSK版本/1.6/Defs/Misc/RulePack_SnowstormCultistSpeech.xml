<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RulePackDef>
        <defName>OAGene_SnowstormCultistSpeech</defName>
        <rulePack>
            <rulesStrings>
                <li>speech_root->[speechSentence]</li>

                <li>speechSentence(speechSection==1)->赞颂风雪之神！</li>
                <li>speechSentence(speechSection==1)->赞颂风雪！</li>
                <li>speechSentence(speechSection==1)->祝颂寒冷！</li>
                <li>speechSentence(speechSection==1)->为主祝颂！</li>
                <li>speechSentence(speechSection==1)->赞颂伟大，全知全能而仁慈的风雪之神！</li>

                <li>speechSentence(speechSection==2)->风雪即真理！</li>
                <li>speechSentence(speechSection==2)->暴风雪是神明的福音！</li>
                <li>speechSentence(speechSection==2)->为风雪献出我们的虔诚！</li>
                <li>speechSentence(speechSection==2)->风雪将洗涤我们的罪过！</li>
                <li>speechSentence(speechSection==2)->风雪是赎罪的唯一道路！</li>

                <li>speechSentence(speechSection==3)->风雪不会伤害它的子民！</li>
                <li>speechSentence(speechSection==3)->风雪不会抛弃它虔诚的信徒！</li>
                <li>speechSentence(speechSection==3)->只有信奉风雪之神才能得到救赎！</li>
                <li>speechSentence(speechSection==3)->为风雪之神而祈祷！愿您宽恕您的子民。</li>

                <li>speechSentence(speechSection==4)->风雪！风雪！神的考验！</li>
                <li>speechSentence(speechSection==4)->风雪的判罚终将到来！</li>
                <li>speechSentence(speechSection==4)->没有人能够逃过神明的审判！</li>

                <li>speechSentence(speechSection==5)->逃避风雪的人将被神明唾弃！</li>
                <li>speechSentence(speechSection==5)->大雪会掩埋每一个不虔诚的罪人！</li>
                <li>speechSentence(speechSection==5)->逃避风雪的人将受到神明的惩罚！</li>
                <li>speechSentence(speechSection==5)->只有万罪难赦的人才会畏惧风雪！</li>
                <li>speechSentence(speechSection==5)->丑陋的心将在风雪中得以净化！</li>
                <li>speechSentence(speechSection==5)->山洞将坍塌，平原将掩埋，唯有风雪万古不变！</li>

                <li>speechSentence(speechSection==6)->（嘴中鼓捣着难懂的词语）</li>
                <li>speechSentence(speechSection==6)->（高声喊着难以听清的话语）</li>
                <li>speechSentence(speechSection==6)->（因为过久的高声赞颂而咳嗽）</li>
                <li>speechSentence(speechSection==6)->（唱诵古老的经文）</li>
                <li>speechSentence(speechSection==6)->（吟诵难懂的经文）</li>
                <li>speechSentence(speechSection==6)->（双手合十念叨着什么）</li>
                <li>speechSentence(speechSection==6)->（向神明祷告着）</li>
                <li>speechSentence(speechSection==6)->（高声为风雪之神祝颂）</li>
            </rulesStrings>
        </rulePack>
    </RulePackDef>

</Defs>