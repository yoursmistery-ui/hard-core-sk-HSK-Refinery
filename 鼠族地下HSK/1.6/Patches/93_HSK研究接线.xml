<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 将原作三个研究节点从鼠族独立页签并入 HSK 武器科技树，
       坐标 (11,32)、(12,32)、(15,32) 为当前全环境未占用格。 -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundAssaultWeapons"]/tab</xpath>
    <value>
      <tab>Weapon_SK</tab>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundAssaultWeapons"]/researchViewX</xpath>
    <value>
      <researchViewX>11</researchViewX>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundAssaultWeapons"]/researchViewY</xpath>
    <value>
      <researchViewY>32</researchViewY>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundExperimentalWeapon"]/tab</xpath>
    <value>
      <tab>Weapon_SK</tab>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundExperimentalWeapon"]/researchViewX</xpath>
    <value>
      <researchViewX>12</researchViewX>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundExperimentalWeapon"]/researchViewY</xpath>
    <value>
      <researchViewY>32</researchViewY>
    </value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundGuerrillaEquipments"]/tab</xpath>
    <value>
      <tab>Weapon_SK</tab>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundGuerrillaEquipments"]/researchViewX</xpath>
    <value>
      <researchViewX>15</researchViewX>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ResearchProjectDef[defName="RKU_UndergroundGuerrillaEquipments"]/researchViewY</xpath>
    <value>
      <researchViewY>32</researchViewY>
    </value>
  </Operation>
</Patch>
