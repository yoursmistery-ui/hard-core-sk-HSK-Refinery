<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <TerrainDef ParentName="FloorBase">
    <defName>OA_RK_FloorSnow</defName>
    <label>风雪冰晶地板</label>
    <renderPrecedence>206</renderPrecedence>
    <description>使用罕见的风雪碎晶作为原材料，加之以无微不至的精细磨制而制成的华丽地板。纯净而不含杂质，拥有着难以言喻的美观。</description><!--走在上面时，就仿佛漫步在过去的那场场风雪之中。-->
    <texturePath>Things/Building/OA_RK_FloorSnow</texturePath>
    <color>(0.96, 0.96, 0.96)</color>
    <pollutionTintColor>(0.92, 0.92, 0.86, 1)</pollutionTintColor>
    <isPaintable>true</isPaintable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiIconPath>Things/Building/OA_RK_FloorSnow_UI</uiIconPath>
    <statBases>
      <WorkToBuild>9300</WorkToBuild>
      <Cleanliness>1.0</Cleanliness>
      <CleaningTimeFactor>0.5</CleaningTimeFactor>
      <Beauty>12</Beauty>
    </statBases>
    <costList>
      <OAGene_IceCrystal>8</OAGene_IceCrystal>
    </costList>
    <tags>
      <li>Floor</li>
      <li>FineFloor</li>
    </tags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc4</designationHotKey>
    <constructionSkillPrerequisite>15</constructionSkillPrerequisite>
    <uiOrder>2120</uiOrder>
  </TerrainDef>

  <TerrainDef ParentName="FloorBase">
    <defName>OA_RK_FloorSnow_B</defName>
    <label>风雪冰晶雕版</label>
    <renderPrecedence>206</renderPrecedence>
    <description>模仿碎晶花的纹路而精心打磨的钢铁地板，虽然好看，但只有使用风雪碎晶去制作才能让它展现真正的美观。</description>
    <texturePath>Things/Building/OA_RK_FloorSnowB</texturePath>
    <color>(0.77, 0.73, 0.73)</color>
    <pollutionTintColor>(0.76, 0.72, 0.72, 1)</pollutionTintColor>
    <isPaintable>true</isPaintable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiIconPath>Things/Building/OA_RK_FloorSnow_UI</uiIconPath>
    <statBases>
      <WorkToBuild>5100</WorkToBuild>
      <Cleanliness>0.0</Cleanliness>
      <CleaningTimeFactor>0.9</CleaningTimeFactor>
      <Beauty>6</Beauty>
    </statBases>
    <costList>
      <Steel>12</Steel>
    </costList>
    <tags>
      <li>Floor</li>
      <li>FineFloor</li>
    </tags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc4</designationHotKey>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <uiOrder>2121</uiOrder>
  </TerrainDef>

</Defs>