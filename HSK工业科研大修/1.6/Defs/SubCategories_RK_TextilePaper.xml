<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 二级菜单:生产类下的"造纸工坊"(MO 纸张生产线:手动沤浆 + 造纸台;PF 自动造纸压机因 ProcessorFramework.dll 缺陷已移除) -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>SubCategory_RKPaperMaking</defName>
		<label>造纸工坊</label>
		<description>从木头沤浆到压制成纸的整条造纸线。</description>
		<defNames>
			<li>RK_PulpVat</li>
			<li>RK_PaperPress</li>
		</defNames>
		<designationCategory>Production</designationCategory>
		<debug>false</debug>
	</ArchitectSense.DesignationSubCategoryDef>

	<!-- 二级菜单:生产类下的"丝绸工坊"(MO 丝绸生产:手动蚕匾架;织绸在 HSK 共享纺织机 TableLoom 上完成, 属通用纺织线, 不并入本丝绸专属菜单。PF 自动丝绸床因 ProcessorFramework.dll 缺陷已移除) -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>SubCategory_RKSilkMaking</defName>
		<label>丝绸工坊</label>
		<description>养蚕缫丝获取生丝的产线;织绸请在纺织机上进行。</description>
		<defNames>
			<li>RK_SilkwormTray</li>
		</defNames>
		<designationCategory>Production</designationCategory>
		<debug>false</debug>
	</ArchitectSense.DesignationSubCategoryDef>

</Defs>
