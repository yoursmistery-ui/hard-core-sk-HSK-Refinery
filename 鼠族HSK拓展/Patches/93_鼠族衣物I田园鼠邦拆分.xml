  <!-- ============================================================ -->
  <!--  93_鼠族衣物I田园鼠邦拆分.xml (2026-08-27)                  -->
  <!--  需求:                                                      -->
  <!--  ① B1(鼠族衣物I·日常衣装) 拆出 22 件鼠邦传统/田园服饰到     -->
  <!--     新节点 鼠族衣物I·田园鼠邦(Ratkin_Apparel_B1c, 中世纪)   -->
  <!--  ② B2A(鼠族衣物II·礼服装) 改完整工业时代                    -->
  <!--     (techLevel Industrial + LabTerminal 研究终端设施)       -->
  <!--  ③ B1b(头脸配饰) 改名 鼠族衣物II·头脸配饰                   -->
  <!--  MoustateJewerly 改名/改前置/工业时代 → 直接改               -->
  <!--     Defs/ResearchDefs/ResearchProjects.xml                  -->
  <!--  注意: 22 件中 RK_ExoticFarmerDress 完全继承 RK_Ruqun 的    -->
  <!--  recipeMaker(无物理节点), 补丁操作原始 XML 不解析继承,      -->
  <!--  须用 Add recipeMaker 覆盖, 其余 21 件用 Replace。          -->
  <!-- ============================================================ -->

  <!-- 1. 新增节点: 鼠族衣物I·田园鼠邦 (中世纪, 前置 B1, 坐标 6,45) -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs</xpath>
    <value>
      <ResearchProjectDef ParentName="MedievalBase">
        <defName>Ratkin_Apparel_B1c</defName>
        <label>鼠族衣物I·田园鼠邦</label>
        <description>鼠族特色服饰。</description>
        <tab>Apparel_SK</tab>
        <researchViewX>6</researchViewX>
        <researchViewY>44</researchViewY>
        <baseCost>300</baseCost>
        <prerequisites>
          <li>Ratkin_Apparel_B1</li>
        </prerequisites>
        <techLevel>Medieval</techLevel>
      </ResearchProjectDef>
    </value>
  </Operation>

  <!-- 2. 22 件鼠邦传统/田园服饰配方迁移 B1 -> B1c -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="RK_Ruqun"]/recipeMaker/researchPrerequisite</xpath>
    <value><researchPrerequisite>Ratkin_Apparel_B1c</researchPrerequisite></value>
  </Operation>
