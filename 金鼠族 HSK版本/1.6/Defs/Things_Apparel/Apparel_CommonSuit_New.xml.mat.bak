   <ThingDef ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_New_Windbreaker_AA</defName>
        <label>Oberonia Aurea Birthday Ceremonial Robe</label>
        <description>Traditional festive attire of the Obernoia Aurea. Its lively, cute blue-and-white style stands out among ceremonial garments and is often kept in citizens' wardrobes as birthday attire.\n\nIn Obernoia Aurea culture, birthdays are regarded as important anniversaries; even strangers offer sincere blessings to the one celebrating. For this reason, the traditional birthday ceremonial robe always features a pocket on the left side, meant to hold Obernoia Aurea flowers for returning gifts and conveying goodwill—though most of the time, the wearer's hood seems to produce an endless supply of Obernoia Aurea flowers.\n\nWill put on the hood in bad weather.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Windbreaker_AA</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Synthread>115</Synthread>
			<Oberonia_Aurea>20</Oberonia_Aurea>
        </costList>
        <costStuffCount>40</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <WorkToMake>23400</WorkToMake>
            <Mass>2.5</Mass>
            <StuffEffectMultiplierArmor>0.24</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.85</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.7</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.0</EquipDelay>
        </statBases>			
        <equippedStatOffsets>
            <SocialImpact>0.35</SocialImpact>
            <TradePriceImprovement>0.08</TradePriceImprovement>
        </equippedStatOffsets>
		<apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
				<!--li>UpperHead</li--><!--阻止遮盖头发的模组无法识别-->
            </bodyPartGroups>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <wornGraphicPath>Apparel/OA_RK_New_Windbreaker_AA</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <tags>
                <li>OARatkin_Noble_Tier1</li>
				<li>OARatkin_Noble_Tier2</li>
                <li>RoyalTier6</li>
                <li>RoyalTier7</li>
                <li>RoyalTier8</li>
            </tags>
        </apparel>
		<modExtensions>
			<li Class="WeatherApparelFramework.ApparelWeatherGraphicExtension">
				<rules>
					<li>
						<targetWeathers>
							<li>Rain</li>
							<li>RainyThunderstorm</li>
							<li>FoggyRain</li>
							<li>Fog</li>
							<li>SnowGentle</li>
							<li>SnowHard</li>
							<li>Underground</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">BloodRain</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">GrayPall</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">Undercave</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">MetalHell</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">UnnaturalDarkness_Stage1</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">UnnaturalDarkness_Stage2</li>
							<li MayRequire="Ludeon.RimWorld.Anomaly">UnnaturalFog</li>
							<li MayRequire="fxz.ratkinanomaly.update">RA_Downpour</li>
							<li MayRequire="OARK.RatkinFaction.ScenarioExpand.Snowstorm">OAGene_IceSnowExtreme</li>
							<li MayRequire="OARK.RatkinFaction.ScenarioExpand.Snowstorm">OAGene_IceRain</li>
							<li MayRequire="OARK.RatkinFaction.ScenarioExpand.Snowstorm">OAGene_SnowExtreme</li>
						</targetWeathers>
						<texPath>Apparel/OA_RK_New_Windbreaker_AA_Rain</texPath>
						<layerOffset>-5</layerOffset>

						<additionalLayers>
							<li>
								<texPath>Apparel/OA_RK_New_Windbreaker_AA_Rain_inside</texPath>
								<layerOffset>0.2</layerOffset>
							</li>
						</additionalLayers>

					</li>
				</rules>
			</li>
		</modExtensions>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_A</researchPrerequisite>
        </recipeMaker>
    </ThingDef>
	
	<ThingDef ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_New_Apparel_E</defName>
        <label>Obernoia Aurea Birthday Ceremonial Dress</label>
        <description>Traditional festive attire of the Obernoia Aurea. Each tassel at the waist symbolizes a blessing personally woven by another. When the clustered tassels of the skirt sway, the shape of goodwill can faintly be glimpsed through the gaps of gold and blue.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Apparel_E</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>16200</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.24</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.54</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <costList>
            <Synthread>90</Synthread>
        </costList>
        <costStuffCount>25</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <SocialImpact>0.35</SocialImpact>
            <TradePriceImprovement>0.20</TradePriceImprovement>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Apparel_E</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
