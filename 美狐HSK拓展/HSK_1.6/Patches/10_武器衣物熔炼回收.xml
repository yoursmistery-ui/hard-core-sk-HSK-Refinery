    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_Shotgun"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_AutoShotgun"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RiflePlasma"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_SniperPlasma"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
