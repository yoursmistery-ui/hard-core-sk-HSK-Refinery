<?xml version="1.0" encoding="utf-8" ?>
<!-- 合并自(保持原执行序): OAFrame_Faction_Patch.xml, OAFrame_Humanlike_Patch.xml -->
<Patch><Operation Class="PatchOperationFindMod">
        <mods>
            <li>NewRatkinPlus</li>
            <li>NewRatkinPlus[1.6]</li>
        </mods>
        <success>Always</success>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FactionDef[@Name="RatkinFactionBase" or @Name="RK_PlayerFactionBase"]/modExtensions/li[@Class="OberoniaAurea_Frame.RatkinFactionFlag"]</xpath>
                    <nomatch Class="PatchOperationAddModExtension">
                        <xpath>/Defs/FactionDef[@Name="RatkinFactionBase" or @Name="RK_PlayerFactionBase"]</xpath>
                        <value>
                            <li Class="OberoniaAurea_Frame.RatkinFactionFlag"/>
                        </value>
                    </nomatch>
                </li>
                <li Class="PatchOperationConditional">
                    <xpath>/Defs/FactionDef[defName="Rakinia"]/modExtensions/li[@Class="OberoniaAurea_Frame.FactionTagsExtension"]</xpath>
                    <nomatch Class="PatchOperationAddModExtension">
                        <xpath>/Defs/FactionDef[defName="Rakinia"]</xpath>
                        <value>
                            <li Class="OberoniaAurea_Frame.FactionTagsExtension">
                                <factionTags>
                                    <li>RatkinKindom</li>
                                </factionTags>
                            </li>
                        </value>
                    </nomatch>
                </li>
            </operations>
        </match>

    </Operation><Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Human"]/comps/li[@Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"]</xpath>
        <success>Always</success>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="Human"]/comps</xpath>
            <value>
                <li Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"/>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Humanoid Alien Races</li>
            <li>Humanoid Alien Races ~ Dev</li>
        </mods>
        <success>Always</success>
        <match Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike" and not(comps)]</xpath>
                    <value>
                        <comps/>
                    </value>
                </li>
                <li Class="PatchOperationAdd">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[race/intelligence="Humanlike" and comps and not(comps/li[@Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"])]/comps</xpath>
                    <value>
                        <li Class="OberoniaAurea_Frame.CompProperties_PawnPreApplyDamage"/>
                    </value>
                </li>
            </operations>
        </match>
    </Operation></Patch>
