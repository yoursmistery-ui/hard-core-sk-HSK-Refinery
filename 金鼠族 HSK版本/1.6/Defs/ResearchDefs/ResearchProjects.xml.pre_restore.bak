	<ResearchProjectDef>
		<defName>OA_RK_Constant_Temperature_Hydroponics_B</defName>
		<label>Oberonia Aurea Improves Crops</label>
		<description>Through the agricultural technology and genetic technology of Oberonia Aurea, common crops and Oberonia Aurea flowers are improved to enhance their yield and fertility sensitivity, and corresponding exclusive cultivation cabinets are unlocked.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>1800</baseCost>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>OA_RK_Constant_Temperature_Hydroponics</li>
		</prerequisites>
		<researchViewX>10</researchViewX>
		<researchViewY>1</researchViewY>
	</ResearchProjectDef>

