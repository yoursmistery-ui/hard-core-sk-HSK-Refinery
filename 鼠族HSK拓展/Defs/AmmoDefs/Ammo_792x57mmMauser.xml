		<label>7.92×57mm 毛瑟弹 (空尖)</label>
		<graphicData>
			<texPath>Things/Ammo/Rifle/Clip/HP</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<statBases>
			<MarketValue>2.53</MarketValue>
		</statBases>
