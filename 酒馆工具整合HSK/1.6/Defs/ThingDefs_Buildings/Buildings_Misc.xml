<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<!--========================= Columns =============================-->

	<ThingDef ParentName="BuildingBase">
	<defName>SD_WoodColumn</defName>
	<label>坚固木柱</label>
	<description>可支撑屋顶的柱子。不遮挡视线与通行,外观也不错。</description>
	<designationCategory>Structure</designationCategory>
	<uiOrder>2040</uiOrder>
	<altitudeLayer>Building</altitudeLayer>
	<passability>PassThroughOnly</passability>
	<fillPercent>0.25</fillPercent>
	<pathCost>0</pathCost>
	<uiIconScale>0.8</uiIconScale>
		<uiIconOffset>(0.2, 0.1)</uiIconOffset>
	<statBases>
		<MaxHitPoints>160</MaxHitPoints>
		<WorkToBuild>750</WorkToBuild>
		<Mass>10</Mass>
		<Flammability>1.0</Flammability>
		<Beauty>5</Beauty>
	</statBases>
	<stuffCategories>
		<li>Woody</li>
	</stuffCategories>
	<costStuffCount>20</costStuffCount>
	<holdsRoof>true</holdsRoof>
	<canOverlapZones>false</canOverlapZones>
	<rotatable>true</rotatable>
		<defaultPlacingRot>North</defaultPlacingRot>
	<fertility>0</fertility>
	<specialDisplayRadius>6.9</specialDisplayRadius> <!-- must be kept in sync with roof hold-up radius -->
	<building>
		<isInert>true</isInert>
		<ai_chillDestination>false</ai_chillDestination>
		<paintable>true</paintable>
	</building>
			<researchPrerequisites>
				<li>ComplexFurniture</li>
			</researchPrerequisites>
	<graphicData>
		<drawSize>(2,2)</drawSize>
		<texPath>Things/Building/Misc/WoodColumn_Corner</texPath>
		<drawRotated>false</drawRotated>
		<graphicClass>Graphic_Multi</graphicClass>
	</graphicData>
	</ThingDef>

