<?xml version='1.0' encoding='UTF-8'?>
<Defs>

  <!-- ================================================================
       老式鼠族装饰(整合自 Ratkin Lifestyle+ / 3263391066, Feng Xinzi)
       原则: 只保留 workshop 贴图, 属性/数值/研究/材料全部按 HSK 家具
       与建筑标准重做; 全部 def 重命名为 RKFC_RL_ 命名空间, 彻底独立,
       不依赖 GloomyFurniture / Gloomylynx / 原 mod DLL。
       动态件(木船漂浮/风车叶片/烛台火焰/发电)由本 mod 自带
       Assemblies/RatkinFurniture.dll(namespace RatkinFurniture)实现。
       ================================================================ -->

  <!-- 晾衣架下拉组 -->
  <DesignatorDropdownGroupDef>
    <defName>RKFC_RL_ClothHanger</defName>
    <label>clothes hanger</label>
  </DesignatorDropdownGroupDef>

  <!-- 画作下拉组 -->
  <DesignatorDropdownGroupDef>
    <defName>RKFC_RL_Paint</defName>
    <label>paint</label>
  </DesignatorDropdownGroupDef>

  <!-- 晾衣架抽象基类(木质材质制) -->
  <ThingDef Abstract="True" ParentName="RKFC_FurnitureBase" Name="RKFC_RL_ClothHangerBase">
    <graphicData>
      <drawSize>(2.1,2.1)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <shadowData>
        <volume>(1.6,0.8,0.4)</volume>
        <offset>(0,0,-0.4)</offset>
      </shadowData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.20</fillPercent>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Mass>6</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>20</Beauty>
    </statBases>
    <pathCost>25</pathCost>
    <rotatable>false</rotatable>
    <size>(2,1)</size>
    <designatorDropdown>RKFC_RL_ClothHanger</designatorDropdown>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>10</costStuffCount>
    <costList>
      <Cloth>20</Cloth>
    </costList>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- 画作抽象基类(艺术品, 挂墙) -->
  <ThingDef Abstract="True" ParentName="RKFC_ArtableFurnitureBase" Name="RKFC_RL_PaintBase">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <thingClass>Building</thingClass>
    <rotatable>false</rotatable>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <fillPercent>0.1</fillPercent>
    <designatorDropdown>RKFC_RL_Paint</designatorDropdown>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <constructEffect>ConstructWood</constructEffect>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>4000</WorkToBuild>
      <Mass>5</Mass>
      <Flammability>1.0</Flammability>
      <Beauty>100</Beauty>
    </statBases>
    <costList>
      <WoodLog>35</WoodLog>
      <Dye>100</Dye>
    </costList>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <building>
      <canPlaceOverWall>true</canPlaceOverWall>
      <isEdifice>false</isEdifice>
    </building>
    <clearBuildingArea>false</clearBuildingArea>
    <artisticSkillPrerequisite>8</artisticSkillPrerequisite>
    <researchPrerequisites>
      <li>Art_A1</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- 烛台抽象基座(燃料+发光+发热+火焰, 原版 Torch 式) -->
  <ThingDef Abstract="True" ParentName="BuildingBase" Name="RKFC_RL_CandleBase">
    <description>鼠族家庭里常见的照明用品。</description>
    <category>Building</category>
    <thingClass>Building</thingClass>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <tickerType>Normal</tickerType>
    <uiIconScale>1.5</uiIconScale>
    <rotatable>false</rotatable>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.05</fillPercent>
    <costList>
      <WoodLog>5</WoodLog>
    </costList>
    <stuffCategories>
      <li>Woody</li>
      <li>Stony</li>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>5</costStuffCount>
    <statBases>
      <MaxHitPoints>40</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Mass>0.05</Mass>
      <Beauty>2</Beauty>
    </statBases>
    <selectable>true</selectable>
    <building>
      <isEdifice>false</isEdifice>
    </building>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <destroyable>true</destroyable>
    <clearBuildingArea>false</clearBuildingArea>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <constructionSkillPrerequisite>2</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
      <li>PlaceWorker_GlowRadius</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>0.5</fuelConsumptionRate>
        <fuelCapacity>25.0</fuelCapacity>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
            <li>Chemfuel</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>1</initialFuelPercent>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(252,187,113,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusher</compClass>
        <heatPerSecond>2.5</heatPerSecond>
        <heatPushMaxTemperature>23</heatPushMaxTemperature>
      </li>
    </comps>
  </ThingDef>

