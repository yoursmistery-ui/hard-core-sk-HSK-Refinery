<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_LS_InfantryUniform</defName>
        <label>Lale Infantry Uniform</label>
        <description>A mass-produced brown-green uniform from several years before the war, with looser trousers and a tendency to fade.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_LS_InfantryUniform/RK_LS_InfantryUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.21</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.68</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.0</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
            <ArmorRating_Heat>0.31</ArmorRating_Heat>
            <Flammability>0.5</Flammability>
            <EquipDelay>2</EquipDelay>
            <Insulation_Heat>2</Insulation_Heat>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_LS</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <MoveSpeed>0.1</MoveSpeed>
            <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
            <MeleeDodgeChance>0.05</MeleeDodgeChance>
        </equippedStatOffsets>
        <costStuffCount>55</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_LS_InfantryUniform/RK_LS_InfantryUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>RK_LS_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
    <ThingDef ParentName="RK_HatMakeableBase">
        <defName>RK_LS_Fez</defName>
        <label>Lale Fez</label>
        <description>A khaki-colored short fez used in some war zones. As the war dragged on, fewer soldiers wore this type of hat.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_LS_Fez/RK_LS_Fez</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>220</MaxHitPoints>
            <WorkToMake>8000</WorkToMake>
            <Mass>1</Mass>
            <StuffEffectMultiplierArmor>0.54</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.20</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.1</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.1</ArmorRating_Blunt>
            <EquipDelay>1.5</EquipDelay>
            <Insulation_Heat>2</Insulation_Heat>
        </statBases>
        <techLevel>Industrial</techLevel>
        <equippedStatOffsets>
            <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
            <SocialImpact>0.1</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>UpperHead</li>
                <li>Eyes</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_LS_Fez/RK_LS_Fez</wornGraphicPath>
            <layers>
                <li>Overhead</li>
            </layers>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>RK_LS_Soldier</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>RK_LS</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
    </ThingDef>
</Defs>