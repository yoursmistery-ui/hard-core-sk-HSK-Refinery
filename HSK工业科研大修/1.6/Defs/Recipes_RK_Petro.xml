  <!-- ===== 污染统一并入(2026-08-29): 核废料 → 毒废包, 接进原版废料处理链 =====
       Def 级 MayRequire 门控: 未装 Rimatomics 时整条配方不加载, 防 recipeUsers 悬空引用。 -->
  <RecipeDef MayRequire="Dubwise.Rimatomics">
    <defName>Process_NuclearWaste_To_Wastepack</defName>
    <label>核废料转换为废料包</label>
    <description>将辐射性核废料稀释封装为常规废料包，使其能进入原版废料处理链统一消纳。每次转换需谨慎操作。</description>
    <jobString>正在封装核废料。</jobString>
    <workAmount>600</workAmount>
    <workSpeedStat>SmeltingSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <workSkillLearnFactor>0.5</workSkillLearnFactor>
    <effectWorking>ConstructMetal</effectWorking>
    <soundWorking>Recipe_Machining</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>NuclearWaste</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>NuclearWaste</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Wastepack>2</Wastepack>
    </products>
    <recipeUsers>
      <li>TableRimatomicsMachining</li>
    </recipeUsers>
  </RecipeDef>

  <!-- ===== 沥青焚烧回收(原污染统一配方, 2026-08-29 并入): 挂原版电焚化炉 ===== -->
  <RecipeDef>
    <defName>Process_Asphalt_To_Concrete</defName>
    <label>焚烧沥青制混凝土</label>
    <description>将堆积的沥青投入焚化炉高温焚烧，烧尽重质烃类后，残余矿质残渣经压实即可回收为混凝土。</description>
    <jobString>正在焚烧沥青。</jobString>
    <workAmount>180</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <effectWorking>Cremate</effectWorking>
    <soundWorking>Recipe_Cremate</soundWorking>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Asphalt</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Asphalt</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <ConcreteResource>3</ConcreteResource>
    </products>
  </RecipeDef>

</Defs>
