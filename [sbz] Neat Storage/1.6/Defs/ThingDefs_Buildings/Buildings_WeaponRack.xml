	<ThingDef ParentName="AdaptiveStorageBase">
        <defName>sbz_WeaponRack</defName>
		<label>weapon rack</label>
		<graphicData>
			<texPath>Things/Building/Storage/WeaponRack/sbz_OldWeaponRack</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
		</graphicData>
		<description>A weapon rack that can display up to 6 weapons.</description>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>20</costStuffCount>
		<fillPercent>0.3</fillPercent>
		<uiIconPath>Things/Building/Storage/WeaponRack/sbz_OldWeaponRack_south</uiIconPath>
		<uiIconScale>1.6</uiIconScale>
		<uiIconOffset>(0, 0.1)</uiIconOffset>
		<size>(2,1)</size>
		<uiOrder>1099</uiOrder>
		<staticSunShadowHeight>0.2</staticSunShadowHeight>
		<rotatable>true</rotatable>
		<defaultPlacingRot>South</defaultPlacingRot>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<statBases>
			<MaxHitPoints>200</MaxHitPoints>
			<WorkToBuild>1500</WorkToBuild>
			<Mass>20</Mass>
			<Flammability>1.0</Flammability>
		</statBases>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
           	<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>3</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<categories>
                        <li>Weapons</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Normal</priority>
				<filter>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsNeatStorage</li>
		</thingCategories>
	</ThingDef>
