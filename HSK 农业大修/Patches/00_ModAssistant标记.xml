         MayRequire 门控沿用既有补丁写法(本环境 FindMod 不生效);
         本 mod 是纯内容 mod(种植箱/爬藤架/提灯太阳灯),排在 Core SK 之后即可。 -->
    <Operation Class="PatchOperationAdd" MayRequire="DimonSever000.ModIndicator.Specific">
        <xpath>Defs/AMA.ModListerSettingsDef[defName="ModListerSettingsDef"]/modIndicators/NativeAddon</xpath>
        <value>
            <li>
                <id>local.hskagrioverhaul</id>
                <HSKMod>true</HSKMod>
                <loadAfter>
                    <li>skyarkhangel.hsk</li>
                </loadAfter>
            </li>
        </value>
    </Operation>
</Patch>
