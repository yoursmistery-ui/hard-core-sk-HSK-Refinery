<?xml version="1.0" encoding="utf-8"?>
<!--
 宝石采集分流（2026-08-30 用户拍板：原本掉粗糙宝石的地方，把粗糙宝石那份掉落量的 20%
 转成 HSK工业科研大修 的 5 档成品宝石，按稀有度加权：黄玉40/紫水晶25/祖母绿15/蓝宝石12/红宝石8。
 宝石晶体点(方解石/石英/紫水晶/红蓝宝/金刚等)。数值按每个 def 自己声明的原始 DropProbability 换算，粗糙宝石那一份打 0.8 折，
 不新增总掉落量。所有操作套 PatchOperationConditional 存在性门控（1.6 Operation 级 MayRequire 已失效），
 @Name 基类节点用属性谓词（PatchOperation 不解析继承）。
-->
<Patch>

  <!-- AmethystCrystal ← StaticMinerals.xml 原粗糙宝石 p=3 → 留 2.4 + 分流 0.6 给成品宝石 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="AmethystCrystal"]/randomlyDropResources/li[ResourceDefName="RoughGem"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="AmethystCrystal"]/randomlyDropResources/li[ResourceDefName="RoughGem"]/DropProbability</xpath>
      <value><DropProbability>2.4</DropProbability></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="AmethystCrystal"]/randomlyDropResources</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="AmethystCrystal"]/randomlyDropResources</xpath>
      <value>
        <li><ResourceDefName>RKGem_Citrine</ResourceDefName><DropProbability>0.24</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>2</MinMiningSkill></li>
        <li><ResourceDefName>RKGem_Amber</ResourceDefName><DropProbability>0.15</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>3</MinMiningSkill></li>
        <li><ResourceDefName>RKGem_Emerald</ResourceDefName><DropProbability>0.09</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>5</MinMiningSkill></li>
        <li><ResourceDefName>RKGem_Sapphire</ResourceDefName><DropProbability>0.072</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>6</MinMiningSkill></li>
        <li><ResourceDefName>RKGem_Ruby</ResourceDefName><DropProbability>0.048</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>8</MinMiningSkill></li>
      </value>
    </match>
  </Operation>

