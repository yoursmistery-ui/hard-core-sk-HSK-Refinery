<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef Name="Kiiro_MerchantUtilityBase" ParentName="Kiiro_ApparelBase" Abstract="True">
		<statBases>
			<Mass>0.4</Mass>
			<EquipDelay>1.0</EquipDelay>
			<MaxHitPoints>60</MaxHitPoints>
		</statBases>
		<graphicData>
			<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
			<drawSize>1.0</drawSize>
			<drawOffset>(0,0,0)</drawOffset>
		</graphicData>
		<recipeMaker Inherit="false">
		</recipeMaker>
		<apparel>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<careIfDamaged>false</careIfDamaged>
			<wearPerDay>0.4</wearPerDay>			<!-- 和原版的默认值一样 -->
			<layers>
				<li>Belt</li>
			</layers>
			<bodyPartGroups>
				<li>Waist</li>
			</bodyPartGroups>
			<tags>
				<li>Kiiro_Misc</li>
			</tags>
		</apparel>
		<comps Inherit="false">			<!--不继承品质-->
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<thingCategories>
			<li>Kiiro_Apparel_Utility</li>
		</thingCategories>
		<generateAllowChance>0</generateAllowChance>
		<hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
	</ThingDef>

	<!-- 缝针套组 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_TailorSet</defName>
		<label>sewing kit</label>
		<description>A full set of portable sewing tools that can be used to repair clothing while carrying. \n\nSelect the carrier wearing clothing in the lowest percentage of durability for its return to a certain durability. More than 75% of the most durable clothing is beyond repair.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/TailorSet</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<costList>
			<Cloth>120</Cloth>
			<Steel>40</Steel>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_TailorSet</li>
			</tags>
		</apparel>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>10</maxCharges>
				<ammoDef>Cloth</ammoDef>
				<ammoCountPerCharge>5</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>Repair</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li Class="AncotLibrary.VerbProperties_MendApparel">
				<verbClass>AncotLibrary.Verb_MendApparel</verbClass>
				<commandIcon>Kiiro_Event/Apparels/TailorSet</commandIcon>
				<violent>false</violent>
				<hasStandardCommand>true</hasStandardCommand>
				<targetable>false</targetable>
				<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
				<onlyManualCast>True</onlyManualCast>
				<percentThreshold>0.75</percentThreshold>
				<hitPointPerUse>20</hitPointPerUse>
			</li>
		</verbs>
	</ThingDef>

	<!-- 登山杖 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_Alpenstock</defName>
		<label>hiking staff</label>
		<description>A portable hiking staff that helps traverse rough terrain and slightly increases travel speed in caravan.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/Alpenstock</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<costList>
			<WoodLog>60</WoodLog>
			<Steel>60</Steel>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_Alpenstock</li>
			</tags>
		</apparel>
		<equippedStatOffsets>
			<CaravanBonusSpeedFactor>0.1</CaravanBonusSpeedFactor>
		</equippedStatOffsets>
	</ThingDef>

	<!-- 磨刀砥石 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_KnifeStone</defName>
		<label>sharpening stone</label>
		<description>A portable sharpening stone.\n\nTemporarily increases the wearer's melee damage with each use. Consumes steel.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/KnifeStone</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<costList>
			<Steel>80</Steel>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_KnifeStone</li>
			</tags>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>10</maxCharges>
				<ammoDef>Steel</ammoDef>
				<ammoCountPerCharge>5</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>Sharpen</chargeNoun>
				<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li Class="AncotLibrary.VerbProperties_Job">
				<verbClass>AncotLibrary.Verb_Job</verbClass>
				<commandIcon>Kiiro_Event/Apparels/KnifeStone</commandIcon>
				<violent>false</violent>
				<hasStandardCommand>true</hasStandardCommand>
				<targetable>false</targetable>
				<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
				<onlyManualCast>True</onlyManualCast>
				<jobDef>Ancot_SharpenWeapon</jobDef>
				<jobNum>1</jobNum>
			</li>
		</verbs>
	</ThingDef>

	<!-- 怀表 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_PocketWatch</defName>
		<label>pocket watch</label>
		<description>A small and portable timekeeping device. Wearing it can subtly increase the wearer's work efficiency.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/PocketWatch</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<statBases>
			<MarketValue>350</MarketValue>
		</statBases>
		<costList>
			<Steel>60</Steel>
			<Plasteel>10</Plasteel>
			<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_PocketWatch</li>
			</tags>
		</apparel>
		<equippedStatOffsets>
			<WorkSpeedGlobal>0.05</WorkSpeedGlobal>
		</equippedStatOffsets>
	</ThingDef>

	<!-- 精致怀表 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_PocketWatch_Delicate</defName>
		<label>delicate pocket watch</label>
		<description>A delicate, small, portable timekeeping device. Wearing it can subtly increase the wearer's work efficiency.</description>
