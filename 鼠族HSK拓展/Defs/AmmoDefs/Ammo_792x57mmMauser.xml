<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 7.92×57mm 毛瑟步枪弹 (2026-09-06 用户确认自创弹种):
	     本环境 CE 无此口径,按 Core_SK 对 CE 弹药的 HSK 终态格式直写——
	     仅 FMJ/AP/HP 三档(燃烧/高爆/脱壳按 HSK 平衡裁去)、HSK 市值与生成率、
	     钢锭分类(SLDBar/USLDBar/HeavyBar)+火药配方 x80/批,复用 CE Rifle 弹匣/弹丸贴图。
	     适配武器(80/81/98 号补丁改映射): 云杉栓动 RK_KB_Fichte / 杏梅栓动 RK_NR_Mume /
	     夹竹桃栓动 RK_LS_Zakkum / 灰叶枫自动步枪 RK_SD_Klyon / 山毛榉狙击 RK_KB_Buche /
	     五月植物轻机枪 RK_KB_Maipflanze。 -->

	<ThingCategoryDef>
		<defName>Ammo792x57mmMauser</defName>
		<label>7.92×57mm 毛瑟</label>
		<parent>AmmoRifles</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberRifle</iconPath>
	</ThingCategoryDef>

	<!-- ==================== 弹药集 ========================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_792x57mmMauser</defName>
		<label>7.92×57mm 毛瑟</label>
		<ammoTypes>
			<Ammo_792x57mmMauser_FMJ>Bullet_792x57mmMauser_FMJ</Ammo_792x57mmMauser_FMJ>
			<Ammo_792x57mmMauser_AP>Bullet_792x57mmMauser_AP</Ammo_792x57mmMauser_AP>
			<Ammo_792x57mmMauser_HP>Bullet_792x57mmMauser_HP</Ammo_792x57mmMauser_HP>
		</ammoTypes>
