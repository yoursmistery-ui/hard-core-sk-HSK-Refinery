<?xml version='1.0' encoding='utf-8'?>
<Defs>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowExtreme</defName>
        <workerClass>OberoniaAureaGene.ThoughtWorker_SnowExtreme</workerClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Extreme blizzard</label>
                <description>If you get lost in this weather, it almost means death...</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
            <li>
                <label>Extreme blizzard</label>
                <description>Even the most steadfast belief appears vulnerable in this storm...</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
        <nullifyingTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </nullifyingTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowExtremeSurvivor</defName>
        <workerClass>OberoniaAureaGene.ThoughtWorker_SnowExtremeSurvivor</workerClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Facing the blizzard head-on</label>
                <description>Wind and snow, I am no longer afraid of you, you cannot blow me down again.</description>
                <baseMoodEffect>4</baseMoodEffect>
            </li>
        </stages>
        <requiredTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </requiredTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_ColdSnow</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Cold Snow</label>
                <description>It's so cold! so painful! Are these really snowflakes instead of blades?!!</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
        </stages>
        <nullifyingTraits>
            <li>OAGene_ExtremeSnowSurvivor</li>
        </nullifyingTraits>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowstormEnd</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <durationDays>5</durationDays>
        <stages>
            <li>
                <label>度过了暴风雪</label>
                <description>哪怕是极端的暴风雪也没能够将我们吹垮。</description>
                <baseMoodEffect>5</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

<ThoughtDef>
        <defName>OAGene_Thought_SnowstormDepress</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>The suppression of a blizzard</label>
                <description>The impenetrable black clouds and howling gusts of wind, such oppression almost made it impossible for me to breathe Can we really survive?</description>
                <baseMoodEffect>-22</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Hediff_SnowstormAngry</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Suppressed anger and anxiety</label>
                <description>This sense of unease makes me feel restless and irritable, and now I just want to be alone for a while.</description>
                <baseMoodEffect>-8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_StormSleepAngry</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <durationDays>1</durationDays>
        <stages>
            <li>
                <label>Sleeping in a dormitory with multiple people</label>
                <description>Enough, why do I still have to sleep with others even when I'm sleeping? I need space to catch my breath!</description>
                <baseMoodEffect>-14</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_UnderDark</defName>
        <workerClass>OberoniaAureaGene.Snowstorm.ThoughtWorker_UnderDark</workerClass>
        <stages>
            <li>
                <label>The darkness beyond the horizon</label>
                <description>Don't I don't want to stay in this darkness, don't!</description>
                <baseMoodEffect>-16</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_StarryNight</defName>
        <durationDays>0.1</durationDays>
        <stackLimit>1</stackLimit>
        <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
        <stages>
            <li>
                <label>Starry night</label>
                <description>What a magnificent moonlit night it is.</description>
                <baseMoodEffect>9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowstormFog</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stages>
            <li>
                <label>Snow and mist diffuse</label>
                <description>Even if there is danger around me now, I'm afraid I won't be able to detect it.</description>
                <baseMoodEffect>-4</baseMoodEffect>
            </li>
            <li>
                <label>Snow and mist diffuse</label>
                <description>I can't see things clearly! I can't see anything!</description>
                <baseMoodEffect>-9</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>