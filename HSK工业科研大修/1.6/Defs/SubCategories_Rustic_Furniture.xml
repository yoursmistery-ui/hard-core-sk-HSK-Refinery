	<ArchitectSense.DesignationSubCategoryDef>
		<defName>SubCategory_RusticTables</defName>
		<label>乡村桌台</label>
		<description>原木与乡村式样的桌案小几: 长桌、方桌、圆桌与床头小几。</description>
		<defNames>
			<li>Rustic_LogTable1x2c</li>
			<li>Rustic_LogTable1x3c</li>
			<li>Rustic_LogTable1x4c</li>
			<li>Rustic_LogTable2x4c</li>
			<li>Rustic_Table1x1c</li>
			<li>Rustic_ReinforcedTable1x1c</li>
			<li>Rustic_Table1x2c</li>
			<li>Rustic_ReinforcedTable1x2c</li>
			<li>Rustic_Table1x3c</li>
			<li>Rustic_Table2x2c</li>
			<li>Rustic_ReinforcedTable2x2c</li>
			<li>Rustic_RoundTable2x2c</li>
			<li>Rustic_Table2x4c</li>
			<li>Rustic_ReinforcedTable2x4c</li>
