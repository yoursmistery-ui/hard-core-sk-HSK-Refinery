<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 使 26 款 Gloomy 发型在所有 HSK 种族文化中可选: 给目标文化 styleItemTags 追加 Gloomy_Style 标签。
       1.6 Operation 级 MayRequire 已失效, 用 PatchOperationConditional 的 xpath 存在性门控, 目标 mod 缺失时空转不报错。 -->
  <!-- RK_Culture_Virtuard (来自 Solaris.RatkinRaceMod) -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/CultureDef[defName="RK_Culture_Virtuard"]/styleItemTags</xpath>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/CultureDef[defName="RK_Culture_Virtuard"]/styleItemTags</xpath>
      <value>
        <li>
          <tag>Gloomy_Style</tag>
          <baseWeight>1</baseWeight>
          <weightFactor>1</weightFactor>
        </li>
      </value>
    </match>
  </Operation>
  <!-- RatkiniaTraditionCulture_Warlord (来自 local.ratkin.clothesweapons) -->
