        <label>Oberonia Aurea Duplex Dress</label>
        <description>One of the common Oberonia Aurea costumes, the multi-layered duplex structure is highly layered, and the carefully designed patterns are no less impressive than palace costumes.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Apparel_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>19000</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.30</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.56</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.35</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <costList>
            <Synthread>55</Synthread>
        </costList>
        <costStuffCount>55</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <GeneralLaborSpeed>0.08</GeneralLaborSpeed>
            <SocialImpact>0.20</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Apparel_A</wornGraphicPath>
