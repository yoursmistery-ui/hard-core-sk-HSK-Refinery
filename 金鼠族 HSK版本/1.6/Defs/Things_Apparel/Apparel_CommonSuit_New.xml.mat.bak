            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_D</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰多功能大衣  -->
    <ThingDef ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Windbreaker_C</defName>
        <label>Oberonia Aurea Multifunctional Coat</label>
        <description>The work uniform commonly used by the Oberonia Aurea Palace has multiple modular components that can be easily connected to the work equipment of the Oberonia Aurea. In addition, it also has certain heat resistance and protective performance.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Windbreaker_C</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Synthread>80</Synthread>
            <ComponentIndustrial>4</ComponentIndustrial>
            <Uranium>40</Uranium>
        </costList>
        <costStuffCount>40</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToMake>27500</WorkToMake>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.20</StuffEffectMultiplierArmor>
            <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.20</ArmorRating_Blunt>
            <ArmorRating_Heat>0.80</ArmorRating_Heat>
            <StuffEffectMultiplierInsulation_Cold>0.8</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.75</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.2</EquipDelay>
        </statBases>
        <equippedStatOffsets>
            <GeneralLaborSpeed>0.15</GeneralLaborSpeed>
            <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <wornGraphicPath>Apparel/OA_RK_New_Windbreaker_C</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <tags>
                <li>OARatkin_TechnicalApparel</li>
                <li>OARatkin_IndustrialApparel</li>
				<li>OARatkin_NavigateApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_B</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰技术官大衣  -->
