<?xml version="1.0" encoding="utf-8"?>
<!--
  06_TributeCoinCurrency(2026-08-20 用户要求)
  「帝国征召队」贡品收集者原本用威望(Favor)结算, 无法接受帝国金银币。
  本补丁把它的贸易货币改为 Silver(银令, 经 ImperialCoinFix 重定向为 SilverCoin),
  使贡品收集者正常接受帝国银币/金币(配合双货币结算)。
  帝国与金鼠族两套贡品收集者都改。
-->
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TraderKindDef[defName="Empire_Caravan_TributeCollector"]/tradeCurrency</xpath>
    <value>
      <tradeCurrency>Silver</tradeCurrency>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/TraderKindDef[defName="OA_RK_Caravan_TributeCollector"]/tradeCurrency</xpath>
    <value>
      <tradeCurrency>Silver</tradeCurrency>
    </value>
  </Operation>
  <!-- 若某补丁没定义 OA_RK 的收集者, 替换失败不影响 Empire 一条(各自独立 Operation) -->
</Patch>