            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>17200</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.22</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.52</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.44</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <costList>
