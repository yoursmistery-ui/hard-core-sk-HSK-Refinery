<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 混凝土搅拌机配方 - 钢筋混凝土(2026-08-19 用户要求)
	     给手动/电动混凝土搅拌机添加制作钢筋混凝土配方:
	     - MixReinforcedConcrete(手动搅拌机 ConcreteMixer):    金属条10 + 混凝土10 → 钢筋混凝土8
	     - MixReinforcedConcreteElectric(电动搅拌机 EConcreteMixer): 金属条20 + 混凝土20 → 钢筋混凝土16
	     数值/材料过滤对齐 Core_SK 原版 MakeReinforcedConcrete_Hand/_Electric(切石桌/高级工具台),
	     工作台、动画与音效改为搅拌机风格(Smelt);原版切石桌/高级工具台两个配方已删除
	     (2026-08-19 用户要求,见 Patches/27_混凝土搅拌机配方.xml),钢筋混凝土仅由搅拌机制作。
	     挂载见 Patches/27_混凝土搅拌机配方.xml -->

	<RecipeDef>
		<defName>MixReinforcedConcrete</defName>
		<label>mix reinforced concrete</label>
		<description>Mixes concrete and metal bars into reinforced concrete. Quite slow. Produces 8.</description>
		<jobString>Mixing reinforced concrete.</jobString>
		<workAmount>1600</workAmount>
		<workSpeedStat>SmeltingSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Metallic</li>
					</categories>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ConcreteResource</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
			<thingDefs>
				<li>ConcreteResource</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>Bronze</li>
				<li>Steel</li>
				<li>ConcreteResource</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>FerrosiliconAlloy</li>
				<li>CupronickelAlloy</li>
			</disallowedThingDefs>
			<disallowedCategories>
				<li>USLDBar</li>
			</disallowedCategories>
		</defaultIngredientFilter>
		<products>
			<ReinforcedConcrete>8</ReinforcedConcrete>
		</products>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<researchPrerequisite>Concrete_C1</researchPrerequisite>
	</RecipeDef>

	<RecipeDef>
		<defName>MixReinforcedConcreteElectric</defName>
		<label>mix reinforced concrete</label>
		<description>Mixes concrete and metal bars into reinforced concrete. Quite fast. Produces 16.</description>
		<jobString>Mixing reinforced concrete.</jobString>
		<workAmount>1200</workAmount>
		<workSpeedStat>SmeltingSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>Metallic</li>
					</categories>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ConcreteResource</li>
					</thingDefs>
				</filter>
				<count>20</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			</categories>
			<thingDefs>
				<li>ConcreteResource</li>
			</thingDefs>
		</fixedIngredientFilter>
		<defaultIngredientFilter>
			<thingDefs>
				<li>Bronze</li>
				<li>Steel</li>
				<li>ConcreteResource</li>
			</thingDefs>
			<disallowedThingDefs>
				<li>FerrosiliconAlloy</li>
				<li>CupronickelAlloy</li>
			</disallowedThingDefs>
			<disallowedCategories>
				<li>USLDBar</li>
			</disallowedCategories>
		</defaultIngredientFilter>
		<products>
			<ReinforcedConcrete>16</ReinforcedConcrete>
		</products>
		<skillRequirements>
			<Crafting>7</Crafting>
		</skillRequirements>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<researchPrerequisite>Concrete_C2</researchPrerequisite>
	</RecipeDef>
</Defs>
