<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- 金鸢尾兰工业背心  -->
    <ThingDef ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Sandwich_A</defName>
        <label>Oberonia Aurea Industrial Vest</label>
        <description>The standard work uniform adopted by the Ministry of Industry of the Oberonia Aurea Palace has weak protective properties and can carry many light tools for easy use during construction.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Sandwich_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <techLevel>Spacer</techLevel>
        <statBases>
            <MaxHitPoints>220</MaxHitPoints>
            <WorkToMake>29900</WorkToMake>
            <Mass>1.0</Mass>
            <ArmorRating_Sharp>0.34</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.34</ArmorRating_Blunt>
            <ArmorRating_Heat>0.50</ArmorRating_Heat>
            <Insulation_Cold>7.5</Insulation_Cold>
            <Insulation_Heat>6.0</Insulation_Heat>
            <EquipDelay>3</EquipDelay>
        </statBases>
        <costList>
            <Synthread>75</Synthread>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <equippedStatOffsets>
            <CarryingCapacity>20</CarryingCapacity>
            <WorkSpeedGlobal>0.08</WorkSpeedGlobal>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Sandwich_A</wornGraphicPath>
            <layers>
                <li>Middle</li>
            </layers>
            <tags>
                <li>OARatkin_IndustrialApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedArmor</unfinishedThingDef>
            <researchPrerequisite>OA_RK_Apparel_E</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰披风  -->
    <ThingDef ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_New_Windbreaker_A</defName>
        <label>Oberonia Aurea Cloak</label>
        <description>The clothing produced by the Oberonia Aurea Empire after being exposed to the culture of the Milky Way is more focused on intuitive and open aesthetics compared to traditional clothing, making it more vibrant.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Windbreaker_A</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Synthread>70</Synthread>
        </costList>
        <costStuffCount>40</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToMake>20200</WorkToMake>
            <Mass>2.8</Mass>
            <StuffEffectMultiplierArmor>0.28</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.7</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.7</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>2.0</EquipDelay>
        </statBases>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <wornGraphicPath>Apparel/OA_RK_New_Windbreaker_A</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <tags>
                <li>OARatkin_Noble_Tier1</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_A</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

    <!-- 金鸢尾兰山地风衣  -->
    <ThingDef ParentName="OARatkin_CourtApparelMakeableBase">
        <defName>OA_RK_New_Windbreaker_B</defName>
        <label>Oberonia Aurea Mountain Windbreaker</label>
        <description>The windbreakers specially designed by the distant travelers of the Oberonia Aurea Empire for the mountainous climate have excellent resistance to falls and cold.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Windbreaker_B</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costList>
            <Synthread>65</Synthread>
        </costList>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToMake>29000</WorkToMake>
            <Mass>3.5</Mass>
            <StuffEffectMultiplierArmor>0.38</StuffEffectMultiplierArmor>
