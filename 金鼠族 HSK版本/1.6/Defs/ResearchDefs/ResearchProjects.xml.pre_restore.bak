	<ResearchProjectDef>
		<defName>OA_RK_Ningguangnuanhui</defName>
		<label>Warm glow facilities</label>
		<description>Contemplate on the life support technologies and other related advanced technologies of Oberonia Aurea, reverse-engineer the advanced public facility "Stasis Bright" of the Oberonia Aurea Empire.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>3000</baseCost>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>OA_RK_Constant_Temperature_Hydroponics</li>
		</prerequisites>
		<hiddenPrerequisites>
			<li>OA_RK_Oberonia_Aurea_Research_C</li>
		</hiddenPrerequisites>
		<researchViewX>13</researchViewX>
		<researchViewY>2.5</researchViewY>
		<techprintCount>1</techprintCount>
		<techprintCommonality>1</techprintCommonality>
		<techprintMarketValue>1800</techprintMarketValue>
		<heldByFactionCategoryTags>
			<li>OA_RK_Faction</li>
		</heldByFactionCategoryTags>
	</ResearchProjectDef>

</Defs>