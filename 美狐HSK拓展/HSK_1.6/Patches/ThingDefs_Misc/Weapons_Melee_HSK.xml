<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--Miho_Weapon_PowerClaw: CE 单手标记(可配盾)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerClaw"]/weaponTags</xpath>
    <value>
      <li>CE_OneHandedWeapon</li>
    </value>
  </Operation>
  <!--Miho_Weapon_Sappertool: CE 单手标记(可配盾)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_Weapon_Sappertool"]/weaponTags</xpath>
    <value>
      <li>CE_OneHandedWeapon</li>
    </value>
  </Operation>
  <!--Miho_Weapon_Tachi: CE 单手标记(可配盾)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_Weapon_Tachi"]/weaponTags</xpath>
    <value>
      <li>CE_OneHandedWeapon</li>
    </value>
  </Operation>
  <!--Miho_Weapon_EltexA: CE 单手标记(可配盾)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_Weapon_EltexA"]/weaponTags</xpath>
    <value>
      <li>CE_OneHandedWeapon</li>
    </value>
  </Operation>
  <!--Miho_Weapon_EltexB: CE 单手标记(可配盾)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_Weapon_EltexB"]/weaponTags</xpath>
    <value>
      <li>CE_OneHandedWeapon</li>
    </value>
  </Operation>
  <!--Miho_Weapon_PowerHammer: 生存工具适配(采矿/拆迁工具;2026-09-06 补 thingClass+加强工具属性+配方改电子元件/集成电路)
      门控: STL 原生 StatDef ToolEffectivenessFactor 存在性(1.6 Operation 级 MayRequire 已失效)-->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="ToolEffectivenessFactor"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]</xpath>
          <value><thingClass>SurvivalToolsLite.SurvivalTool</thingClass></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]/statBases</xpath>
          <value><ToolEffectivenessFactor>1</ToolEffectivenessFactor></value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]</xpath>
          <value>
            <li Class="SurvivalToolsLite.SurvivalToolProperties">
              <baseWorkStatFactors>
                <MiningSpeed>2.5</MiningSpeed>
                <ConstructionSpeed>2.0</ConstructionSpeed>
                <DeepDrillingSpeed>2.0</DeepDrillingSpeed>
              </baseWorkStatFactors>
              <defaultSurvivalToolAssignmentTags>
                <li>Miner</li>
                <li>Constructor</li>
              </defaultSurvivalToolAssignmentTags>
              <toolWearFactor>0.8</toolWearFactor>
              <purpose>凿岩/拆建</purpose>
            </li>
          </value>
        </li>
        <!--工作加成改由工具系统接管,移除手持面板重复加成(27号同款做法);MoveSpeed 惩罚保留-->
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]/equippedStatOffsets/MiningSpeed</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]/equippedStatOffsets/SmoothingSpeed</xpath>
        </li>
        <!--配方改工业电子档:天界鳞陶瓷+电子元件+集成电路,金属坯料保留(决定品质/材质)-->
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]/costList</xpath>
          <value>
            <costList>
              <Miho_Ceramics>60</Miho_Ceramics>
              <ElectronicComponents>12</ElectronicComponents>
              <Electronics>8</Electronics>
            </costList>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerHammer"]/statBases/WorkToMake</xpath>
          <value><WorkToMake>60000</WorkToMake></value>
        </li>
      </operations>
    </match>
  </Operation>
  <!--Miho_Weapon_Sappertool: 注册为生存工具(刺股/拆建维修),武器属性全保留(2026-09-06)-->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/StatDef[defName="ToolEffectivenessFactor"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_Sappertool"]</xpath>
          <value><thingClass>SurvivalToolsLite.SurvivalTool</thingClass></value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_Sappertool"]/statBases</xpath>
          <value><ToolEffectivenessFactor>1</ToolEffectivenessFactor></value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/ThingDef[defName="Miho_Weapon_Sappertool"]</xpath>
          <value>
            <li Class="SurvivalToolsLite.SurvivalToolProperties">
              <baseWorkStatFactors>
                <ConstructionSpeed>1.3</ConstructionSpeed>
                <GeneralLaborSpeed>1.1</GeneralLaborSpeed>
              </baseWorkStatFactors>
              <defaultSurvivalToolAssignmentTags>
                <li>Constructor</li>
              </defaultSurvivalToolAssignmentTags>
              <toolWearFactor>0.85</toolWearFactor>
              <purpose>刺股/拆建维修</purpose>
            </li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
