<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--绮罗勇者佩剑-->
	<Operation Class="PatchOperationFindMod">
    <mods>
      <li>Kiiro Race</li>
    </mods>
    <match Class="PatchOperationSequence">
	<operations>
	<li Class="PatchOperationReplace">
		<xpath>Defs/AncotLibrary.ThingDef_Custom[defName="Kiiro_ValorSabre"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>point</label>
					<capacities>
						<li>Kiiro_SabreCombo</li>
					</capacities>
					<power>4</power>
					<cooldownTime>1.8</cooldownTime>
					<chanceFactor>0.1</chanceFactor>
					<armorPenetrationSharp>26.81</armorPenetrationSharp>
					<armorPenetrationBlunt>3.4</armorPenetrationBlunt>
				</li>

				<li Class="CombatExtended.ToolCE">
					<label>edge</label>
					<capacities>
						<li>Kiiro_SabreCombo</li>
					</capacities>
					<power>40</power>
					<cooldownTime>1.5</cooldownTime>
					<armorPenetrationSharp>32.85</armorPenetrationSharp>
					<armorPenetrationBlunt>6.8</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
				</li>

			</tools>
		</value>
	</li>
	<li Class="PatchOperationConditional">
        <xpath>Defs/AncotLibrary.ThingDef_Custom[defName="Kiiro_ValorSabre"]/equippedStatOffsets</xpath>
        <nomatch Class="PatchOperationAdd">
			<xpath>Defs/AncotLibrary.ThingDef_Custom[defName="Kiiro_ValorSabre"]</xpath>
			<value>
				<equippedStatOffsets>
					<MeleeCritChance>1.25</MeleeCritChance>
					<MeleeParryChance>0.7</MeleeParryChance>
					<MeleeDodgeChance>0.65</MeleeDodgeChance>
				</equippedStatOffsets>
			</value>
		</nomatch>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>Defs/AncotLibrary.ThingDef_Custom[defName="Kiiro_ValorSabre"]/statBases</xpath>
		<value>
			<Bulk>8.5</Bulk>
			<MeleeCounterParryBonus>1.5</MeleeCounterParryBonus>
		</value>
	</li>
	<li Class="PatchOperationAdd">
		<xpath>Defs/AncotLibrary.ThingDef_Custom[defName="Kiiro_ValorSabre"]/weaponTags</xpath>
		<value>
			<li>CE_OneHandedWeapon</li>
		</value>
	</li>
	</operations>
    </match>
  </Operation>
</Patch>