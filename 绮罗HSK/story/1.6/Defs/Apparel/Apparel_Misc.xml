	</ThingDef>


	<!-- 紧急包扎绷带 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_EmergencyBandage</defName>
		<label>emergency bandage</label>
		<description>A portable bandage for basic first aid. Bandaging a target will heal three random wounds with low quality. Consumes mixed herbal. Bandaging speed and quality are affected by the wearer's medical skill.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/EmergencyBandage</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<costList>
			<Cloth>80</Cloth>
			<Kiiro_MixMedicineHerbal>10</Kiiro_MixMedicineHerbal>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_EmergencyBandage</li>
			</tags>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>10</maxCharges>
				<ammoDef>Kiiro_MixMedicineHerbal</ammoDef>
				<ammoCountPerCharge>1</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>bandage</chargeNoun>
				<displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li Class="AncotLibrary.VerbProperties_Job">
				<verbClass>AncotLibrary.Verb_EmergencyTend</verbClass>
				<commandIcon>Kiiro_Event/Apparels/EmergencyBandage</commandIcon>
				<violent>false</violent>
				<range>14.9</range>
				<targetable>true</targetable>
				<hasStandardCommand>true</hasStandardCommand>
				<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
				<onlyManualCast>true</onlyManualCast>
				<requireLineOfSight>false</requireLineOfSight>
				<targetParams>
					<canTargetSelf>true</canTargetSelf>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetMechs>false</canTargetMechs>
				</targetParams>
				<jobDef>Ancot_EmergencyTend</jobDef>
				<jobNum>1</jobNum>
			</li>
		</verbs>
	</ThingDef>




	<!-- 腌制小食口袋 -->
	<ThingDef ParentName="Kiiro_MerchantUtilityBase">
		<defName>Kiiro_CuringSnackBag</defName>
		<label>jerky pouch</label>
		<description>A wearable pouch for carrying jerky. Quickly consuming the jerky and slightly restores hunger.</description>
		<graphicData>
			<texPath>Kiiro_Event/Apparels/CuringSnackBag</texPath>
			<drawSize>1.0</drawSize>
		</graphicData>
		<costList>
			<Cloth>80</Cloth>
			<Kiiro_CuringFood>10</Kiiro_CuringFood>
		</costList>
		<apparel>
			<tags>
				<li>Kiiro_CuringSnackBag</li>
			</tags>
		</apparel>
		<comps>
			<li Class="CompProperties_ApparelReloadable">
				<maxCharges>10</maxCharges>
				<ammoDef>Kiiro_CuringFood</ammoDef>
				<ammoCountPerCharge>1</ammoCountPerCharge>
				<baseReloadTicks>60</baseReloadTicks>
				<soundReload>Standard_Reload</soundReload>
				<hotKey>Misc4</hotKey>
				<chargeNoun>Jerky</chargeNoun>
				<displayGizmoWhileUndrafted>true</displayGizmoWhileUndrafted>
			</li>
		</comps>
		<verbs>
			<li Class="AncotLibrary.VerbProperties_Job">
				<verbClass>AncotLibrary.Verb_Job</verbClass>
				<commandIcon>Kiiro_Event/Items/CuringSnack/CuringSnackB</commandIcon>
				<violent>false</violent>
				<hasStandardCommand>true</hasStandardCommand>
				<targetable>false</targetable>
				<nonInterruptingSelfCast>true</nonInterruptingSelfCast>
				<onlyManualCast>True</onlyManualCast>
				<jobDef>Kiiro_UseCuringSnackBag</jobDef>
				<jobNum>1</jobNum>
			</li>
		</verbs>
	</ThingDef>



