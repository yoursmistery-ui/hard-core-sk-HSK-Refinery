				<Ratkin_Hamster MayRequire="Ludeon.RimWorld.Biotech">0.14</Ratkin_Hamster>
				<Ratkin_Vole MayRequire="Ludeon.RimWorld.Biotech">0.08</Ratkin_Vole>
