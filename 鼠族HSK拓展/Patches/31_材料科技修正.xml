<?xml version='1.0' encoding='UTF-8'?>
<Patch>
    <!-- 31_材料科技修正(2026-08-09 用户要求):
         前工业(中世纪)衣物移除石油材料(Compaste/SyntheticFibers/Plastic/Rubber),
         ComponentIndustrial(普通零部件)改为 ComponentMedieval(原始零部件)——
         按科技档判断: 中世纪=原始零部件, 工业=普通零部件;
         优雅贝雷帽(beileimao)按用户判定为前工业, 同样处理;
         十字军护甲/十字军轻型护盔/格鲁斯之铠补成丰富中世纪配方(金属+钢铁+布料+原始零部件)。
         覆盖 01/02/08 的对应材料;最终层补丁。 -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_WhiteCoat"]/ingredients</xpath>
        <value>
<ingredients>
                <li><filter><stuffCategoriesToAllow><li>Leathery</li></stuffCategoriesToAllow></filter><count>85</count></li>
                <li><filter><stuffCategoriesToAllow><li>HF</li></stuffCategoriesToAllow></filter><count>45</count></li>
                <li><filter><thingDefs><li>Cloth</li></thingDefs></filter><count>20</count></li>
                <li><filter><stuffCategoriesToAllow><li>StrongMetallic</li></stuffCategoriesToAllow></filter><count>15</count></li>
                <li><filter><thingDefs><li>ComponentMedieval</li></thingDefs></filter><count>11</count></li>
</ingredients>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_WhiteCoat"]/fixedIngredientFilter</xpath>
        <value>
<fixedIngredientFilter>
    <stuffCategoriesToAllow><li>Leathery</li><li>HF</li><li>StrongMetallic</li></stuffCategoriesToAllow>
    <thingDefs><li>Cloth</li><li>ComponentMedieval</li></thingDefs>
</fixedIngredientFilter>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_ResearchGlasses"]/ingredients</xpath>
        <value>
<ingredients>
                <li><filter><stuffCategoriesToAllow><li>Glass</li></stuffCategoriesToAllow></filter><count>15</count></li>
                <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>3</count></li>
</ingredients>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_ResearchGlasses"]/fixedIngredientFilter</xpath>
        <value>
<fixedIngredientFilter>
    <stuffCategoriesToAllow><li>Glass</li></stuffCategoriesToAllow>
    <thingDefs><li>ComponentIndustrial</li></thingDefs>
</fixedIngredientFilter>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKVictoria_Make_Crusaders"]/ingredients</xpath>
        <value>
<ingredients>
                <li><filter><stuffCategoriesToAllow><li>Metallic</li></stuffCategoriesToAllow></filter><count>100</count></li>
                <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>40</count></li>
                <li><filter><thingDefs><li>Cloth</li></thingDefs></filter><count>30</count></li>
                <li><filter><thingDefs><li>ComponentMedieval</li></thingDefs></filter><count>4</count></li>
</ingredients>
