<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 酒馆家具二级菜单(ArchitectSense 子分类)。
	     已并入 HSK 标准分类:家具(Furniture)、辅助建筑(Accessories)、生产(Production)。
	     灯光/地毯/装饰挂到辅助建筑;厨房(除厨房台面 Tav_Kitchen)挂到生产。
	     厨房台面(Tav_Kitchen)保留在家具分类,并入"柜台与货架"。 -->

	<!-- ===== 家具 Furniture ===== -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Seats</defName>
		<label>酒馆座椅</label>
		<description>酒馆风格的椅子、凳子、长凳与扶手椅。</description>
		<defNames>
			<li>Tav_ChairA</li>
			<li>Tav_SoftChair</li>
			<li>Tav_StoolA</li>
			<li>Tav_SoftStool</li>
			<li>Tav_TavernBench</li>
			<li>Tav_SoftArmchair</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>10</order>
		<types>
			<li>Seats</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Tables</defName>
		<label>酒馆桌台</label>
		<description>酒馆风格的方形桌与餐桌。</description>
		<defNames>
			<li>Tav_1x1Table</li>
			<li>Tav_1x2Table</li>
			<li>Tav_2x2Table</li>
			<li>Tav_2x2RoundTable</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>20</order>
		<types>
			<li>Tables</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_CounterRack</defName>
		<label>柜台与货架</label>
		<description>酒馆的吧台、上菜台、厨房台面与货架。</description>
		<defNames>
			<li>Tav_1x2Counter</li>
			<li>Tav_1x3Counter</li>
			<li>Tav_Kitchen</li>
			<li>Tav_RackA</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>30</order>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Beds</defName>
		<label>酒馆床铺</label>
		<description>酒馆风格的单人床与双人床。</description>
		<defNames>
			<li>Tav_SoftBed</li>
			<li>Tav_SoftDoubleBed</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>40</order>
		<types>
			<li>Beds</li>
			<li>Bedroom</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_BedroomStorage</defName>
		<label>卧室储物</label>
		<description>酒馆卧室的床头柜、梳妆台与衣柜。</description>
		<defNames>
			<li>Tav_EndTable</li>
			<li>Tav_Dresser</li>
			<li>Tav_Wardrobe</li>
			<li>Tav_1x1Wardrobe</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
		<order>50</order>
	</ArchitectSense.DesignationSubCategoryDef>

	<!-- ===== 辅助建筑 Accessories ===== -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Lights</defName>
		<label>酒馆照明</label>
		<description>营造温馨酒馆氛围的烛台与蜡烛。</description>
		<defNames>
			<li>Tav_Candleholder</li>
			<li>Tav_TableLight</li>
		</defNames>
		<designationCategory>Accessories</designationCategory>
		<debug>false</debug>
		<order>10</order>
		<types>
			<li>Lights</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_DecorRugs</defName>
		<label>装饰与地毯</label>
		<description>酒馆的奖杯、旗帜与编织装饰地毯,全部在建筑菜单直接建造。</description>
		<defNames>
			<li>Tav_DecTrophy</li>
			<li>Tav_Dec2x1Flags</li>
			<li>Tav_Dec3x1Flags</li>
			<li>Tav_Dec4x1Flags</li>
			<li>Tav_KitchenAdd</li>
			<li>Tav_StrawRugA</li>
			<li>Tav_RugA</li>
			<li>Tav_RugB</li>
			<li>Tav_RugSquareA</li>
			<li>Tav_RugSquareB</li>
			<li>Tav_RugSquare4X2A</li>
		</defNames>
		<designationCategory>Accessories</designationCategory>
		<debug>false</debug>
		<order>20</order>
		<types>
			<li>Misc</li>
			<li>Decor</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<!-- ===== 生产 Production ===== -->
	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Kitchen</defName>
		<label>酒馆厨房</label>
			<description>厨房搁架、壁柜、烤箱与屠宰台。</description>
		<defNames>
			<li>Tav_KitchenShelfs</li>
			<li>Tav_KitchenCloset</li>
			<li>Tav_Oven</li>
			<li>Tav_KitchenButch</li>
		</defNames>
		<designationCategory>Production</designationCategory>
		<debug>false</debug>
		<order>10</order>
	</ArchitectSense.DesignationSubCategoryDef>

</Defs>