<?xml version='1.0' encoding='UTF-8'?>
<Defs>
	<!-- 整合自 SimpleStairs (Folk) 1.6 (workshop 3565659409, Reimu Scarlet)。
	     楼梯/扶手/矮墙/转角柱 3 类结构件,保留 鼠族 RGK + Gloomy GL 两套贴图(去重删除原版 GO 一套)。
	     全部 RKFC_ 命名空间,Structure 分类,挂「古典楼梯」子分类,研究 建造 I(Construction_B1)。 -->

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>RKFC_SubCategory_Stairs</defName>
		<label>ratkin stairs</label>
		<description>Ratkin style stairs, handrails, wall boards and corner fences.</description>
		<defNames>
			<li>RKFC_SimpleStair</li>
			<li>RKFC_RGK_Handrail</li>
			<li>RKFC_RGK_HighWall</li>
			<li>RKFC_RGK_FloorFence</li>
			<li>RKFC_GL_Handrail</li>
			<li>RKFC_GL_HighWall</li>
			<li>RKFC_GL_FloorFence</li>
		</defNames>
		<designationCategory>Structure</designationCategory>
		<debug>false</debug>
		<order>20</order>
	</ArchitectSense.DesignationSubCategoryDef>

	<!-- 楼梯 -->
	<ThingDef ParentName="BuildingBase">
		<defName>RKFC_SimpleStair</defName>
		<label>stairs</label>
		<description>A simple set of stairs for crossing uneven ground.</description>
		<category>Building</category>
		<thingClass>Building</thingClass>
		<graphicData>
			<texPath>Things/Building/GO_stairs</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.03</drawSize>
		</graphicData>
		<uiIconScale>1</uiIconScale>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>Standable</passability>
		<fillPercent>0</fillPercent>
		<statBases>
			<SellPriceFactor>0.70</SellPriceFactor>
			<MaxHitPoints>45</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Flammability>0</Flammability>
			<Mass>1</Mass>
			<Beauty>1</Beauty>
		</statBases>
		<selectable>true</selectable>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>1</costStuffCount>
		<building>
			<isEdifice>false</isEdifice>
			<paintable>true</paintable>
			<relatedBuildCommands>
				<li>RKFC_RGK_Handrail</li>
				<li>RKFC_RGK_HighWall</li>
				<li>RKFC_RGK_FloorFence</li>
				<li>RKFC_GL_Handrail</li>
				<li>RKFC_GL_HighWall</li>
				<li>RKFC_GL_FloorFence</li>
			</relatedBuildCommands>
		</building>
		<soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<rotatable>true</rotatable>
		<scatterableOnMapGen>false</scatterableOnMapGen>
		<useHitPoints>False</useHitPoints>
		<designationCategory>Structure</designationCategory>
		<destroyable>true</destroyable>
		<tradeability>None</tradeability>
		<clearBuildingArea>false</clearBuildingArea>
		<resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
		<drawStyleCategory>Default2D</drawStyleCategory>
		<researchPrerequisites><li>Construction_B1</li></researchPrerequisites>
	</ThingDef>

