<?xml version='1.0' encoding='utf-8'?>
<Defs>
	<ThingDef ParentName="RK_IndustrialRangeWeapon">
		<defName>RK_EU_Edelweib</defName>
		<label>"Edelweib"Repeating Rifle</label>
		<description>Designed with a straight-pull bolt system, greatly increasing rate of fire. At the time, it offered excellent firepower and speed.</description>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/RK_EU_Edelweib</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.0</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit="false">
			<li>RK_EU_Rifle</li>
		</weaponTags>
		<statBases>
			<WorkToMake>11000</WorkToMake>
			<Mass>2.5</Mass>
			<Bulk>8</Bulk>
			<AccuracyTouch>0.70</AccuracyTouch>
			<AccuracyShort>0.80</AccuracyShort>
			<AccuracyMedium>0.85</AccuracyMedium>
			<AccuracyLong>0.75</AccuracyLong>
			<RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>50</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
			<WoodLog>40</WoodLog>
		</costList>
		<recipeMaker>
			<researchPrerequisite>RK_EU_Weapon</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<equippedAngleOffset>45</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Edelweib</defaultProjectile>
				<warmupTime>1.6</warmupTime>
				<range>45</range>
				<soundCast>RK_EU_Edelweib</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>10</muzzleFlashScale>
			</li>
		</verbs>
		<comps Inherit="False">
			<li Class="RatkinWeapons.CompProperties_Bayonet" MayRequire="bbb.ratkinweapon.morefailure">
				<cooldown>1800</cooldown>
				<radius>14.9</radius>
				<label>RK.BayonetLabel</label>
				<description>RK.BayonetDescription</description>
				<icon>UI/Abilities/RK_Bayonet</icon>
			</li>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Styleable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponGun</nameMaker>
				<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>2</cooldownTime>
				<armorPenetrationBlunt>3</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>bayonet</label>
				<capacities>
					<li>Cut</li>
					<li>Stab</li>
				</capacities>
				<power>17</power>
				<cooldownTime>2.3</cooldownTime>
				<armorPenetrationSharp>6</armorPenetrationSharp>
				<armorPenetrationBlunt>5</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
	</ThingDef>
	<ThingDef ParentName="BaseMakeableGrenade">
		<defName>RK_EU_Zundkraut</defName>
		<label>"Zundkraut" Handle Grenade</label>
		<description>A standard grenade shaped like a cylindrical iron can. While less powerful than fragmentation grenades, it was easy to manufacture and effective for trench and close-quarters combat.</description>
		<recipeMaker>
			<researchPrerequisite>RK_KB_Weapon</researchPrerequisite>
		</recipeMaker>
		<relicChance>0</relicChance>
		<tickerType>Normal</tickerType>
		<weaponTags Inherit="false">
			<li>RK_WR_Grenade</li>
		</weaponTags>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/RK_EU_Zundkraut</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<uiIconScale>1.3</uiIconScale>
		<soundInteract>Interact_Grenade</soundInteract>
		<techLevel>Industrial</techLevel>
		<statBases>
			<Mass>1</Mass>
			<RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
			<WorkToMake>2000</WorkToMake>
		</statBases>
		<costList>
			<Steel>25</Steel>
			<Chemfuel>50</Chemfuel>
		</costList>
		<weaponTags>
			<li>GrenadeDestructive</li>
		</weaponTags>
		<smeltable>true</smeltable>
		<verbs>
			<li>
				<label>throw frag grenade</label>
				<verbClass>Verb_LaunchProjectile</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<range>20</range>
				<forcedMissRadius>1.9</forcedMissRadius>
				<warmupTime>1</warmupTime>
				<noiseRadius>4</noiseRadius>
				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
				<soundCast>ThrowGrenade</soundCast>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<defaultProjectile>RK_EU_Zundkraut_Grenade</defaultProjectile>
				<rangedFireRulepack>Combat_RangedFire_Thrown</rangedFireRulepack>
			</li>
		</verbs>
		<comps>
			<li Class="CompProperties_Explosive">
				<explosiveRadius>3.5</explosiveRadius>
				<explosiveDamageType>Bomb</explosiveDamageType>
				<requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
			</li>
		</comps>
	</ThingDef>
</Defs>
