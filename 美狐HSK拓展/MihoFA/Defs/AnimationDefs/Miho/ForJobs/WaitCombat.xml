<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  <FacialAnimation.FaceAnimationDef>
    <defName>WaitCombat_Miho</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>1</duration>
        <browShapeDef>angled</browShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
      </li>
    </animationFrames>
    <targetJobs>
      <li>Wait_Combat</li>
    </targetJobs>
    <priority>10200</priority>
  </FacialAnimation.FaceAnimationDef>
  
  <FacialAnimation.FaceAnimationDef>
    <defName>Wait_Combat_Rare_Miho</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>15</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
      <li>
        <duration>4</duration>
        <browOffset>(0,0,-0.00375)</browOffset>
        <browShapeDef>flat</browShapeDef>
        <lidShapeDef>half</lidShapeDef>
        <lidOffset>(0,0,-0.0025)</lidOffset>
        <headOffset>(0,0,-0.00625)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
      <li>
        <duration>45</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>s-shaped</browShapeDef>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0,0,-0.005)</lidOffset>
        <headOffset>(0,0,-0.0175)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>s-shaped</browShapeDef>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0,0,-0.005)</lidOffset>
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>7</duration>
        <browOffset>(0,0,-0.00375)</browOffset>
        <browShapeDef>s-shaped</browShapeDef>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0,0,-0.0025)</lidOffset>
        <headOffset>(0,0,-0.0085)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
      <li>
        <duration>4</duration>
        <browShapeDef>flat</browShapeDef>
        <lidShapeDef>half</lidShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
      </li>
      <li>
        <duration>30</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
    </animationFrames>
    <targetJobs>
      <li>Wait_Combat</li>
    </targetJobs>
    <priority>10302</priority>
    <roopIntervalMin>1000</roopIntervalMin>
    <roopIntervalMax>2000</roopIntervalMax>
  </FacialAnimation.FaceAnimationDef>
  
  <FacialAnimation.FaceAnimationDef>
    <defName>Wait_Combat_Rare_Miho_fish</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>15</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0,0,-0.0175)</headOffset>
        <mouthShapeDef>down</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish</headShapeDef><!-- 雜 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef><!-- down嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>50</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish2</headShapeDef><!-- 雜魚 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>open</mouthShapeDef><!-- open嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish</headShapeDef><!-- 雜 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef><!-- down嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>100</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>angled</browShapeDef>
		<headShapeDef>fish3</headShapeDef><!-- 更多雜魚 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
		<lidShapeDef>fish</lidShapeDef><!-- 雜魚眼皮 -->
        <mouthShapeDef>fish</mouthShapeDef><!-- 雜魚嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>	
      <li>
        <duration>30</duration>
        <browShapeDef>flat</browShapeDef>
        <lidShapeDef>half</lidShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
      </li>
      <li>
        <duration>15</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
    </animationFrames>
	
    <targetJobs>
      <li>Wait_Combat</li>
    </targetJobs>
    <priority>10303</priority>
    <roopIntervalMin>1000</roopIntervalMin>
    <roopIntervalMax>2000</roopIntervalMax>
  </FacialAnimation.FaceAnimationDef>
</Defs>