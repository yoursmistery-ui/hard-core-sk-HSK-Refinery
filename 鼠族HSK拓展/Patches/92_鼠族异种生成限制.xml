    <!-- ⑦ 人类异种人白名单(Human 只允许原版+DLC 异种人,禁止鼠族异种人):
         HAR(AlienRaces)的 HumansAreAliensToo 把 Human 改成 AlienRace 并给 xenotypeList,
         Core_SK 的人类定义含 Baseline_Nova/Dova/Norbal/Orassan(其它种族基线异种人),
         RatkinRaceHSK 的 HumansAreAlienToo_Patch 还会 Add RK_XenoType_Ratkin(初鼠族)
         → 人类会随机到鼠族/其它种族异种人。这里在最终层统一 Replace 为纯净白名单
         (原版 Biotech + Odyssey 异种人),与 HSK修复整合 09_杂项 的人类白名单一致并兜底。
         注意: 该节点由 HAR/Core_SK 提供,若缺失(无 HAR 环境)则 Conditional 跳过。 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Human"]/alienRace/raceRestriction/xenotypeList</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="Human"]/alienRace/raceRestriction/xenotypeList</xpath>
            <value>
                <xenotypeList>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Baseliner</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Sanguophage</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Dirtmole</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Hussar</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Waster</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Pigskin</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Neanderthal</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Impid</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Genie</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Yttakin</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">Starjack</li>
                </xenotypeList>
            </value>
        </match>
    </Operation>

    <!-- ⑧ 阿莎丽(Alien_Asari)异种人限制 —— 2026-08-22 暂存本文件(用户指示:
         "人种的先放在这里,后面再改";AsariRace=skyarkhangel.asarirace,依赖 HAR+HSK)。
         需求: 阿莎丽 = 本mod种族(Baseline_Asari)+ 原版+DLC 异种人,极低点缀
         (基线 0.98 主导,原版异种各 0.002)。AsariRace 自身白名单=[Baseline_Asari]
         (纯基线),派系/PawnKind 池=[Baseline_Asari 999] → 连原版异种人也出不来。
         这里: 白名单扩展 + 池权重调整。不含 Baseliner(无基因异种人,对异星种族无意义,
         Core_SK/鼠族池均不含)。人类侧已由 AsariRace 自动 blackXenotypeList=Baseline_Asari,不动。 -->
    <Operation Class="PatchOperationConditional">
        <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Alien_Asari"]/alienRace/raceRestriction/xenotypeList</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Alien_Asari"]/alienRace/raceRestriction/xenotypeList</xpath>
            <value>
                <xenotypeList>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Baseline_Asari</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Sanguophage</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Dirtmole</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Hussar</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Waster</li>
                    <li MayRequire="Ludeon.RimWorld.Biotech">Pigskin</li>
