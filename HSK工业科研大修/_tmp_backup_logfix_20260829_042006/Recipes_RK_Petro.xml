  <!-- ===== 深度裂解厂 ===== -->
  <RecipeDef><defName>RK_Recipe_DeepCrack</defName><label>深度裂解·制混合气</label><description>将天然气、石脑油与沥青深度裂解为裂解混合气。</description><jobString>裂解中。</jobString>
    <workAmount>2000</workAmount><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill><effectWorking>Cook</effectWorking><soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers><li>RK_Petro_DeepCracker</li></recipeUsers><researchPrerequisite>RK_Petro_DeepCracking</researchPrerequisite>
    <ingredients>
      <li><filter><thingDefs><li>RK_Petro_NaturalGas</li></thingDefs></filter><count>5</count></li>
      <li><filter><thingDefs><li>RK_Petro_Naphtha</li></thingDefs></filter><count>10</count></li>
      <li><filter><thingDefs><li>Asphalt</li></thingDefs></filter><count>10</count></li>
    </ingredients>
    <fixedIngredientFilter><thingDefs><li>RK_Petro_NaturalGas</li><li>RK_Petro_Naphtha</li><li>Asphalt</li></thingDefs></fixedIngredientFilter>
    <products><RK_Petro_MixedGas>20</RK_Petro_MixedGas></products>
  </RecipeDef>
  <RecipeDef><defName>RK_Recipe_CrackSynth</defName><label>裂解·制合成烯/酰胺</label><description>将化合燃料裂解为合成烯与合成酰胺单体。</description><jobString>裂解中。</jobString>
    <workAmount>1800</workAmount><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill><effectWorking>Cook</effectWorking><soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers><li>RK_Petro_OilCracker</li></recipeUsers><researchPrerequisite>RK_Petro_DeepCracking</researchPrerequisite>
    <ingredients><li><filter><thingDefs><li>Chemfuel</li></thingDefs></filter><count>20</count></li></ingredients>
