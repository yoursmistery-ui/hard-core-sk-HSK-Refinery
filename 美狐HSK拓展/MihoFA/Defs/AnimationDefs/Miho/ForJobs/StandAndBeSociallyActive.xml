<?xml version="1.0" encoding="utf-8" ?>

<Defs>
  <FacialAnimation.FaceAnimationDef>
    <defName>StandAndBeSociallyActive_Miho</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>3</duration>
        <browShapeDef>normal</browShapeDef>
        <headOffset>(0.0,0,-0.0025)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
      <li>
        <duration>3</duration>
        <browShapeDef>normal</browShapeDef>
        <headOffset>(0.0,0,-0.005)</headOffset>
        <mouthShapeDef>open</mouthShapeDef>
      </li>
      <li>
        <duration>3</duration>
        <browShapeDef>normal</browShapeDef>
        <headOffset>(0.0,0,0)</headOffset>
        <mouthShapeDef>normal</mouthShapeDef>
      </li>
    </animationFrames>
    <roopIntervalMin>0</roopIntervalMin>
    <roopIntervalMax>100</roopIntervalMax>
    <targetJobs>
      <li>StandAndBeSociallyActive</li>
	  <li>GiveSpeech</li>
	  <li>SocialRelax</li>	  
    </targetJobs>
    <priority>10</priority>
    <applyWhenStandingOnly>true</applyWhenStandingOnly>
  </FacialAnimation.FaceAnimationDef>

    <FacialAnimation.FaceAnimationDef>
    <defName>StandAndBeSociallyActive_Miho_Fish</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>15</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0,0,-0.0175)</headOffset>
        <mouthShapeDef>down</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish</headShapeDef><!-- 雜 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef><!-- down嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>50</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish2</headShapeDef><!-- 雜魚 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>open</mouthShapeDef><!-- open嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
		<headShapeDef>fish</headShapeDef><!-- 雜 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef><!-- down嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>100</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>angled</browShapeDef>
		<headShapeDef>fish3</headShapeDef><!-- 更多雜魚 文字 -->
        <headOffset>(0,0,-0.015)</headOffset>
		<lidShapeDef>fish</lidShapeDef><!-- 雜魚眼皮 -->
        <mouthShapeDef>fish</mouthShapeDef><!-- 雜魚嘴型 -->
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>
      <li>
        <duration>30</duration>
        <browOffset>(0,0,-0.01)</browOffset>
        <browShapeDef>normal</browShapeDef>
        <headOffset>(0,0,-0.015)</headOffset>
        <mouthShapeDef>down</mouthShapeDef>
        <mouthOffset>(0,0,-0.005)</mouthOffset>
      </li>	
      <li>
        <duration>30</duration>
        <browShapeDef>flat</browShapeDef>
        <lidShapeDef>half</lidShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
      </li>
      <li>
        <duration>15</duration>
        <browShapeDef>normal</browShapeDef>
      </li>
    </animationFrames>
	<roopIntervalMin>300</roopIntervalMin>
    <roopIntervalMax>600</roopIntervalMax>
    <targetJobs>
      <li>StandAndBeSociallyActive</li>
	  <li>GiveSpeech</li>
	  <li>SocialRelax</li>
    </targetJobs>
    <priority>30</priority>
    <applyWhenStandingOnly>true</applyWhenStandingOnly>
  </FacialAnimation.FaceAnimationDef>
  
</Defs>