  <ThingDef ParentName="RK_IndustrialRangeWeapon">
  		<defName>RK_NR_Mume</defName>
  		<label>"Mume"Bolt-Action Rifle</label>
  		<description>A replica of the old rifles from the Kornblume Confederation, serving as the main standard-issue rifle during both the Empire and Republic periods.</description>
  		<graphicData>
  			<texPath>Things/Item/Equipment/WeaponRanged/RK_NR_Mume</texPath>
  			<graphicClass>Graphic_Single</graphicClass>
              <drawSize>1.0</drawSize>
  		</graphicData>
  		<soundInteract>Interact_Rifle</soundInteract>
          <weaponTags Inherit="false">
  			<li>RK_NR_Rifle</li>
  		</weaponTags>
  		<statBases>
  			<WorkToMake>8000</WorkToMake>
  			<Mass>2.5</Mass>
  			<AccuracyTouch>0.70</AccuracyTouch>
  			<AccuracyShort>0.75</AccuracyShort>
  			<AccuracyMedium>0.85</AccuracyMedium>
  			<AccuracyLong>0.80</AccuracyLong>
  			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
  		</statBases>
  		<costList>
  			<Steel>30</Steel>
  			<ComponentIndustrial>2</ComponentIndustrial>
  			<WoodPlank>40</WoodPlank>
  		</costList>		
  		<equippedAngleOffset>45</equippedAngleOffset>
  		<verbs>
  			<li>
  				<verbClass>Verb_Shoot</verbClass>
  				<hasStandardCommand>true</hasStandardCommand>
  				<defaultProjectile>Bullet_Mume</defaultProjectile>
  				<warmupTime>1.6</warmupTime>
  				<range>45</range>
  				<soundCast>RK_KB_Fichte</soundCast>
                  <soundCastTail>GunTail_Heavy</soundCastTail>
  				<muzzleFlashScale>10</muzzleFlashScale>
  			</li>	
  		</verbs>
  		<comps Inherit="False">
  		    <li Class="RatkinWeapons.CompProperties_Bayonet" MayRequire="bbb.ratkinweapon.morefailure">
  				<cooldown>1800</cooldown>
  				<radius>14.9</radius>
  				<label>RK.BayonetLabel</label>
  				<description>RK.BayonetDescription</description>
  				<icon>UI/Abilities/RK_Bayonet</icon>
  			</li>
  			<li>
                <compClass>CompEquippable</compClass>
              </li>
  			<li Class="CompProperties_Forbiddable" />
              <li Class="CompProperties_Styleable" />
              <li>
                <compClass>CompQuality</compClass>
              </li>
              <li Class="CompProperties_Art">
                <nameMaker>NamerArtWeaponGun</nameMaker>
                <descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
                <minQualityForArtistic>Excellent</minQualityForArtistic>
              </li>
  		</comps>
  		<tools>
  			<li>
  				<label>stock</label>
  				<capacities>
  					<li>Blunt</li>
  				</capacities>
  				<power>7</power>
  				<cooldownTime>2</cooldownTime>
  			</li>
  			<li>
  				<label>bayonet</label>
  				<capacities>
  					<li>Cut</li>
  					<li>Stab</li>
  				</capacities>
  				<power>17</power>
  				<cooldownTime>2.3</cooldownTime>
  	        </li>
  		</tools>
  	</ThingDef>
  
  	
  	
