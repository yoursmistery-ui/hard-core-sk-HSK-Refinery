<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 剑气：命中瞬间在武器尖端爆出的发光弧。由 impactFlashFleck 走
       FleckMaker.Static(静态、不抛射)，MoteGlow 加法混合 → 黑/透明背景自然消隐。 -->
  <FleckDef ParentName="FleckBase_Thrown">
    <defName>JE_Melee_SlashQi</defName>
    <graphicData>
      <texPath>Things/Mote/JobEffects/SlashQi</texPath>
      <shaderType>MoteGlow</shaderType>
      <color>(180, 225, 255)</color>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <fadeInTime>0.01</fadeInTime>
    <solidTime>0.06</solidTime>
    <fadeOutTime>0.14</fadeOutTime>
  </FleckDef>

</Defs>
