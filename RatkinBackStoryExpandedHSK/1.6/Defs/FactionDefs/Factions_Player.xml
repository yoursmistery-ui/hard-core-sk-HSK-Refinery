<?xml version="1.0" encoding="utf-8" ?>
<Defs>
    
	<!-- 逃生奴隶开局 -->
	<FactionDef ParentName="RK_PlayerFactionBase">
		<defName>RK_EscapeFaction</defName>
		<label>Ratkin Escaper</label>
		<description>A new future lies ahead for a slave ratkin, who was once taken captive by space pirates but managed to escape.</description>
		<isPlayer>true</isPlayer>
		<basicMemberKind>RatkinColonist</basicMemberKind>
		<pawnSingular>Ratkin</pawnSingular>
		<pawnsPlural>Escaper</pawnsPlural>
		<techLevel>Medieval</techLevel>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
		<factionIconPath>Icon/RK_icon</factionIconPath>
		
		<playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
		<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
	</FactionDef>


	<!-- 流亡敌对开局 -->
	<FactionDef ParentName="RK_PlayerFactionBase">
		<defName>RK_ExileFaction</defName>
		<label>Exile Community</label>
		<description>The ratkin exiles, who were forced into exile for various reasons, have created a new community, and they are trying to carve out a new world of their own on the frontier, but they are also threatened by the Ratkin Kingdom for their rebellion.</description>
		<isPlayer>true</isPlayer>
		<basicMemberKind>RatkinColonist</basicMemberKind>
		<pawnSingular>Ratkin</pawnSingular>
		<pawnsPlural>Exile</pawnsPlural>
		<techLevel>Medieval</techLevel>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<settlementTexturePath>Icon/RK_DefaultColony</settlementTexturePath>
		<factionIconPath>Icon/RK_icon</factionIconPath>
		
		<playerInitialSettlementNameMaker>NamerInitialSettlementColony</playerInitialSettlementNameMaker>
		<factionNameMaker>NamerFaction_RatkinKingdom</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
	</FactionDef>

</Defs>
