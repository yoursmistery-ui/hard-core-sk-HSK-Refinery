<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- ========== 高级陶瓷 (原美狐 Miho_Ceramics 改名) ===========
	     材质类别: Metallic + Stony + Ceramic(用于衣物/武器)
	     数值在普通陶瓷基础上上调 -->
	<ThingDef ParentName="ResourceBase">
		<defName>Miho_Ceramics</defName>
		<label>high grade ceramic</label>
		<description>Advanced ceramics made by refining ordinary ceramics with metal. Strong and versatile, used for high-grade equipment.</description>
		<graphicData>
			<texPath>Things/Items/MihoCeramic</texPath>
			<graphicClass>Graphic_StackCount</graphicClass>
		</graphicData>
		<soundInteract>Metal_Drop</soundInteract>
		<soundDrop>Metal_Drop</soundDrop>
		<statBases>
			<MarketValue>5</MarketValue>
			<Mass>0.5</Mass>
			<StuffPower_Armor_Sharp>1.10</StuffPower_Armor_Sharp>
			<StuffPower_Armor_Blunt>0.55</StuffPower_Armor_Blunt>
			<StuffPower_Armor_Heat>1.60</StuffPower_Armor_Heat>
			<StuffPower_Insulation_Cold>3</StuffPower_Insulation_Cold>
			<StuffPower_Insulation_Heat>0</StuffPower_Insulation_Heat>
			<SharpDamageMultiplier>1.0</SharpDamageMultiplier>
			<BluntDamageMultiplier>0.7</BluntDamageMultiplier>
		</statBases>
		<useHitPoints>false</useHitPoints>
		<healthAffectsPrice>false</healthAffectsPrice>
		<slagDef>ChunkSlagSteel</slagDef>
		<thingCategories>
			<li>Ceramic</li>
		</thingCategories>
		<burnableByRecipe>true</burnableByRecipe>
		<smeltable>true</smeltable>
		<stuffProps>
			<categories>
				<li>Metallic</li>
				<li>Stony</li>
				<li>Ceramic</li>
			</categories>
			<isAirtight>true</isAirtight>
			<appearance>Metal</appearance>
			<commonality>0.05</commonality>
			<constructEffect>ConstructMetal</constructEffect>
			<color>(205,205,205)</color>
			<soundImpactBullet>BulletImpact_Metal</soundImpactBullet>
			<soundMeleeHitSharp>MeleeHit_Metal_Sharp</soundMeleeHitSharp>
			<soundMeleeHitBlunt>MeleeHit_Metal_Blunt</soundMeleeHitBlunt>
			<soundImpactMelee>Pawn_Melee_Punch_HitBuilding_Metal</soundImpactMelee>
			<statFactors>
				<MaxHitPoints>1.5</MaxHitPoints>
				<Beauty>3</Beauty>
				<Flammability>0</Flammability>
				<MeleeWeapon_CooldownMultiplier>0.85</MeleeWeapon_CooldownMultiplier>
			</statFactors>
			<canSuggestUseDefaultStuff>true</canSuggestUseDefaultStuff>
		</stuffProps>
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
	</ThingDef>

