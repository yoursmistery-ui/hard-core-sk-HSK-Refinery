<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- 金属锭追加科技档类(2026-09-02): 每锭 Conditional 双路——thingCategories 节点存在则 Add li,
       不存在(如 VMS 塑料系原始 def 无节点, 类别由 HSK 加载期补丁建)则整节点 Add。
       2026-09-03 增加继承去重: 祖先(Name 链)已归档同档的子锭跳过(分类经 XML 继承从父类获得,
       补丁会造成合并后 duplicate thingCategory config error)。
       由 _tmp/材料门控/gen_tier_categories.py 生成, 勿手改; 新锭需重跑。 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="ABS"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ABS"]/thingCategories</xpath>
      <value><li>RK_Bar_Industrial</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="ABS"]</xpath>
      <value><thingCategories><li>RK_Bar_Industrial</li></thingCategories></value>
    </nomatch>
  </Operation>
