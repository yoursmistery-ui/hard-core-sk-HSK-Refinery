<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 鼠族电焊枪(2026-08-10): 工业电子/零部件制造工具,鼠族电力锻造台打造;
         贴图 Textures/Weapon/RK_WeldingTorch.png(用户图抠图→灰度,材质随钢/塑钢/金变色);
         STL 工具属性与工具分类由 45 号补丁提供(MayRequire 门控),CE 适配见 39 号。 -->
    <ThingDef ParentName="RK_MeleeWeapon">
        <defName>RK_WeldingTorch</defName>
        <label>鼠族电焊枪</label>
        <description>工业电焊枪,电子/零部件制造利器,也能应急近战。</description>
        <graphicData>
            <texPath>Weapon/RK_WeldingTorch</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <uiIconScale>1.3</uiIconScale>
        <techLevel>Industrial</techLevel>
        <weaponTags Inherit="false">
            <li>RK_MeleeWeapon_Short</li>
            <li>RK_WeaponTag_OneHand</li>
        </weaponTags>
        <statBases>
            <WorkToMake>12000</WorkToMake>
            <Mass>3</Mass>
        </statBases>
        <equippedAngleOffset>135</equippedAngleOffset>
        <costStuffCount>55</costStuffCount>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <tools>
            <li>
                <label>torch</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>12</power>
                <cooldownTime>1.6</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="NewRatkin.CompProperties_WeaponGripType">
                <gripTypes>
                    <li>OneHand</li>
                </gripTypes>
            </li>
        </comps>
        <recipeMaker Inherit="False" IsNull="True" />
    </ThingDef>
</Defs>
