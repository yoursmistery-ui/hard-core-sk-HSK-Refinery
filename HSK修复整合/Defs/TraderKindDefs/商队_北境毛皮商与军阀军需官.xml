<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 鼠族派系特色商人(2026-09-09, 方案 §六之后的第二轮: 服装/装备按派系身份分工)
       现有王国资服商(RK_TraderKind_KingdomDressMerchant)已覆盖 RK_Apparel 148 件 + 文化纺织分类, 不重复造;
       这里只补两个真正空缺的定位: 北境鼠国的毛皮/驮兽线、血鼠军阀的军需线。
       全部用现成 tradeTag/category, 不引用其它 mod 的 def, 故不需要 MayRequire。 -->

  <!-- ===== 北境毛皮商(挂北境鼠国): 毛皮 + 粗布 + 驮兽与饲料, 雪原防寒货 ===== -->
  <TraderKindDef>
    <defName>RK_TraderKind_NorthernFurrier</defName>
    <label>北境毛皮商</label>
    <commonality>1.2</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>SilverCoin</thingDef>
        <countRange>2000~3500</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Leathers</categoryDef>
        <thingDefCountRange>6~10</thingDefCountRange>
        <totalPriceRange>600~1600</totalPriceRange>
        <price>Cheap</price>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>200~450</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WoolMuffalo</thingDef>
        <countRange>100~260</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>WoolSheep</thingDef>
        <countRange>80~200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Hay</thingDef>
        <countRange>200~500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Kibble</thingDef>
        <countRange>60~200</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>BasicClothing</tradeTag>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
        <countRange>5~9</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>RK_Apparel</tradeTag>
        <thingDefCountRange>3~6</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <!-- 驮兽/猎犬: 雪橇与搬运用 -->
      <li Class="StockGenerator_Animals">
        <maxWildness>0.70</maxWildness>
        <tradeTagsSell>
          <li>AnimalFarm</li>
          <li>AnimalPet</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalFighter</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>2~4</kindCountRange>
        <countRange>3~6</countRange>
        <createMatingPair>
          <li>AnimalFarm</li>
        </createMatingPair>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>Art</tag>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RK_SellableApparel</tag>
      </li>
      <li Class="StockGenerator_BuyExpensiveSimple" />
    </stockGenerators>
  </TraderKindDef>

  <!-- ===== 军阀军需官(挂血鼠): 护甲/枪械/弹药件/伤药, 不做礼装与稀罕物 ===== -->
  <TraderKindDef>
    <defName>RK_TraderKind_WarlordPurveyor</defName>
    <label>军阀军需官</label>
    <commonality>2</commonality>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>SilverCoin</thingDef>
        <countRange>1500~3000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>10~28</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>200~450</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineIndustrial</thingDef>
        <countRange>6~16</countRange>
      </li>
      <li Class="SK.StockGenerator_WithAppropriateAmmo">
        <tradeTag>WeaponRanged</tradeTag>
        <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
        <countRange>2~5</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>WeaponsMelee</categoryDef>
        <maxTechLevelGenerate>Industrial</maxTechLevelGenerate>
        <thingDefCountRange>3~6</thingDefCountRange>
        <countRange>2~4</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Armor</tradeTag>
        <countRange>4~8</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>RK_ExoticArmor</tradeTag>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
          <li>AnimalFighter</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>1~2</kindCountRange>
        <countRange>2~4</countRange>
      </li>
      <!-- 只收军械与护甲, 不收艺术品(军阀不做文雅生意) -->
      <li Class="StockGenerator_BuyTradeTag">
        <tag>RK_TradeTag_ArmorHighTech</tag>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>HiTechArmor</tag>
      </li>
      <li Class="StockGenerator_BuyTradeTag">
        <tag>WeaponRanged</tag>
      </li>
      <li Class="StockGenerator_BuySingleDef">
        <thingDef>Gold</thingDef>
      </li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
