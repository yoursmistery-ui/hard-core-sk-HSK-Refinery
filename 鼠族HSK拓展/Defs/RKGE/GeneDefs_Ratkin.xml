		<iconPath>UI/Icons/Genes/prototype_vole_tail</iconPath>
	</GeneDef>

  <GeneDef ParentName="GenePainBase">
    <defName>Pain_Increased</defName>
    <label>increased pain</label>
    <labelShortAdj>pain-increased</labelShortAdj>
    <description>Carriers of this gene experience more pain and are more sensitive to it than normal individuals.</description>
    <iconPath>UI/Icons/Genes/WR_Frag</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>
    <painFactor>1.25</painFactor>
    <biostatMet>2</biostatMet>
  </GeneDef>

	<GeneDef>
		<defName>Ratkin_ShoShoShot</defName>
		<biostatCpx>1</biostatCpx>
		<biostatMet>0</biostatMet>
		<displayCategory>Violence</displayCategory>
		<iconColor>(1, 1, 1)</iconColor>
		<displayOrderInCategory>33</displayOrderInCategory>
		<forcedTraits>
			<li>
				<def>ShootingAccuracy</def>
				<degree>-1</degree>
			</li>
		</forcedTraits>
		<label>trigger-happy</label>
		<description>Carriers of this gene tend to keep pressing the trigger continuously. They really dislike taking the time to aim carefully.</description>
		<iconPath>UI/Icons/Genes/WR_Shoting</iconPath>
	</GeneDef>

	<GeneDef>
		<defName>Ratkin_Sassy</defName>
		<biostatCpx>0</biostatCpx>
		<biostatMet>1</biostatMet>
		<iconColor>(1, 1, 1)</iconColor>
		<displayCategory>RatkinGene</displayCategory>
		<displayOrderInCategory>33</displayOrderInCategory>
		<label>Sassy</label>
		<description>Carriers of this gene tend to behave rudely in social situations. When they speak, they often use sarcastic language, making it difficult for others to handle.</description>
		<customEffectDescriptions>
			<li>The probability of sarcasm or insult doubles.</li>
		</customEffectDescriptions>
		<iconPath>UI/Icons/Genes/WR_Gaki</iconPath>
	</GeneDef>



