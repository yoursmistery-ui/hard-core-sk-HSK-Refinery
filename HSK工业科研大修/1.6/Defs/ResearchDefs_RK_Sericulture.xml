<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 蚕桑缫丝 · 中世纪自有科研节点(HSK工业科研大修, 2026-08-28)
       丝绸是"超越原始时代的超强布料"(Vile TIER2.5), 故其生产线(蚕匾架养蚕缫丝 + 纺织机织绸)从原先借挂的
       Fabrication(工业·电力) 下移到本中世纪节点, 不再要求电力。ParentName="MedievalBase"
       (Core_SK: techLevel Medieval + SimpleResearchBench + AdvancedResearchExtension[Simple,HiTech] + ResearchTreeSK),
       前置 Apparel_B1(服装生产 II, 提供纺织机 TableLoom), 与邻排纺织线同档不越级。
       坐标落 Apparel_SK 行 Y=39 空位 X=5 (该行仅 X=1,4,8,12,18,21-24 被占)。 -->

  <ResearchProjectDef ParentName="MedievalBase">
    <defName>RK_Sericulture</defName>
    <label>蚕桑缫丝</label>
    <description>掌握养蚕、缫丝与上机织绸的手艺。生丝织成的丝绸轻暖华贵、寒暑皆宜, 是能超越原始时代的顶级天然布料, 也是皇家衣饰与镶金家具的命脉。</description>
    <tab>Apparel_SK</tab>
    <baseCost>500</baseCost>
    <prerequisites>
      <li>Apparel_B1</li>
    </prerequisites>
    <researchViewX>5.00</researchViewX>
    <researchViewY>39.00</researchViewY>
  </ResearchProjectDef>

</Defs>
