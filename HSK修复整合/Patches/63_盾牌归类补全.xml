    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]/thingCategories</xpath>
      <value><li>HSK_U_Tac</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]</xpath>
      <value><thingCategories><li>HSK_U_Tac</li></thingCategories></value>
    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_HeavyShield"]/thingCategories/li[text()="HSK_U_Daily"]</xpath>
    <match Class="PatchOperationRemove">
      <xpath>Defs/ThingDef[defName="Apparel_HeavyShield"]/thingCategories/li[text()="HSK_U_Daily"]</xpath>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_HeavyShield"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_HeavyShield"]/thingCategories</xpath>
      <value><li>HSK_U_Tac</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_HeavyShield"]</xpath>
      <value><thingCategories><li>HSK_U_Tac</li></thingCategories></value>
    </nomatch>
  </Operation>

  <!-- ⑥ 两个同名空节点收编进盾牌: Shields(CE)→"护盾装置"子节点, VFEC_Shields(VEF)暂空归档在盾牌下 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingCategoryDef[defName="Shields"]/parent</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingCategoryDef[defName="Shields"]/parent</xpath>
      <value><parent>ShieldCat</parent></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingCategoryDef[defName="VFEC_Shields"]/parent</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingCategoryDef[defName="VFEC_Shields"]/parent</xpath>
      <value><parent>ShieldCat</parent></value>
    </match>
  </Operation>

  <!-- ⑦ 能量护盾装置补挂 护盾装置(Shields); 它们同时保留原有的 战术装备/配饰腰背 等分类 -->
