  <ThingDef ParentName="PlantBase" Name="RKFC_DecoTree" Abstract="True">	
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>130</pathCost>
		<blockWind>true</blockWind>		
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<Beauty>5</Beauty>
			<Nutrition>1.2</Nutrition>		
		</statBases>
		<ingestible>
			<foodType>Tree</foodType>
			<preferability>RawBad</preferability>
		</ingestible>
		<plant>
			<soundHarvesting>Harvest_Tree</soundHarvesting>
			<soundHarvestFinish>Harvest_Tree_Finish</soundHarvestFinish>
			<growDays>14</growDays>
			<harvestTag>Wood</harvestTag>		
			<sowResearchPrerequisites>
				<li>TreeSowing</li>
			</sowResearchPrerequisites>
			<sowWork>4000</sowWork>
			<sowMinSkill>6</sowMinSkill>
			<sowTags>
				<li>Ground</li>
			</sowTags>
			<visualSizeRange>1.3~2.0</visualSizeRange>
			<topWindExposure>0.25</topWindExposure>
			<blockAdjacentSow>true</blockAdjacentSow>
			<wildOrder>2</wildOrder>			
			<harvestedThingDef>WoodLog</harvestedThingDef>
			<harvestYield>4</harvestYield>
			<harvestMinGrowth>0.90</harvestMinGrowth>
			<harvestAfterGrowth>0.75</harvestAfterGrowth>
			<harvestFailable>false</harvestFailable>
			<purpose>Beauty</purpose>
			<leaflessGraphicPath>Things/Plant/Tree_Leafless</leaflessGraphicPath>
			<interferesWithRoof>true</interferesWithRoof>
		</plant>
		<selectable>true</selectable>
	</ThingDef>
  <ThingDef Abstract="True" Name="RKFC_WallLightBase" ParentName="LampBase">
		<researchPrerequisites Inherit="False"/>
		<minifiedDef>MinifiedThing</minifiedDef>
		<designationCategory>Furniture</designationCategory>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>Standable</passability>
		<terrainAffordanceNeeded IsNull="True"/>
		<pathCost>0</pathCost>
		<statBases>
			<MaxHitPoints>45</MaxHitPoints>
			<WorkToBuild>100</WorkToBuild>
			<Flammability>0.0</Flammability>
			<Mass>2</Mass>
		</statBases>
		<costList>
			<Steel>20</Steel>
			<WoodLog>5</WoodLog>
		</costList>
		<placeWorkers Inherit="False">
			<li>Placeworker_AttachedToWall</li>
		</placeWorkers>
		<building>
			<isEdifice>false</isEdifice>
			<isAttachment>true</isAttachment>
		</building>
		<rotatable>true</rotatable>
		<overrideMinifiedRot>North</overrideMinifiedRot>
		<minifiedDrawOffset>(0, 0, 0.2)</minifiedDrawOffset>
		<uiIconPath>Things/Building/Furniture/GL_WallLit_menuicon</uiIconPath>
		<uiIconScale>1.5</uiIconScale>
	</ThingDef>
