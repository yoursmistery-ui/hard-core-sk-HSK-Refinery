			<li>Rustic_TallEndTable</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>SubCategory_RusticSeats</defName>
		<label>乡村椅凳</label>
		<description>原木与乡村式样的座椅条凳: 长凳、圆凳与餐椅。</description>
		<defNames>
			<li>Rustic_LogChair</li>
			<li>Rustic_LogBench1x2c</li>
			<li>Rustic_LogBench1x3c</li>
			<li>Rustic_LogBench1x4c</li>
			<li>Rustic_RoundStool</li>
			<li>Rustic_DiningChair</li>
		</defNames>
		<designationCategory>Furniture</designationCategory>
		<debug>false</debug>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>SubCategory_RusticBeds</defName>
		<label>乡村床铺</label>
		<description>稻草、原木、柳条与毛皮床, 含单人/双人两型。</description>
		<defNames>
			<li>Rustic_StrawBed</li>
			<li>Rustic_StrawBedDouble</li>
			<li>Rustic_BedLog</li>
			<li>Rustic_BedLogDouble</li>
