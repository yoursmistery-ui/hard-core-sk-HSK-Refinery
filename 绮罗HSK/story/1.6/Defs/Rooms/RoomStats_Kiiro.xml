<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <StatDef>
    <defName>Kiiro_MerchantCapacity</defName>
    <label>Inventory Scale</label>
    <description>Inventory capacity of the merchant.</description>
    <category>BasicsNonPawn</category>
    <defaultBaseValue>0</defaultBaseValue>
    <maxValue>1000</maxValue>
    <minValue>0</minValue>
    <hideAtValue>0</hideAtValue>
    <toStringStyle>FloatOne</toStringStyle>
    <applyFactorsIfNegative>false</applyFactorsIfNegative>
    <displayPriorityInCategory>3000</displayPriorityInCategory>
    <parts>
      <li Class="StatPart_Quality">
        <factorAwful>0.4</factorAwful>
        <factorPoor>0.7</factorPoor>
        <factorNormal>1</factorNormal>
        <factorGood>1.2</factorGood>
        <factorExcellent>1.5</factorExcellent>
        <factorMasterwork>2.0</factorMasterwork>
        <factorLegendary>2.8</factorLegendary>
      </li>
    </parts>
  </StatDef>

  <RoomStatDef>
    <defName>Kiiro_MerchantCapacity_Room</defName>
    <label>merchant capacity</label>
    <workerClass>Kiiro_Event.RoomStatWorker_MerchantCapacity</workerClass>
    <updatePriority>2</updatePriority>
    <roomlessScore>0</roomlessScore>
    <isHidden>true</isHidden>
    <scoreStages>
      <li>
        <label>nothing</label>
      </li>
      <li>
        <minScore>20</minScore>
        <label>bare-bones</label>
      </li>
      <li>
        <minScore>60</minScore>
        <label>modest</label>
      </li>
      <li>
        <minScore>120</minScore>
        <label>established</label>
      </li>
      <li>
        <minScore>220</minScore>
        <label>diverse</label>
      </li>
      <li>
        <minScore>400</minScore>
        <label>well-stocked</label>
      </li>
      <li>
        <minScore>600</minScore>
        <label>abundant</label>
      </li>
    </scoreStages>
  </RoomStatDef>

</Defs>
