<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_YE_InfantryUniform</defName>
        <label>Yaezakura Infantry Uniform</label>
        <description>After the war with the Snow Lotus Tsardom, the uniform was reformed into a dark khaki design to reduce visibility.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_YE_InfantryUniform/RK_YE_InfantryUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>10000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.31</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_YE</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <MoveSpeed>0.1</MoveSpeed>
            <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
            <MeleeDodgeChance>0.05</MeleeDodgeChance>
        </equippedStatOffsets>
        <costStuffCount>75</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>RK_Noble</li>
            </defaultOutfitTags>
            <wornGraphicPath>Things/Item/Apparel/RK_YE_InfantryUniform/RK_YE_InfantryUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>RK_YE_Officer</li>
                <li>RK_YE_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
    <ThingDef ParentName="RK_HatMakeableBase">
        <defName>RK_YE_ServiceCap</defName>
        <label>Yaezakura Service Cap</label>
        <description>Following uniform reforms, the Yaezakura military replaced the old flat-topped shako with a peaked service cap to better suit the modern battlefield.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_YE_ServiceCap/RK_YE_ServiceCap</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>5000</WorkToMake>
            <StuffEffectMultiplierArmor>0.17</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
            <Mass>0.15</Mass>
            <EquipDelay>0.75</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <equippedStatOffsets>
            <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
            <SocialImpact>0.15</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>UpperHead</li>
                <li>Eyes</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_YE_ServiceCap/RK_YE_ServiceCap</wornGraphicPath>
            <tags>
                <li>RK_YE_Officer</li>
                <li>RK_YE_Soldier</li>
            </tags>
            <layers>
                <li>Overhead</li>
            </layers>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>RK_YE</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
    </ThingDef>
</Defs>