				<Ratkin_Waster>1</Ratkin_Waster>
			</xenotypeChances>
		</xenotypeSet>
		<basicMemberKind>RatkinWaster</basicMemberKind>
		<allowedCultures Inherit="False">
			<li>RatkiniaWasterCulture</li>
		</allowedCultures>
