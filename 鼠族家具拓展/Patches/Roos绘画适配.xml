	<!-- 2b. 基类显式置空 designationCategory:
	     子类字面的 Accessories 移除后, 继承链上层 RKFC_FurnitureBase 的 Furniture 会冒出来
	     (Unified.xml 实测: 移除后画仍显示 designationCategory=Furniture, 仍可建造)。
	     在抽象基类(用 @Name, 非 defName)上 Add IsNull 覆盖, 8 幅画继承后不可直接建造。 -->
	<Operation Class="PatchOperationAdd" MayRequire="Rooboid.Paintings.Ex">
		<xpath>Defs/ThingDef[@Name="RKFC_RL_PaintBase"]</xpath>
		<value>
			<designationCategory IsNull="True"/>
		</value>
	</Operation>

	<!-- ========== 3. 观赏适配: 8 幅画加入 Roos InterpretArt JoyGiver ========== -->
	<Operation Class="PatchOperationAdd" MayRequire="Rooboid.Paintings.Ex">
		<xpath>Defs/JoyGiverDef[defName="InterpretArt"]/thingDefs</xpath>
		<value>
