    <!-- ───────── 来源: 58_液压钳冶炼适配.xml ───────── -->
<!-- 58_液压钳冶炼适配(2026-08-13 用户反馈「Simple Sidearms + STL 下做电解精炼不自动换液压钳」):
         原因排查(反编译 STL 核实): STL 的自动换工具(RightToolForJob.EquipTool,
         CE 环境走 recipe.workSpeedStat 路径)只从殖民者携带的工具里挑
         SurvivalToolProperties.baseWorkStatFactors 包含「当前工作对应属性」的工具,
         取该属性值最高者换上。电解精炼/熔炼配方 workSpeedStat=SmeltingSpeed(冶炼速度),
         而 37 号给液压钳的 7 项加成是 锻造/建造/零部件制作/电子制造/武器制作/
         综合劳动/制作品质,没有 SmeltingSpeed → 液压钳永远不会被 STL 选中,
         这不是 Simple Sidearms 拦截(SS 只管战斗副武器;其自动工具机制只覆盖
         Fieldwork/MiscWork 工作,不覆盖熔炼)。会正常换上的是带冶炼速度的工具:
         鼠族锤子 1.3 / 大锤 1.3 / 电焊枪 1.2 / 钉头锤 1.2 / 手锤 1.2 / 扳手 1.2 /
         多功能工具 1.2。
         本补丁给液压钳补 SmeltingSpeed 1.2(与其他熔炼工具同档;若殖民者同时携带
         锤子 1.3 与液压钳 1.2,STL 仍选更高的锤子),做电解精炼/熔炼时自动换上液压钳,
         与其他设施(采矿→矿镐、建造→锤子)行为一致。
         写法: PatchOperationConditional + nomatch Add(已存在则不重复添加),
         MayRequire=skyarkhangel.SurvivalToolsLite 门控(未装 STL 时跳过,零风险)。
         SmeltingSpeed 的 StatPart_SurvivalTool 由 48 号挂载(noToolStatFactor=1),
         装备即生效。最终层补丁(58),后于 37/48/56 号加载。 -->
    <Operation Class="PatchOperationConditional" MayRequire="skyarkhangel.SurvivalToolsLite">
        <xpath>Defs/ThingDef[defName="RK_HydraulicPliers"]/modExtensions/li[@Class="SurvivalToolsLite.SurvivalToolProperties"]/baseWorkStatFactors/SmeltingSpeed</xpath>
        <nomatch Class="PatchOperationAdd" MayRequire="skyarkhangel.SurvivalToolsLite">
            <xpath>Defs/ThingDef[defName="RK_HydraulicPliers"]/modExtensions/li[@Class="SurvivalToolsLite.SurvivalToolProperties"]/baseWorkStatFactors</xpath>
            <value>
                <SmeltingSpeed>1.2</SmeltingSpeed>
            </value>
        </nomatch>
    </Operation>
    <!-- ───────── 来源: 59_工具CE单手武器.xml ───────── -->
<!-- 59_工具CE单手武器(2026-08-13 用户要求):
         让所有 SurvivalToolsLite 工具在 Combat Extended 中都能与盾牌共存,
         同时保持工具本质不变(不改成普通武器)。

         CE 的 StatWorker_OneHandedness / CE_Utility.IsTwoHandedWeapon
         只检查 ThingDef.weaponTags 是否包含 CE_OneHandedWeapon;
         加这个 tag 后,这些工具会被 CE 判定为单手武器,可和盾牌同时装备。

         依据游戏最终导出 Unified.xml 扫描:
         全部 28 件 thingClass=SurvivalToolsLite.SurvivalTool 中,
         已有 18 件自带 CE_OneHandedWeapon(鼠族匕首/钉头锤/锤子、
         Core_SK 基本工具、生存小刀/骨锯/扳手/剁肉刀等)。
         下面 10 件仍缺该 tag,统一补上;其余不重复添加,避免重复 li。
         仅当 CE 与 SurvivalToolsLite 同时加载时应用(保持“工具本质”的前提)。
    -->

    <Operation Class="PatchOperationAdd" MayRequire="CETeam.CombatExtended,skyarkhangel.SurvivalToolsLite">
        <xpath>
            Defs/ThingDef[
                defName="RK_Axe"
                or defName="RK_Cleaver"
                or defName="RK_Hockey"
                or defName="RK_Fork"
                or defName="RK_Pickaxe"
                or defName="RK_Scissors"
                or defName="RK_ImpactDrill"
                or defName="RK_HydraulicPliers"
                or defName="RK_WeldingTorch"
                or defName="MeleeWeapon_Sledgehammer"
            ]/weaponTags
        </xpath>
        <value>
            <li>CE_OneHandedWeapon</li>
        </value>
    </Operation>
    <!-- ───────── 来源: 61_工具单手武器.xml ───────── -->
<!-- 61_工具单手武器(2026-08-13 用户要求「把所有的工具改为单手武器,全部」):
	     59 号只补了 CE 的 CE_OneHandedWeapon 标签(CE 与盾牌共存),但鼠族本体的握持系统
	     NewRatkin.CompProperties_WeaponGripType 仍把斧头 RK_Axe / 锄头 RK_Hockey / 矿镐 RK_Pickaxe
	     标为 TwoHand(双手),导致它们不能与鼠族盾牌(重盾/木盾/能量力盾等,allowedGripTypes=OneHand/Special)共存。
	     本补丁:
	     1) 把这三件的握持类型 TwoHand → OneHand;
	     2) 把它们的 weaponTags 由 RK_WeaponTag_TwoHand* → RK_WeaponTag_OneHand*;
	     3) 给原本无握持 comp 的匕首 RK_Dagger / 草叉 RK_Fork 补上 OneHand 握持(其余工具
	        RK_Cleaver/RK_Mace/RK_Weapon_Maul 已是 OneHand,4 件新工具由 Defs 直接补齐)。
	     本补丁不依赖 CE/STL(握持系统来自 NewRatkin.dll,始终存在),故不加 MayRequire。-->

	<!-- ===================== 斧头 / 锄头 / 矿镐: TwoHand → OneHand ===================== -->

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Axe" or defName="RK_Hockey" or defName="RK_Pickaxe"]/comps/li[@Class="NewRatkin.CompProperties_WeaponGripType"]/gripTypes/li[normalize-space(.)="TwoHand"]</xpath>
		<value>
			<li>OneHand</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Axe" or defName="RK_Hockey" or defName="RK_Pickaxe"]/weaponTags/li[normalize-space(.)="RK_WeaponTag_TwoHand"]</xpath>
		<value>
			<li>RK_WeaponTag_OneHand</li>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="RK_Axe" or defName="RK_Hockey" or defName="RK_Pickaxe"]/weaponTags/li[normalize-space(.)="RK_WeaponTag_TwoHandMelee"]</xpath>
		<value>
			<li>RK_WeaponTag_OneHandMelee</li>
		</value>
	</Operation>

	<!-- ===================== 匕首: 补 OneHand 握持(HSK_Generated 已显式设置 comps) ===================== -->

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="RK_Dagger"]/comps</xpath>
		<value>
			<li Class="NewRatkin.CompProperties_WeaponGripType">
				<gripTypes>
					<li>OneHand</li>
				</gripTypes>
			</li>
		</value>
	</Operation>

	<!-- ===================== 草叉: 补 OneHand 握持(HSK_Generated 已删除其 comps,需条件补) ===================== -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="RK_Fork"]/comps</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RK_Fork"]/comps</xpath>
			<value>
				<li Class="NewRatkin.CompProperties_WeaponGripType">
					<gripTypes>
						<li>OneHand</li>
					</gripTypes>
				</li>
			</value>
		</match>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="RK_Fork"]</xpath>
			<value>
				<comps>
					<li Class="NewRatkin.CompProperties_WeaponGripType">
						<gripTypes>
							<li>OneHand</li>
						</gripTypes>
					</li>
				</comps>
			</value>
		</nomatch>
	</Operation>
