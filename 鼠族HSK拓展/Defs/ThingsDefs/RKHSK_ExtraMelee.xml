<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- ============ HSK 整合: Ratkin Weapons+ 细剑 (单手武器) ============ -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>RKHSK_Rapier</defName>
