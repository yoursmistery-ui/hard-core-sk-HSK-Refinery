<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- =====================================================================
        金鼠族 HSK 版本 · 01_科技树挂钩
        目标: ①修复鼠族科技断链(衣物 II→III、盔甲 I/II→III 串联);
              ②金鼠族 25 个研究节点按功能分区智能归位到对应科研 tab
                (工业→Buildings_SK / 食物→Food_SK / 植物→Plants_SK /
                 医疗→Medicine_SK / 武器→Weapon_SK / 服饰→Apparel_SK),
                不再团成一团,且全部坐标经核对无冲突;
              ③逐节点挂靠鼠族科技,形成「鼠族科技→金鼠族科技」一环套一环的完整链。
        说明: 本文件中的电力科技节点(OA_RK_Electrical_System / _B / _C)补丁
              仅在未安装「边缘核能」时生效(回退路径)。安装边缘核能时,
              05_边缘核能整合.xml 会移除这些节点并整合进 Rimatomics 科研体系。
        加载顺序: 本补丁位于 鼠族HSK拓展(32/52 号)之后,Replace/Add 生效。
        ===================================================================== -->

    <!-- ========== ① 修复鼠族科技断链 ========== -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="Ratkin_Apparel_C1"]/prerequisites</xpath>
        <value>
            <prerequisites>
                <li>Fabrication</li>
                <li>Ratkin_Apparel_B2A</li>
            </prerequisites>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="Ratkin_Armor_D1"]/prerequisites</xpath>
        <value>
            <prerequisites>
                <li>Apparel_D1</li>
                <li>Ratkin_Armor_B2</li>
            </prerequisites>
        </value>
    </Operation>

    <!-- ========== ② 金鼠族研究: tab 迁移(按功能分区) ========== -->
    <!-- 植物区 Plants_SK -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="OA_RK_Oberonia_Aurea_Research"]/tab</xpath>
        <value><tab>Plants_SK</tab></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ResearchProjectDef[defName="OA_RK_Constant_Temperature_Hydroponics_B"]/tab</xpath>
