<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!--2-tier bookcase-->
	<ThingDef ParentName="BookcaseBase">
		<defName>sbz_TwoTierBookcase</defName>
		<label>2-tier bookcase</label>
		<description>A two-tier bookcase for storing and displaying up to twenty-four books. Books stored here will passively enhance academic work done nearby, and increase the beauty of the bookcase. The stored books will never deteriorate.</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcase</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawOffset>(0, 0.08, 0)</drawOffset>
		</graphicData>
		<size>(2,1)</size>
		<uiIconPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcase_south</uiIconPath>
		<uiIconScale>1.6</uiIconScale>
		<uiIconOffset>(0, 0.1)</uiIconOffset>
		<costStuffCount>48</costStuffCount>
		<staticSunShadowHeight>0.4</staticSunShadowHeight>
		<statBases>
			<MaxHitPoints>240</MaxHitPoints>
			<Mass>16</Mass>
			<WorkToBuild>1200</WorkToBuild>
		</statBases>
		<building>
			<maxItemsInCell>12</maxItemsInCell>
		</building>
		<placeWorkers>
			<li>sbz.PlaceWorker_Bookcase</li>
		</placeWorkers>
		<modExtensions>
			<li Class="sbz.BookcaseModExtension">
				<north>
					<bookHide>true</bookHide>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcaseLayer_north</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 3.5, 0)</offset>
						</li>
					</layers>
				</north>
				<east>
					<bookHide>true</bookHide>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcaseLayer_east</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 3.5, 0)</offset>
						</li>
					</layers>
				</east>
				<south>
					<bookOffset>(-0.8, 0.1, -0.05)</bookOffset>
					<bookRotate>0</bookRotate>
					<bookSpacing>(0.147, 0, 0)</bookSpacing>
					<booksPerTier>12</booksPerTier>
					<tierOffset>(0, 1.6, 0.56)</tierOffset>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcaseLayer1_south</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 0.6, 0)</offset>
						</li>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcaseLayer2_south</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 3.5, 0)</offset>
						</li>
					</layers>
				</south>
				<west>
					<bookHide>true</bookHide>
					<layers>
						<li>
							<graphic>
								<texPath>Things/Building/Furniture/Bookcase/sbz_TwoTierBookcaseLayer_west</texPath>
								<graphicClass>Graphic_Single</graphicClass>
								<drawSize>(4,4)</drawSize>
							</graphic>
							<offset>(0, 3.5, 0)</offset>
						</li>
					</layers>				
				</west>
			</li>
		</modExtensions>
	</ThingDef>

