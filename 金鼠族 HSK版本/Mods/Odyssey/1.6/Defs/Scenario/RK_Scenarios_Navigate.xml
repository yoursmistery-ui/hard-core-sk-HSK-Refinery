<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ScenarioDef ParentName="ScenarioBase">
		<defName>OA_RK_Scenario_Navigate</defName>
		<label>Interrupted Voyage</label>
		<description>Every Navigation Department attendant possesses a heart yearning for free exploration, and some ambitious members, after acquiring sufficient skills and gathering suitable companions, leave the Department to purchase a small spacecraft with their pooled savings and explore freely.\n\nHowever, exploration is inevitably fraught with dangers, just like this time when they encountered a Mechanoid ship shortly after departure. Though the alarms never ceased, their exceptional piloting skills ultimately allowed the four to escape. Yet their ship's signal has been recorded - it's certain their future explorations will be accompanied by endless Mechanoid pursuit.\n\nShould they end it here, abandon the ship and return to the Iris Empire for protection? Or continue exploring, facing whatever risks may come?\n\nThis isn't really a choice.</description>
		<scenario>
			<summary>Perhaps they forgot to pray to the North Star before departure, but their good days ended before they even began.</summary>
			<playerFaction>
				<def>PlayerFaction</def>
				<factionDef>OA_RK_PlayerFaction_B</factionDef>
			</playerFaction>
			<parts Inherit="False">
				<li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
					<def>ConfigPage_ConfigureStartingPawns</def>
					<pawnChoiceCount>4</pawnChoiceCount>
					<pawnCount>4</pawnCount>
				</li>
				<li MayRequire="Ludeon.RimWorld.Biotech" Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
					<def>ConfigurePawnsXenotypes</def>
					<pawnChoiceCount>4</pawnChoiceCount>
					<xenotypeCounts>
						<li>
							<count>4</count>
							<requiredAtStart>True</requiredAtStart>
							<xenotype>Ratkin_OA</xenotype>
							<allowedDevelopmentalStages>Baby, Child, Adult</allowedDevelopmentalStages>
						</li>
					</xenotypeCounts>
				</li>
				<li Class="ScenPart_ForcedMap">
					<def>ForcedMap</def>
					<mapGenerator>OrbitalRelay</mapGenerator>
					<layerDef>Orbit</layerDef>
				</li>
				<li Class="ScenPart_PlanetLayer">
					<def>PlanetLayerFixed</def>
					<tag>Orbit</tag>
					<layer>Orbit</layer>
					<settingsDef>Orbit</settingsDef>
					<hide>true</hide>
					<connections>
						<Surface>
							<zoomMode>ZoomIn</zoomMode>
						</Surface>
					</connections>
				</li>
				<li Class="ScenPart_PlayerPawnsArriveMethod">
					<def>PlayerPawnsArriveMethod</def>
					<method>Gravship</method>
				</li>
				<li Class="ScenPart_PursuingMechanoids">
					<def>PursuingMechanoids</def>
				</li>
	
				<li Class="ScenPart_DisableQuest">
					<def>DisableQuest</def>
					<questDef>MechanoidSignal</questDef>
				</li>
				<li Class="ScenPart_StartingResearch">
					<def>StartingResearch</def>
					<project>BasicGravtech</project>
				</li>
				<li Class="ScenPart_StartingResearch">
					<def>StartingResearch</def>
					<project>BiofuelRefining</project>
				</li>
				<li Class="ScenPart_StartingThing_Defined">
