  <!-- EN: Jealously -->
  <VSIE_JealouslyMyPartnerDatedSomeoneElse.stages.Jealously.label>感情挫傷</VSIE_JealouslyMyPartnerDatedSomeoneElse.stages.Jealously.label>
  <!-- EN: I'm jealous. My {0} went on a date with someone else! -->
  <VSIE_JealouslyMyPartnerDatedSomeoneElse.stages.Jealously.description>我被綠了！我的{0}居然跑去和別人約會了！</VSIE_JealouslyMyPartnerDatedSomeoneElse.stages.Jealously.description>
  
  <!-- EN: sharing the burden -->
  <VSIE_SharingBurden.stages.sharing_the_burden.label>分擔壓力</VSIE_SharingBurden.stages.sharing_the_burden.label>
  <!-- EN: It felt good to finally unbottle my feelings to a friend. -->
  <VSIE_SharingBurden.stages.sharing_the_burden.description>向朋友傾訴一番過後，我的心情好了很多。</VSIE_SharingBurden.stages.sharing_the_burden.description>
  
  <!-- EN: Good reputation -->
  <VSIE_SocialEnvironment.stages.Good_reputation.label>美譽</VSIE_SocialEnvironment.stages.Good_reputation.label>
  <!-- EN: I am liked and respected here. These people need me. -->
  <VSIE_SocialEnvironment.stages.Good_reputation.description>我在這裡受到愛戴與尊重，這些人需要我！</VSIE_SocialEnvironment.stages.Good_reputation.description>
  <!-- EN: Bad reputation -->
  <VSIE_SocialEnvironment.stages.Bad_reputation.label>惡譽</VSIE_SocialEnvironment.stages.Bad_reputation.label>
  <!-- EN: I'm not having fun here. Nobody seems to respect me! -->
  <VSIE_SocialEnvironment.stages.Bad_reputation.description>我在這兒一點也不開心。似乎沒人尊重我！</VSIE_SocialEnvironment.stages.Bad_reputation.description>
  
  <!-- EN: my friend vented to me -->
  <VSIE_VentedOnMe.stages.my_friend_vented_to_me.label>被傾訴</VSIE_VentedOnMe.stages.my_friend_vented_to_me.label>
  <!-- EN: My friend unbottled their feelings to me. -->
  <VSIE_VentedOnMe.stages.my_friend_vented_to_me.description>我的朋友向我吐露了他們的真情。</VSIE_VentedOnMe.stages.my_friend_vented_to_me.description>
  
