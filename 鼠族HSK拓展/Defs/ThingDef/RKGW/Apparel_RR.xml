<?xml version='1.0' encoding='utf-8'?>
<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_RR_InfantryUniform</defName>
        <label>Red Rose Infantry Uniform</label>
        <description>A dark brown infantry uniform with red piping along the edges. Due to shortages of supplies, most soldiers wore sheepskin puttees instead of leather boots.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_RR_InfantryUniform/RK_RR_InfantryUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>9000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.31</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_RR</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <MoveSpeed>0.1</MoveSpeed>
            <ShootingAccuracyPawn>0.15</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costStuffCount>65</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_RR_InfantryUniform/RK_RR_InfantryUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>RK_RR_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
    <ThingDef ParentName="RK_HatMakeableBase">
        <defName>RK_RR_Furazhka</defName>
        <label>Red Rose Furazhka</label>
        <description>A Snowdrop-style visor cap worn by officers, infantry, and cavalry alike, which was gradually replaced in the later period by helmets supplied by the Kornblume Confederation.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_RR_Furazhka/RK_RR_Furazhka</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <costStuffCount>60</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>4000</WorkToMake>
            <StuffEffectMultiplierArmor>0.17</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
            <Mass>0.15</Mass>
            <EquipDelay>0.75</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <equippedStatOffsets>
            <ShootingAccuracyPawn>0.05</ShootingAccuracyPawn>
            <SocialImpact>0.1</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>UpperHead</li>
                <li>Eyes</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_RR_Furazhka/RK_RR_Furazhka</wornGraphicPath>
            <tags>
                <li>RK_RR_Officer</li>
                <li>RK_RR_Soldier</li>
                <li>RK_RR_Cavalry</li>
            </tags>
            <layers>
                <li>Overhead</li>
            </layers>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>RK_RR</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
    </ThingDef>
</Defs>