		<baseChance>2</baseChance>
		<thingDefs>
			<li>Rustic_CupAndDice</li>
		</thingDefs>
		<jobDef>Rustic_Play_CupAndDice</jobDef>
		<joyKind>Gaming_Cerebral</joyKind>
		<requiredCapacities>
			<li>Manipulation</li>
		</requiredCapacities>
	</JoyGiverDef>

	
<JoyGiverDef>
		<defName>Rustic_Play_Tarocco</defName>
		<giverClass>JoyGiver_InteractBuildingSitAdjacent</giverClass>
