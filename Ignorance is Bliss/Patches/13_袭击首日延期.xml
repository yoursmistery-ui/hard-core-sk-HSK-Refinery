<?xml version="1.0" encoding="utf-8"?>
<!-- [2026-09-09 迁移] 本文件由 HSK修复整合 整体迁入 Ignorance Is Bliss,HSK 侧已移除。 -->
<Patch>
  <!-- 袭击大敌最早出现日(2026-08-31 首设;2026-09-04 下调到 3~4 年档;2026-09-07 用户要求再降)。
       机制(2026-09-04 起): 机械体/虫族在 RaidHelperWealthTech.cs 里不再是"豁免科技档",
       而是吃"玩家科技档下限(Industrial)+财富(100 万)"双门槛;
       本文件控制其"最早袭击天数",与科技/财富门槛三条件并存:
         Mechanoid(原版,earliestRaidDays=45)→ 120(1.5 年)
         Insect(原版虫族基因系,FactionDef 无该字段,默认0)→ 补 160(2 年)
         Insectoid(Core_SK 虫巢,15)→ 160(2 年)
       天网(120 天/Spacer/200 万)与心灵飞船(120 天/Industrial)在 18_威胁事件年限提前.xml。 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="Mechanoid"]/earliestRaidDays</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/FactionDef[defName="Mechanoid"]/earliestRaidDays</xpath>
      <value>
        <earliestRaidDays>120</earliestRaidDays>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="Insect"]</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/FactionDef[defName="Insect"]</xpath>
      <value>
        <earliestRaidDays>160</earliestRaidDays>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/FactionDef[defName="Insectoid"]/earliestRaidDays</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/FactionDef[defName="Insectoid"]/earliestRaidDays</xpath>
      <value>
        <earliestRaidDays>160</earliestRaidDays>
      </value>
    </match>
  </Operation>
</Patch>
