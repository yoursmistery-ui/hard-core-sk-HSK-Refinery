							<li>Wort</li>
							<li>Hay</li>
							<li MayRequire="oskarpotocki.vanillafactionsexpanded.medievalmodule">VFEM_Must</li>
						</thingDefs>
					</filter>
				</defaultStorageSettings>
				<paintable>true</paintable>
			</building>
			<minifiedDef>MinifiedThing</minifiedDef>
			<thingCategories>
				<li>BuildingsFurniture</li>
			</thingCategories>
