<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <SeedsPlease.SeedDef ParentName="SeedBase">
    <defName>Miho_Seed_Posflower</defName>
    <label>helianto seeds</label>
    <sources>
      <li>Plant_PosFlower</li>
    </sources>
    <graphicData>
      <texPath>Things/Item/Seeds/PosFlower</texPath>
    </graphicData>
  </SeedsPlease.SeedDef>

  <RecipeDef ParentName="ExtractSeed">
    <defName>ExtractSeedPosFlower</defName>
    <label>extract helianto seeds</label>
    <description>extract seeds from helianto pellets</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>RawPosFlower</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>RawPosFlower</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Miho_Seed_Posflower>3</Miho_Seed_Posflower>
    </products>
  </RecipeDef>

  <SeedsPlease.SeedDef ParentName="SeedBase">
    <defName>Miho_Seed_Ebony_Silk</defName>
    <label>ebony mulberry seeds</label>
    <sources>
      <li>Plant_Ebony_Silk</li>
    </sources>
    <graphicData>
      <texPath>Things/Item/Seeds/EbonyMulberry</texPath>
    </graphicData>
  </SeedsPlease.SeedDef>

  <RecipeDef ParentName="ExtractSeed">
    <defName>ExtractSeedEbony_Silk</defName>
    <label>extract ebony mulberry seeds</label>
    <description>extract seeds from ebony mulberry</description>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Miho_Ebony_Mulberry</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Miho_Ebony_Mulberry</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Miho_Seed_Ebony_Silk>3</Miho_Seed_Ebony_Silk>
    </products>
  </RecipeDef>

</Defs>
