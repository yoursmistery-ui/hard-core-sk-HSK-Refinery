<?xml version='1.0' encoding='utf-8'?>
<Defs>
	<ThingDef ParentName="RK_IndustrialRangeWeapon">
		<defName>RK_MR_Eschscholzia</defName>
		<label>"Eschscholzia" Trench Gun</label>
		<description>Famously known as the "Trench Sweeper." Capable of rapid fire, it was devastating in trench warfare, to the point that the Kornblume Confederation lodged protests against its use.</description>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/RK_MR_Eschscholzia</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.9</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit="false">
			<li>RK_MR_Shotgun</li>
		</weaponTags>
		<statBases>
			<WorkToMake>12000</WorkToMake>
			<Mass>2</Mass>
			<Bulk>10</Bulk>
			<AccuracyTouch>0.78</AccuracyTouch>
			<AccuracyShort>0.85</AccuracyShort>
			<AccuracyMedium>0.70</AccuracyMedium>
			<AccuracyLong>0.60</AccuracyLong>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>55</Steel>
			<ComponentIndustrial>3</ComponentIndustrial>
			<WoodLog>25</WoodLog>
		</costList>
		<recipeMaker>
			<researchPrerequisite>RK_MR_Weapon</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<equippedAngleOffset>45</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Eschscholzia</defaultProjectile>
				<warmupTime>1.1</warmupTime>
				<range>16</range>
				<soundCast>RK_MR_Eschscholzia</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>10</muzzleFlashScale>
			</li>
		</verbs>
		<comps Inherit="False">
			<li Class="RatkinWeapons.CompProperties_Bayonet" MayRequire="bbb.ratkinweapon.morefailure">
				<cooldown>1800</cooldown>
				<radius>14.9</radius>
				<label>RK.BayonetLabel</label>
				<description>RK.BayonetDescription</description>
				<icon>UI/Abilities/RK_Bayonet</icon>
			</li>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
			<li Class="CompProperties_Forbiddable"/>
			<li Class="CompProperties_Styleable"/>
			<li>
				<compClass>CompQuality</compClass>
			</li>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponGun</nameMaker>
				<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
		</comps>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>2</cooldownTime>
				<armorPenetrationBlunt>3</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
			<li Class="CombatExtended.ToolCE">
				<label>bayonet</label>
				<capacities>
					<li>Cut</li>
					<li>Stab</li>
				</capacities>
				<power>17</power>
				<cooldownTime>2.3</cooldownTime>
				<armorPenetrationSharp>6</armorPenetrationSharp>
				<armorPenetrationBlunt>5</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
			</li>
		</tools>
	</ThingDef>
</Defs>
