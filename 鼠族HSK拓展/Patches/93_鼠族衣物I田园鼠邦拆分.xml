  <!-- RK_ExoticFarmerDress: 无物理 recipeMaker(继承 RK_Ruqun), Add 覆盖 -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="RK_ExoticFarmerDress"]</xpath>
