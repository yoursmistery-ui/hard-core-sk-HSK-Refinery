	<GeneDef>
		<defName>Ratkin_WaterproofFur</defName>
		<label>waterproof fur</label>
		<description>Carriers of this gene have waterproof fur. They won't be unhappy just because they get soaked through.</description>
		<iconPath>UI/Icons/Genes/WaterproofFur</iconPath>
		<biostatCpx>1</biostatCpx>
		<biostatMet>0</biostatMet>
	</GeneDef>

	<GeneDef>
		<defName>Ratkin_CarefullyShoot</defName>
		<displayCategory>Violence</displayCategory>
		<exclusionTags>
			<li>RKGE_GeneAimingTimeBase</li>
		</exclusionTags>
		<biostatCpx>1</biostatCpx>
		<biostatMet>0</biostatMet>
		<iconColor>(1, 1, 1)</iconColor>
		<displayOrderInCategory>134</displayOrderInCategory>
		<forcedTraits>
			<li>
				<def>ShootingAccuracy</def>
				<degree>1</degree>
			</li>
		</forcedTraits>
		<label>careful shooter</label>
		<description>Carriers of this gene take their time to aim carefully before shooting, which significantly improve the shooting accuracy but also increases the time needed for aiming.</description>
		<iconPath>UI/Icons/Genes/CarefullyAiming</iconPath>
	</GeneDef>

  <GeneDef ParentName="GenePainBase">
    <defName>Ratkin_Hyperactivity</defName>
    <label>hyperactivity</label>
    <labelShortAdj>hyperactivity</labelShortAdj>
    <description>Carriers of this gene tend to be very active and are prone to getting tired of their work.</description>
    <iconPath>UI/Icons/Genes/Squirrel_Hyperactivity</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>
		<statFactors>
			<ResearchSpeedFactor>0.8</ResearchSpeedFactor>
			<JoyFallRateFactor>1.15</JoyFallRateFactor>
		</statFactors>
		<statOffsets>
			<GeneralLaborSpeed>-0.2</GeneralLaborSpeed>
      <MoveSpeed>0.1</MoveSpeed>
		</statOffsets>
    <biostatMet>1</biostatMet>
  </GeneDef>

	<GeneDef>
		<defName>Ratkin_FastTalking</defName>
		<biostatCpx>1</biostatCpx>
		<biostatMet>1</biostatMet>
		<iconColor>(1, 1, 1)</iconColor>
		<displayCategory>RatkinGene</displayCategory>
		<displayOrderInCategory>33</displayOrderInCategory>
		<label>Fast Talking</label>
		<description>Carriers of this gene tend to speak too fast, which can cause some degree of communication difficulties.</description>
		<iconPath>UI/Icons/Genes/Squirrel_Fasttalking</iconPath>    
		<aptitudes>
      <Social>-4</Social>
    </aptitudes>
    <statOffsets>
      <SocialIdeoSpreadFrequencyFactor MayRequire="Ludeon.RimWorld.Ideology">2</SocialIdeoSpreadFrequencyFactor>
			<SocialImpact>-0.2</SocialImpact>
			<NegotiationAbility>0.03</NegotiationAbility>
		</statOffsets>
	</GeneDef>
</Defs>
