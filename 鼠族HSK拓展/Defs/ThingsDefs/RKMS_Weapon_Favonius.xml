<Defs>

	<!-- ==========================================================================
	     Knights of Favonius 西风骑士团 近战武器整合 (2026-08-26, 后工业档)
	     来源: Steam 创意工坊 3768887719 "Knights of Favonius - Weapon and Armour"
	     适配: 整合 5 把近战武器 (通用武器, 人类/鼠族均可使用)。
	     - 父类 BaseMeleeWeapon_Sharp_Quality (同本mod其它近战武器)
	     - recipeMaker Inherit=False IsNull=True 关闭自动配方(参照 12 号补丁铁律)
     - 全部武器 CE 适配 (CombatExtended.ToolCE + Bulk + weaponTags)
	     - 全部武器带 SYS.CompProperties_WeaponExtention 位置偏移(鼠族手持适配)
	     - 贴图统一放 Textures/Weapon/Favonius/ (体型缩放 patch 按此前缀定位)
	     - 研究: RKHSK_FavoniusArmory (Weapon_SK tab, 后工业档, 前置 Melee_C2)
	     ========================================================================== -->

	<!-- ============ Favonius basic sword 西风基础剑 (单手) ============ -->
	<ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
		<defName>RKHSK_Favonius_Sword</defName>
		<label>西风基础剑</label>
		<description>西风骑士团新兵配发的制式长剑。朴素可靠, 适合斩除魔物, 守护蒙德的市民。</description>
		<possessionCount>1</possessionCount>
		<graphicData>
			<texPath>Weapon/Favonius/KOFS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<techLevel>Industrial</techLevel>
		<costStuffCount>50</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<costList>
			<ComponentIndustrial>4</ComponentIndustrial>
			<SyntheticFibers>15</SyntheticFibers>
		</costList>
		<weaponTags Inherit="false">
			<li>MedievalMeleeAdvanced</li>
			<li>CE_OneHandedWeapon</li>
			<li>RK_WeaponTag_OneHand</li>
			<li>RK_WeaponTag_OneHandMelee</li>
		</weaponTags>
		<statBases>
			<WorkToMake>10000</WorkToMake>
			<Mass>1.6</Mass>
			<Bulk>4</Bulk>
			<MeleeCounterParryBonus>0.4</MeleeCounterParryBonus>
		</statBases>
		<equippedStatOffsets>
			<MeleeHitChance>2</MeleeHitChance>
			<MeleeCritChance>0.25</MeleeCritChance>
			<MeleeParryChance>0.2</MeleeParryChance>
			<Suppressability>-0.2</Suppressability>
		</equippedStatOffsets>
		<equippedAngleOffset>-65</equippedAngleOffset>
