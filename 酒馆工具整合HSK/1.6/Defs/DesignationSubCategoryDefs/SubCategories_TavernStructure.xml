<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- 酒馆结构二级菜单(ArchitectSense 子分类,参照鼠族家具 SubCategories_RatkinStructure.xml 写法)。
	     已并入 HSK 标准分类:结构(Structure)。
	     柱子与门分别建子分类:酒馆柱子(Columns)、酒馆门(Doors)。 -->

	<!-- ===== 结构 Structure ===== -->

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Columns</defName>
		<label>酒馆柱子</label>
		<description>木质、石质与工业酒馆柱子。</description>
		<defNames>
			<li>SD_WoodColumn</li>
			<li>SD_StoneColumn</li>
			<li>SD_IndustrialColumn</li>
		</defNames>
		<designationCategory>Structure</designationCategory>
		<debug>false</debug>
		<order>10</order>
		<types>
			<li>Rooms</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

	<ArchitectSense.DesignationSubCategoryDef>
		<defName>Tav_SubCategory_Doors</defName>
		<label>酒馆门</label>
		<description>木质、石质与工业酒馆门,规格 1x1、1x2 与 1x3。</description>
		<defNames>
			<li>SD_1x1WoodDoor</li>
			<li>SD_2x1WoodDoor</li>
			<li>SD_3x1WoodDoor</li>
			<li>SD_1x1StoneDoor</li>
			<li>SD_2x1StoneDoor</li>
			<li>SD_3x1StoneDoor</li>
			<li>SD_1x1IndustrialDoor</li>
			<li>SD_2x1IndustrialDoor</li>
			<li>SD_3x1IndustrialDoor</li>
		</defNames>
		<designationCategory>Structure</designationCategory>
		<debug>false</debug>
		<order>20</order>
		<types>
			<li>Rooms</li>
		</types>
	</ArchitectSense.DesignationSubCategoryDef>

</Defs>
