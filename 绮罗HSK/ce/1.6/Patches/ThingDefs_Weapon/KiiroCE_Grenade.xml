<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 手榴弹基本设置  -->
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag" or defName="Kiiro_GrenadeSmoke" or defName="Kiiro_GrenadeFlash"]</xpath>
		<attribute>ParentName</attribute>
		<value>BaseWeapon</value>
	</Operation>
	
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag" or defName="Kiiro_GrenadeSmoke" or defName="Kiiro_GrenadeFlash"]/recipeMaker</xpath>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag" or defName="Kiiro_GrenadeSmoke" or defName="Kiiro_GrenadeFlash"]</xpath>
		<value>
			<thingCategories>
			  <li>Grenades</li>
			</thingCategories>
		</value>
	</Operation>
	
	<!-- 手榴弹近战  -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag" or defName="Kiiro_GrenadeSmoke" or defName="Kiiro_GrenadeFlash"]</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>Body</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>3</power>
					<cooldownTime>1.5</cooldownTime>
					<armorPenetrationBlunt>2</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Base</linkedBodyPartsGroup>
				</li>
			</tools>
			<tradeTags Inherit="False">
				<li>CE_MediumAmmo</li>
			</tradeTags>
			<allowedArchonexusCount>5</allowedArchonexusCount>
		</value>
	</Operation>
	
	<!-- 绮罗木柄手榴弹 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag"]</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<stackLimit>75</stackLimit>
			<resourceReadoutPriority>First</resourceReadoutPriority>
			<techLevel>Industrial</techLevel>
		</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag"]/comps</xpath>
		<value>
			<comps>
				<li Class="CombatExtended.CompProperties_ExplosiveCE">
					<damageAmountBase>48</damageAmountBase>
					<explosiveDamageType>Bomb</explosiveDamageType>
					<explosiveRadius>2</explosiveRadius>
				</li>
			</comps>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFrag"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Small>40</Fragment_Small>
				</fragments>
			</li>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Kiiro_GrenadeFrag</defName>
		<statBases>
			<Bulk>0.95</Bulk>
			<MarketValue>11</MarketValue>
			<RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
		</statBases>
		<Properties>
			<label>throw Kiiro grenade</label>
			<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<range>20</range>
			<minRange>4</minRange>
			<warmupTime>1.2</warmupTime>
			<noiseRadius>2</noiseRadius>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<soundCast>ThrowGrenade</soundCast>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
			<defaultProjectile>KiiroProjectile_GrenadeFrag</defaultProjectile>
			<onlyManualCast>true</onlyManualCast>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			<ai_AvoidFriendlyFireRadius>7</ai_AvoidFriendlyFireRadius>
		</Properties>
		<weaponTags>
			<li>Kiiro_GrenadeFrag</li>
			<li>CE_AI_Grenade</li>
			<li>CE_AI_AOE</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
	</Operation>
	
	<!-- 木柄手榴弹投射物 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFrag"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFrag"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<explosionRadius>2</explosionRadius>
				<damageDef>Bomb</damageDef>
				<damageAmountBase>48</damageAmountBase>
				<explosionDelay>35</explosionDelay>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
				<speed>21</speed>
				<suppressionFactor>3.0</suppressionFactor>
				<dangerFactor>2.0</dangerFactor>
				<airborneSuppressionFactor>0.25</airborneSuppressionFactor>
				<arcHeightFactor>2</arcHeightFactor>
				<shadowSize>0.4</shadowSize>
			</projectile>
		</value>
	</Operation>
	
	<!-- 添加comps并增加破片效果 -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFrag"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFrag"]</xpath>
			<value>
				<comps />
			</value>
		</nomatch>
	</Operation>
	
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFrag"]/comps</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Small>40</Fragment_Small>
				</fragments>
			</li>
		</value>
	</Operation>
	
	<!-- 绮罗烟雾手榴弹 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeSmoke"]</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<stackLimit>75</stackLimit>
			<resourceReadoutPriority>First</resourceReadoutPriority>
			<techLevel>Industrial</techLevel>
		</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeSmoke"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeSmoke"]/comps</xpath>
		<value>
			<comps>
				<li Class="CombatExtended.CompProperties_ExplosiveCE">
					<damageAmountBase>4</damageAmountBase>
					<explosiveDamageType>Smoke</explosiveDamageType>
					<postExplosionGasType>BlindSmoke</postExplosionGasType>
					<preExplosionSpawnChance>1</preExplosionSpawnChance>
				</li>
			</comps>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Kiiro_GrenadeSmoke</defName>
		<statBases>
			<Bulk>0.95</Bulk>
			<MarketValue>10.6</MarketValue>
			<RangedWeapon_Cooldown>2.8</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
		</statBases>
		<Properties>
			<label>throw Kiiro grenade</label>
			<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<range>14</range>
			<warmupTime>1.6</warmupTime>
			<noiseRadius>2</noiseRadius>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<soundCast>ThrowGrenade</soundCast>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
			<defaultProjectile>KiiroProjectile_GrenadeSmoke</defaultProjectile>
			<onlyManualCast>true</onlyManualCast>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			<ai_AvoidFriendlyFireRadius>7</ai_AvoidFriendlyFireRadius>
		</Properties>
		<weaponTags>
			<li>Kiiro_GrenadeSmoke</li>
			<li>CE_AI_SMOKE</li>
			<li>GrenadeSmoke</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
	</Operation>
	
	<!-- 绮罗烟雾投射物 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeSmoke"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeSmoke"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<explosionRadius>5</explosionRadius>
				<damageDef>Smoke</damageDef>
				<suppressionFactor>0.0</suppressionFactor>
				<dangerFactor>0.0</dangerFactor>
				<explosionDelay>30</explosionDelay>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<postExplosionGasType>BlindSmoke</postExplosionGasType>
				<preExplosionSpawnChance>1</preExplosionSpawnChance>
				<screenShakeFactor>0</screenShakeFactor>
				<speed>21</speed>
				<arcHeightFactor>2</arcHeightFactor>
				<shadowSize>0.4</shadowSize>
				<ai_IsIncendiary>true</ai_IsIncendiary>
			</projectile>
		</value>
	</Operation>
	<!-- 添加comps -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeSmoke"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeSmoke"]</xpath>
			<value>
				<comps />
			</value>
		</nomatch>
	</Operation>
	
	<!-- 绮罗闪光手榴弹 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFlash"]</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<stackLimit>75</stackLimit>
			<resourceReadoutPriority>First</resourceReadoutPriority>
		</value>
	</Operation>
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFlash"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Kiiro_GrenadeFlash"]/comps</xpath>
		<value>
			<comps>
				<li Class="CompProperties_Explosive">
					<explosiveRadius>5</explosiveRadius>
					<explosiveDamageType>Stun</explosiveDamageType>
					<requiredDamageTypeToExplode>Flame</requiredDamageTypeToExplode>
				</li>
			</comps>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Kiiro_GrenadeFlash</defName>
		<statBases>
			<Bulk>0.95</Bulk>
			<MarketValue>10.6</MarketValue>
			<RangedWeapon_Cooldown>5.8</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
		</statBases>
		<Properties>
			<label>throw Kiiro grenade</label>
			<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<range>14</range>
			<warmupTime>2.5</warmupTime>
			<noiseRadius>2</noiseRadius>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<soundCast>ThrowGrenade</soundCast>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
			<defaultProjectile>KiiroProjectile_GrenadeFlash</defaultProjectile>
			<onlyManualCast>true</onlyManualCast>
			<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>
			<ai_AvoidFriendlyFireRadius>7</ai_AvoidFriendlyFireRadius>
		</Properties>
		<weaponTags>
			<li>CE_AI_AOE</li>
			<li>CE_GrenadeFlashbang</li>
			<li>CE_OneHandedWeapon</li>
		</weaponTags>
	</Operation>
	
	<!-- 绮罗闪光投射物 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFlash"]</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFlash"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<speed>21</speed>
				<arcHeightFactor>2</arcHeightFactor>
				<shadowSize>0.4</shadowSize>
				<explosionRadius>5</explosionRadius>
				<damageDef>Stun</damageDef>
				<damageAmountBase>75</damageAmountBase>
				<stoppingPower>1.2</stoppingPower>
				<explosionDelay>30</explosionDelay>
				<soundExplode>Explosion_Stun</soundExplode>
				<dropsCasings>true</dropsCasings>
				<casingMoteDefname>Fleck_GrenadePin</casingMoteDefname>
				<screenShakeFactor>0</screenShakeFactor>
				<suppressionFactor>2.0</suppressionFactor>
				<dangerFactor>1.5</dangerFactor>
				<airborneSuppressionFactor>0.25</airborneSuppressionFactor>
			</projectile>
		</value>
	</Operation>
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFlash"]/comps</xpath>
		<nomatch Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="KiiroProjectile_GrenadeFlash"]</xpath>
			<value>
				<comps />
			</value>
		</nomatch>
	</Operation>
</Patch>