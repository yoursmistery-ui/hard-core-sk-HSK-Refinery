  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]/thingCategories</xpath>
