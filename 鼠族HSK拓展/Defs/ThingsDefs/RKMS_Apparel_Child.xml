<?xml version="1.0" encoding="utf-8"?>
<Defs>


	<ThingDef ParentName="RKGE_ChildApparelMakeableBase">
		<defName>RK_DuDouChild</defName>
		<label>ratkin child bellyband</label>
		<description>This dress is very refreshing for children to wear in summer.</description>
		<graphicData>
			<texPath>Item_Apparel/RK_DuDouChild</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>4000</WorkToMake>
			<Mass>0.3</Mass>
			<StuffEffectMultiplierArmor>0.25</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>3</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1.5</EquipDelay>
		</statBases>
		<costStuffCount>30</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Worker</li>
			</defaultOutfitTags>
			<wornGraphicPath>Item_Apparel/RK_DuDouChild</wornGraphicPath>
			<layers>
				<li>OnSkin</li>
				<li>Middle</li>
			</layers>
			<tags>
				<li>RK_ExoticWorker</li>
				<li>RK_ExoticFarmer</li>
				<li>RK_ExoticTier1</li>
				<li>RK_ExoticTier2</li>
				<li>RK_ExoticTier3</li>
				<li>RK_ExoticChild</li>

				<li>RoyalTier2</li>
				<li>RoyalTier5</li>
			</tags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<developmentalStageFilter>Child</developmentalStageFilter>
		</apparel>
	
		<recipeMaker>
			<researchPrerequisite>Ratkin_Apparel_B1</researchPrerequisite>
		</recipeMaker>
		<costList>
				<ComponentMedieval>2</ComponentMedieval>
		</costList></ThingDef>


