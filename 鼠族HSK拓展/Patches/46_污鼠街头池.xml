<?xml version="1.0" encoding="utf-8"?>
<!-- 46_污鼠街头池.xml | 给污鼠 RK_JiraiApparel 街头池补 generateCommonality 权重(常见1.3/标准1.15/次要0.8/稀有0.6) | 生成器 _tmp,勿手改 -->
<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RK_GangShirt"]/generateCommonality</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="RK_GangShirt"]/generateCommonality</xpath><value><generateCommonality>1.3</generateCommonality></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="RK_GangShirt"]</xpath><value><generateCommonality>1.3</generateCommonality></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RK_Hoodie"]/generateCommonality</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="RK_Hoodie"]/generateCommonality</xpath><value><generateCommonality>1.15</generateCommonality></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="RK_Hoodie"]</xpath><value><generateCommonality>1.15</generateCommonality></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RK_Jirai"]/generateCommonality</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="RK_Jirai"]/generateCommonality</xpath><value><generateCommonality>1.0</generateCommonality></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="RK_Jirai"]</xpath><value><generateCommonality>1.0</generateCommonality></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RK_BikerJacket"]/generateCommonality</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="RK_BikerJacket"]/generateCommonality</xpath><value><generateCommonality>0.8</generateCommonality></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="RK_BikerJacket"]</xpath><value><generateCommonality>0.8</generateCommonality></value></nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="RK_PunkOutfit"]/generateCommonality</xpath>
    <match Class="PatchOperationReplace"><xpath>Defs/ThingDef[defName="RK_PunkOutfit"]/generateCommonality</xpath><value><generateCommonality>0.6</generateCommonality></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="RK_PunkOutfit"]</xpath><value><generateCommonality>0.6</generateCommonality></value></nomatch>
  </Operation>
</Patch>
