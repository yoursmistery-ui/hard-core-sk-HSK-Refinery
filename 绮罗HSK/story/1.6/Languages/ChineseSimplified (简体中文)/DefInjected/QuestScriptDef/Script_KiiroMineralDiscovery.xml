<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->The scouts from [kiiro_settlement_label] have discovered a newly fallen meteorite nearby, which appears to contain some minerals. [kiiro_settlement_label] lacks the means to send miners to extract these minerals and has decided to entrust this meteorite mine to you. The location of the meteorite has now been marked on your map.\n\nThere may be unknown threats near the meteorite.\n\n"There might be others eyeing this meteorite as well, please be cautious."</li>
  -->
  <Kiiro_Mineral_Discovery.questDescriptionRules.rulesStrings>
    <li>questDescription->[kiiro_settlement_label]的斥候在附近发现了一处新坠落的陨石，其中似乎也包含了一些矿物。[kiiro_settlement_label]没有能力派出矿工来开采这些矿石，于是决定将这处陨石矿交由你处理，这处陨石的位置现在被标注在你的地图上了。\n\n陨石附近可能会存在未知的威胁。\n\n“可能会有其他人也盯上了这处陨石，请务必小心。”</li>
  </Kiiro_Mineral_Discovery.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->mineral discovery</li>
  -->
  <Kiiro_Mineral_Discovery.questNameRules.rulesStrings>
    <li>questName->矿物发现</li>
  </Kiiro_Mineral_Discovery.questNameRules.rulesStrings>
  <!-- EN: Quest expired: [resolvedQuestName] -->
  <Kiiro_Mineral_Discovery.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>任务过期：[resolvedQuestName]</Kiiro_Mineral_Discovery.root.nodes.WorldObjectTimeout.node.nodes.Letter.label.slateRef>
  <!-- EN: Seems that the meteorite mine has already been mined by someone else. -->
  <Kiiro_Mineral_Discovery.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>看起来陨石矿已经被别人开采了。</Kiiro_Mineral_Discovery.root.nodes.WorldObjectTimeout.node.nodes.Letter.text.slateRef>
  
</LanguageData>