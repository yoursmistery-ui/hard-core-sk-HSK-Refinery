<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN:
    <li>questDescription->A group of kiiro guerrillas who are being pursued by the enemy have retreated near [map_definite], they ask you for helping them stop the enemy in [map_definite], and want to stop here for a short time to get some respite. The group of [enemyFaction_pawnsPlural] is composed of: \n\n[raid/raidPawnKinds]</li>
  -->
  <Kiiro_GuerrillaAssist.questDescriptionRules.rulesStrings>
    <li>questDescription->一支正在被敌人追击的绮罗游击队撤退到了[map_definite]附近，她们恳求你能在[map_definite]帮助一起阻击敌人，并且希望能够在这里短暂停留以便得到片刻的喘息。[enemyFaction_pawnsPlural]的队伍构成: \n\n[raid/raidPawnKinds]</li>
  </Kiiro_GuerrillaAssist.questDescriptionRules.rulesStrings>
  <!-- EN:
    <li>questName->[aThe] kiiro guerrilla [alms]</li>
    <li>aThe->A group of</li>
    <li>aThe->A team</li>
    <li>aThe->A crowd of</li>
    <li>alms->asking for help</li>
    <li>alms->in need of help</li>
    <li>alms->seeking for help</li>
    <li>alms->need help</li>
  -->
  <Kiiro_GuerrillaAssist.questNameRules.rulesStrings>
    <li>questName->[aThe][alms]绮罗游击队</li>
    <li>aThe->一群</li>
    <li>aThe->一队</li>
    <li>aThe->一支</li>
    <li>alms->需要帮助的</li>
    <li>alms->请求支援的</li>
    <li>alms->寻求帮助的</li>
    <li>alms->走投无路的</li>
  </Kiiro_GuerrillaAssist.questNameRules.rulesStrings>
  <!-- EN: {BASELABEL} chasing kiiro guerrilla -->
  <Kiiro_GuerrillaAssist.root.nodes.Delay-1.node.parms.customLetterLabel.value.slateRef>{BASELABEL}追击绮罗游击队</Kiiro_GuerrillaAssist.root.nodes.Delay-1.node.parms.customLetterLabel.value.slateRef>
  <!-- EN: {BASETEXT}\nThese [enemyFaction_pawnsPlural] is coming for kiiro guerrillas. -->
  <Kiiro_GuerrillaAssist.root.nodes.Delay-1.node.parms.customLetterText.value.slateRef>{BASETEXT}\n这些[enemyFaction_pawnsPlural]是为追击绮罗游击队而来。</Kiiro_GuerrillaAssist.root.nodes.Delay-1.node.parms.customLetterText.value.slateRef>
  <!-- EN: leave in {0}. -->
  <Kiiro_GuerrillaAssist.root.nodes.ExtraInspectStringAddOn.extraInspectString.slateRef>于{0}后离开。</Kiiro_GuerrillaAssist.root.nodes.ExtraInspectStringAddOn.extraInspectString.slateRef>
  <!-- EN: kiiro guerrilla leave -->
  <Kiiro_GuerrillaAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.label.slateRef>游击队离开</Kiiro_GuerrillaAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.label.slateRef>
  <!-- EN: The kiiro guerrillas have finished their rectification, and they will leave now. -->
  <Kiiro_GuerrillaAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.text.slateRef>绮罗游击队已经完成了整顿，她们将离开你的殖民地。</Kiiro_GuerrillaAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.text.slateRef>
  <!-- EN: Relation with kiiro guerrilla broke down -->
  <Kiiro_GuerrillaAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>绮罗游击队关系破裂</Kiiro_GuerrillaAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>
  <!-- EN: due to we are now hostile to kiiro, our relation with kiiro guerrilla broke down and now they treat us as enemy. -->
  <Kiiro_GuerrillaAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>由于现在与绮罗族处于敌对关系，我们与绮罗游击队的关系破裂了，她们现在视我们为敌人。</Kiiro_GuerrillaAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>
  
  <!-- UNUSED -->
  <Kiiro_GuerrillaAssist.LetterLabelChasing.value.slateRef>{BASELABEL}追击绮罗游击队</Kiiro_GuerrillaAssist.LetterLabelChasing.value.slateRef>
  <Kiiro_GuerrillaAssist.LetterTextChasing.value.slateRef>{BASETEXT}\n这帮[enemyFaction_pawnsPlural]是为了追击绮罗游击队而来。</Kiiro_GuerrillaAssist.LetterTextChasing.value.slateRef>
  
</LanguageData>