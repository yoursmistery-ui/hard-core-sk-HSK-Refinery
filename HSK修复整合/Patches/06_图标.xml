    <!-- ============================================================
         06_图标.xml  (2026-08-22 按大类合并)
         合并自 5 个补丁: 12_铅合金图标修复.xml, 15_聚碳酸酯图标修复.xml, 16_聚苯乙烯图标修复.xml, 38_乙烯特氟龙HSK原版贴图.xml, 45_VileLeatherStationIcons.xml
         铅合金/聚碳酸酯/聚苯乙烯/乙烯特氟龙/皮革站图标修复。
         ============================================================ -->
    <!-- 来源: 12_铅合金图标修复.xml -->
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="LeadBar"]/graphicData/texPath</xpath>
    <value>
        <texPath>Things/Item/Ingot</texPath>
    </value>
</Operation>
	
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="LeadBar"]/graphicData/graphicClass</xpath>
    <value>
        <graphicClass>Graphic_StackCount</graphicClass>
    </value>
</Operation>
	
<Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="LeadBar"]/graphicData/color</xpath>
    <value>
        <color>(129,107,100)</color>
    </value>
</Operation>

    <!-- 来源: 15_聚碳酸酯图标修复.xml -->
