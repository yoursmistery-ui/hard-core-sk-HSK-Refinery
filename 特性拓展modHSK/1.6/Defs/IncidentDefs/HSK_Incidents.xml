<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 机制一: 背景强关联 · 授予(叙事者事件)。v2 (2026-08-27) 大幅收紧:
       · minRefireDays 365→730(两年最多开一次窗口), baseChance 1.4→0.6(更不容易被抽中)
       · 能否真授予还要过 IncidentWorker 里的 开局满2年门 + 殖民地年度配额 + backgroundGrantChance(0.25)
       · 特性失效不再走事件, 改由账本每日低频检查驱动(见 Source/HSKLedger.cs MaybeDriftCheck)。 -->
  <IncidentDef>
    <defName>RK_TraitGrantingEvent</defName>
    <baseChance>0.6</baseChance>
    <minRefireDays>730</minRefireDays>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HSKTraitExt.IncidentWorker_HSKTraitGrant</workerClass>
  </IncidentDef>

  <!-- v2 追加的三套叙事者外壳: 与 RK_TraitGrantingEvent 同一个授予引擎(只换 FrameIndex 与文案),
       共用殖民地年度配额, 因此事件变多只是"由头"变多, 授予总量不变。 -->
  <IncidentDef>
    <defName>RK_TraitTalentRipening</defName>
    <baseChance>0.5</baseChance>
    <minRefireDays>730</minRefireDays>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>HSKTraitExt.IncidentWorker_HSKTraitTalentRipening</workerClass>
  </IncidentDef>

  <IncidentDef>
    <defName>RK_TraitSeenByOthers</defName>
    <baseChance>0.5</baseChance>
    <minRefireDays>730</minRefireDays>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>HSKTraitExt.IncidentWorker_HSKTraitSeenByOthers</workerClass>
  </IncidentDef>

  <IncidentDef>
    <defName>RK_TraitSeasonCounting</defName>
    <baseChance>0.5</baseChance>
    <minRefireDays>730</minRefireDays>
    <category>Misc</category>
    <targetTags><li>Map_PlayerHome</li></targetTags>
    <workerClass>HSKTraitExt.IncidentWorker_HSKTraitSeasonCounting</workerClass>
  </IncidentDef>
</Defs>
