<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- ============================================================================
  P1 · 可搜刮战利品容器 (M1 骨架批, 2026-08-28)
  来源: Medieval Overhaul 1.6.2.2 机制复刻 —— thingClass 换成我们自研的
        BlueprintUnlockHSK.Building_LootableHSK(语义抄 MO Building_Lootable,
        见 Source/LootableHSK.cs), 扩展换成 LootableExtensionHSK。
  定制: 新增 blueprintTier / blueprintChance / blueprintSeriesTech / blueprintCount
        → 废墟探索成为 112 本蓝图书的定向获取渠道(优先给未读卷册)。
  材料/物品引用一律改为本环境已存在的 def(Unified.xml 逐个核对)。
  这些容器**不可建造**(无 designationCategory / 无造价), 由地图生成与站点布局投放;
  M1 阶段可用开发者模式直接摆放验证。
============================================================================ -->

	<ThingDef Name="Rustic_LootBuildingBase" ParentName="BuildingBase" Abstract="True">
		<thingClass>BlueprintUnlockHSK.Building_LootableHSK</thingClass>
		<category>Building</category>
		<tickerType>Never</tickerType>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<fillPercent>0.40</fillPercent>
		<blockLight>false</blockLight>
		<holdsRoof>false</holdsRoof>
		<canOverlapZones>false</canOverlapZones>
		<selectable>true</selectable>
		<rotatable>false</rotatable>
		<size>(1,1)</size>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>250</WorkToBuild>
			<Mass>4</Mass>
			<Flammability>0.5</Flammability>
			<SellPriceFactor>0</SellPriceFactor>
		</statBases>
		<building>
			<isInert>true</isInert>
			<ai_chillDestination>false</ai_chillDestination>
		</building>
		<!-- 搜索容器不应进建筑师菜单(基类无 designationCategory), 但需清掉 HSK BuildingBase 的研究门禁 -->
		<researchPrerequisites Inherit="False"/>
		<costList Inherit="False"/>
	</ThingDef>

	<!-- ======================= 1. 藏身处木桶 ======================= -->
	<ThingDef ParentName="Rustic_LootBuildingBase">
		<defName>Rustic_LootBarrelClosed</defName>
		<label>废弃木桶</label>
		<description>一只箍着铁皮的旧木桶, 桶口的塞子已经腐烂。里面大概还剩下些前人来不及搬走的东西。\n\n搜刮后可能翻出杂物, 偶尔也夹着一卷旧图纸。</description>
		<graphicData>
			<texPath>Things/Building/Storage/BarrelClosed</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
			<drawRotated>false</drawRotated>
		</graphicData>
		<castEdgeShadows>true</castEdgeShadows>
		<modExtensions>
			<li Class="BlueprintUnlockHSK.LootableExtensionHSK">
				<lootChance>1</lootChance>
				<lootCount>2~8</lootCount>
				<maxStacks>3</maxStacks>
				<lootQualityRange>1~3</lootQualityRange>
				<isRandom>true</isRandom>
				<randomItems>
					<li>Pemmican</li>
					<li>MealSurvivalPack</li>
					<li>Salt</li>
					<li>Cloth</li>
					<li>ComponentMedieval</li>
					<li>Steel</li>
					
				</randomItems>
				<emptyGraphicData>
					<texPath>Things/Building/Storage/BarrelClosed</texPath>
					<graphicClass>Graphic_Single</graphicClass>
					<drawSize>(2,2)</drawSize>
					<color>(120,110,100)</color>
				</emptyGraphicData>
				<enemysToSpawn><li>Rat</li></enemysToSpawn>
				<enemySpawnChance>0.10</enemySpawnChance>
				<hostileEnemy>false</hostileEnemy>
				<blueprintTier>1</blueprintTier>
				<blueprintChance>0.20</blueprintChance>
				<searchEffect>DustPuff</searchEffect>
				<effectSize>2.5</effectSize>
			</li>
		</modExtensions>
	</ThingDef>

