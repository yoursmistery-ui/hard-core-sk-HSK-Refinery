    </nomatch>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="JD_shield"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="JD_shield"]/thingCategories</xpath>
      <value><li>ShieldCat</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="JD_shield"]</xpath>
      <value><thingCategories><li>ShieldCat</li></thingCategories></value>
    </nomatch>
  </Operation>

  <!-- ⑤ 能量护盾装置: 日常便服→战术装备 (不是盾牌, 只修用途轴) -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PackBroadshield"]/thingCategories/li[text()="HSK_U_Daily"]</xpath>
