<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- AmmoSet -->
	<!--  绮罗反曲弓 绮罗猎人短弓的毒箭 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_Arrow"]/ammoTypes</xpath>
		<value>
			<Ammo_KiiroArrow_Paralytic>Projectile_KiiroArrow_Paralytic</Ammo_KiiroArrow_Paralytic>
			<Ammo_KiiroArrow_Deadly>Projectile_KiiroArrow_Deadly</Ammo_KiiroArrow_Deadly>
		</value>
	</Operation>

	<!-- 绮罗长弓的毒箭 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_Arrow"]/ammoTypes</xpath>
		<value>
			<Ammo_KiiroGreatArrow_Paralytic>Projectile_KiiroGreatArrow_Paralytic</Ammo_KiiroGreatArrow_Paralytic>
			<Ammo_KiiroGreatArrow_Deadly>Projectile_KiiroGreatArrow_Deadly</Ammo_KiiroGreatArrow_Deadly>
		</value>
	</Operation>

	<!-- 绮罗十字弩 绮罗连弩的毒箭 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_Bolt"]/ammoTypes</xpath>
		<value>
			<Ammo_KiiroCrossbowBolt_Paralytic>Projectile_KiiroCrossbowBolt_Paralytic</Ammo_KiiroCrossbowBolt_Paralytic>
			<Ammo_KiiroCrossbowBolt_Deadly>Projectile_KiiroCrossbowBolt_Deadly</Ammo_KiiroCrossbowBolt_Deadly>
		</value>
	</Operation>

	<!-- 绮罗照明弹 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_81mmMortarShell"]/ammoTypes</xpath>
		<value>
			<KiiroShell_FlareCE>KiiroBullet_Shell_FlareCE</KiiroShell_FlareCE>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationRemove">
		<xpath>/Defs/ThingDef[defName="Shell_Flare"]</xpath>
	</Operation>
</Patch>
