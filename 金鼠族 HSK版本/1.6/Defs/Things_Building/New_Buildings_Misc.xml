<?xml version="1.0" encoding="utf-8"?>
<Defs>
  

  

  

  

  

  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_Zhuzi_New</defName>
    <label>Oberonia Aurea Optical Column</label>    <!--不要指望它替代太阳灯，这玩意是放工作间照明的同时满足光学台需求的-->
    <description>A support column specially designed for optical research laboratories, which is equipped with a high-energy optical component inside and can simulate various lighting conditions. When there is no research task, sometimes researchers may freely adjust colors according to their own preferences.</description>
    <designationCategory>Structure</designationCategory>
    <uiOrder>2041</uiOrder>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.25</fillPercent>
    <pathCost>0</pathCost>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToBuild>3500</WorkToBuild>
      <Mass>10</Mass>
      <Flammability>0.5</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <costList>
      <Plasteel>45</Plasteel>
      <ComponentSpacer>2</ComponentSpacer>
      <ComponentAdvanced>1</ComponentAdvanced>
    </costList>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>false</canOverlapZones>
    <rotatable>false</rotatable>
    <fertility>0</fertility>
    <specialDisplayRadius>2.4</specialDisplayRadius>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
      <paintable>true</paintable>
    </building>
    <graphicData>
      <drawSize>(1.1,1.28)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <texPath>Building/OA_RK_Zhuzi_D</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <!--shaderType>CutoutComplex</shaderType-->
      <shadowData>
        <volume>(0.3, 0.5, 0.3)</volume>
        <offset>(0,0,-0.23)</offset>
      </shadowData>
      <damageData>
        <rect>(0.2,0.2,0.6,0.6)</rect>
      </damageData>
    </graphicData>
    <placeWorkers>
      <li>PlaceWorker_GlowRadius</li>
      <li MayRequire="OARK.RatkinFaction.ScenarioExpand.Snowstorm">OberoniaAureaGene.Snowstorm.PlaceWorker_RoofProtectRadius</li>
    </placeWorkers>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <comps>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>400</basePowerConsumption>
      </li>
      <li Class="CompProperties_Glower">
        <overlightRadius>3.4</overlightRadius>
        <glowRadius>20</glowRadius>
        <glowColor>(216,177,110,0)</glowColor>
        <colorPickerEnabled>true</colorPickerEnabled>
        <darklightToggle>true</darklightToggle>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>2</heatPerSecond>
      </li>
    </comps>
    <researchPrerequisites>
      <li>Research_table_D2</li>
    </researchPrerequisites>
  </ThingDef>

  

  <TerrainDef ParentName="FloorBase">
    <defName>OA_RK_Floor_Jishu</defName>
    <label>金鸢尾兰技术部地板</label>
    <renderPrecedence>200</renderPrecedence>
    <description>金鸢尾兰宫廷技术部侍从们研发出的一种具有一定自清洁性的地板，铺设简单的同时具有相当的美观性，很适合大规模铺设制作。</description>
    <texturePath>Building/OA_RK_Floor_Jishu</texturePath>
    <color>(0.67, 0.67, 0.67)</color>
    <pollutionTintColor>(0.91, 0.91, 0.86, 1)</pollutionTintColor>
    <isPaintable>true</isPaintable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiIconPath>Building/OA_RK_Floor_Jishu_UI</uiIconPath>
    <statBases>
      <WorkToBuild>1080</WorkToBuild>
      <Cleanliness>0.35</Cleanliness>
      <CleaningTimeFactor>0.6</CleaningTimeFactor>
      <Beauty>4</Beauty>
    </statBases>
    <costList>
      <Steel>9</Steel>
    </costList>
    <tags>
      <li>Floor</li>
    </tags>
    <constructEffect>ConstructMetal</constructEffect>
    <designationHotKey>Misc4</designationHotKey>
    <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>Metal_floor_D1</li>
    </researchPrerequisites>
    <uiOrder>2116</uiOrder>
  </TerrainDef>

  <!-- OA_RK_Tailor(金鸢尾兰缝纫台)已于 2026-08-27 整体迁移至「HSK 工业与科研大修」
       (ratkinpatch.HSKIndustrialResearchOverhaul) 的 Defs/ThingDefs/OA_RK_Tailor.xml,
       并升级为太空时代生产建筑(承载鼠族+金鼠族太空/极致衣物护甲)。
       本处仅保留其连接的布料回收设施 OA_RK_Cloth_Processing_B。 -->

  <ThingDef ParentName="BuildingBase">
    <defName>OA_RK_Cloth_Processing_B</defName>
    <label>Fabric recycling facilities</label>
    <description>A machine that can automatically adjust and process the details of clothing, optimizing the structure while recycling excess fabric. \n\nThe sewing table connected to this device will be able to recycle a small amount of fiber materials when completing the production of clothing containing fiber materials.</description>
    <graphicData>
      <texPath>Building/OA_RK_Cloth_Processing_B</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3.05,3.05)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <castEdgeShadows>true</castEdgeShadows>
    <rotatable>false</rotatable>
    <staticSunShadowHeight>0.35</staticSunShadowHeight>
    <fillPercent>0.5</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <pathCost>42</pathCost>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>16000</WorkToBuild>
      <Mass>30</Mass>
      <Flammability>0.2</Flammability>
    </statBases>
    <size>(2,2)</size>
    <costList>
      <Plasteel>100</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
      <ComponentAdvanced>2</ComponentAdvanced>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <researchPrerequisites>
      <li>OA_RK_Apparel_I</li>
    </researchPrerequisites>
    <designationCategory>Misc</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>150</basePowerConsumption>
      </li>
      <li Class="CompProperties_Facility">
        <statOffsets>
          <WorkTableWorkSpeedFactor>0.08</WorkTableWorkSpeedFactor>
        </statOffsets>
        <maxSimultaneous>1</maxSimultaneous>
      </li>
    </comps>
    <designationHotKey>Misc6</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
    </placeWorkers>
  </ThingDef>

</Defs>
