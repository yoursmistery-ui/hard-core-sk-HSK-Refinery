<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!--Miho_TableMachining: 工业档补 HSK 材料(粘合剂+合成纤维)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_TableMachining"]/costList</xpath>
    <value>
      <Compaste>8</Compaste>
      <SyntheticFibers>10</SyntheticFibers>
    </value>
  </Operation>
  <!--Miho_WorkAI: 太空档补 HSK 电子元件-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_WorkAI"]/costList</xpath>
    <value>
      <Electronics>10</Electronics>
    </value>
  </Operation>
  <!--Miho_MechFactory: 太空档补 HSK 材料(碳纤维+电子元件)-->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Miho_MechFactory"]/costList</xpath>
    <value>
      <Carbon>20</Carbon>
      <Electronics>15</Electronics>
    </value>
  </Operation>
</Patch>
