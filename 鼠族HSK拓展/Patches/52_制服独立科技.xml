<!-- 合并自(保持原执行序): 52_制服独立科技.xml, 53_材料外观补全.xml -->
<Patch><!-- 52_制服独立科技(2026-08-11, 用户要求):
         鼠族衣物 II(B2A)里有一堆 xxx制服, 本补丁把制服独立成工业时代科技节点:
         1) 新增研究节点 鼠族制服(Ratkin_Apparel_Uniform, 工业时代, 前置 鼠族衣物 III);
         2) 7 条制服配方(作战服×2/守卫制服A·B/军用制服/军官制服/步兵制服)
            研究前置由 鼠族衣物 II(B2A) 改挂 鼠族制服;
         3) B2A 描述移除制服清单;
         4) 制服材料统一为 前工业化材料: 布料/皮革 + 原始零部件,
            移除 电子元件(ElectronicComponents)/集成电路(Electronics),
            普通零部件(ComponentIndustrial)→原始零部件(ComponentMedieval),
            军官/步兵制服保留金锭点缀(与贵族装同款小量固定材质)。
         最终层补丁(52), 后于 51 号加载。 -->

    <!-- ========== 1) 新增 鼠族制服 研究节点(工业时代科技) ========== -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs</xpath>
        <value>
            <ResearchProjectDef ParentName="IndustrialBase">
                <defName>Ratkin_Apparel_Uniform</defName>
                <label>鼠族制服</label>
                <description>鼠族制服: 解锁鼠族作战服/守卫制服A·B/军用制服/军官制服/步兵制服等军用制服,前置鼠族衣物 III。</description>
                <baseCost>500</baseCost>
                <techLevel>Industrial</techLevel>
                <prerequisites><li>Ratkin_Apparel_C1</li></prerequisites>
                <researchViewX>11.00</researchViewX>
                <researchViewY>43.00</researchViewY>
                <tab>Apparel_SK</tab>
            </ResearchProjectDef>
        </value>
    </Operation>

    <!-- ========== 2) 7 条制服配方研究改挂 鼠族制服 ========== -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_OrderUniform"]/researchPrerequisite</xpath>
        <value><researchPrerequisite>Ratkin_Apparel_Uniform</researchPrerequisite></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKFix_Make_RK_OrderUniformB"]/researchPrerequisite</xpath>
