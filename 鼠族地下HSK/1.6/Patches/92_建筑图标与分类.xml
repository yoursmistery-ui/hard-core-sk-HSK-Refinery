<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Graphic_Multi 建造物补单张 UI 图，避免建筑师菜单/选择图标取不到贴图。 -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RKU_DrillingVehicle"]</xpath>
    <value>
      <uiIconPath>Buildings/DrillingVehicle/BaseDrillingVehicle_south</uiIconPath>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="RKU_DrillingVehicleCargo"]</xpath>
    <value>
      <uiIconPath>Buildings/DrillingVehicle/DrillingVehicleCargo_south</uiIconPath>
    </value>
  </Operation>
</Patch>
