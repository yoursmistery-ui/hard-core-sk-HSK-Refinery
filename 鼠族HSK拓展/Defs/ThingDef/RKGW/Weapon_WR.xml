<?xml version='1.0' encoding='utf-8'?>
<Defs>
	<ThingDef ParentName="RK_IndustrialRangeWeapon">
		<defName>RK_WR_Camellia</defName>
		<label>"Camellia" Light Machine Gun</label>
		<description>The "Camellia" Light Machine Gun was invented by Colonel Camellia of the Red Rose Federation. Although it was never adopted domestically, it was instead brought to prominence by the White Rose Kingdom during the Great War.</description>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/RK_WR_Camellia</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1.0</drawSize>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>
		<weaponTags Inherit="false">
			<li>RK_WR_LMG</li>
		</weaponTags>
		<statBases>
			<WorkToMake>18000</WorkToMake>
			<Mass>5.4</Mass>
			<Bulk>18</Bulk>
			<AccuracyTouch>0.35</AccuracyTouch>
			<AccuracyShort>0.38</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.35</AccuracyLong>
			<RangedWeapon_Cooldown>1.75</RangedWeapon_Cooldown>
		</statBases>
		<costList>
			<Steel>150</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<WoodPlank>40</WoodPlank>
		</costList>
		<recipeMaker>
			<researchPrerequisite>RK_WR_Weapon</researchPrerequisite>
			<skillRequirements>
				<Crafting>5</Crafting>
			</skillRequirements>
		</recipeMaker>
		<equippedAngleOffset>45</equippedAngleOffset>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_WhiteRose</defaultProjectile>
				<warmupTime>2.5</warmupTime>
				<range>30</range>
				<ticksBetweenBurstShots>7</ticksBetweenBurstShots>
				<burstShotCount>10</burstShotCount>
				<soundCast>RK_WR_Camellia</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>10</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li Class="CombatExtended.ToolCE">
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>7</power>
				<cooldownTime>2</cooldownTime>
				<armorPenetrationBlunt>3</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
			</li>
		</tools>
	</ThingDef>
