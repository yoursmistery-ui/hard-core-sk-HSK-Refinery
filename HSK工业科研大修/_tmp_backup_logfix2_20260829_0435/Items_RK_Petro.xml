    <comps><li Class="CompProperties_Explosive"><explosiveRadius>1.6</explosiveRadius><explosiveDamageType>Flame</explosiveDamageType><wickTicks><min>60</min><max>120</max></wickTicks><startWickHitPointsPercent>0.35</startWickHitPointsPercent></li></comps>
  </ThingDef>

