<Patch>
    <!-- =====================================================================
        金鼠族 HSK 版本 · 07_武器工作台适配(2026-08-23 v2, 用户要求分级)
        目标: 金鼠族武器按 HSK 武器台分级挂载,与鼠族产业线区分:
              ① 锻造台 FueledSmithy + ElectricSmithy —— 中世纪/工具为主
                 (登山杖 Mountain_Stick 系, Melee_C2/D1);
              ② 先进武器台 AdvWeaponCraftingWorkTable —— 后工业化武器
                 (工业步枪/霰弹/冲锋枪/重武器, Rifles_C1/Shotgun_C2/SMG_C2/Heavy_C3);
              ③ 量子武器台 MechWeaponCraftingWorkTable —— 太空/极致时代武器
                 (电荷 Blitz 系/不稳定电荷/极致近战, Charge_weapons_D/E/Melee_Ultra);
              ④ 武器制造台 WeaponCraftingWorkTable(前工业): 金鼠族无前工业武器,不使用。
        衣物: 见 Apparel_Base.xml(基类已挂 ElectricTailoringBench + HyperTailoringBench)。
        说明: 弹药已由 CE 补丁全量映射 HSK 弹药,金鼠族不自造。
        ===================================================================== -->

    <!-- ① 锻造台(中世纪/工具): 登山杖系列 Melee_C2/D1(继承链无 recipeUsers,用 Add 覆盖) -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="OA_RK_Mountain_Stick"]/recipeMaker</xpath>
        <value>
            <recipeUsers Inherit="false">
                <li>FueledSmithy</li>
                <li>ElectricSmithy</li>
            </recipeUsers>
        </value>
    </Operation>
