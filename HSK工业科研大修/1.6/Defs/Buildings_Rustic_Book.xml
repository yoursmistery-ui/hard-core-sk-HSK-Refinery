<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- 书籍类家具(讲台/乡村书架/空书架/皇家书架)
     来源: Medieval Overhaul 1.6.2.2 Buildings_Book.xml + Buildings_Furniture.xml 书架段移植(2026-08-27)。
     已改挂 1.6 原版抽象基类 BookcaseBase(原生书架: Building_Bookcase, 藏书被动加成科研)与 ShelfBase,
     弃用 MO 自建图书储物分类过滤(改用原版 Books 分类);
     研究 RusticFurniture/RoyalRusticFurniture→ComplexFurniture; 菜单挂 Furniture。 -->

	<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>Rustic_Lecturn</defName>
		<label>经文讲台</label>
		<description>一座简朴的斜读台, 摊开经卷或书册便俯读不累。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Lecturn</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawRotated>false</drawRotated>
			<shadowData>
				<volume>(0.3, 0.6, 0.3)</volume>
			</shadowData>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToBuild>450</WorkToBuild>
			<Mass>3</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>0</Beauty>
			<Comfort>0.5</Comfort>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">5</StyleDominance>
		</statBases>
		<stuffCategories Inherit="False">
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>25</costStuffCount>
		<pathCost>30</pathCost>
		<fillPercent>0.20</fillPercent>
		<building>
			<paintable>true</paintable>
		</building>
		<comps>
			<li Class="CompProperties_Styleable"/>
		</comps>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>Furniture</designationCategory>
	</ThingDef>

	<!--==================== 乡村书架(带科研加成) ====================-->
	<ThingDef ParentName="BookcaseBase">
		<defName>Rustic_ResearchShelf</defName>
		<label>乡村研究书架 (1x1)</label>
		<description>塞满抄本的小书架, 摆在研究台旁能加快研究进度。每台研究台最多加算两个小书架。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RusticBookshelf1x1</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>3</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>0.5</uiIconScale>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<size>(1,1)</size>
		<castEdgeShadows>true</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToBuild>2500</WorkToBuild>
			<Mass>40</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">8</StyleDominance>
		</statBases>
		<costList>
			<Cloth>40</Cloth>
		</costList>
		<pathCost>50</pathCost>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<comps>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<ResearchSpeedFactor>0.05</ResearchSpeedFactor>
				</statOffsets>
				<maxDistance>5</maxDistance>
				<maxSimultaneous>2</maxSimultaneous>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<building>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>ASFstorage</designationCategory>
	</ThingDef>

	<ThingDef ParentName="BookcaseBase">
		<defName>Rustic_ResearchShelf1x2c</defName>
		<label>乡村研究书架 (1x2)</label>
		<description>两层高的大书架, 学术气息扑面而来。摆在研究台旁显著加快研究, 每台只认一个大书架。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RusticBookshelf1x2</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3.5,3)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<size>(2,1)</size>
		<castEdgeShadows>true</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>140</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Mass>60</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">8</StyleDominance>
		</statBases>
		<pathCost>50</pathCost>
		<costList>
			<Cloth>60</Cloth>
		</costList>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<comps>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<ResearchSpeedFactor>0.1</ResearchSpeedFactor>
				</statOffsets>
				<maxDistance>5</maxDistance>
				<maxSimultaneous>1</maxSimultaneous>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<building>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>ASFstorage</designationCategory>
	</ThingDef>

	<!--==================== 空书架(纯储物, 无科研加成) ====================-->
	<ThingDef ParentName="ShelfBase">
		<defName>Rustic_EmptyShelf</defName>
		<label>空书架 (1x1)</label>
		<description>一格空书架。先造架子后藏书, 也适合当装饰搁板。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RusticEmptyShelf1x1</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<thingClass>Building_Storage</thingClass>
		<uiIconScale>0.5</uiIconScale>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<size>(1,1)</size>
		<castEdgeShadows>true</castEdgeShadows>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>70</MaxHitPoints>
			<WorkToBuild>2500</WorkToBuild>
			<Mass>40</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">8</StyleDominance>
		</statBases>
		<pathCost>50</pathCost>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>3</maxItemsInCell>
			<storageGroupTag>Shelf</storageGroupTag>
			<blueprintClass>Blueprint_Storage</blueprintClass>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Books</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<categories>
						<li>Books</li>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>ASFstorage</designationCategory>
	</ThingDef>

	<ThingDef ParentName="ShelfBase">
		<defName>Rustic_EmptyShelf1x2c</defName>
		<label>空书架 (1x2)</label>
		<description>宽两格的大空书架, 静候还没写出来的书。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RusticEmptyShelf1x2</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3.5,3)</drawSize>
		</graphicData>
		<thingClass>Building_Storage</thingClass>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<size>(2,1)</size>
		<castEdgeShadows>true</castEdgeShadows>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>140</MaxHitPoints>
			<WorkToBuild>5000</WorkToBuild>
			<Mass>60</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>5</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">8</StyleDominance>
		</statBases>
		<pathCost>50</pathCost>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>75</costStuffCount>
		<constructionSkillPrerequisite>5</constructionSkillPrerequisite>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>3</maxItemsInCell>
			<storageGroupTag>Shelf</storageGroupTag>
			<blueprintClass>Blueprint_Storage</blueprintClass>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Books</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<categories>
						<li>Books</li>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>ASFstorage</designationCategory>
	</ThingDef>

	<!--==================== 皇家书架 ====================-->
	<ThingDef ParentName="BookcaseBase">
		<defName>Rustic_RoyalBookshelf</defName>
		<label>皇家书架</label>
		<description>衬绸描金的贵重书架, 摆在研究台旁可加快研究。每台研究台最多联结两个皇家书架。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RoyalBookshelf</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>3</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<uiIconScale>0.65</uiIconScale>
		<uiIconOffset>(0, 0.15)</uiIconOffset>
		<size>(1,1)</size>
		<castEdgeShadows>true</castEdgeShadows>
		<canOverlapZones>false</canOverlapZones>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<thingCategories>
			<li>BuildingsMisc</li>
		</thingCategories>
		<statBases>
			<MaxHitPoints>140</MaxHitPoints>
			<WorkToBuild>14500</WorkToBuild>
			<Mass>45</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>30</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
		</statBases>
		<pathCost>50</pathCost>
		<costList>
			<Cloth>30</Cloth>
			<GoldBar>30</GoldBar>
			<ComponentMedieval>2</ComponentMedieval>
		</costList>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>80</costStuffCount>
		<comps>
			<li Class="CompProperties_Facility">
				<statOffsets>
					<ResearchSpeedFactor>0.075</ResearchSpeedFactor>
				</statOffsets>
				<maxDistance>5</maxDistance>
				<maxSimultaneous>2</maxSimultaneous>
			</li>
		</comps>
		<placeWorkers>
			<li>PlaceWorker_ShowFacilitiesConnections</li>
		</placeWorkers>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<building>
			<paintable>true</paintable>
		</building>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>Furniture</designationCategory>
	</ThingDef>

</Defs>
