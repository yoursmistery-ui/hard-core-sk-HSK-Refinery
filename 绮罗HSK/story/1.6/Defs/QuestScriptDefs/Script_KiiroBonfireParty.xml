<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <QuestScriptDef>
    <defName>Kiiro_OpportunitySite_BonfireParty</defName>
    <rootSelectionWeight>1</rootSelectionWeight>
    <!-- <rootMinProgressScore>10</rootMinProgressScore> -->
    <autoAccept>true</autoAccept>
    <!-- <expireDaysRange>1~3</expireDaysRange> -->
    <questNameRules>
      <rulesStrings>
        <li>questName->bonfire party</li>
      </rulesStrings>
    </questNameRules>
    <questDescriptionRules>
      <rulesStrings>
        <li>questDescription->The residents of [kiiro_settlement_label] are planning to have a bonfire party in the wilderness and would like to invite you to join.\n\nEven though kiiros life is no longer as peaceful as before, they still choose to engage in some leisurely social activities when it's safe. A simple bonfire party is a perfect choice, allowing participants to relax in meals and enjoy themselves.</li>
      </rulesStrings>
    </questDescriptionRules>
    <layerWhitelist>
      <li>Surface</li>
    </layerWhitelist>
    <root Class="QuestNode_Sequence">
      <nodes>
        <li Class="QuestNode_Set">          <!--设置地点距离-->
          <name>siteDistRange</name>
          <value>1~3</value>
        </li>

        <li Class="QuestNode_GetMap" />

        <li Class="Kiiro_Event.QuestNode_ModSettingOn">          <!--事件开关-->
          <modSettingSwitch>OpportunitySite_BonfireParty</modSettingSwitch>
        </li>

        <li Class="Kiiro_Event.QuestNode_IsKiiroFactionSatisfied">
          <needFactionInteractionOpen>true</needFactionInteractionOpen>
          <!-- <needFactionNotHostile>true</needFactionNotHostile> -->
          <needFactionAlly>true</needFactionAlly>
          <needTotalTrust>true</needTotalTrust>
        </li>

        <!-- 任务唯一性 -->
        <li Class="QuestNode_QuestUnique">
          <tag>Kiiro_OpportunitySite_BonfireParty</tag>
          <faction>$siteFaction</faction>
        </li>

        <!-- 获取附近绮罗定居点信息 -->
        <li Class="Kiiro_Event.QuestNode_GetNearbyKiiroSettlement">
          <allowActiveTradeRequest>false</allowActiveTradeRequest>
          <maxTileDistance>8</maxTileDistance>
          <storeAs>kiiro_settlement</storeAs>
        </li>


        <li Class="QuestNode_GetPlayerFaction">
          <storeAs>playerFaction</storeAs>
        </li>

        <!-- 生成在绮罗定居点附近 -->
        <li Class="Kiiro_Event.QuestNode_GetSiteTile">
          <storeAs>tile</storeAs>
          <preferCloserTiles>false</preferCloserTiles>
          <nearKiiroSettlementTile>true</nearKiiroSettlementTile>
        </li>


        <li Class="QuestNode_GenerateWorldObject">
          <def>Kiiro_BonfireParty</def>
          <tile>$tile</tile>
          <faction>Kiiro_Faction</faction>
          <storeAs>Kiiro_BonfireParty</storeAs>
        </li>
        <li Class="QuestNode_SpawnWorldObjects">
          <worldObjects>$Kiiro_BonfireParty</worldObjects>
          <tile>$tile</tile>
        </li>

        <!-- 3到6天 -->
        <li Class="QuestNode_Set">
          <name>timeoutTicks</name>
          <value>$(randInt(3,6)*60000)</value>
        </li>

        <li Class="QuestNode_WorldObjectTimeout">
          <worldObject>$Kiiro_BonfireParty</worldObject>
          <delayTicks>$timeoutTicks</delayTicks>
          <isQuestTimeout>true</isQuestTimeout>
          <inSignalDisable>Kiiro_BonfireParty.MapGenerated</inSignalDisable>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestExpired">Quest expired: [resolvedQuestName]</label>
                <text TKey="LetterTextQuestExpired">The bonfire party of [kiiro_settlement_label] has concluded successfully.</text>
              </li>
              <li Class="QuestNode_SendSignals">
                <outSignals>Timeout</outSignals>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

        <li Class="QuestNode_End">
          <inSignal>Kiiro_BonfireParty.Resolved</inSignal>
          <outcome>Success</outcome>
        </li>

        <li Class="Kiiro_Event.QuestNode_GetKiiroFaction">
          <storeAs>faction</storeAs>
        </li>
        <!-- 派系敌对则结束任务 -->
        <li Class="QuestNode_Signal">
          <inSignal>faction.BecameHostileToPlayer</inSignal>
          <node Class="QuestNode_Sequence">
            <nodes>
              <li Class="QuestNode_Letter">
                <label TKey="LetterLabelQuestExpired">[resolvedQuestName] failed</label>
                <text TKey="LetterTextQuestExpired">Due to the hostile relationship with the kiiros, [resolvedQuestName] cannot be completed further.</text>
              </li>
              <li Class="QuestNode_DestroyWorldObject">
                <worldObject>$Kiiro_BonfireParty</worldObject>
              </li>
              <li Class="QuestNode_End">
                <outcome>Fail</outcome>
              </li>
            </nodes>
          </node>
        </li>

      </nodes>
    </root>
  </QuestScriptDef>
</Defs>