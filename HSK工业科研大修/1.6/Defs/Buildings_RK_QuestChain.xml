<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- ============================================================================
  P1 · M2 探索链设施(2026-08-28): 信鸽站 / 信使台 / 探秘桌 + 三类链接件
  对标 MO 的 DankPyon_BirdPost / MessengerPost / QuestFinder(探险家工作台)体系。
  与 MO 的关键差异:
   1) 不引 MO 的 Building_QuestScanner / CompQuestFinder / GameComponent_QuestFinder,
      改用本 mod 自研 BlueprintUnlockHSK.CompQuestFinderHSK(见 Source/QuestFinderHSK.cs);
   2) 扫描由**小人工作量**改为**玩家点击 + 消耗残页情报**(事件驱动, 零 tick, AGENTS §9);
   3) 三级门槛沿用 MO 的"链接件数量"设计: 1 / 5 / 9 件解锁 1~3 级线索。
  链接件=原版 CompProperties_Facility(无需代码), 探秘桌=原版 CompProperties_AffectedByFacilities
  + 自研 comp。贴图全部取自本 mod 已拷入的 MO 资源, 相对路径不变。
============================================================================ -->

	<ThingDef Name="RK_QuestLinkBase" ParentName="BuildingBase" Abstract="True">
		<category>Building</category>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>70</pathCost>
		<fillPercent>0.35</fillPercent>
		<size>(1,1)</size>
		<rotatable>true</rotatable>
		<tickerType>Never</tickerType>
		<statBases>
			<MaxHitPoints>80</MaxHitPoints>
			<WorkToBuild>1200</WorkToBuild>
			<Flammability>0.6</Flammability>
		</statBases>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- ============ 主体: 探秘桌(扫描入口) ============ -->
	<ThingDef ParentName="BuildingBase">
		<defName>RK_QuestFinder</defName>
		<label>探秘桌</label>
		<description>一张摊满地图、信笺与线绳的长桌。把攒下的残页情报拼合在这里, 就能推出附近还没被人搜过的据点大概位置。\n\n周围摆放的信鸽站、信使台、档案柜、古基座与古球越多, 能推演出的目标就越深——一级线索只要一件链接物, 二级要五件, 三级要九件。</description>
		<thingClass>Building_WorkTable</thingClass>
		<category>Building</category>
		<altitudeLayer>Building</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>120</pathCost>
		<fillPercent>0.5</fillPercent>
		<size>(2,2)</size>
		<rotatable>true</rotatable>
		<tickerType>Never</tickerType>
		<hasInteractionCell>true</hasInteractionCell>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<designationCategory>Misc</designationCategory>
		<uiOrder>2100</uiOrder>
		<graphicData>
			<texPath>Things/Building/Furniture/RoyalTable2x2</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>180</MaxHitPoints>
			<WorkToBuild>6000</WorkToBuild>
			<Mass>60</Mass>
			<Flammability>0.5</Flammability>
			<Beauty>14</Beauty>
		</statBases>
		<costList>
			<WroughtIron>40</WroughtIron>
			<ComponentMedieval>4</ComponentMedieval>
					<ComponentIndustrial>2</ComponentIndustrial>
		</costList>
		<costStuffCount>150</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>RK_BirdPost</li>
					<li>RK_MessengerPost</li>
					<li>RK_ArchiveCabinet</li>
					<li>RK_OldPedestal</li>
					<li>RK_AncientOrb</li>
				</linkableFacilities>
			</li>
			<li Class="BlueprintUnlockHSK.CompProperties_QuestFinderHSK"/>
		</comps>
		<modExtensions>
			<li Class="BlueprintUnlockHSK.QuestFinderProperties">
				<noteCost>
					<li>3</li>
					<li>4</li>
					<li>6</li>
				</noteCost>
				<tierThreshold>
					<li>1</li>
					<li>5</li>
					<li>9</li>
				</tierThreshold>
				<questScripts>
					<li>OpportunitySite_ItemStash</li>
					<li>OpportunitySite_BanditCamp</li>
					<li>OpportunitySite_BanditCamp</li>
				</questScripts>
				<tierPoints>
					<li>600</li>
					<li>1200</li>
					<li>2200</li>
				</tierPoints>
				<minDaysBetweenScans>3</minDaysBetweenScans>
			</li>
		</modExtensions>
	</ThingDef>

	<!-- ============ 链接件 1: 信鸽站 ============ -->
	<ThingDef ParentName="RK_QuestLinkBase">
		<defName>RK_BirdPost</defName>
		<uiIconPath>Things/Building/Misc/BirdPost</uiIconPath>
		<label>信鸽站</label>
		<description>架在墙头的鸽笼与跳板。养一窝信鸽, 消息就能在几十公里内当天往返——探秘桌推演线索时最缺的就是这种新鲜情报。</description>
		<graphicData>
			<texPath>Things/Building/Misc/BirdPost</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
		<costList>
			<ComponentMedieval>1</ComponentMedieval>
		</costList>
		<costStuffCount>45</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<statBases>
			<Beauty>4</Beauty>
		</statBases>
		<comps>
			<li Class="CompProperties_Facility">
				<maxDistance>6</maxDistance>
				<maxSimultaneous>1</maxSimultaneous>
				<statOffsets>
					<Beauty>4</Beauty>
				</statOffsets>
			</li>
		</comps>
	</ThingDef>

	<!-- ============ 链接件 2: 信使台 ============ -->
	<ThingDef ParentName="RK_QuestLinkBase">
		<defName>RK_MessengerPost</defName>
		<label>信使台</label>
		<description>一张靠背长凳加一只信箱, 雇来的信使在这里接单。与信鸽站配套时, 探秘桌才敢把线索推得更远。</description>
		<graphicData>
			<texPath>Things/Building/Storage/ShelfFilledA</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2.8,2.2)</drawSize>
		</graphicData>
		<size>(2,1)</size>
		<uiIconPath>Things/Building/Storage/ShelfFilledA_north</uiIconPath>
		<costStuffCount>60</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<comps>
			<li Class="CompProperties_Facility">
				<maxDistance>6</maxDistance>
				<maxSimultaneous>1</maxSimultaneous>
			</li>
		</comps>
	</ThingDef>

	<!-- ============ 链接件 3: 探险家档案柜 ============ -->
	<ThingDef ParentName="RK_QuestLinkBase">
		<defName>RK_ArchiveCabinet</defName>
		<uiIconPath>Things/Building/Ruin/RuinedBookshelf</uiIconPath>
		<label>探险家档案柜</label>
		<description>一格格编了号的卷宗柜: 路线、地形、目击记录、失踪商队的清单。它能存下九张残页情报, 也能让拼合工作有据可查。</description>
		<graphicData>
			<texPath>Things/Building/Ruin/RuinedBookshelf</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(2,2)</drawSize>
		</graphicData>
		<costList>
			<WroughtIron>15</WroughtIron>
		</costList>
		<costStuffCount>75</costStuffCount>
		<stuffCategories>
			<li>Woody</li>
		</stuffCategories>
		<statBases>
			<Beauty>6</Beauty>
		</statBases>
		<comps>
			<li Class="CompProperties_Facility">
				<maxDistance>6</maxDistance>
				<maxSimultaneous>3</maxSimultaneous>
				<statOffsets>
					<Beauty>6</Beauty>
				</statOffsets>
			</li>
		</comps>
	</ThingDef>

	<!-- ============ 链接件 4: 古基座(邪教线索) ============ -->
	<ThingDef ParentName="RK_QuestLinkBase">
		<defName>RK_OldPedestal</defName>
		<label>古基座</label>
		<description>从旧神殿里搬回来的石座, 底部刻着无人能读的符号。把它摆在探秘桌旁, 残页上那些"邪教标记"忽然就读得通了。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/Decoration/TallColumn</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.6,1.6)</drawSize>
		</graphicData>
		<costList>
			<WroughtIron>10</WroughtIron>
		</costList>
		<costStuffCount>120</costStuffCount>
		<stuffCategories>
			<li>Stony</li>
		</stuffCategories>
		<statBases>
			<Beauty>10</Beauty>
		</statBases>
		<researchPrerequisites>
			<li>Stonecutting</li>
		</researchPrerequisites>
		<comps>
			<li Class="CompProperties_Facility">
				<maxDistance>6</maxDistance>
				<maxSimultaneous>2</maxSimultaneous>
				<statOffsets>
					<Beauty>10</Beauty>
				</statOffsets>
			</li>
		</comps>
	</ThingDef>

	<!-- ============ 链接件 5: 古球(最高级线索) ============ -->
	<ThingDef ParentName="RK_QuestLinkBase">
		<defName>RK_AncientOrb</defName>
		<uiIconPath>Things/Building/Furniture/AncientOrb/Orb</uiIconPath>
		<label>古球</label>
		<description>一颗打磨得过分光滑的石球, 内部的纹路像是某种星图。没人知道它从哪来, 但拼合线索时, 它会让桌上的地图"自己对齐"。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/AncientOrb/Orb</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1.4,1.4)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costList>
			<GoldBar>15</GoldBar>
			<WroughtIron>10</WroughtIron>
		</costList>
		<statBases>
			<Beauty>18</Beauty>
			<WorkToBuild>9000</WorkToBuild>
		</statBases>
		<comps>
			<li Class="CompProperties_Facility">
				<maxDistance>6</maxDistance>
				<maxSimultaneous>1</maxSimultaneous>
				<statOffsets>
					<Beauty>18</Beauty>
				</statOffsets>
			</li>
		</comps>
	</ThingDef>

</Defs>
