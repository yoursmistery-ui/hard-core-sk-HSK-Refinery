<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!--绮罗中世纪远程武器=-->
	<!--绮罗柳叶飞刀-->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_ThrowingKnife"]</xpath>
		<value>
			<thingClass>CombatExtended.AmmoThing</thingClass>
			<stackLimit>75</stackLimit>
			<resourceReadoutPriority>First</resourceReadoutPriority>
			<techLevel>Medieval</techLevel>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationAttributeSet">
		<xpath>Defs/ThingDef[defName="Kiiro_ThrowingKnife"]</xpath>
		<attribute>Class</attribute>
		<value>CombatExtended.AmmoDef</value>
	</Operation>
	
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Kiiro_ThrowingKnife</defName>
		<statBases>
			<Mass>0.1</Mass>
			<Bulk>0.2</Bulk>
			<MarketValue>2</MarketValue>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			<SightsEfficiency>1.0</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>0.9</SwayFactor>
		</statBases>
		<Properties>
			<label>Throw Throwing Knife</label>
			<recoilAmount>0.25</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCEOneUse</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<range>15.9</range>
			<warmupTime>0.1</warmupTime>
			<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			<soundCast>ThrowGrenade</soundCast>
			<defaultProjectile>KiiroProjectile_ThrowingKnife</defaultProjectile>
		</Properties>
		<weaponTags>
			<li>CE_OneHandedWeapon</li>
			<li>Kiiro_ThrowingKnife</li>
			<li>Kiiro_Darts</li>
			<li>Kiiro_MedievalRangeWeapon</li>
		</weaponTags>
	</Operation>
	
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Kiiro_ThrowingKnife"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>blade</label>
					<capacities>
						<li>Cut</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.2</cooldownTime>
					<armorPenetrationSharp>3.5</armorPenetrationSharp>
					<armorPenetrationBlunt>1.75</armorPenetrationBlunt>
				</li>
			</tools>
		</value>
	</Operation>
	
	<!--删除绮罗柳叶飞刀制作-->
	<Operation Class="PatchOperationRemove">
		<xpath>/Defs/ThingDef[defName="Kiiro_ThrowingKnife"]/costList</xpath>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Kiiro_ThrowingKnife"]/recipeMaker</xpath>
		<value>
			<recipeMaker Inherit="false" IsNull="true"/>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="Kiiro_ThrowingKnife"]/smeltable</xpath>
		<value>
			<smeltable>false</smeltable>
		</value>
	</Operation>
	
	<!-- 绮罗柳叶飞刀投射物 -->
	<Operation Class="PatchOperationReplace">
		<xpath>/Defs/ThingDef[defName="KiiroProjectile_ThrowingKnife"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<damageDef>ArrowHighVelocity</damageDef>
				<armorPenetrationSharp>6</armorPenetrationSharp>
				<armorPenetrationBlunt>2</armorPenetrationBlunt>
				<damageAmountBase>12</damageAmountBase>
				<stoppingPower>0.2</stoppingPower>
				<speed>85</speed>
			</projectile>
		</value>
	</Operation>
	
	<!-- 兼容性考量 -->
	<Operation Class="PatchOperationRemove">
		<xpath>/Defs/ThingDef[defName="KiiroProjectile_ThrowingKnife"]/thingClass</xpath>
	</Operation>
	
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName="Kiiro_ThrowingKnife"]/comps</xpath>
				<success>Invert</success>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>/Defs/ThingDef[defName="Kiiro_ThrowingKnife"]</xpath>
				<value>
					<comps />
				</value>
			</li>
		</operations>
	</Operation>
	
	
