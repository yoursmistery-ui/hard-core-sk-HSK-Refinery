<LanguageData>
  <!-- 近战动画HSK (co.uk.epicguru.meleeanimation) 处决相关键补译 -->
  <AM.Exec.FloatMenu>处决 {0}</AM.Exec.FloatMenu>
  <AM.Exec.FloatMenu.Tip>对{1}执行处决动作。\n可能的结果取决于武器、近战技能、护甲、mod设置等：\n{2}</AM.Exec.FloatMenu.Tip>
  <AM.Exec.FloatMenu.Walk>（走向目标）</AM.Exec.FloatMenu.Walk>
  <AM.Exec.FloatMenu.Lasso>（套索拉拽）</AM.Exec.FloatMenu.Lasso>

  <AM.Error.Exec.FloatMenu>无法处决：{0}</AM.Error.Exec.FloatMenu>
