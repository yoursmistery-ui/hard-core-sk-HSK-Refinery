<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- 乡村装饰与艺术建筑
     来源: Medieval Overhaul 1.6.2.2 Buildings_Art/Art_Vases/Banners/Decoration/Loot 纯原版类 def 移植(2026-08-27),
     前缀统一 Rustic_; 跳过冰雕系列(MO 融化 comp/MO minified 类依赖 DLL)。
     材料映射: Clay→SoftClay, Linen→Cloth, Paper→Cloth, IronIngot→Iron, Ale→Beer, Mead/Wine/IceWine/GriffonWine→Alcohol_Wine,
     MulberryWine→Alcohol_BerryWine, 宝石(Ruby/Emerald/Sapphire)→Jade; Gems 材质档删除; 研究 RusticFurniture→ComplexFurniture。
     dominantStyleCategory(MO 旧世界观风格)与 MO modExtensions 已剥离; 菜单统一挂 Furniture 下"乡村装饰"子分类。 -->

	<!--==================== 基类 ====================-->
	<ThingDef ParentName="SculptureBase" Name="Rustic_SculptureBase" Abstract="True">
		<rotatable>false</rotatable>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>Accessories</designationCategory>
	</ThingDef>

	<!-- 古物基类: 不经雕刻台, 直接建造 -->
	<ThingDef ParentName="Rustic_SculptureBase" Name="Rustic_AncientArtBase" Abstract="True">
		<recipeMaker>
			<recipeUsers Inherit="False"/>
		</recipeMaker>
	</ThingDef>

	<!-- 2x2 巨型古迹基类 -->
	<ThingDef ParentName="Rustic_AncientArtBase" Name="Rustic_GrandSculptureBase" Abstract="True">
		<fillPercent>0.5</fillPercent>
		<size>(2,2)</size>
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<Beauty>600</Beauty>
			<Mass>28</Mass>
			<WorkToMake>205000</WorkToMake>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">60</StyleDominance>
		</statBases>
		<stuffCategories Inherit="False">
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>400</costStuffCount>
		<castEdgeShadows>true</castEdgeShadows>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
	</ThingDef>

	<!-- 桌面摆件基类 -->
	<ThingDef ParentName="FurnitureBase" Name="Rustic_OnTopTableBase" Abstract="True">
		<graphicData>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(2,2)</drawSize>
			<damageData>
				<enabled>false</enabled>
			</damageData>
		</graphicData>
		<uiIconScale>0.85</uiIconScale>
		<uiIconOffset>(0, 0.25)</uiIconOffset>
		<building>
			<paintable>false</paintable>
			<isEdifice>false</isEdifice>
		</building>
		<size>(1,1)</size>
		<surfaceType>Item</surfaceType>
		<canOverlapZones>false</canOverlapZones>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<wipesPlants>true</wipesPlants>
		<passability>Standable</passability>
		<pathCost>0</pathCost>
		<clearBuildingArea>false</clearBuildingArea>
		<statBases>
			<MaxHitPoints>50</MaxHitPoints>
			<Mass>1</Mass>
			<WorkToBuild>10</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>3</Beauty>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">3</StyleDominance>
		</statBases>
		<comps>
			<li Class="CompProperties_Styleable" Inherit="False"/>
		</comps>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<designationCategory>Accessories</designationCategory>
	</ThingDef>

	<DesignatorDropdownGroupDef>
		<defName>Rustic_Beverages</defName>
		<label>乡村酒饮摆件</label>
	</DesignatorDropdownGroupDef>
	<ThingDef ParentName="Rustic_OnTopTableBase" Name="Rustic_BeveragesGroup" Abstract="True">
		<designatorDropdown>Rustic_Beverages</designatorDropdown>
		<resourcesFractionWhenDeconstructed>0</resourcesFractionWhenDeconstructed>
	</ThingDef>

	<DesignatorDropdownGroupDef>
		<defName>Rustic_ScribeTools</defName>
		<label>乡村抄写工具摆件</label>
	</DesignatorDropdownGroupDef>
	<ThingDef ParentName="Rustic_OnTopTableBase" Name="Rustic_ScribeToolsGroup" Abstract="True">
		<designatorDropdown>Rustic_ScribeTools</designatorDropdown>
	</ThingDef>

	<ThingDef ParentName="Rustic_OnTopTableBase" Name="Rustic_KitchenGroup_Base" Abstract="True">
		<stuffCategories Inherit="False">
			<li>Woody</li>
			<li>Metallic</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>15</costStuffCount>
	</ThingDef>

	<DesignatorDropdownGroupDef>
		<defName>Rustic_ResearchTools</defName>
		<label>乡村研究炼金摆件</label>
	</DesignatorDropdownGroupDef>
	<ThingDef ParentName="Rustic_OnTopTableBase" Name="Rustic_ResearchToolsGroup" Abstract="True">
		<designatorDropdown>Rustic_ResearchTools</designatorDropdown>
	</ThingDef>

	<!-- 横幅基类 -->
	<ThingDef ParentName="FurnitureWithQualityBase" Name="Rustic_BannerBase" Abstract="True">
		<description>染色的亚麻长幡, 悬挂起来宣示领主的旗号。</description>
		<designationCategory>Accessories</designationCategory>
		<passability>PassThroughOnly</passability>
		<fillPercent>0.25</fillPercent>
		<pathCost>0</pathCost>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>750</WorkToBuild>
			<Mass>10</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>20</Beauty>
		</statBases>
		<stuffCategories Inherit="False">
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>20</costStuffCount>
		<costList>
			<Cloth>40</Cloth>
		</costList>
		<holdsRoof>false</holdsRoof>
		<canOverlapZones>false</canOverlapZones>
		<fertility>0</fertility>
		<graphicData>
			<drawSize>(3,3)</drawSize>
			<drawOffset>(0,0,0.4)</drawOffset>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(0.3, 0.5, 0.3)</volume>
				<offset>(0,0,-0.23)</offset>
			</shadowData>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<uiIconScale>0.5</uiIconScale>
		<rotatable>true</rotatable>
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
	</ThingDef>

	<!-- 不可建造的阵营旗帜(战利品/生成物) -->
	<ThingDef ParentName="Rustic_BannerBase" Name="Rustic_NonBuildableBanners" Abstract="True">
		<designationCategory Inherit="false"/>
		<stuffCategories Inherit="False"/>
		<costStuffCount Inherit="False"/>
		<costList Inherit="False"/>
		<researchPrerequisites Inherit="False"/>
	</ThingDef>

	<!-- 战利品装饰基类(原 MO 废墟发现物, 本地化为可建造的收藏陈设; MO 专属 modExtensions 已剥离) -->
	<ThingDef ParentName="BuildingBase" Name="Rustic_LootDecorBase" Abstract="True">
		<altitudeLayer>BuildingOnTop</altitudeLayer>
		<passability>PassThroughOnly</passability>
		<pathCost>20</pathCost>
		<useHitPoints>true</useHitPoints>
		<minifiedDef>MinifiedThing</minifiedDef>
		<fillPercent>0.35</fillPercent>
		<rotatable>false</rotatable>
		<clearBuildingArea>false</clearBuildingArea>
		<thingCategories>
			<li>BuildingsArt</li>
		</thingCategories>
		<size>(1,1)</size>
		<building>
			<isEdifice>false</isEdifice>
		</building>
		<statBases>
			<Flammability>0</Flammability>
			<SellPriceFactor>1.10</SellPriceFactor>
			<MeditationFocusStrength>0.0</MeditationFocusStrength>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">10</StyleDominance>
		</statBases>
		<tradeTags>
			<li>Rustic_Loot</li>
		</tradeTags>
		<comps>
			<li Class="CompProperties_Styleable"/>
		</comps>
		<designationCategory>Accessories</designationCategory>
		<researchPrerequisites Inherit="False">
			<li>ComplexFurniture</li>
		</researchPrerequisites>
	</ThingDef>

