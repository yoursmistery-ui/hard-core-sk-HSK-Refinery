  </Operation><!-- ============================================================================
       Compatibility: 鼠族家具拓展 (local.ratkinfurniture / fxz.ratkinfaction)
       Maps the ratkin furniture mod's worker-operated production benches to the matching
       animated tool by appending their defNames to existing tools' <workbenchDefs>. These
       benches are Building_WorkTable driven by the standard DoBill job (they carry their
       own <recipes> — or inherit them from the mod's BenchBase — and Core_SK's generic
       DoBill workgiver serves them), so the same hand-tool that fits the vanilla bench
       fits the ratkin one.

       Gated on /Defs/ThingDef[defName="RKFC_GL_TableButcher"] (a ratkin-furniture-only
       bench the vanilla/HSK never define) instead of PatchOperationFindMod — an xpath
       existence gate is the definitive guard and is inert when the mod isn't loaded.

       Bench -> tool:
         cooking     RKFC_GL_Bonfire / RKFC_GL_ElectricStove / RKFC_RGK_FueledStove
                     -> spoon (cook stir + steam)
         butchering  RKFC_GL_TableButcher -> cleaver chop
         smithing    RKFC_GL_ElectricSmithy / RKFC_GL_FueledSmithy
                     -> bench welder + mask (= vanilla smithies)
         workbench   RK_HandMsWorkbench / RK_ElectricMsWorkbench
                     -> sewing needle (the workbench serves the tailoring/apparel line)
       ============================================================================ -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="RKFC_GL_TableButcher"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- ===== Cooking: spoon (stir + steam) ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Spoon"]/workbenchDefs</xpath>
          <value>
            <li>RKFC_GL_Bonfire</li>
            <li>RKFC_GL_ElectricStove</li>
            <li>RKFC_RGK_FueledStove</li>
          </value>
        </li>

        <!-- ===== Butchering: cleaver chop ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Cleaver"]/workbenchDefs</xpath>
          <value>
            <li>RKFC_GL_TableButcher</li>
          </value>
        </li>

        <!-- ===== Smithing: bench welder + mask ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_BenchWelder"]/workbenchDefs</xpath>
          <value>
            <li>RKFC_GL_ElectricSmithy</li>
            <li>RKFC_GL_FueledSmithy</li>
          </value>
        </li>

        <!-- ===== Workbench (tailoring/apparel line): sewing needle ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Needle"]/workbenchDefs</xpath>
          <value>
            <li>RK_HandMsWorkbench</li>
            <li>RK_ElectricMsWorkbench</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation><!-- ============================================================================
       Compatibility: Stoneborn - Cuisine (det.sbcuisine)
       Maps the mod's two worker-operated cooking benches to the cooking spoon (stir +
       rising steam) by appending them to JE_Tool_Spoon's <workbenchDefs>. Gated behind
       PatchOperationFindMod (matched on the mod's display NAME), so nothing touches our
       defs when the mod isn't loaded.

       Worker benches (Building_WorkTable, Cooking-skill DoBill recipes):
         SC_HotGrill  (hot grill)         -> grilling skewers & rockburgers
         SC_PrepTable (preparation bench) -> preparing dough / fresh cheese

       Skipped on purpose — every other Stoneborn building is an AUTOMATIC processor with
       no continuous "working" toil for a colonist to animate over (the pawn only hauls
       ingredients in): dwarven kiln, portable pot, archotech microwave (PipeSystem
       AdvancedResourceProcessor), curing rack (Processor Framework), and the insectiary
       (a passive jelly spawner).
       ============================================================================ -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Stoneborn - Cuisine</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Spoon"]/workbenchDefs</xpath>
      <value>
        <li>SC_HotGrill</li>
        <li>SC_PrepTable</li>
      </value>
    </match>
  </Operation><!-- ============================================================================
       Compatibility: Vanilla Furniture Expanded - Production (VanillaExpanded.VFEProduction)
       Maps VFE-P's "large"/electric/fueled workbenches to the matching animated tool by
       appending their defNames to existing tools' <workbenchDefs>. Every op is gated behind
       PatchOperationFindMod (matched on the mod's display NAME — PatchOperationFindMod uses
       ModLister.HasActiveModWithName), so nothing touches our defs when VFE-P isn't loaded.

       These benches are all Building_WorkTable(_HeatPush) that inherit the vanilla recipe set
       via VEF's RecipeInheritanceExtension, so the same hand-tool that fits the vanilla bench
       fits the VFE-P one. No new JobToolDefs or sprites are needed — pure workbenchDefs appends.

       Bench -> tool:
         large stove                  -> spoon (cook stir + steam)
         large tailoring table        -> sewing needle
         large machining table        -> metalworking chisel
         assembly (component) bench   -> metalworking chisel (= vanilla FabricationBench)
         large electric smithy        -> bench welder + mask
         electric butcher             -> cleaver chop
         electric drug lab            -> drug-lab pour flask
         fueled smelter               -> glowing smelt rod
         electric stonecutter's table -> bench chisel + mallet
       ============================================================================ -->

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Vanilla Furniture Expanded - Production</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- Cooking: large stove. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Spoon"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableStoveLarge</li>
          </value>
        </li>

        <!-- Tailoring: large tailoring table. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Needle"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableTailorLarge</li>
          </value>
        </li>

        <!-- Machining / fabrication: large machining table + assembly (component) bench. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_MetalChisel"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableMachiningLarge</li>
            <li>VFE_ComponentFabricationBench</li>
          </value>
        </li>

        <!-- Smithing: large electric smithy (bench welder + mask, like the vanilla smithies). -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_BenchWelder"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableSmithyLarge</li>
          </value>
        </li>

        <!-- Butchering: electric butcher. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Cleaver"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableButcherElectric</li>
          </value>
        </li>

        <!-- Drugs: electric drug lab. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_DrugSpoon"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableDrugLabElectric</li>
          </value>
        </li>

        <!-- Smelting: fueled smelter. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_SmeltRod"]/workbenchDefs</xpath>
          <value>
            <li>VFE_FueledSmelter</li>
          </value>
        </li>

        <!-- Stonecutting: electric stonecutter's table. -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_BenchChisel"]/workbenchDefs</xpath>
          <value>
            <li>VFE_TableStonecutterElectric</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation><!-- ============================================================================
       Compatibility: Vile's Materials Science / Metallurgy / Hell Bent for Leather
       Tanning (vitech.materialsscience / vitech.metallurgy / vitech.leathertanning)
       Maps Vile's worker-operated production benches to the matching animated tool by
       appending their defNames to existing tools' <workbenchDefs>. All of these benches
       are SK_WorkTable-driven DoBill tables (worked via Core_SK's own WorkGiverDefs —
       DoBillsSmeltMetal_Hand / DoBillsTableChemlab / DoBillsTanningDrum / etc.), so the
       same hand-tool that fits the vanilla/HSK bench fits the Vile one.

       Gated on /Defs/ThingDef[defName="ChemistryLab"] (a Vile-Materials-Science bench the
       vanilla/HSK never define) instead of PatchOperationFindMod — an xpath existence gate
       is the definitive guard and is inert when Vile's Materials Science isn't loaded.
       The Metallurgy / Leather-Tanning benches ride the same gate: they are only ever
       played in a colony that has Materials Science enabled too, and if a bench def is
       absent its name is simply an inert string in the list.

       Bench -> tool:
         smelting/refining  ElectrolyticRefinery / InductionFurnace / Bloomery / Foundry /
                            FirePit -> smelt rod (hover + embers)
         chemistry          ChemistryLab -> drug-lab pour flask (chem mixing)
         leather tanning    BriningStation / DyeingStation / TanningDrum -> drug-lab pour
                            flask (brine/dye/tan liquor work)
         deep-frying        Fryer -> spoon (cook stir + steam)
         pottery            PotteryStation -> bench chisel + mallet (hand-thrown clay)
         ore crushing       StampMill -> metal chisel (crushing/milling ore)

       Skipped on purpose — no suitable DoBill tool exists for these (a non-DoBill tool's
       workbenchDefs would gate its own job away, see Compat_HSK.xml):
         ChoppingBlock / LogSplittingSpot (firewood/planks — the saw is a non-DoBill tool)
       ============================================================================ -->

  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ChemistryLab"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>

        <!-- ===== Smelting / refining: smelt rod ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_SmeltRod"]/workbenchDefs</xpath>
          <value>
            <li>ElectrolyticRefinery</li>
            <li>InductionFurnace</li>
            <li>Bloomery</li>
            <li>Foundry</li>
            <li>FirePit</li>
          </value>
        </li>

        <!-- ===== Chemistry: pour flask ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_DrugSpoon"]/workbenchDefs</xpath>
          <value>
            <li>ChemistryLab</li>
          </value>
        </li>

        <!-- ===== Leather tanning (brine / dye / tan): pour flask ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_DrugSpoon"]/workbenchDefs</xpath>
          <value>
            <li>BriningStation</li>
            <li>DyeingStation</li>
            <li>TanningDrum</li>
          </value>
        </li>

        <!-- ===== Deep-frying: spoon ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_Spoon"]/workbenchDefs</xpath>
          <value>
            <li>Fryer</li>
          </value>
        </li>

        <!-- ===== Pottery: bench chisel + mallet ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_BenchChisel"]/workbenchDefs</xpath>
          <value>
            <li>PotteryStation</li>
          </value>
        </li>

        <!-- ===== Ore crushing: metal chisel ===== -->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/JobEffects.JobToolDef[defName="JE_Tool_MetalChisel"]/workbenchDefs</xpath>
          <value>
            <li>StampMill</li>
          </value>
        </li>

      </operations>
    </match>
  </Operation></Patch>
