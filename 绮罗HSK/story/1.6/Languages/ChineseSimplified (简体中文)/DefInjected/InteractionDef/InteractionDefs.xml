<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: Merchant Gift -->
  <Kiiro_MerchantGift.label>商户赠礼</Kiiro_MerchantGift.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] talked with [RECIPIENT_nameDef]happily, and [INITIATOR_nameDef] send [RECIPIENT_nameDef] a gift.</li>
    <li>r_logentry->[INITIATOR_nameDef] have had a great conversastion with [RECIPIENT_nameDef], therefore [INITIATOR_nameDef] gifted a personal item to [RECIPIENT_nameDef].</li>
    <li>r_logentry->[INITIATOR_nameDef] gifted [RECIPIENT_nameDef] a local specialty.</li>
  -->
  <Kiiro_MerchantGift.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef]与[RECIPIENT_nameDef]相谈甚欢，[INITIATOR_nameDef]赠送了一件礼物给[RECIPIENT_nameDef]。</li>
    <li>r_logentry->[INITIATOR_nameDef]与[RECIPIENT_nameDef]聊的十分投机，[INITIATOR_nameDef]将自己的一件商品作为礼物赠送给[RECIPIENT_nameDef]以留作纪念。</li>
    <li>r_logentry->[INITIATOR_nameDef]赠送了[RECIPIENT_nameDef]一件土特产。</li>
  </Kiiro_MerchantGift.logRulesInitiator.rulesStrings>
  
  <!-- EN: Merchant Peddling -->
  <Kiiro_MerchantPeddle.label>商户兜售</Kiiro_MerchantPeddle.label>
  <!-- EN:
    <li>r_logentry->[INITIATOR_nameDef] tried to sell products to[RECIPIENT_nameDef] who gladly bought it.</li>
    <li>r_logentry->[INITIATOR_nameDef] tricked [RECIPIENT_nameDef] into buying an item with own pockets money.</li>
    <li>r_logentry->[RECIPIENT_nameDef] buyed form [INITIATOR_nameDef] their favoring items with their own pockets money.</li>
  -->
  <Kiiro_MerchantPeddle.logRulesInitiator.rulesStrings>
    <li>r_logentry->[INITIATOR_nameDef]向[RECIPIENT_nameDef]推销了一份自己的商品，[RECIPIENT_nameDef]欣然买下了它。</li>
    <li>r_logentry->[INITIATOR_nameDef]忽悠[RECIPIENT_nameDef]用自己的私房钱买下了一个小玩意。</li>
    <li>r_logentry->[RECIPIENT_nameDef]用零花钱在[INITIATOR_nameDef]那里购买了自己心仪的物品。</li>
  </Kiiro_MerchantPeddle.logRulesInitiator.rulesStrings>
  
</LanguageData>