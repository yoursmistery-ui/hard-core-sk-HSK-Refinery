        <hediff>Miho_Pariah_Hediff</hediff>
        <part>Head</part>
      </li>
    </value>
  </Operation>  <!-- Remove redundant hediff removal components for ALL optimized hediffs. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/HediffDef[
      defName="Miho_Magnifier_Hediff" or
      defName="Miho_TacticalAssist_Hediff" or
      defName="Miho_Glasses_Hediff" or
      defName="Miho_RoundGlasses_Hediff" or
      defName="Miho_SunGlasses_Hediff" or
      defName="Miho_Visor_Hediff" or
      defName="Miho_Toxmask_Hediff" or
      defName="Miho_EltexTalisman_Hediff" or
      defName="Miho_OrnatedCaptain_Hediff" or
      defName="Miho_OrnatedMiho_Hediff" or
      defName="Miho_OrnatedOne_Hediff" or
      defName="Miho_OrnatedTwo_Hediff" or
      defName="Miho_Medic_Hediff" or
      defName="Miho_EltexMask_Hediff" or
      defName="Miho_EltexCaptain_Hediff" or
      defName="Miho_Pariah_Hediff"
    ]/comps/li[@Class="HediffCompProperties_RemoveIfApparelDropped" or @Class="MonoTail.HediffCompProperties_RemoveIfApparelDropped"]</xpath>
  </Operation>

</Patch>
