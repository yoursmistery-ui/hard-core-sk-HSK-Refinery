        <defName>OA_RK_Oberonia_Aurea_Research</defName>
        <label>金鼠族农业科技</label>
        <description>研究金鸢尾兰的种植技艺与金鸢尾兰茶的冲泡方法,逐渐了解金鸢尾兰帝国本身。</description>
        <tab>Plants_SK</tab>
        <baseCost>600</baseCost>
        <techLevel>Medieval</techLevel>
        <prerequisites>
            <li>SewageSludgeComposting</li>
        </prerequisites>
        <researchViewX>3.00</researchViewX>
        <researchViewY>52.00</researchViewY>
    </ResearchProjectDef>

