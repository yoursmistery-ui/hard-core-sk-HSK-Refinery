<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="RK_ExoticShield">
		<defName>RK_TengPai</defName>
		<label>ratkin cane shield</label>
		<description>A simple shield woven from vines and treated with herbs to make it more
			defensive.
			Children can easily make it, careful not to get caught on fire.</description>
		<graphicData>
			<texPath>Item_Shield/RK_TengPai</texPath>
		</graphicData>
		<recipeMaker>
			<researchPrerequisite>Ratkin_Armor_B1</researchPrerequisite>
			<effectWorking>Tailor</effectWorking>
			<soundWorking>Recipe_Tailor</soundWorking>
			<recipeUsers Inherit="false">
				<li>RK_ElectricTailoringBench</li>
				<li>RK_HandTailoringBench</li>
				<li>CraftingSpot</li>
			</recipeUsers>
			<skillRequirements>
				<Crafting>1</Crafting>
			</skillRequirements>
		</recipeMaker>
		<costStuffCount>10</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<costList>
			<WoodLog>50</WoodLog>
			<MedicineHerbal>1</MedicineHerbal>
			<Steel>10</Steel>
			<ComponentMedieval>3</ComponentMedieval>
			<ComponentIndustrial>2</ComponentIndustrial>
			<LeadBar>20</LeadBar>
		</costList>
		<techLevel>Neolithic</techLevel>
		<statBases>
			<MaxHitPoints>120</MaxHitPoints>
			<WorkToMake>7000</WorkToMake>
			<Mass>1.2</Mass>
			<ArmorRating_Sharp>0.6</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.2</ArmorRating_Blunt>
			<ArmorRating_Heat>-0.2</ArmorRating_Heat>
			<Flammability>1.8</Flammability>
			<EquipDelay>0.5</EquipDelay>
		</statBases>
		<equippedStatOffsets>
			<!-- <MeleeDodgeChance>-3</MeleeDodgeChance> -->
			<Flammability>0.15</Flammability>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Soldier</li>
			</defaultOutfitTags>
			<layers>
				<li>OuterClothing</li>
			</layers>
			<tags>
				<li>RK_ExoticLightShield</li>
			</tags>
		</apparel>
		<comps>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponMelee</nameMaker>
				<descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
				<minQualityForArtistic>Awful</minQualityForArtistic>
			</li>
			<li Class="RatkinGeneExpanded.CompProperties_ShieldInfos">
				<isShield>true</isShield>
				<canUseRangedWeapon>false</canUseRangedWeapon>
				<useStuffColor>false</useStuffColor>
			</li>
		</comps>
	</ThingDef>


	<ThingDef ParentName="RK_ExoticShield">
