<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 通用石化气管网 · 2介质(天然气/氨)x 管/泵/阀/出料口 = 8建筑。氢气已并入天然气(2026-08-28)。
       管段用 VHGE(2877699803) GasPipe_Atlas 整图复用+只染有色像素: NG=绿 / NH3=琥珀, 分色绝不混输。
       阀门/出料口用 Vanilla Chemfuel Expanded(2792917473) 现成图(红铜阀 / 深铜阀 / 漏斗出料口)。
       研究挂位(v3): 天然气管网=石化工业I(随蒸馏塔与燃气发电机同期), 氨气管网=石化工业III(随氨储罐/合成氨精炼厂)。
       危害分工(v3 补齐, 原先 CompProperties_GasExplosive 写了却无人引用 = 死代码):
         天然气侧 管/阀/出料口 nominalUnits=6、气泵=30 → 被击毁按存量缩放 Flame 爆炸(玩家主动拆除不炸);
         氨侧一律不炸, 走 CompProperties_GasToxic 泄 ToxGas 毒云。 -->

  <!--==================== 天然气(I 档) ====================-->
  <ThingDef ParentName="BuildingBase">
    <defName>RK_Petro_GasPipe_NG</defName><label>天然气管</label>
    <description>输送天然气的连通管道, 自动沿同介质管段/端口拼接走线。仅同介质成网, 两种气体各走各色线, 绝不混输。</description>
    <thingClass>BlueprintUnlockHSK.Building_RKPipe</thingClass><tickerType>Never</tickerType>
    <graphicData><texPath>Things/Building/Linked/RK_Petro_GasPipe_NG_Atlas</texPath><graphicClass>Graphic_Single</graphicClass><linkType>Basic</linkType><linkFlags><li>Custom1</li></linkFlags><drawSize>(1,1)</drawSize><damageData><rect>(0,0.35,1,0.3)</rect></damageData></graphicData>
    <uiIconPath>Things/Building/RK_Petro_GasPipe_NG_MenuIcon</uiIconPath><uiIconScale>1.1</uiIconScale>
    <size>(1,1)</size><altitudeLayer>Conduits</altitudeLayer><passability>Standable</passability><pathCost>0</pathCost><fillPercent>0</fillPercent>
    <drawerType>MapMeshOnly</drawerType><rotatable>false</rotatable><neverMultiSelect>true</neverMultiSelect><clearBuildingArea>false</clearBuildingArea><coversFloor>false</coversFloor>
    <building><isInert>true</isInert><isEdifice>false</isEdifice><ai_chillDestination>false</ai_chillDestination></building>
    <statBases><MaxHitPoints>60</MaxHitPoints><WorkToBuild>260</WorkToBuild><Flammability>0.3</Flammability><Beauty>-1</Beauty></statBases>
    <costList><Pipe>2</Pipe></costList>
    <researchPrerequisites><li>RK_Petro_AtmosphericDistillation</li></researchPrerequisites><designationCategory>Rimefeller</designationCategory>
    <comps><li Class="BlueprintUnlockHSK.CompProperties_GasPort"><role>Pipe</role><gasType>NaturalGas</gasType></li><li Class="BlueprintUnlockHSK.CompProperties_GasExplosive"><minRadius>1.5</minRadius><perUnit>0.02</perUnit><maxRadius>4</maxRadius><nominalUnits>6</nominalUnits></li></comps>
  </ThingDef>
  <ThingDef ParentName="BuildingBase">
    <defName>RK_Petro_GasValve_NG</defName><label>天然气阀门</label>
    <description>切断/接通天然气管网的阀门, 关闭时该点从网络剔除, 用于分段或隔离供气管线。</description>
    <thingClass>Building</thingClass><tickerType>Never</tickerType>
    <graphicData><texPath>Things/Building/RK_Petro_GasValve_NG</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1,1)</drawSize><linkFlags><li>Custom1</li></linkFlags></graphicData>
