    <xpath>Defs/ThingDef[defName="BoulderBasalt"]/randomlyDropResources/li[ResourceDefName="RoughGem"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="BoulderBasalt"]/randomlyDropResources/li[ResourceDefName="RoughGem"]/DropProbability</xpath>
      <value><DropProbability>0.016</DropProbability></value>
    </match>
  </Operation>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="BoulderBasalt"]/randomlyDropResources</xpath>
