<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<ThingDef ParentName="RKGE_ApparelMakeableBaseNoColor">
		<defName>RK_Jirai</defName>
		<label>ratkin jirai outfit</label>
		<description>A common outfit worn by certain unapproachable Ratkin women, often featuring long sleeves and long socks.</description>
		<graphicData>
			<texPath>Apparel/RK_Jirai</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
		</graphicData>
		<statBases>
			<MaxHitPoints>130</MaxHitPoints>
			<WorkToMake>3500</WorkToMake>
			<Mass>0.3</Mass>
			<StuffEffectMultiplierArmor>0.17</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.42</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.20</StuffEffectMultiplierInsulation_Heat>
			<ArmorRating_Sharp>0.05</ArmorRating_Sharp>
			<Flammability>0.97</Flammability>
			<EquipDelay>1.7</EquipDelay>
		</statBases>
		<costStuffCount>85</costStuffCount>
		<stuffCategories>
			<li>Fabric</li>
			<li>Leathery</li>
		</stuffCategories>
		<equippedStatOffsets>
			<ResearchSpeed>0.12</ResearchSpeed>
			<SocialImpact>-0.15</SocialImpact>
			<MoveSpeed>0.12</MoveSpeed>
			<PainShockThreshold>0.22</PainShockThreshold>
		</equippedStatOffsets>
		<apparel>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Shoulders</li>
				<li>Arms</li>
				<li>Legs</li>
			</bodyPartGroups>
			<defaultOutfitTags>
				<li>Worker</li>
				<li>Soldier</li>
			</defaultOutfitTags>
			<wornGraphicPath>Apparel/RK_Jirai</wornGraphicPath>
			<useWornGraphicMask>true</useWornGraphicMask>
			<layers>
				<li>OnSkin</li>
			</layers>
			<tags>
				<li>RK_JiraiApparel</li>
				<li>RK_JiraiPlayer</li>
			</tags>
		</apparel>
		<comps>
			<li Class="RatkinGeneExpanded.CompProperties_Uncolorable" />
		</comps>
		<recipeMaker>
			<useIngredientsForColor>false</useIngredientsForColor>
		</recipeMaker>
	</ThingDef>

	<ThingDef ParentName="RKGE_ApparelMakeableBase">
		<defName>RK_GangShirt</defName>
		<label>ratkin gang outfit</label>
		<description>Some Ratkin gangs that are entrenched in the lower districts of certain cities like to wear simple clothing, mainly consisting of jackets with symbols representing their gang's power, durable work pants, and short boots that can hide a pistol or dagger. Ratkin dressed in this way often have dangerous criminal organizations behind them.</description>
		<graphicData>
			<texPath>Apparel/RK_Gang</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<onGroundRandomRotateAngle>0</onGroundRandomRotateAngle>
