    <!-- ────────── 武器熔炼产物 ×5(Spacer) ────────── -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_PlasmaTachi"]</xpath>
        <value><smeltProducts><Weapon_Parts>5</Weapon_Parts></smeltProducts></value>
    </Operation>

    <!-- ────────── 衣物/头饰可熔炼(按类别批量, not(smeltable) 防重复) ────────── -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[thingCategories/li[text()="Miho_Apparel"] and not(smeltable)]</xpath>
        <value><smeltable>true</smeltable></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[thingCategories/li[text()="Miho_Headgear"] and not(smeltable)]</xpath>
        <value><smeltable>true</smeltable></value>
    </Operation>
</Patch>
