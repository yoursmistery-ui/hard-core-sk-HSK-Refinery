	<!-- ================= 注入原版任务站点 ================= -->
	<!-- 波次6(2026-08-29): 原两个土匪营地 GenStepDef 合并为单池 —— GenStep_CustomStructureGen 对
	     structureLayoutDefs 随机选一, 池 = P1 小/中废墟 + MO 小藏身处/匪徒废墟(布局在 HSK工业科研大修);
	     另修复全部符号 thingDef→thing(旧写法在 VEF 里是静默 no-op, 废墟此前并不生成)。 -->
	<GenStepDef>
		<defName>RK_GenStep_Ruin_Camp</defName>
		<linkWithSite>BanditCamp</linkWithSite>
		<order>460</order>
		<genStep Class="KCSG.GenStep_CustomStructureGen">
			<structureLayoutDefs>
				<li>RK_Struct_SmallRuin</li>
				<li>RK_Struct_MediumRuin</li>
				<li>RK_MO_SmallHideout1c</li>
				<li>RK_MO_SmallHideout2c</li>
				<li>RK_MO_Medium_Ruin_Brigand1c</li>
				<li>RK_MO_Medium_Ruin_Brigand2c</li>
			</structureLayoutDefs>
		</genStep>
	</GenStepDef>

	<GenStepDef>
