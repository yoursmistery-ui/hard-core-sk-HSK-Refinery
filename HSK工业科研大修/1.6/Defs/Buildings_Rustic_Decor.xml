	<ThingDef ParentName="Rustic_GrandSculptureBase">
		<defName>Rustic_Brazier2x2c</defName>
		<label>古方尖火盆</label>
		<description>顶端燃着火盆的古老纪念碑, 夜风中也烧得格外明亮, 是冥想者钟爱的火焰焦点。</description>
		<castEdgeShadows>true</castEdgeShadows>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Things/Building/Art/AncientBrazier2x2</texPath>
			<drawSize>(5,5)</drawSize>
			<shaderType>CutoutComplex</shaderType>
		</graphicData>
		<costList>
			<GoldBar>100</GoldBar>
		</costList>
		<tickerType>Normal</tickerType>
		<drawerType>RealtimeOnly</drawerType>
		<placeWorkers>
			<li>PlaceWorker_Heater</li>
			<li>PlaceWorker_MeditationOffsetBuildingsNear</li>
		</placeWorkers>
		<drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
		<comps>
			<li Class="CompProperties_Styleable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>18</glowRadius>
				<glowColor>(252,187,113,0)</glowColor>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>CompHeatPusherPowered</compClass>
				<heatPerSecond>6.5</heatPerSecond>
				<heatPushMaxTemperature>29</heatPushMaxTemperature>
			</li>
			<li Class="CompProperties_FireOverlay">
				<fireSize>1.5</fireSize>
				<offset>(0,0,1.9)</offset>
			</li>
			<li Class="CompProperties_MeditationFocus">
				<statDef>MeditationFocusStrength</statDef>
				<focusTypes><li>Flame</li></focusTypes>
				<offsets>
					<li Class="FocusStrengthOffset_Lit">
						<offset>0.1</offset>
					</li>
					<li Class="FocusStrengthOffset_BuildingDefsLit">
						<defs>
							<li>Campfire</li>
							<li>TorchLamp</li>
							<li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
							<li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
							<li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
						</defs>
						<offsetPerBuilding>0.01</offsetPerBuilding>
						<radius>9.9</radius>
						<maxBuildings>8</maxBuildings>
						<explanationKey>MeditationFocusPerFlame</explanationKey>
						<explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
					</li>
				</offsets>
			</li>
		</comps>
	</ThingDef>

