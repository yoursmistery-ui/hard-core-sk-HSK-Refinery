<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<!-- 1.6 deployable 57 mm infantry gun -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="Miho_DeployableAutocannon"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.Building_TurretGunCE</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Miho_Turret_InfantryGun"]/statBases</xpath>
		<value>
			<AimingAccuracy>0.5</AimingAccuracy>
		</value>
	</Operation>

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Miho_Turret_InfantryGun"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
	</Operation>

	<!--
		RimWorld 1.6's vanilla radius place worker only recognizes Verb_Shoot
		and Verb_Spray.  It dereferences null when this gun is converted to
		CE's Verb_ShootMortarCE, preventing the blueprint from being placed.
	-->
	<Operation Class="PatchOperationRemove">
		<!-- placeWorkers is declared on this abstract parent, before XML inheritance is resolved. -->
		<xpath>Defs/ThingDef[@Name="Miho_DeployableAutocannon"]/placeWorkers/li[.="PlaceWorker_ShowTurretRadius"]</xpath>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Miho_BuildingWeapon_InfantryGun</defName>
		<statBases>
			<RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
			<SightsEfficiency>2.00</SightsEfficiency>
			<ShotSpread>0.08</ShotSpread>
			<SwayFactor>1.40</SwayFactor>
			<Bulk>60</Bulk>
			<Mass>15</Mass>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_90mmCannonShell_HE</defaultProjectile>
			<warmupTime>2.25</warmupTime>
			<range>75</range>
			<minRange>9.9</minRange>
			<burstShotCount>1</burstShotCount>
			<soundCast>Miho_Mortar</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
			<circularError>0.8</circularError>
			<requireLineOfSight>false</requireLineOfSight>
			<indirectFirePenalty>0.2</indirectFirePenalty>
			<targetParams>
				<canTargetLocations>true</canTargetLocations>
			</targetParams>
		</Properties>
		<AmmoUser>
			<magazineSize>1</magazineSize>
			<reloadTime>4.5</reloadTime>
			<ammoSet>AmmoSet_90mmCannonShell</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>CE_AI_Launcher</li>
			<li>TurretGun</li>
		</weaponTags>
	</Operation>

	<!-- 1.6 abomination integrated weapons do not use inventory ammunition. -->
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="Miho_AbomiWeapon_MissileTurret"]/verbs/li[@Class="MihoLib.VerbProperties_ShotGun"]</xpath>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Miho_AbomiWeapon_MissileTurret</defName>
		<statBases>
			<RangedWeapon_Cooldown>20</RangedWeapon_Cooldown>
			<SightsEfficiency>1.80</SightsEfficiency>
			<ShotSpread>0.20</ShotSpread>
			<SwayFactor>0.30</SwayFactor>
			<Bulk>125</Bulk>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_80mmRocket_HE</defaultProjectile>
			<range>55</range>
			<minRange>18</minRange>
			<burstShotCount>2</burstShotCount>
			<ticksBetweenBurstShots>50</ticksBetweenBurstShots>
			<soundCast>Miho_Rocket</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
			<defaultCooldownTime>20</defaultCooldownTime>
			<linkedBodyPartsGroup>Neck</linkedBodyPartsGroup>
			<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
		</Properties>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>NoSwitch</li>
		</weaponTags>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Miho_AbomiWeapon_DeathBlink</defName>
		<statBases>
			<RangedWeapon_Cooldown>6.7</RangedWeapon_Cooldown>
			<SightsEfficiency>2.20</SightsEfficiency>
			<ShotSpread>0.05</ShotSpread>
			<SwayFactor>0.20</SwayFactor>
			<Bulk>60</Bulk>
		</statBases>
		<Properties>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Miho_AbomiWeapon_DeathBlink_Proj</defaultProjectile>
			<range>28.9</range>
			<minRange>1.9</minRange>
			<burstShotCount>1</burstShotCount>
			<soundCast>Bow_Large</soundCast>
			<soundCastTail>GunTail_Heavy</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
			<defaultCooldownTime>6.7</defaultCooldownTime>
			<linkedBodyPartsGroup>Neck</linkedBodyPartsGroup>
			<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
		</Properties>
		<FireModes>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>NoSwitch</li>
		</weaponTags>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Miho_AbomiWeapon_DeathBlink_Proj"]/thingClass</xpath>
		<value>
			<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Miho_AbomiWeapon_DeathBlink_Proj"]/projectile</xpath>
		<value>
			<projectile Class="CombatExtended.ProjectilePropertiesCE">
				<damageDef>Miho_MagicBombEMP</damageDef>
				<damageAmountBase>32</damageAmountBase>
				<armorPenetrationSharp>20</armorPenetrationSharp>
				<armorPenetrationBlunt>8</armorPenetrationBlunt>
				<stoppingPower>3</stoppingPower>
				<speed>110</speed>
				<explosionRadius>1.5</explosionRadius>
				<flyOverhead>false</flyOverhead>
			</projectile>
		</value>
	</Operation>
</Patch>
