    </Operation><!-- 53_材料外观补全(2026-08-11, 修复启动报错):
         Vile's Materials Science(vitech.materialsscience)的合金/复合材料 stuff 使用
         <appearance>Panel</appearance> / <appearance>Cladding</appearance>,
         而这两个 StuffAppearanceDef 只由 Vile's Hardcore Renovation
         (xenomacabre.HCSKwallsandfloorsreduxeno) 定义;
         当前 ModsConfig 未启用 Hardcore Renovation, 游戏加载时报
         "No Verse.StuffAppearanceDef named Panel/Cladding found ..." 交叉引用错误。
         本补丁在 Hardcore Renovation 未加载时补充这两个空标记定义(与 HR 原定义一致,
         仅 defName, 无贴图路径), 使 VMS 材质外观交叉引用正常解析;
         若日后启用 Hardcore Renovation, 条件不成立自动跳过, 不重复定义。 -->

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/StuffAppearanceDef[defName="Panel"]</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
                <StuffAppearanceDef>
                    <defName>Panel</defName>
                </StuffAppearanceDef>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/StuffAppearanceDef[defName="Cladding"]</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs</xpath>
            <value>
                <StuffAppearanceDef>
                    <defName>Cladding</defName>
                </StuffAppearanceDef>
            </value>
        </nomatch>
    </Operation></Patch>
