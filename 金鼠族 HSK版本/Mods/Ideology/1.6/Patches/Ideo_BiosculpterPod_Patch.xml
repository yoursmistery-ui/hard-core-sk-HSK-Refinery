        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]</xpath>
            <value>
                <conflictingMemes>
                    <li>OAGene_TerritorialHegemony</li>
                </conflictingMemes>
            </value>
        </nomatch>
    </Operation-->

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "Corpses_DontCare"]/associatedMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "Corpses_DontCare"]/requiredMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName = "IdeoRole_ShootingSpecialist" or defName = "IdeoRole_MeleeSpecialist"]/requiredMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation><Operation Class="PatchOperationConditional">
        <xpath>Defs/PreceptDef[defName="IdeoBuilding"]/buildingRoomRequirements/li[@Class="RoomRequirement_ThingCount" and thingDef="Column"]</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/PreceptDef[defName="IdeoBuilding"]/buildingRoomRequirements/li[@Class="RoomRequirement_ThingCount" and thingDef="Column"]</xpath>
            <value>
                <li Class="RoomRequirement_ThingAnyOfCount">
                    <things>
                        <li>Column</li>
                        <li>OA_RK_Zhuzi</li>
                    </things>
                    <count>4</count>
                </li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoBuilding"]/buildingRoomRequirements/li[@Class="RoomRequirement_ThingAnyOfCount" and things/li="Column"]/things</xpath>
            <value>
                <li>OA_RK_Zhuzi</li>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThoughtDef[@Name="IdeoLeaderResentmentBase"]/thoughtClass</xpath>
        <value>
            <thoughtClass>OberoniaAurea.Thought_OAIdeoLeaderResentment</thoughtClass>
        </value>
    </Operation>

    <Operation Class="OberoniaAurea_Frame.PatchOperationCheckDLC">
        <Anomaly>true</Anomaly>
        <match Class="PatchOperationAdd">
            <xpath>Defs/MemeDef[defName="Inhuman"]/requireOne</xpath>
            <value>
                <li>
                    <li>OARK_Birthday_Ignore</li>
                </li>
            </value>
        </match>
    </Operation></Patch>
