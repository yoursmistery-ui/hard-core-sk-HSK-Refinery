    <!-- 金鸢尾兰厚摆长袍  -->
    <ThingDef ParentName="OARatkin_CommonApparelMakeableBase">
        <defName>OA_RK_New_Apparel_C</defName>
        <label>Oberonia Aurea thick robe</label>
        <description>One of the common daily servings of the Oberonia Aurea. By hanging and fixing additional high-quality heavy fabrics on the belt, the entire design has both classical charm and a considerable sense of solemnity and elegance.</description>        <!--腰带上的两个八角星用于固定布料，而整块布料则是宛若晾衣绳上的床单一样搭在腰带上的，灵感来源于古希腊的希顿。-->
        <graphicData>
            <texPath>Apparel/OA_RK_New_Apparel_C</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>18200</WorkToMake>
            <Mass>1.5</Mass>
            <StuffEffectMultiplierArmor>0.26</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.58</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0.40</StuffEffectMultiplierInsulation_Heat>
            <EquipDelay>3.5</EquipDelay>
        </statBases>
        <costList>
            <Synthread>60</Synthread>
        </costList>
        <costStuffCount>50</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <equippedStatOffsets>
            <GeneralLaborSpeed>0.05</GeneralLaborSpeed>
            <SocialImpact>0.20</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Shoulders</li>
                <li>Neck</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Apparel/OA_RK_New_Apparel_C</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>OARatkin_CourtApparel</li>
            </tags>
        </apparel>
        <recipeMaker>
            <researchPrerequisite>OA_RK_Apparel_A</researchPrerequisite>
        </recipeMaker>
    </ThingDef>

