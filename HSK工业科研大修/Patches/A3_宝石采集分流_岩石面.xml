      <value>
        <li><ResourceDefName>RKGem_Citrine</ResourceDefName><DropProbability>0.0016</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>2</MinMiningSkill></li>
        <li><ResourceDefName>RKGem_Amber</ResourceDefName><DropProbability>0.001</DropProbability><CountPerDrop>1</CountPerDrop><MinMiningSkill>3</MinMiningSkill></li>
