				<li Class="Meow.ScenPart_StartWithPrefab">
					<def>StartWithPrefab</def>
					<showSummary>true</showSummary>
					<prefabExtDef>MousieHouse</prefabExtDef>
					<forbidAllSpawnedItems>true</forbidAllSpawnedItems>
					<forbidBuildings>false</forbidBuildings>
					<rotation>North</rotation>
					<randomizeRotation>false</randomizeRotation>
					<chargeBatteries>true</chargeBatteries>
					<batteryChargeRange>0.8~1.0</batteryChargeRange>
					<reconnectPower>true</reconnectPower>
					<spawnInPlayerFaction>true</spawnInPlayerFaction>
