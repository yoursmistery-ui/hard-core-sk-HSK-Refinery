		<graphicData>
			<texPath>Things/Pawn/Humanlike/Apparel/Jewelry/OnyxRing</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>1</drawSize>
		</graphicData>
		<statBases>
			<Beauty>14</Beauty>
		</statBases>
	</ThingDef>

	<!--========== 高档戒指 ==========-->
	<ThingDef ParentName="Rustic_RingBase" Name="Rustic_RingRoyalBase" Abstract="True">
		<equippedStatOffsets Inherit="False">
			<PawnBeauty>2</PawnBeauty>
			<SocialImpact>0.2</SocialImpact>
			<TradePriceImprovement>0.10</TradePriceImprovement>
		</equippedStatOffsets>
	</ThingDef>

	<ThingDef ParentName="Rustic_RingRoyalBase">
