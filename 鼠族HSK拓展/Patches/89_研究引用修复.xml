<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- 89_研究引用修复 (2026-08-22)
         RK_Research_* 研究节点已在 HSK 适配中全部删除(AGENTS.md: 研究线已改为 Ratkin_Apparel_*/Armor_*),
         但 RKMS(鼠邦)与原 RK 装备的 recipeMaker 自动配方仍引用旧研究名,启动报:
           "Could not resolve cross-reference: No Verse.ResearchProjectDef named RK_Research_Tailoring/FunctionalApparel/RatkinEngineering"
         修复: ① recipeMaker 研究前置映射到 HSK 现行研究线(基础裁缝→B1, 功能性服装→C1)
               ② 3 把枪械(RK_ExoticPistol/RK_ExoticLMG/RK_WallGun)recipeMaker researchPrerequisites
                  删除已不存在的 RK_Research_RatkinEngineering(GasOperation/PrecisionRifling 前置已足够) -->
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_Research_Tailoring"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>Ratkin_Apparel_B1</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_Research_FunctionalApparel"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>Ratkin_Apparel_C1</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="RK_ExoticPistol"]/recipeMaker/researchPrerequisites/li[text()="RK_Research_RatkinEngineering"]</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="RK_ExoticLMG"]/recipeMaker/researchPrerequisites/li[text()="RK_Research_RatkinEngineering"]</xpath>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="RK_WallGun"]/recipeMaker/researchPrerequisites/li[text()="RK_Research_RatkinEngineering"]</xpath>
    </Operation>

    <!-- 2026-09-06 修复 17 条 Failed to find a node: EU/YE/MR 武器与 14 组 GW 服饰的
         recipeMaker 已被 80 号(86_二战军服适配) Conditional+Remove+Add IsNull 整体关闭并改挂
         显式配方 RKHSKGW_Make_*, 本补丁的对应 Replace 是死操作(启动报 17 条 Failed)。
         已删除死操作, 仅保留仍有活目标的 KB/WR 两阵营映射(80 号只 IsNull 了它们的部分 def)
         与 4 把 GW2 名枪的 recipeMaker Add。终态已核: Unified.xml 无悬空 RK_ 旧科研名。 -->

    <!-- GW2 名枪 4 把原版无 recipeMaker(继承 BaseMakeableGun 配方无科研门槛),补挂二战军火节点 -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RK_NR_Mume"]</xpath>
        <value>
            <recipeMaker>
                <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
                <skillRequirements>
                    <Crafting>5</Crafting>
                </skillRequirements>
            </recipeMaker>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RK_LS_Zakkum"]</xpath>
        <value>
            <recipeMaker>
                <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
                <skillRequirements>
                    <Crafting>5</Crafting>
                </skillRequirements>
            </recipeMaker>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RK_SD_Klyon"]</xpath>
        <value>
            <recipeMaker>
                <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
                <skillRequirements>
                    <Crafting>5</Crafting>
                </skillRequirements>
            </recipeMaker>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="RK_VK_Gloriosa"]</xpath>
        <value>
            <recipeMaker>
                <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
                <skillRequirements>
                    <Crafting>5</Crafting>
                </skillRequirements>
            </recipeMaker>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_KB_Weapon"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_WR_Weapon"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>RK_GW_Weapon</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_KB"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>Ratkin_Apparel_Uniform</researchPrerequisite>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[recipeMaker/researchPrerequisite="RK_WR"]/recipeMaker/researchPrerequisite</xpath>
        <value>
            <researchPrerequisite>Ratkin_Apparel_Uniform</researchPrerequisite>
        </value>
    </Operation>
</Patch>
