    <statBases><MaxHitPoints>120</MaxHitPoints><WorkToBuild>1200</WorkToBuild><Flammability>0.4</Flammability><Beauty>-3</Beauty></statBases>
    <costList><Steel>60</Steel><ComponentIndustrial>2</ComponentIndustrial></costList><rotatable>false</rotatable>
