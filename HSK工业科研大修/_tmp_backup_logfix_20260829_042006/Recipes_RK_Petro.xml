<Defs>

  <!-- 石化工业线 · 配方（并入 HSK工业科研大修, 2026-08-28）
       全部走 recipeUsers 单路径挂到 RK_Petro_* 建筑; 每条给 researchPrerequisite 与建筑同档, 避免 duplicate unlocked。
       乙烯=Polymers 苯=Sulphates 二甲苯=Xylene 丙烯=Propylene 丁二烯=Butadiene 氨=SyntheticAmmonia 中性胺=Neutroamine 合成纤维=SyntheticFibers。 -->

  <!-- ===== 常减压蒸馏塔: 5 档转化比例(玩家挂哪个 bill = 选哪档) ===== -->
  <RecipeDef><defName>RK_Recipe_Distill_T1</defName><label>蒸馏·一档(重留底)</label><description>低转化深度: 多沥青与石脑油, 少燃油。</description><jobString>蒸馏中。</jobString>
    <workAmount>1200</workAmount><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill>
    <effectWorking>Cook</effectWorking><soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers><li>RK_Petro_DistillationColumn</li></recipeUsers>
    <researchPrerequisite>RK_Petro_AtmosphericDistillation</researchPrerequisite>
    <ingredients><li><filter><thingDefs><li>OilBarrel</li></thingDefs></filter><count>10</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>OilBarrel</li></thingDefs></fixedIngredientFilter>
    <products><Chemfuel>5</Chemfuel><RK_Petro_NaturalGas>2</RK_Petro_NaturalGas><RK_Petro_Naphtha>3</RK_Petro_Naphtha><Asphalt>12</Asphalt></products>
  </RecipeDef>
