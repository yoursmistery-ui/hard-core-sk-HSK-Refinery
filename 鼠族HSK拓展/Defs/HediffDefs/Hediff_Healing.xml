        <capMods>
          <li>
			<capacity>Consciousness</capacity>  <!-- 意识能力 -->
            <offset>0.1</offset>
          </li>
		 </capMods>
	  </li>
     </stages>
     <comps>
       <li Class="HediffCompProperties_RemoveIfApparelDropped" />
     </comps>
     <isBad>false</isBad>
   </HediffDef>     
   
   <HediffDef>
     <defName>EX</defName>
     <label>强化外骨骼装甲</label>
     <description>维多利亚的先锋作战方案，速度！速度！还是速度！你丫的脚底抹油都没你这么慢!菜鸟!</description>
