      <drawOffset>(0,0,0.2)</drawOffset>
      <damageData>
        <rect>(0.1,0.1,0.8,0.8)</rect>
      </damageData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>10</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Mass>20</Mass>
      <Beauty>20</Beauty>
    </statBases>
    <size>(1,2)</size>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <defaultPlacingRot>South</defaultPlacingRot>
    <terrainAffordanceNeeded>Bridgeable</terrainAffordanceNeeded>
    <resourcesFractionWhenDeconstructed>0.2</resourcesFractionWhenDeconstructed>
    <drawerType>RealtimeOnly</drawerType>
    <researchPrerequisites>
      <li>Construction_B1</li>
    </researchPrerequisites>
  </ThingDef>

  <!-- ============ 风车(装饰, 叶片旋转) ============ -->
  <ThingDef ParentName="BuildingBase">
    <designationCategory>Accessories</designationCategory><defName>RKFC_RL_Windmill</defName>
    <thingClass>RatkinFurniture.Windmill</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <label>windmill</label>
    <description>巨大的风车，常见于大大小小的农庄之中。</description>
    <graphicData>
      <texPath>RL/RL_Windmill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
      <damageData>
        <rect>(0.2,0.0,2.6,3.0)</rect>
      </damageData>
      <shadowData>
        <volume>(1.6,3.0,1.6)</volume>
        <offset>(0,0,-0.6)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <canOverlapZones>false</canOverlapZones>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>3300</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>80</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(2,3)</size>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <constructEffect>ConstructWood</constructEffect>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <allowAutoroof>false</allowAutoroof>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <researchPrerequisites>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <costList>
      <WoodLog>120</WoodLog>
      <Steel>20</Steel>
      <Cloth>40</Cloth>
    </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <!-- ============ 发电风车 ============ -->
  <ThingDef ParentName="BuildingBase">
    <defName>RKFC_RL_Windmill_Power</defName>
    <thingClass>RatkinFurniture.Windmill</thingClass>
    <drawerType>MapMeshAndRealTime</drawerType>
    <label>windmill (electricity)</label>
    <description>巨大的风车，可以借助风力发电。</description>
    <graphicData>
      <texPath>RL/RL_Windmill</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(5,5)</drawSize>
      <damageData>
        <rect>(0.2,0.0,2.6,3.0)</rect>
      </damageData>
      <shadowData>
        <volume>(1.6,3.0,1.6)</volume>
        <offset>(0,0,-0.6)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <canOverlapZones>false</canOverlapZones>
    <blockWind>true</blockWind>
    <fillPercent>1.0</fillPercent>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>3300</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Beauty>80</Beauty>
    </statBases>
    <tickerType>Normal</tickerType>
    <size>(2,3)</size>
    <selectable>true</selectable>
    <rotatable>false</rotatable>
    <constructEffect>ConstructMetal</constructEffect>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <building>
      <allowAutoroof>false</allowAutoroof>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>RatkinFurniture.CompPowerWind</compClass>
        <basePowerConsumption>-1400</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <researchPrerequisites>
      <li>Electricity</li>
      <li>ComplexFurniture</li>
    </researchPrerequisites>
    <costList>
      <WoodLog>120</WoodLog>
      <Steel>60</Steel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <Cloth>40</Cloth>
    </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <designationCategory>Power</designationCategory>
  </ThingDef>

