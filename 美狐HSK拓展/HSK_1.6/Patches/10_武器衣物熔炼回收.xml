    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_ShotgunPsychic"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RiflePsychic"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_PowerClaw"]</xpath>
