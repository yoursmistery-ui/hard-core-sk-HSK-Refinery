<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- 鼠族文化风格 ThingStyleDef: 用本 mod 建筑的外观替换指定基础建筑(Ideology 图形风格,保留原属性) -->

	<ThingStyleDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>RKFC_Wall_Style</defName>
		<label>ratkin old wall</label>
		<uiIconPath>Things/Building/Linked/GL_Wall_MenuIcon</uiIconPath>
		<graphicData>
			<texPath>Things/Building/Linked/GL_Wall</texPath>
			<graphicClass>Graphic_Appearances</graphicClass>
			<linkType>CornerFiller</linkType>
			<linkFlags>
				<li>Wall</li>
				<li>Rock</li>
			</linkFlags>
		</graphicData>
	</ThingStyleDef>

	<ThingStyleDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>RKFC_DiningChair_Style</defName>
		<label>ratkin dining chair</label>
		<graphicData>
			<texPath>Things/Building/Furniture/RGK_Chair3</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(3,3)</drawSize>
		</graphicData>
	</ThingStyleDef>

	<ThingStyleDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>RKFC_PokerTable_Style</defName>
		<label>ratkin poker table</label>
		<graphicData>
			<texPath>Things/Building/Joy/GF_PokerTable</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(1.6,0.3,1.6)</volume>
				<offset>(0,0,-0.15)</offset>
			</shadowData>
		</graphicData>
	</ThingStyleDef>

	<ThingStyleDef MayRequire="Ludeon.RimWorld.Ideology">
		<defName>RKFC_Lectern_Style</defName>
		<label>ratkin pulpit</label>
		<graphicData>
			<texPath>Things/Building/Furniture/RK_Pulpit</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(1.5,1.5)</drawSize>
		</graphicData>
	</ThingStyleDef>

</Defs>
