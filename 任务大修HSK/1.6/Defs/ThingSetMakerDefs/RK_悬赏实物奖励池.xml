    <defName>RK_BountyReward_Gear</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <totalMarketValueRange>300~500</totalMarketValueRange>
        <filter>
          <thingDefs>
            <li>Apparel_FlakVest</li>
            <li>Apparel_FlakJacket</li>
            <li>Apparel_FlakPants</li>
            <li>Apparel_SimpleHelmet</li>
            <li>Apparel_AdvancedHelmet</li>
            <li>Apparel_SmokepopBelt</li>
            <li>Apparel_Gambeson</li>
            <li>Apparel_GambesonPadded</li>
            <li>Apparel_BrocadeVest</li>
            <li>Apparel_FurCoat</li>
            <li>Apparel_HazardVest</li>
            <li>Apparel_HazardHelmet</li>
            <li>Apparel_LongCloak</li>
            <li>Apparel_DesertRobe</li>
            <li>Apparel_Ammobelt</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

  <!-- 杂项池:零件/医药/化工 -->
  <ThingSetMakerDef>
    <defName>RK_BountyReward_Sundries</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <totalMarketValueRange>300~500</totalMarketValueRange>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
            <li>ComponentSpacer</li>
            <li>MedicineIndustrial</li>
            <li>MedicineUltratech</li>
            <li>Chemfuel</li>
            <li>Neutroamine</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
  </ThingSetMakerDef>

</Defs>
