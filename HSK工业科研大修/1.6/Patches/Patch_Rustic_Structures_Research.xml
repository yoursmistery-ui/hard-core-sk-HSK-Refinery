<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- 中世纪乡村结构 · 19 项建筑拆分 4 档解锁(HSK工业科研大修, 2026-09-03)
       门禁规则 统一收敛为 RK_Rustic_SimpleFences / SimpleDoors / AdvancedDoors / ColumnsAndCastle
       原状态: 5 项无 prereq(开局即解锁), 其余多挂 ComplexFurniture, 都铎墙/城堡墙挂 Stonecutting。
       本补丁: 顶层 PatchOperationConditional(match=Replace/nomatch=Add)。
         ⚠ Replace 语义 = 把 value 的"子节点"拼回被匹配节点位置 → value 必须保留 researchPrerequisites
           完整外层(裸 <li> 会变成 ThingDef 的非法子节点, researchPrerequisites 整个被删, 2026-09-04 踩坑)。
         ⚠ nomatch.Add 的 value 是新增子节点 → 同样裹 researchPrerequisites 外层。
         ⚠ 两条分支 value 一律带 Inherit="False": 挡父类继承的旧 prereq(实例: CastleWallEmbrasures
           父类 Rustic_CastleWallBase 挂 Stonecutting, 不挡则终态变成双前置)。
       AGENTS.md §3 禁用 FindMod+Sequence → 一律顶层独立 Conditional;1.6 无 Operation 级 MayRequire(失效)。 -->

  <!-- ① 围栏工 -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="Rustic_LogWall"]/researchPrerequisites</xpath>
    <match Class="PatchOperationReplace"><xpath>/Defs/ThingDef[defName="Rustic_LogWall"]/researchPrerequisites</xpath><value><researchPrerequisites Inherit="False"><li>RK_Rustic_SimpleFences</li></researchPrerequisites></value></match>
    <nomatch Class="PatchOperationAdd"><xpath>/Defs/ThingDef[defName="Rustic_LogWall"]</xpath><value><researchPrerequisites Inherit="False"><li>RK_Rustic_SimpleFences</li></researchPrerequisites></value></nomatch>
  </Operation>

