<Defs>
<!-- 乡村照明与取火(2026-08-29 · 第二批波次 2)
     来源: Medieval Overhaul 1.6.2.2 Buildings_Furniture.xml 纯原版类 def 移植。
     前缀统一 Rustic_; 剥离 MO DLL 依赖: MedievalOverhaul.CompProperties_StoreFuelThing /
     MedievalOverhaul.ITab_Fuel / CannotBePlacedTogetherWithThisModExtension,
     以及 MO 专属的 FocusStrengthOffset_BuildingDefsLit 清单(原版 Refuelable 自带燃料 UI, 无需 ITab_Fuel)。
     材料映射: Tallow→Tallow, Coal→Coal, RawWood/Wood 类别→Woody, IronIngot→WroughtIron。
     ⚠ Tar(焦油)与 Wax(蜂蜡)本环境均不存在 → 油灯燃料改烧 Tallow(牛油);
       蜂蜡变体(Candle_Beeswax / Candles_Beeswax)不移植(无养蜂产业链)。
     研究分档(按用途, 见 09 计划 §二):
       篝火/火把/大柴堆 → RK_PrimitiveLighting(Neolithic, 本 mod 新建, Buildings_SK Y=9 X=2);
       油灯/路灯/蜡烛   → Light_B1(Medieval, HSK 既有, Buildings_SK Y=9 X=3)。
     菜单: designationCategory=Accessories(HSK 辅助建筑) + 子分类「乡村照明」(SubCategories_Rustic_Lighting.xml)。
     ⚠ stuffable 建筑全部显式写 uiIconPath(AGENTS §5: 缺失会在点选时每帧 NRE 卡死)。 -->

	<!--==================== 原始档 · 取火与照明(RK_PrimitiveLighting) ====================-->

	<ThingDef ParentName="TorchLamp">
		<defName>Rustic_TorchLamp</defName>
		<label>乡村火把</label>
		<description>一根浸过油脂的木柄火把, 插在地上就能烧上一天。光不算亮, 却足够让人在夜里看清脚下、干活不至于慢半拍。消耗木料或煤, 雨天烧得更快些。</description>
		<graphicData>
			<texPath>Things/Building/Furniture/RusticTorch</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<damageData>
				<rect>(0.35,0.35,0.3,0.3)</rect>
			</damageData>
			<drawSize>(3,3)</drawSize>
		</graphicData>
		<uiIconPath>Things/Building/Furniture/RusticTorch_MenuIcon</uiIconPath>
		<uiIconScale>0.85</uiIconScale>
		<costList Inherit="False"/>
		<stuffCategories Inherit="False">
			<li>Woody</li>
		</stuffCategories>
		<costStuffCount>20</costStuffCount>
		<comps Inherit="False">
			<li Class="CompProperties_Styleable"/>
			<li Class="CompProperties_Glower">
				<glowRadius>10</glowRadius>
				<glowColor>(184,136,83,0)</glowColor>
			</li>
