        <value>
<fixedIngredientFilter>
    <stuffCategoriesToAllow><li>Metallic</li></stuffCategoriesToAllow>
    <thingDefs><li>Steel</li><li>Cloth</li><li>ComponentMedieval</li></thingDefs>
