<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!-- HSK 熔炼扩展 - 新增配方(2026-08-09)
	     配方挂载见 Patches/00_熔炼扩展.xml(直接 Add 到工作台 ThingDef /recipes 列表,
	     机制同鼠族 mod 30 号锯木台配方,保证工作台清单必定显示) -->

	<RecipeDef>
		<defName>RKHSKSmeltAmmo</defName>
		<label>smelt ammunition</label>
		<description>Smelt unwanted ammunition. Accepts all types of ammunition, 1-100 rounds per batch. Returns 30% of the manufacturing materials (calculated for the whole batch); metal bars are returned as steel (low-carbon steel), wood planks as redwood planks.</description>
		<jobString>Smelting ammunition.</jobString>
		<workAmount>500</workAmount>
		<workSpeedStat>SmeltingSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<!-- 2026-08-10: 动态数量。count=1 表示「至少 1 发即可开工」,配合
		     ignoreIngredientCountTakeEntireStacks(取整堆)+ HSKFixPack.dll 的
		     SmeltAmmoFix(单批上限 100)实现 1-100 发/批;
		     ⚠️ 2026-08-10 用户反馈「要满100才能熔炼」: count 由 100 改为 1,
		     消除「需要 100」的误导显示(实际行为不变) -->
		<ignoreIngredientCountTakeEntireStacks>true</ignoreIngredientCountTakeEntireStacks>
		<!-- 2026-08-11: 走 specialProducts=Smelted → Thing.SmeltProducts,
		     由 HSKFixPack.dll 的 SmeltProducts30Fix 前缀按 30% 返还全部制造材料,
		     并按被熔炼弹药堆叠数(1-100 发)乘算(每发材料 × 发数 × 30%);
		     1.6 的 specialProducts 是列表字段,必须用 <li> 包裹(实测非列表写法
		     报 "Raw text found inside a list element") -->
		<specialProducts>
			<li>Smelted</li>
		</specialProducts>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li MayRequire="CETeam.CombatExtended">Ammo</li>
						<li MayRequire="Solaris.RatkinRaceMod">RK_ThingCategory_Ammo</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li MayRequire="CETeam.CombatExtended">Ammo</li>
				<li MayRequire="Solaris.RatkinRaceMod">RK_ThingCategory_Ammo</li>
			</categories>
		</fixedIngredientFilter>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.5</workSkillLearnFactor>
	</RecipeDef>

	<RecipeDef>
		<defName>RKHSKSmeltWeaponCrate</defName>
		<label>smelt weapon crate</label>
		<description>Smelt an unwanted weapon crate into steel, components and other resources.</description>
		<jobString>Smelting weapon crate.</jobString>
		<workAmount>600</workAmount>
		<workSpeedStat>SmeltingSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>WeaponCrate</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>WeaponCrate</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Steel>80</Steel>
			<ComponentIndustrial>5</ComponentIndustrial>
			<Plasteel>5</Plasteel>
			<ElectronicComponents>3</ElectronicComponents>
		</products>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.5</workSkillLearnFactor>
		<uiIconThing>Balista_Crate</uiIconThing>
	</RecipeDef>

	<RecipeDef>
		<defName>RKHSKSmeltWeaponParts</defName>
		<label>smelt weapon parts</label>
		<description>Smelt unwanted weapon parts back into steel.</description>
		<jobString>Smelting weapon parts.</jobString>
		<workAmount>400</workAmount>
		<workSpeedStat>SmeltingSpeed</workSpeedStat>
		<effectWorking>Smelt</effectWorking>
		<soundWorking>Recipe_Smelt</soundWorking>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>WeaponParts</li>
					</categories>
				</filter>
				<count>1</count>
			</li>
		</ingredients>
		<fixedIngredientFilter>
			<categories>
				<li>WeaponParts</li>
			</categories>
		</fixedIngredientFilter>
		<products>
			<Steel>10</Steel>
		</products>
		<workSkill>Crafting</workSkill>
		<workSkillLearnFactor>0.5</workSkillLearnFactor>
		<uiIconThing>Weapon_Parts</uiIconThing>
	</RecipeDef>
</Defs>
