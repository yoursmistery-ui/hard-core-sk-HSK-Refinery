		<defName>OA_RK_Constant_Temperature_Hydroponics</defName>
		<label>Oberonia Aurea basic infrastrutues</label>
		<description>Research the basic infrastructures of Oberonia Aurea and unlock the "Oberonia Aurea thermostat hydroponic tank", along with a series of buildings characteristic to Oberonia Aurea.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>1500</baseCost>
