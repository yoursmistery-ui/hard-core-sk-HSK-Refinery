        </value>
    </Operation>
<!--  粒子爆炸 -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/DamageDef[defName="Milira_ParticleBombBig"]/defaultArmorPenetration</xpath>
        <value>
            <defaultArmorPenetration>3</defaultArmorPenetration>
        </value>
    </Operation>

</Patch>