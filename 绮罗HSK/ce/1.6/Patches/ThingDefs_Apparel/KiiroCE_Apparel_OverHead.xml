<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 绮罗头饰层基础修改-重量 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_OverheadBase"
		]/statBases/Mass</xpath>
		<value>
			<Mass>0.4</Mass>
		</value>
	</Operation>
	<!-- 绮罗头饰层基础修改-体积 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_OverheadBase"
		]/statBases</xpath>
		<value>
			<Bulk>1.5</Bulk>
			<WornBulk>0.5</WornBulk>
		</value>
	</Operation>
	
