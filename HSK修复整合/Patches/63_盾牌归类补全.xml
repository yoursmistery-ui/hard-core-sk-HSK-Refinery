  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="Apparel_PersonalNanoShield"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Apparel_PersonalNanoShield"]/thingCategories</xpath>
