<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- SeedsPlease 种子提取配方(2026-08-22 新增): 植物处理台上用风雪碎晶提取种子 -->
  <!-- 参照 SeedsPlease 标准 ExtractSeed: 4 原料 → 3 种子,研究前置 OA_RK_Oberonia_Aurea_Research -->

  <RecipeDef MayRequire="notfood.SeedsPlease">
    <defName>ExtractSeedOAGeneIceCrystalFlower</defName>
    <label>extract ice crystal flower seeds</label>
    <description>Extract ice crystal flower seeds from blizzard shattered crystals.</description>
    <jobString>Extracting seeds.</jobString>
    <workSpeedStat>CookSpeed</workSpeedStat>
    <effectWorking>Cook</effectWorking>
    <workSkill>Cooking</workSkill>
    <workAmount>600</workAmount>
    <recipeUsers>
      <li>PlantProcessingTable</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>OAGene_IceCrystal</li>
          </thingDefs>
        </filter>
        <count>4</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>OAGene_IceCrystal</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <SeedOAGeneIceCrystalFlower>3</SeedOAGeneIceCrystalFlower>
    </products>
    <researchPrerequisite>OA_RK_Oberonia_Aurea_Research</researchPrerequisite>
  </RecipeDef>

