<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <NeedFoodVariety>
    <stages>
      <barren_menu>
        <label>贫瘠的食谱</label>
      </barren_menu>
    </stages>
    <stages>
      <barren_menu>
        <description>已经没有能吃的了。空荡荡的感觉令人难以忍受。</description>
      </barren_menu>
    </stages>
    <stages>
      <empty_menu>
        <label>空无一物的食谱</label>
      </empty_menu>
    </stages>
    <stages>
      <empty_menu>
        <description>我不能再吃这个了，真的，不行。求求了，给我点别的什么。</description>
      </empty_menu>
    </stages>
    <stages>
      <poor_menu>
        <label>贫乏的食谱</label>
      </poor_menu>
    </stages>
    <stages>
      <poor_menu>
        <description>一样平淡的食物。单调且缺乏灵感。</description>
      </poor_menu>
    </stages>
    <stages>
      <scarce_menu>
        <label>稀缺的食谱</label>
      </scarce_menu>
    </stages>
    <stages>
      <scarce_menu>
        <description>这些种类如此稀缺，很难称之为一顿饭。</description>
      </scarce_menu>
    </stages>
    <stages>
      <limited_menu>
        <label>有限的食谱</label>
      </limited_menu>
    </stages>
    <stages>
      <limited_menu>
        <description>选择有限。越来越难以享受菜肴。</description>
      </limited_menu>
    </stages>
    <stages>
      <below_average_menu>
        <label>不及格的食谱</label>
      </below_average_menu>
    </stages>
    <stages>
      <below_average_menu>
        <description>食物普普通通，勉强避免了单调。</description>
      </below_average_menu>
    </stages>
    <stages>
      <average_menu>
        <label>一般的食谱</label>
      </average_menu>
    </stages>
    <stages>
      <average_menu>
        <description>一般，没什么特别的，但其实也还不错。</description>
      </average_menu>
    </stages>
    <stages>
      <above_average_menu>
        <label>高于平均的食谱</label>
      </above_average_menu>
    </stages>
    <stages>
      <above_average_menu>
        <description>还算丰富，有时会带来愉快的惊喜。</description>
      </above_average_menu>
    </stages>
    <stages>
      <good_menu>
        <label>不错的食谱</label>
      </good_menu>
    </stages>
    <stages>
      <good_menu>
        <description>对选项相当满意，总有一些喜爱的食物在周围。</description>
      </good_menu>
    </stages>
    <stages>
      <great_menu>
        <label>很好的食谱</label>
      </great_menu>
    </stages>
    <stages>
      <great_menu>
        <description>非常好食谱，总有新玩意，使我的味蕾尖叫。</description>
      </great_menu>
    </stages>
    <stages>
      <excellent_menu>
        <label>极好的食谱</label>
      </excellent_menu>
    </stages>
    <stages>
      <excellent_menu>
        <description>非常棒的选择范围。每一次用餐都是新的冒险。</description>
      </excellent_menu>
    </stages>
    <stages>
      <exceptional_menu>
        <label>卓越的食谱</label>
      </exceptional_menu>
    </stages>
    <stages>
      <exceptional_menu>
        <description>就像每天都能在一家一流餐厅用餐一样。绝对棒极了。</description>
      </exceptional_menu>
    </stages>
    <stages>
      <overwhelming_menu>
        <label>震撼的食谱</label>
      </overwhelming_menu>
    </stages>
    <stages>
      <overwhelming_menu>
        <description>品种繁多，几乎让人难以选择！</description>
      </overwhelming_menu>
    </stages>
  </NeedFoodVariety>
</LanguageData>
