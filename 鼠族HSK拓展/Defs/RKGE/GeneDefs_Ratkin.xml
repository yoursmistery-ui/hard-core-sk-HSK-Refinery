	<GeneDef Name="RatkinGeneEarsBase" Abstract="True">
		<biostatCpx>0</biostatCpx>
		<displayCategory>RatkinEarsGene</displayCategory>
		<displayOrderInCategory>75</displayOrderInCategory>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<endogeneCategory>Ears</endogeneCategory>
		<randomChosen>false</randomChosen>
		<exclusionTags>
			<li>Ears</li>
		</exclusionTags>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>rat</symbol>
				</li>
				<li>
					<symbol>squeak</symbol>
				</li>
				<li>
					<symbol>whisk</symbol>
				</li>
			</prefixSymbols>
			<suffixSymbols>
				<li>
					<symbol>rat</symbol>
				</li>
				<li>
					<symbol>ear</symbol>
				</li>
				<li>
					<symbol>squeak</symbol>
				</li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	<GeneDef Name="RatkinGeneTailBase" Abstract="True">
		<biostatCpx>0</biostatCpx>
		<displayCategory>RatkinTailGene</displayCategory>
		<displayOrderInCategory>1001</displayOrderInCategory>
		<iconColor>(0.75, 0.75, 0.75)</iconColor>
		<randomChosen>true</randomChosen>
		<exclusionTags>
			<li>Tail</li>
		</exclusionTags>
		<symbolPack>
			<prefixSymbols>
				<li>
					<symbol>tail</symbol>
				</li>
				<li>
					<symbol>rat</symbol>
				</li>
			</prefixSymbols>
			<suffixSymbols>
				<li>
					<symbol>tail</symbol>
				</li>
				<li>
					<symbol>rat</symbol>
				</li>
			</suffixSymbols>
		</symbolPack>
	</GeneDef>

	<GeneDef ParentName="RatkinGeneEarsBase">
		<defName>Ratkin_Ears</defName>
		<label>Mouse ears</label>
		<description>The Ratkin with this gene has mouse ears</description>
		<iconPath>UI/Icons/Genes/Mouse_ear</iconPath>
	</GeneDef>

	<GeneDef ParentName="RatkinGeneTailBase">
		<defName>Ratkin_Tail</defName>
		<label>Mouse tail</label>
		<description>The Ratkin with this gene has a common mouse tail</description>
		<iconPath>UI/Icons/Genes/Mouse_tail</iconPath>
	</GeneDef>


	<GeneDef ParentName="RatkinGeneEarsBase">
		<defName>Ratkin_LabRatEars</defName>
		<iconColor>(0.9, 0.9, 0.9)</iconColor>
		<label>LabRat ears</label>
		<description>Ratkin with this gene have mouse ears that magically have a tag attached to them.</description>
		<iconPath>UI/Icons/Genes/ICR_ear</iconPath>
	</GeneDef>


	<GeneDef ParentName="RatkinGeneEarsBase">
		<defName>Ratkin_WREars</defName>
		<label>Waste rat ears</label>
		<description>Ratkin with this gene have waste rat ears</description>
		<iconPath>UI/Icons/Genes/WR_ear</iconPath>
	</GeneDef>

	<GeneDef ParentName="RatkinGeneTailBase">
		<defName>Ratkin_WRTail</defName>
		<biostatMet>-1</biostatMet>
    <capMods>
      <li>
        <capacity>Manipulation</capacity>
        <postFactor>1.1</postFactor>
      </li>
    </capMods>
		<label>Waste rat tail</label>
		<description>Ratkin with this gene has a waste rat tail</description>
		<iconPath>UI/Icons/Genes/WR_tail</iconPath>
	</GeneDef>

	<GeneDef>
		<biostatCpx>0</biostatCpx>
		<biostatMet>0</biostatMet>
		<iconColor>(1, 1, 1)</iconColor>
		<defName>Ratkin_YunDanFengQing</defName>
		<displayCategory>RatkinGene</displayCategory>
		<displayOrderInCategory>33</displayOrderInCategory>
		<suppressedTraits>
			<li>
				<def>Pyromaniac</def>
			</li>
			<li>
				<def>Greedy</def>
			</li>
			<li>
				<def>Gourmand</def>
			</li>
		</suppressedTraits>
		<forcedTraits>
			<li>
				<def>RKTrait_YunDanFengQing</def>
			</li>
		</forcedTraits>
		<socialFightChanceFactor>0.1</socialFightChanceFactor>
		<aggroMentalBreakSelectionChanceFactor>0.5</aggroMentalBreakSelectionChanceFactor>
		<label>Take it easy</label>
		<description>What adversity needs is not to be overcome, but to be actively eliminated. Before that, I will always hold hope in my heart.</description>
		<customEffectDescriptions>
			<li>Don't care about the awful bedroom environment.</li>
		</customEffectDescriptions>
		<iconPath>UI/Icons/Genes/Vole_YunDanFengQing</iconPath>
	</GeneDef>


	<GeneDef ParentName="RatkinGeneEarsBase">
		<defName>Ratkin_Prototype_Vole_Ears</defName>
		<iconColor>(1, 0.92, 0.65)</iconColor>
		<biostatMet>6</biostatMet>
		<label>Prototype Vole ears</label>
		<description>The Ratkin with this gene has vole ears</description>
		<iconPath>UI/Icons/Genes/prototype_vole_ears</iconPath>
	</GeneDef>

	<GeneDef ParentName="RatkinGeneTailBase">
