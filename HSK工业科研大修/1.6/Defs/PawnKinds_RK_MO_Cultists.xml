<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- ============================================================================
  邪教三级兵种(2026-09-10 波次7): 移植自 MO PawnKinds_Cultists.xml 的三级结构,
  但按用户拍板方案换装 = "HSK 中世纪甲 + 邪教徒兜帽", 不搬 MO 布甲/武器体系。
  基底仿 Core_SK `KingdomBase`(王国系), race Human, 挂现有敌对派系 MedievalKingdom
  (用户选定"挂现有敌对派系", 不新建 ShadowSect); 故三种兵种只经 KCSG 守卫符号/任务站点
  投放, 不进派系随机袭击池。
  层差: T1 新手(布甲/轻防) → T2 侍僧(锁子甲) → T3 得道者(板甲, 精英)。
  兜帽 defName: RK_MO_Apparel_CultistHood(本 mod Apparel_RK_MO_CultistHood.xml)。
============================================================================ -->
	<PawnKindDef Abstract="True" Name="RK_MO_CultistBase">
		<race>Human</race>
		<defaultFactionType>MedievalKingdom</defaultFactionType>
		<backstoryFilters>
			<li>
				<categories>
					<li>Outlander</li>
					<li>Pirate</li>
					<li>Outsider</li>
				</categories>
			</li>
		</backstoryFilters>
		<chemicalAddictionChance>0.03</chemicalAddictionChance>
		<isFighter>true</isFighter>
		<itemQuality>Normal</itemQuality>
		<minGenerationAge>18</minGenerationAge>
		<maxGenerationAge>55</maxGenerationAge>
		<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
		<gearHealthRange>
			<min>0.5</min>
			<max>1.3</max>
		</gearHealthRange>
		<apparelRequired>
			<li>RK_MO_Apparel_CultistHood</li>
		</apparelRequired>
		<apparelTags>
			<li>MedievalKnightly</li>
			<li>Medieval</li>
		</apparelTags>
		<apparelMoney>
			<min>700</min>
			<max>1100</max>
		</apparelMoney>
		<weaponMoney>
			<min>200</min>
			<max>320</max>
		</weaponMoney>
		<initialWillRange>2~10</initialWillRange>
		<initialResistanceRange>6~16</initialResistanceRange>
		<disallowedTraits>
			<li>Wimp</li>
			<li>Pyromaniac</li>
			<li>Nudist</li>
		</disallowedTraits>
		<requiredWorkTags>
			<li>Violent</li>
		</requiredWorkTags>
		<skills>
			<li>
				<skill>Melee</skill>
				<range>4~8</range>
			</li>
			<li>
				<skill>Shooting</skill>
				<range>3~6</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- T1 新手: 布衣杂兵, 近战为主 -->
	<PawnKindDef ParentName="RK_MO_CultistBase">
		<defName>RK_MO_Cultist_Initiate</defName>
		<label>邪教新信徒</label>
		<combatPower>100</combatPower>
		<!-- 兜帽由父类 RK_MO_CultistBase 提供,列表继承会自动并入,勿在此重复(否则同层冲突报错) -->
		<apparelRequired>
			<li>Apparel_Gambeson</li>
		</apparelRequired>
		<weaponTags>
			<li>MedievalMelee</li>
		</weaponTags>
	</PawnKindDef>

	<!-- T2 侍僧: 锁子甲 -->
	<PawnKindDef ParentName="RK_MO_CultistBase">
		<defName>RK_MO_Cultist_Acolyte</defName>
		<label>邪教侍僧</label>
		<combatPower>160</combatPower>
		<apparelRequired>
			<li>Armor_Hauberk</li>
		</apparelRequired>
		<weaponTags>
			<li>MedievalMelee2H</li>
		</weaponTags>
		<skills>
			<li>
				<skill>Melee</skill>
				<range>6~11</range>
			</li>
			<li>
				<skill>Shooting</skill>
				<range>5~9</range>
			</li>
		</skills>
	</PawnKindDef>

	<!-- T3 得道者: 板甲精英, 可远可近 -->
	<PawnKindDef ParentName="RK_MO_CultistBase">
		<defName>RK_MO_Cultist_Adept</defName>
		<label>邪教得道者</label>
		<combatPower>230</combatPower>
		<apparelRequired>
			<li>Armor_PlateArmor</li>
		</apparelRequired>
		<weaponTags>
			<li>MedievalMelee2H</li>
			<li>MedievalRanged</li>
		</weaponTags>
		<apparelMoney>
			<min>1100</min>
			<max>1600</max>
		</apparelMoney>
		<weaponMoney>
			<min>300</min>
			<max>450</max>
		</weaponMoney>
		<skills>
			<li>
				<skill>Melee</skill>
				<range>9~14</range>
			</li>
			<li>
				<skill>Shooting</skill>
				<range>8~13</range>
			</li>
		</skills>
	</PawnKindDef>
</Defs>
