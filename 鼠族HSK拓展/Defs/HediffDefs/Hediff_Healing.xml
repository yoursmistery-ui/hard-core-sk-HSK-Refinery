  <HediffDef>
    <defName>Visual_enhancement</defName>
    <label>视力增强</label>
    <description>全景补充协议提供目标视距和焦点捕捉功能，让用户视觉精确，犀利</description>
    <hediffClass>HediffWithComps</hediffClass>
	<defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>   <!-- 视觉能力 -->
            <offset>0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>  
  
  <HediffDef>
    <defName>Breath_system</defName>
    <label>气息辅助系统</label>
    <description>辅助调节用户的氧气输送，调节胸腔正负压状态，稳定呼吸频率</description>
    <hediffClass>HediffWithComps</hediffClass>
	<defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Breathing</capacity>  <!-- 呼吸能力 -->
            <offset>0.4</offset>
          </li>
        </capMods>
      </li>
    </stages>

    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>
  
  <HediffDef>
     <defName>Augmented_Reality</defName>
     <label>TBMR感官增强系统</label>
     <description>来自于无尽星芒头盔设计图的现实增强系统，全景实时计算与皮层脑波接入，不仅能够提供各种计算分析指导服务，还让人精神抖擞，意气风发</description>
	 <defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
     <hediffClass>HediffWithComps</hediffClass>
     <stages>
      <li>
	    <label>精神刺激</label>
        <restFallFactor>0.8</restFallFactor>  <!-- 疲劳度 -->
        <capMods>
          <li>
			<capacity>Consciousness</capacity>  <!-- 意识能力 -->
            <offset>0.2</offset>
          </li>
		  <li>
			<capacity>Manipulation</capacity>   <!-- 操作能力 -->
            <offset>0.5</offset>
          </li>
        </capMods>
      </li>
     </stages>
     <comps>
       <li Class="HediffCompProperties_RemoveIfApparelDropped" />
     </comps>
     <isBad>false</isBad>
   </HediffDef>  
   
   <HediffDef>
     <defName>xqz</defName>
     <label>先驱电导流辅助</label>
     <description>引用小功率电流通过芯片的辅助倒流调节，刺激脑皮层提振精神</description>
	 <defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
     <hediffClass>HediffWithComps</hediffClass>
     <stages>
      <li>
		<statFactors>
		    <RestFallRateFactor>0.95</RestFallRateFactor>  <!-- 休息系数 -->
