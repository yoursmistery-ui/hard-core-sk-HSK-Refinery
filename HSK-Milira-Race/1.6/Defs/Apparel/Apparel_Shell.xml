			</tags>
		</apparel>
		<equippedStatOffsets>
		</equippedStatOffsets>
	</ThingDef>

  <!-- 猎手风衣 -->
	<ThingDef ParentName="Milira_ShellBaseII">
		<defName>Milira_HunterCoat</defName>
		<label>Milira hunter coat</label>
		<description>The retro-style wide coat offers protection and insulation.</description>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
      <li>Fabric</li>
    </stuffCategories>
    <costList>
      <Milira_FeatherThread>20</Milira_FeatherThread>
    </costList>
		<graphicData>
			<texPath>Milira/Apparel/Shell/HunterCoat/HunterCoat</texPath>
      <shaderType>CutoutComplex</shaderType>
		</graphicData>
		<statBases>
			<MaxHitPoints>300</MaxHitPoints>
			<WorkToMake>32000</WorkToMake>
			<ArmorRating_Sharp>0.40</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.30</ArmorRating_Blunt>
			<ArmorRating_Heat>0.30</ArmorRating_Heat>
			<StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.5</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <Insulation_Cold>10</Insulation_Cold>
      <Insulation_Heat>10</Insulation_Heat>
		</statBases>
		<apparel>
			<useWornGraphicMask>true</useWornGraphicMask>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Feet</li>
        <li>Hands</li>
        <li>Milira_Wings</li>
      </bodyPartGroups>
			<wornGraphicPath>Milira/Apparel/Shell/HunterCoat/HunterCoat</wornGraphicPath>
			<tags>
				<li>Milira_Hunter</li>
			</tags>
			<renderNodeProperties>
				<li>
					<debugLabel>Milira_HunterCoat BG</debugLabel>
					<nodeClass>AncotLibrary.PawnRenderNode_ApparelAddition</nodeClass>
					<workerClass>PawnRenderNodeWorker_Apparel_Body</workerClass>
					<pawnType>Any</pawnType>
					<texPath>Milira/Apparel/Shell/HunterCoat/HunterCoatBG</texPath>
					<baseLayer>-10</baseLayer>
					<parentTagDef>ApparelBody</parentTagDef>
				</li>
			</renderNodeProperties>
		</apparel>
		<equippedStatOffsets>
      <MeleeDodgeChance>4</MeleeDodgeChance>
      <Ancot_RangeDodgeChance>0.06</Ancot_RangeDodgeChance>
    </equippedStatOffsets>
	</ThingDef>


</Defs>