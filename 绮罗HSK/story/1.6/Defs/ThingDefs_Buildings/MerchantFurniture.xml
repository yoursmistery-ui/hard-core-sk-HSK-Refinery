  <!-- 达到满额评价需要600点货物储量，都为传奇的话需要214点基础 -->
  <ThingDef Name="Kiiro_FurnitureBase" ParentName="ArtableFurnitureBase" Abstract="true">
    <thingClass>Kiiro_Event.Building_GoodsShelf</thingClass>
    <designationCategory>Kiiro_Furniture</designationCategory>
    <altitudeLayer>Building</altitudeLayer>
    <tickerType>Long</tickerType>
    <building>
      <buildingTags>
        <li>Kiiro_GoodsShelf</li>
      </buildingTags>
    </building>
  </ThingDef>

  <!-- =================================================================================================================================== -->

  <!-- 板条小木盒 -->
  <ThingDef Name="Kiiro_WoodBoxSmall" ParentName="Kiiro_FurnitureBase" Abstract="true">
    <description>A wooden box.</description>
    <graphicData>
      <texPath>Kiiro_Event/Buildings/WoodBoxSmallA/WoodBoxSmallA</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.6,2.6)</drawSize>
      <drawOffset>(0,0,0.2)</drawOffset>
      <shadowData>
        <volume>(0.5, 0.4, 0.5)</volume>
      </shadowData>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <!-- <altitudeLayer>BuildingOnTop</altitudeLayer> -->
    <passability>PassThroughOnly</passability>
    <fillPercent>0.4</fillPercent>
    <!-- <castEdgeShadows>true</castEdgeShadows> -->
    <pathCost>42</pathCost>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <defaultPlacingRot>South</defaultPlacingRot>
    <costStuffCount>10</costStuffCount>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>5</Mass>
      <WorkToBuild>1200</WorkToBuild>
      <Flammability>1.0</Flammability>
      <Kiiro_MerchantCapacity>6</Kiiro_MerchantCapacity>
      <Beauty>-5</Beauty>
    </statBases>
    <size>(1,1)</size>
    <designationHotKey>Misc12</designationHotKey>
    <uiOrder>2070</uiOrder>
    <!-- <staticSunShadowHeight>0.5</staticSunShadowHeight> -->
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <placeWorkers>
    </placeWorkers>
    <researchPrerequisites>
      <li>Kiiro_Furniture</li>
    </researchPrerequisites>
    <building>
      <paintable>true</paintable>
    </building>
    <comps>
      <li Class="Kiiro_Event.CompProperties_NeedOrganize">
        <organizeInterval>120000~240000</organizeInterval>
      </li>
    </comps>
    <uiIconScale>0.5</uiIconScale>
  </ThingDef>

