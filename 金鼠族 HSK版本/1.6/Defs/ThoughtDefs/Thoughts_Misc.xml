<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowstormStrugglers</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Gratitude for being rescued</label>
                <description>In this snowstorm, just surviving is already very grateful to me.</description>
                <baseMoodEffect>16</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_SnowstormCultistConvert</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>1</durationDays>
        <stackLimit>6</stackLimit>
        <stackedEffectMultiplier>0.2</stackedEffectMultiplier>
        <stages>
            <li>
                <label>Missionary work of believers</label>
                <description>The endless chanting of scriptures by those guys is really annoying.</description>
                <baseMoodEffect>-2</baseMoodEffect>
                <baseOpinionOffset>-10</baseOpinionOffset>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>OAGene_Thought_IceCrystalFlowerSea</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>8</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>Spectacular Ice Crystal Flower Sea</label>
                <description>That is a dazzling and dazzling sea, with scattered light points flickering and reflecting in the ice crystals. The dazzling brightness is truly brilliant.</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>