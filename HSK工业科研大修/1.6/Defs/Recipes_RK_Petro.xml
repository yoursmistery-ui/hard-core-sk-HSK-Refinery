    <workAmount>1200</workAmount><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill>
    <effectWorking>Cook</effectWorking><soundWorking>Recipe_Machining</soundWorking>
    <recipeUsers><li>RK_Petro_DistillationColumn</li></recipeUsers>
    <researchPrerequisite>RK_Petro_AtmosphericDistillation</researchPrerequisite>
    <ingredients><li><filter><thingDefs><li>OilBarrel</li></thingDefs></filter><count>10</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>OilBarrel</li></thingDefs></fixedIngredientFilter>
    <products><Chemfuel>5</Chemfuel><RK_Petro_NaturalGas>3</RK_Petro_NaturalGas><Asphalt>2</Asphalt></products>
