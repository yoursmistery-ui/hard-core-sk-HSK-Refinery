<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<ResearchProjectDef>
		<defName>OA_RK_Oberonia_Aurea_Research</defName>
		<label>Oberonia Aurea</label>
		<description>Study the cultivation practices of the Oberonia Aurea Empire, as well as the brewing methods of Oberonia Aurea tea, whilst gradually gaining an understanding of the Oberonia Aurea Empire itself. \n\nBreathe in, the fragrance of Oberonia Aurea.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>600</baseCost>
		<techLevel>Neolithic</techLevel>
		<researchViewX>6</researchViewX>
		<researchViewY>3</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>OA_RK_Oberonia_Aurea_Research_B</defName>
		<label>Oberonia Aurea traditional food</label>
		<description>Learn various methods of processing Oberonia Aurea s to make them into beloved delicacies.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>300</baseCost>
		<techLevel>Neolithic</techLevel>
		<prerequisites>
			<li>OA_RK_Oberonia_Aurea_Research</li>
		</prerequisites>
		<researchViewX>7</researchViewX>
		<researchViewY>1</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>OA_RK_Oberonia_Aurea_Research_C</defName>
		<label>Extraction of Qingsu from Oberonia Aurea Flower</label>
		<description>Extract special medical ingredients from the Oberonia Aurea to make drugs that can promote immunity and wound healing.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>1200</baseCost>
		<techLevel>Industrial</techLevel>
		<prerequisites>
			<li>OA_RK_Oberonia_Aurea_Research</li>
		</prerequisites>
		<researchViewX>8</researchViewX>
		<researchViewY>1</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>OA_RK_Basic_Building</defName>
		<label>Oberonia Aurea basic engineering</label>
		<description>Study the basics of Oberonia Aurea engineering. Unlocks varies structures, including "Oberoia Aurea thermostat".</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>800</baseCost>
		<techLevel>Industrial</techLevel>
		<prerequisites>
			<li>OA_RK_Oberonia_Aurea_Research</li>
		</prerequisites>
		<researchViewX>8</researchViewX>
		<researchViewY>3</researchViewY>
	</ResearchProjectDef>

	<ResearchProjectDef>
		<defName>OA_RK_Constant_Temperature_Hydroponics</defName>
		<label>Oberonia Aurea Complex Machinery</label>
		<description>Research a series of complex mechanical equipment for the Oberonia Aurea , unlock a series of equipment such as the Oberonia Aurea constant temperature hydroponic incubator, the Oberonia Aurea optical research platform, and the Oberonia Aurea tip analysis platform.</description>
		<tab>RK_ResearchTab_Default</tab>
		<baseCost>2500</baseCost>
		<techLevel>Spacer</techLevel>
		<prerequisites>
			<li>OA_RK_Basic_Building</li>
			<li>MicroelectronicsBasics</li>
		</prerequisites>
		<researchViewX>9</researchViewX>
		<researchViewY>3.5</researchViewY>
	</ResearchProjectDef>

