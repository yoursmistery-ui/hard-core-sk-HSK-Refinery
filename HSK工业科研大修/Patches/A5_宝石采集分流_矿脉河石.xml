  <!-- BeachRock ← RiverRock.xml 原粗糙宝石 p=0.05 → 留 0.04 + 分流 0.01 给成品宝石 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="BeachRock"]/randomlyDropResources/li[ResourceDefName="RoughGem"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/ThingDef[defName="BeachRock"]/randomlyDropResources/li[ResourceDefName="RoughGem"]/DropProbability</xpath>
      <value><DropProbability>0.04</DropProbability></value>
    </match>
