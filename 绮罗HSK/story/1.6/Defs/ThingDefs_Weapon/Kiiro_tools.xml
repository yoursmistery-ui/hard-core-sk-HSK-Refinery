<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="Kiiro_ToolBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Kiiro_ExpertFishingRod</defName>
    <label>kiiro expert fishing rod</label>
    <description>A handy fishing tool for experienced angler.</description>
    <graphicData>
      <texPath>Kiiro_Event/Weapon/Tool/ExpertFishingRod</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <uiIconPath>Kiiro_Event/Weapon/Tool/ExpertFishingRod</uiIconPath>
    <uiIconScale>1.3</uiIconScale>
    <weaponTags Inherit="false">
      <li>Kiiro_ExpertFishingRod</li>
    </weaponTags>
    <tradeTags Inherit="false" />
    <costList>
      <Steel>85</Steel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Cloth>30</Cloth>
    </costList>
    <statBases>
      <WorkToMake>8400</WorkToMake>
      <Mass>1.6</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite Inherit="false" />
      <recipeUsers Inherit="false" />
    </recipeMaker>
    <equippedStatOffsets>
      <FishingSpeed>0.4</FishingSpeed>
      <FishingYield>0.1</FishingYield>
    </equippedStatOffsets>
    <equippedAngleOffset>-35</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="AncotLibrary.ExtraGraphicData_Extension">
        <graphicData>
          <texPath>Kiiro_Event/Weapon/Tool/ExpertFishingRod_OnHand</texPath>
          <graphicClass>Graphic_Single</graphicClass>
          <drawSize>(1.5,1.5)</drawSize>
        </graphicData>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>