<Patch>
  <!-- 95_服饰三轴挂载 (2026-09-09, 本 mod 自有服饰挂三轴; 分类 def 见 HSK修复整合)
       每件补挂 ①穿戴位置 ②用途场景 ③科技档位 三个新分类。
       Conditional: 已有 thingCategories 则追加 li; 没有则整体 Add 一个 thingCategories 节点
       (不带 Inherit="False", 让父类继承的旧分类照常合并, 只做加法)。 -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/ThingDef[defName="OAGene_SnowstormBarrette"]/thingCategories</xpath>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="OAGene_SnowstormBarrette"]/thingCategories</xpath>
      <value><li>HSK_P_Head</li><li>HSK_U_Noble</li><li>RK_Apparel_Medieval</li></value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="OAGene_SnowstormBarrette"]</xpath>
      <value><thingCategories><li>HSK_P_Head</li><li>HSK_U_Noble</li><li>RK_Apparel_Medieval</li></thingCategories></value>
