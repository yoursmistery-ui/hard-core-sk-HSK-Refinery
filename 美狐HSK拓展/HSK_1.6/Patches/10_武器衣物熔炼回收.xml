<?xml version="1.0" encoding="utf-8"?>
<Patch>
    <!-- =====================================================================
        美狐 HSK 版本 · 10_武器衣物熔炼回收(2026-08-27)
        目标: 武器可在熔炼炉回收为 Weapon_Parts(Core_SK 通用零件),
              衣物/头饰可被 SmeltApparel 配方接收(smeltable=true)。
        产物标准: 统一 Weapon_Parts, 按科技等级递进
                  Industrial(含 Medieval/Neolithic) ×3 / Spacer ×5。
        ===================================================================== -->

    <!-- ────────── 武器熔炼产物 ×3(Industrial/Medieval/Neolithic) ────────── -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RifleCQB"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_Pistol"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RifleDefenceGrenade"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RifleMachinegun"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Miho_Weapon_RifleOld"]</xpath>
        <value><smeltProducts><Weapon_Parts>3</Weapon_Parts></smeltProducts></value>
    </Operation>
