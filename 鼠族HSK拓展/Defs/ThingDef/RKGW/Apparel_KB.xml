<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_KB_InfantryUniform</defName>
        <label>Kornblume Bluse</label>
        <description>New style uniform jackets issued in the later stages of the war, with a looser fit.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_KB_InfantryUniform/RK_KB_InfantryUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>10000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.31</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.45</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
            <Insulation_Cold>2</Insulation_Cold>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_KB</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>415</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <MoveSpeed>0.1</MoveSpeed>
            <ShootingAccuracyPawn>0.15</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costStuffCount>75</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_KB_InfantryUniform/RK_KB_InfantryUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
                <li>RK_KB_Soldier</li>
            </tags>
        </apparel>
    </ThingDef>
