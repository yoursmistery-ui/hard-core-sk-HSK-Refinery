<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
  <!--
    通缉任务的名称与描述(2026-08-31 六期重写)。规则变量必须原样保留:
    [victim_nameFull] [victim_faction_name] [asker_nameFull] [asker_faction_name]
    [artifactLabel] [animal_indefinite] [reason] [reward] [rewardForDead] [rewardForLiving] $
  -->

  <!-- EN: questName->A warrant on [victim_nameFull] -->
  <SW_Warrant_Animal.questNameRules.rulesStrings.0>questName->悬赏令:猎杀[victim_nameFull]</SW_Warrant_Animal.questNameRules.rulesStrings.0>
  <!-- EN: questDescription->[asker_nameFull] from [asker_faction_name] issued a warrant on [victim_nameFull]. They are offering [rewardForDead]$ for you to hunt and deliver one. -->
  <SW_Warrant_Animal.questDescriptionRules.rulesStrings.0>questDescription->来自[asker_faction_name]的悬赏令:[victim_nameFull]肆虐一方,悬赏猎杀。带回尸体即可获得[rewardForDead]$。</SW_Warrant_Animal.questDescriptionRules.rulesStrings.0>

  <!-- EN: questName->A warrant on [artifactLabel] -->
  <SW_Warrant_Artifact.questNameRules.rulesStrings.0>questName->悬赏令:寻回[artifactLabel]</SW_Warrant_Artifact.questNameRules.rulesStrings.0>
  <!-- EN: questDescription->[asker_nameFull] from [asker_faction_name] issued a warrant on [artifactLabel]. [reward] reward for delivering. -->
  <SW_Warrant_Artifact.questDescriptionRules.rulesStrings.0>questDescription->来自[asker_faction_name]的悬赏令:[artifactLabel]是其失窃之物,寻回送达即可获得[reward]$。</SW_Warrant_Artifact.questDescriptionRules.rulesStrings.0>

  <!-- EN: questName->A warrant on [victim_nameFull] -->
  <SW_Warrant_Pawn.questNameRules.rulesStrings.0>questName->悬赏令:通缉[victim_nameFull]</SW_Warrant_Pawn.questNameRules.rulesStrings.0>
  <!-- EN: questDescription->[asker_nameFull] from [asker_faction_name] has issued a warrant on [victim_nameFull] for the crime of [reason]. They are offering [rewardForLiving]$ if captured alive, [rewardForDead]$ if returned dead. -->
  <SW_Warrant_Pawn.questDescriptionRules.rulesStrings.0>questDescription->来自[asker_faction_name]的悬赏令:通缉[victim_faction_name]的[victim_nameFull],罪名——[reason]。活捉交付可得[rewardForLiving]$;击杀带回可得[rewardForDead]$。赏金按其身价、派系科技档与双方关系结算。</SW_Warrant_Pawn.questDescriptionRules.rulesStrings.0>

  <!-- EN: questName->A warrant on [animal_indefinite] -->
  <SW_Warrant_Tame.questNameRules.rulesStrings.0>questName->悬赏令:驯捕[animal_indefinite]</SW_Warrant_Tame.questNameRules.rulesStrings.0>
  <!-- EN: questDescription->[asker_nameFull] from [asker_faction_name] issued a warrant on [animal_indefinite]. They are offering [reward]$ for you to tame and deliver one. -->
  <SW_Warrant_Tame.questDescriptionRules.rulesStrings.0>questDescription->来自[asker_faction_name]的悬赏令:求购[animal_indefinite]。驯服并带回一只即可获得[reward]$。</SW_Warrant_Tame.questDescriptionRules.rulesStrings.0>
</LanguageData>
