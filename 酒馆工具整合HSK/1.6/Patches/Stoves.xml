<?xml version="1.0" encoding="utf-8"?>
<Patch>
	<Operation Class="PatchOperationSequence">
		<operations>
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="ElectricStove"]/comps/li[@Class="CompProperties_AffectedByFacilities"]</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="ElectricStove"]/comps</xpath>
					<value>
						<li Class="CompProperties_AffectedByFacilities">
							<linkableFacilities />
						</li>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="ElectricStove"]/comps/li/linkableFacilities</xpath>
				<value>
					<li>Tav_Kitchen</li>
					<li>Tav_KitchenShelfs</li>
					<li>Tav_KitchenCloset</li>
				</value>
			</li>
			<li Class="PatchOperationConditional">
				<xpath>Defs/ThingDef[defName="FueledStove"]/comps/li[@Class="CompProperties_AffectedByFacilities"]</xpath>
				<nomatch Class="PatchOperationAdd">
					<xpath>Defs/ThingDef[defName="FueledStove"]/comps</xpath>
					<value>
						<li Class="CompProperties_AffectedByFacilities">
							<linkableFacilities />
						</li>
					</value>
				</nomatch>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/ThingDef[defName="FueledStove"]/comps/li/linkableFacilities</xpath>
				<value>
					<li>Tav_Kitchen</li>
					<li>Tav_KitchenShelfs</li>
					<li>Tav_KitchenCloset</li>
				</value>
			</li>
		</operations>
	</Operation>
</Patch>