<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- 莓果藤架 -->
  <ThingDef ParentName="FurnitureBase">
    <defName>Kiiro_BerryPergola</defName>
    <label>berry trellis</label>
    <description>A structure for growing perennial berry vines. Once fully grown, it will produce a steady supply of berries.</description>
    <graphicData>
      <texPath>Kiiro_Event/Buildings/BerryPergola/BerryPergola</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.125,3.125)</drawSize>
      <drawOffset>(0,0,0.3)</drawOffset>
      <shaderType>CutoutComplex</shaderType>
      <shadowData>
        <volume>(1.8, 0.4, 1.0)</volume>
      </shadowData>
      <damageData>
        <rect>(0,0.75,1.0,0.5)</rect>
      </damageData>
    </graphicData>
    <uiIconScale>1.0</uiIconScale>
    <designationCategory Inherit="false" />
    <costStuffCount>120</costStuffCount>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <statBases>
      <MarketValue>210</MarketValue>
      <MaxHitPoints>80</MaxHitPoints>
      <Flammability>0.5</Flammability>
      <Beauty>-10</Beauty>
      <Mass>12</Mass>
      <WorkToBuild>6000</WorkToBuild>
    </statBases>
    <size>(2,1)</size>
    <fillPercent>0.2</fillPercent>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <rotatable>true</rotatable>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tickerType>Long</tickerType>
    <!-- <drawerType>RealtimeOnly</drawerType> -->
    <hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
    <comps>
      <li Class="AncotLibrary.CompProperties_SpawnerCustom_PlantGrow">
        <growDays>8.2</growDays>
        <growTemperature>0~58</growTemperature>
        <thingToSpawn>RawBerries</thingToSpawn>
        <spawnCountRange>20~40</spawnCountRange>
        <spawnIntervalRange>360000~400000</spawnIntervalRange>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
        <!-- <showMessageIfOwned>true</showMessageIfOwned> -->
      </li>
    </comps>
  </ThingDef>

  <!-- 渔网 -->
  <ThingDef ParentName="FurnitureBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Kiiro_FishingTrap</defName>
    <label>fishing trap</label>
    <description>A trap placed in the water near the shore for catching fish. \n\nThe speed and yield of the catch depend on the number of fish in the surrounding water body.</description>
    <graphicData>
      <texPath>Kiiro_Event/Buildings/FishingTrap</texPath>
      <graphicClass>Graphic_Random</graphicClass>
      <drawSize>(2.0,2.0)</drawSize>
      <drawOffset>(0,0,0.1)</drawOffset>
      <shadowData>
        <volume>(0, 0, 0)</volume>
      </shadowData>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconScale>1.0</uiIconScale>
    <designationCategory Inherit="false" />
    <!-- <designationCategory>Kiiro_Furniture</designationCategory> -->
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <terrainAffordanceNeeded />
    <costList>
      <WoodLog>60</WoodLog>
      <Cloth>60</Cloth>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
    <statBases>
      <MarketValue>210</MarketValue>
      <MaxHitPoints>45</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <Beauty>-10</Beauty>
      <Mass>5</Mass>
      <WorkToBuild>6000</WorkToBuild>
    </statBases>
    <size>(1,1)</size>
    <fillPercent>0.2</fillPercent>
    <pathCost>30</pathCost>
    <passability>PassThroughOnly</passability>
    <rotatable>false</rotatable>
    <surfaceType>Item</surfaceType>
    <canOverlapZones>false</canOverlapZones>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>
    <tradeability>All</tradeability>
    <tickerType>Long</tickerType>
    <hiddenWhileUndiscovered>true</hiddenWhileUndiscovered>
    <placeWorkers>
      <li>Kiiro_Event.PlaceWorker_Waterborne</li>
      <li>Kiiro_Event.PlaceWorker_Shoreline</li>
    </placeWorkers>
    <comps>
      <li Class="Kiiro_Event.CompProperties_FishCatcher">
        <spawnIntervalRange>360000~400000</spawnIntervalRange>
        <writeTimeLeftToSpawn>true</writeTimeLeftToSpawn>
      </li>
    </comps>
    <modExtensions>
      <li Class="Kiiro_Event.ModExtension_OffshoreDistance">
        <offshoreDistance>4.9</offshoreDistance>
      </li>
    </modExtensions>
  </ThingDef>

</Defs>
