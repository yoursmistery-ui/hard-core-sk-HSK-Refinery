	<Operation Class="PatchOperationRemove">
		<xpath>Defs/ThingDef[defName="KiiroSpecial_Spear"]</xpath>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>Defs</xpath>
		<value>
			<ThingDef ParentName="BaseProjectileNeolithic" >
				<defName>KiiroSpecial_Spear</defName>
				<label>kiiro spear</label>
				<graphicData>
					<texPath>Kiiro/Weapon/Medieval/Projectile/SpearPoken</texPath>
					<graphicClass>Graphic_Single</graphicClass>
				</graphicData>
				<projectile Class="CombatExtended.ProjectilePropertiesCE">
					<damageDef>ArrowHighVelocity</damageDef>
					<damageAmountBase>16</damageAmountBase>
					<armorPenetrationSharp>4.15</armorPenetrationSharp>
					<speed>400</speed>
					<dropsCasings>false</dropsCasings>
				</projectile>
			</ThingDef>
		</value>
	</Operation>

	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>Kiiro_Spear</defName>
		<statBases>
			<RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>0.01</SwayFactor>
			<Bulk>12.00</Bulk>
			<MeleeCounterParryBonus>1.8</MeleeCounterParryBonus>
		</statBases>
		<Properties>
			<recoilAmount>0</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>KiiroSpecial_Spear</defaultProjectile>
			<warmupTime>0</warmupTime>
			<range>2.4</range>
			<soundCast>Bow_Recurve</soundCast>
		</Properties>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Kiiro_Spear"]/tools</xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>handle</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>6</power>
					<cooldownTime>1.8</cooldownTime>
					<chanceFactor>0.15</chanceFactor>
					<armorPenetrationBlunt>2.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Handle</linkedBodyPartsGroup>
				</li>

				<li Class="CombatExtended.ToolCE">
					<label>head</label>
					<capacities>
						<li>Stab</li>
					</capacities>
					<power>32</power>
					<cooldownTime>1.45</cooldownTime>
					<armorPenetrationSharp>5.25</armorPenetrationSharp>
					<armorPenetrationBlunt>2.5</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Head</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Kiiro_Spear"]</xpath>
		<value>
			<equippedStatOffsets>
				<MeleeCritChance>0.20</MeleeCritChance>
				<MeleeParryChance>1.5</MeleeParryChance>
				<MeleeDodgeChance>1</MeleeDodgeChance>
			</equippedStatOffsets>
		</value>
	</Operation>
	
