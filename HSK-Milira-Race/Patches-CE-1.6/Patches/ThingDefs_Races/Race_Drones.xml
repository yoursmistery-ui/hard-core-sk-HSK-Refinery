<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Milira_BaseDrone -->

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[@Name="Milira_BaseDrone"]/statBases</xpath>
        <value>
            <CarryWeight>50</CarryWeight>
            <CarryBulk>25</CarryBulk>
            <SmokeSensitivity>0</SmokeSensitivity>
            <NightVisionEfficiency>0.80</NightVisionEfficiency>
            <MeleeDodgeChance>0.1</MeleeDodgeChance>
            <MeleeCritChance>0.04</MeleeCritChance>
            <MeleeParryChance>0.04</MeleeParryChance>
        </value>
    </Operation>

    <Operation Class="PatchOperationAddModExtension">
        <xpath>/Defs/ThingDef[@Name="Milira_BaseDrone"]</xpath>
        <value>
            <li Class="CombatExtended.RacePropertiesExtensionCE">
                <bodyShape>Vehicle</bodyShape>
            </li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[@Name="Milira_BaseDrone"]/comps</xpath>
        <value>
            <li>
                <compClass>CombatExtended.CompPawnGizmo</compClass>
            </li>
            <!-- <li Class="CombatExtended.CompProperties_Suppressable" /> -->
            <li>
                <compClass>CombatExtended.CompAmmoGiver</compClass>
            </li>
            <li Class="CombatExtended.CompProperties_ArmorDurability">
                <Durability>700</Durability>
                <Regenerates>true</Regenerates>
                <RegenInterval>1250</RegenInterval>
                <RegenValue>5</RegenValue>
                <Repairable>true</Repairable>
                <RepairIngredients>
                    <Milira_SplendidSteel>10</Milira_SplendidSteel>
                </RepairIngredients>
                <RepairTime>300</RepairTime>
                <RepairValue>200</RepairValue>
                <MinArmorPct>0.5</MinArmorPct>
            </li>
        </value>
    </Operation>

    <!-- Milira_DroneFreight运载单元 -->

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneFreight"]/statBases/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>2</ArmorRating_Sharp>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneFreight"]/statBases/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>4</ArmorRating_Blunt>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Milira_DroneFreight"]/statBases</xpath>
        <value>
            <CarryWeight>75</CarryWeight>
            <CarryBulk>50</CarryBulk>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneFreight"]/tools</xpath>
        <value>
            <tools Inherit="false">
                <li Class="CombatExtended.ToolCE">
                    <label>body</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>8</power>
                    <armorPenetrationBlunt>1.5</armorPenetrationBlunt>
                    <cooldownTime>2.4</cooldownTime>
                    <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
                    <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                </li>
            </tools>
        </value>
    </Operation>

    <!-- Milira_DroneCleansweeper清洁单元 -->

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneCleansweeper"]/statBases/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>1</ArmorRating_Sharp>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneCleansweeper"]/tools</xpath>
        <value>
            <tools Inherit="false">
                <li Class="CombatExtended.ToolCE">
                    <label>body</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>6</power>
                    <armorPenetrationBlunt>1.0</armorPenetrationBlunt>
                    <cooldownTime>2.2</cooldownTime>
                    <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
                    <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                </li>
            </tools>
        </value>
    </Operation>

    <!-- Milira_DroneStorage贮存单元 -->

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneStorage"]/statBases/ArmorRating_Sharp</xpath>
        <value>
            <ArmorRating_Sharp>4</ArmorRating_Sharp>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneStorage"]/statBases/ArmorRating_Blunt</xpath>
        <value>
            <ArmorRating_Blunt>8</ArmorRating_Blunt>
        </value>
    </Operation>
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Milira_DroneStorage"]/statBases</xpath>
        <value>
            <CarryWeight>75</CarryWeight>
            <CarryBulk>50</CarryBulk>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_DroneStorage"]/tools</xpath>
        <value>
            <tools Inherit="false">
                <li Class="CombatExtended.ToolCE">
                    <label>body</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>18</power>
                    <armorPenetrationBlunt>9</armorPenetrationBlunt>
                    <cooldownTime>3.6</cooldownTime>
                    <linkedBodyPartsGroup>Torso</linkedBodyPartsGroup>
                    <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                </li>
            </tools>
        </value>
    </Operation>

</Patch>