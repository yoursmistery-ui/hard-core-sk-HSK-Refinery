    <size>(1,1)</size><altitudeLayer>Building</altitudeLayer><passability>PassThroughOnly</passability><pathCost>20</pathCost><fillPercent>0.25</fillPercent>
    <statBases><MaxHitPoints>70</MaxHitPoints><WorkToBuild>500</WorkToBuild><Flammability>0.3</Flammability><Beauty>-2</Beauty></statBases>
    <costList><Steel>20</Steel><ComponentIndustrial>1</ComponentIndustrial></costList><rotatable>false</rotatable>
