<Defs>
    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>RK_KO_KnightUniform</defName>
        <label>Order State Knight Uniform</label>
        <description>As officers and elite warriors of the Order-State’s military, knights were originally distinguished by lavish decorations that emphasized their status. However, as battlefield feedback increasingly called for improved practicality, the uniform was redesigned into a more restrained form—simpler in appearance, yet still clearly reflecting the dignity and authority of a knight.</description>
        <graphicData>
            <texPath>Things/Item/Apparel/RK_KO_KnightUniform/RK_KO_KnightUniform</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>12000</WorkToMake>
            <Mass>0.35</Mass>
            <StuffEffectMultiplierArmor>0.60</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.88</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>1.2</StuffEffectMultiplierInsulation_Heat>
            <ArmorRating_Sharp>0.55</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.50</ArmorRating_Blunt>
            <ArmorRating_Heat>0.41</ArmorRating_Heat>
            <Flammability>0.4</Flammability>
            <EquipDelay>2</EquipDelay>
        </statBases>
        <techLevel>Industrial</techLevel>
        <recipeMaker>
            <researchPrerequisite>RK_KO</researchPrerequisite>
            <skillRequirements>
                <Crafting>4</Crafting>
            </skillRequirements>
            <displayPriority>600</displayPriority>
        </recipeMaker>
        <equippedStatOffsets>
            <PainShockThreshold>0.1</PainShockThreshold>
            <IncomingDamageFactor>-0.1</IncomingDamageFactor>
            <ShootingAccuracyPawn>0.1</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costStuffCount>150</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
        </stuffCategories>
        <apparel>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <wornGraphicPath>Things/Item/Apparel/RK_KO_KnightUniform/RK_KO_KnightUniform</wornGraphicPath>
            <layers>
                <li>OnSkin</li>
            </layers>
            <tags>
				
