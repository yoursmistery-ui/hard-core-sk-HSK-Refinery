<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- 2026-08-21: 恢复 OARK_ComponentBox(金鸢尾兰零件盒)ThingDef 定义。
         原因: OberoniaAureaYH.dll 的 OARK_ThingDefOf 静态类仍引用该 def,
         删除定义会导致游戏启动 DefOf 绑定报错
         (Failed to find Verse.ThingDef named 'OARK_ComponentBox')。
         处理: 保留完整功能(CompProperties_ComponentBox 打开给 15 工业零件+1 太空零件),
         但 generateCommonality=0、不放入 thingCategories(商队/战利品池不可见)、
         无 recipeMaker(不可制造),新档流程中完全不可获得,
         仅满足 DefOf 绑定与遗留存档兼容。 -->

    <ThingDef ParentName="ResourceBase">
        <defName>OARK_ComponentBox</defName>
        <label>金鸢尾兰零件盒</label>
        <description>装着一些常用的零部件的收纳盒，本身相当坚固且难以摧毁，相当适合用于零件的长期保存。</description>
        <thingClass>ThingWithComps</thingClass>
        <possessionCount>2</possessionCount>
        <graphicData>
            <texPath>Item/OARK_ComponentBox</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
            <drawSize>1.3</drawSize>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>
        <stackLimit>15</stackLimit>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MarketValue>320</MarketValue>
            <MaxHitPoints>250</MaxHitPoints>
            <Mass>6.0</Mass>
            <Flammability>0</Flammability>
        </statBases>
        <intricate>true</intricate>
        <allowedArchonexusCount>10</allowedArchonexusCount>
        <generateCommonality>0</generateCommonality>
        <comps>
            <li Class="OberoniaAurea.CompProperties_ComponentBox">
                <industrialCount>15</industrialCount>
                <spacerCount>1</spacerCount>
            </li>
        </comps>
    </ThingDef>

</Defs>
