<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 绮罗夹层修改-基础 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[@Name="Kiiro_MiddleBase"]/statBases/Mass</xpath>
		<value>
			<Mass>1</Mass>
		</value>
	</Operation>
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[@Name="Kiiro_MiddleBase"]/statBases</xpath>
		<value>
			<Bulk>2</Bulk>
			<WornBulk>1.5</WornBulk>
		</value>
	</Operation>
	
	<!-- 绮罗猫猫斜挎包 绮罗猫猫双肩包 绮罗猫猫旅行背包 的耐久度提高 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_MessengerBag" or 
		defName="Kiiro_BackBag" or 
		defName="Kiiro_PacksackBag"
		]/statBases/MaxHitPoints</xpath>
		<value>
			<MaxHitPoints>120</MaxHitPoints>
		</value>
	</Operation>
	
	<!-- 绮罗猫猫斜挎包 的体积重量携带能力 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		defName="Kiiro_MessengerBag"
		]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>25</CarryBulk>
			<CarryWeight>8</CarryWeight>
		</value>
	</Operation>
	
	<!-- 绮罗猫猫双肩包 的体积重量携带能力 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		defName="Kiiro_BackBag"
		]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>35</CarryBulk>
			<CarryWeight>12</CarryWeight>
		</value>
	</Operation>
	
	<!-- 绮罗猫猫旅行背包 的体积重量携带能力 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		defName="Kiiro_PacksackBag"
		]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>50</CarryBulk>
			<CarryWeight>25</CarryWeight>
		</value>
	</Operation>
	
	<!-- 绮罗简易皮甲 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_SimpleLeatherArmor"
		]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_SimpleLeatherArmor"
		]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>1</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_SimpleLeatherArmor"
		]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>2.5</ArmorRating_Blunt>
		</value>
	</Operation>
	
	<!-- 绮罗轻型胸甲 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_ChestPlate"
		]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>6</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_ChestPlate"
		]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>2.5</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_ChestPlate"
		]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>8</ArmorRating_Blunt>
		</value>
	</Operation>
	
	<!-- 绮罗战术携行具 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_LoadCarrier"
		]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>4</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_LoadCarrier"
		]/statBases/ArmorRating_Sharp</xpath>
		<value>
			<ArmorRating_Sharp>0.5</ArmorRating_Sharp>
		</value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_LoadCarrier"
		]/statBases/ArmorRating_Blunt</xpath>
		<value>
			<ArmorRating_Blunt>0.25</ArmorRating_Blunt>
		</value>
	</Operation>
	
	<!-- 绮罗战术携行具 的体积重量携带能力 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		defName="Kiiro_LoadCarrier"
		]/equippedStatOffsets</xpath>
		<value>
			<CarryBulk>35</CarryBulk>
			<CarryWeight>15</CarryWeight>
		</value>
	</Operation>
</Patch>