<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef>
		<defName>Miho_Tatami</defName>
		<label>미호 다다미</label>
		<category>Building</category>
		<thingClass>Building</thingClass>
		<soundImpactDefault>BulletImpact_Metal</soundImpactDefault>
		<selectable>true</selectable>
		<drawerType>MapMeshAndRealTime</drawerType>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<repairEffect>Repair</repairEffect>
		<filthLeaving>Filth_RubbleBuilding</filthLeaving>
		<minifiedDef>MinifiedThing</minifiedDef>
		<thingCategories>
			<li>BuildingsFurniture</li>
		</thingCategories>
		<graphicData>
			<texPath>Things/Floor/Tatami</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(1,2)</drawSize>
			<damageData>
				<rect>(0.2,0.2,0.6,0.6)</rect>
			</damageData>
		</graphicData>
		<building>    
			<isEdifice>false</isEdifice>
		</building>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<passability>Standable</passability>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>10</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Beauty>4</Beauty>
			<Mass>5</Mass>
		</statBases>
		<size>(1,2)</size>
    <costList>
      <Hay>10</Hay>
    </costList>
		<description>다다미 입니다.</description>
		<leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
		<rotatable>true</rotatable>
		<clearBuildingArea>false</clearBuildingArea>
		<saveCompressible>false</saveCompressible>
		<designationHotKey>Misc7</designationHotKey>
		<designationCategory>Accessories</designationCategory>

	</ThingDef>


  <ThingDef ParentName="BenchBase">
    <defName>Miho_TableMachining</defName>
    <label>미호 종합작업대</label>
    <description>인간들의 3D 프린터를 따라한 종합작업대 입니다.</description>
    <thingClass>Building_WorkTable</thingClass>
    <graphicData>
      <texPath>Things/Building/MihoCommonProd/MihoCommonProd</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3.5,1.5)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <costList>
      <Ceramics>100</Ceramics>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <altitudeLayer>Building</altitudeLayer>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>True</useHitPoints>
    <statBases>
      <WorkToBuild>3000</WorkToBuild>
      <MaxHitPoints>180</MaxHitPoints>
      <Flammability>1.0</Flammability>
    </statBases>
    <size>(3,1)</size>
    <designationCategory>Production</designationCategory>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <hasInteractionCell>True</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
    <recipes>
      <li>ButcherCorpseMechanoid</li>
      <li>Miho_ComponentIndustrial</li>
      <li>Miho_ComponentSpacer</li>
      <li>Miho_MeattoDust</li>

    </recipes>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <shortCircuitInRain>true</shortCircuitInRain>
        <basePowerConsumption>350</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="CompProperties_Glower">
        <glowRadius>5</glowRadius>
        <glowColor>(73,123,138,0)</glowColor>
      </li>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>ToolCabinet</li>
		  <li>Miho_WorkAI</li>
        </linkableFacilities>
      </li>
      <li Class="CompProperties_Breakdownable"/>
    </comps>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
    </building>
    <constructEffect>ConstructMetal</constructEffect>
    <researchPrerequisites>
      <li>Machining</li>
    </researchPrerequisites>
    <designationHotKey>Misc7</designationHotKey>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>
