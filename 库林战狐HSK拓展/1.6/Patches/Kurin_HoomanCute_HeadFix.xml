<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Kurin explicitly uses a 0.9 body draw size. Hooman cute injects a
       Human-inherited 0.75 head size, so Kurin must use its own 0.9 scale. -->

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator/customHeadDrawSize</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator/customHeadDrawSize</xpath>
      <value>
        <customHeadDrawSize>(0.9, 0.9)</customHeadDrawSize>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator</xpath>
      <value>
        <customHeadDrawSize>(0.9, 0.9)</customHeadDrawSize>
      </value>
    </nomatch>
  </Operation>

  <Operation Class="PatchOperationConditional">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator/customPortraitHeadDrawSize</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator/customPortraitHeadDrawSize</xpath>
      <value>
        <customPortraitHeadDrawSize>(0.9, 0.9)</customPortraitHeadDrawSize>
      </value>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator</xpath>
      <value>
        <customPortraitHeadDrawSize>(0.9, 0.9)</customPortraitHeadDrawSize>
      </value>
    </nomatch>
  </Operation>
  
<Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator</xpath>
    <value>
        <headOffsetDirectional>
            <north>
                <offset>(0,0)</offset>
            </north>
            <south>
                <offset>(0,0)</offset>
            </south>
            <east>
                <offset>(0,0)</offset>
            </east>
            <west>
                <offset>(0,0)</offset>
            </west>
        </headOffsetDirectional>
    </value>
</Operation>

<Operation Class="PatchOperationAdd">
    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="Kurin_Race"]/alienRace/generalSettings/alienPartGenerator</xpath>
    <value>
        <headOffset>(0,-0.07)</headOffset>
        <headFemaleOffset>(0,-0.07)</headFemaleOffset>

        <headOffsetDirectional>
            <north>
                <offset>(0,0)</offset>
            </north>
            <south>
                <offset>(0,0)</offset>
            </south>
            <east>
                <offset>(0,0)</offset>
            </east>
            <west>
                <offset>(0,0)</offset>
            </west>
        </headOffsetDirectional>

        <headFemaleOffsetDirectional>
            <north>
                <offset>(0,0)</offset>
            </north>
            <south>
                <offset>(0,0)</offset>
            </south>
            <east>
                <offset>(0,0)</offset><!--change this to(-0.033,0.042)if new head placement is enabled -->
            </east>
            <west>
                <offset>(0,0)</offset><!--change this to(0.033,0.042)if new head placement is enabled -->
            </west>
        </headFemaleOffsetDirectional>

        
    </value>
</Operation>



</Patch>
