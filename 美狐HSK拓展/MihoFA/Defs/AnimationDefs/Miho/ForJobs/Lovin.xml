<Defs>
  <FacialAnimation.FaceAnimationDef>
    <defName>Lovin_Miho</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>8</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0.0,0,0.00125)</headOffset>
        <browOffset>(0.0,0,-0.005)</browOffset>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0.0,0,-0.001)</lidOffset>
        <eyeballOffset>(0.0,0,0.0075)</eyeballOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
      </li>
      <li>
        <duration>8</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0.0,0,-0.00375)</headOffset>
        <browOffset>(0.0,0,-0.0075)</browOffset>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0.0,0,-0.0015)</lidOffset>
        <eyeballOffset>(0.0,0,0.0075)</eyeballOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <mouthOffset>(0,0,-0.002)</mouthOffset>
        <headShapeDef>blush</headShapeDef>
      </li>
      <li>
        <duration>8</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0.0,0,0.0075)</headOffset>
        <browOffset>(0.0,0,0.00125)</browOffset>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0.0,0,0.001)</lidOffset>
        <eyeballOffset>(0.0,0,0.0075)</eyeballOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <mouthOffset>(0,0,-0.001)</mouthOffset>
        <headShapeDef>blush</headShapeDef>
      </li>
    </animationFrames>
    <applyWhenStandingOnly>true</applyWhenStandingOnly>
    <targetJobs>
      <li>Lovin</li>
      <li>MLI_Jobs_MassLoveIn</li>
      <li>MLI_Jobs_SingleLoveIn</li>
    </targetJobs>
    <priority>10400</priority>
  </FacialAnimation.FaceAnimationDef>

  <FacialAnimation.FaceAnimationDef>
    <defName>Lovin2_Miho</defName>
	<raceName>Alien_Miho</raceName>
    <animationFrames>
      <li>
        <duration>100</duration>
		<headOffset>(0.0,0,0.0055)</headOffset><!--add -->
		<lidShapeDef>normal</lidShapeDef>
		<eyeballShapeDef>normal</eyeballShapeDef><!--add_normal -->
        <browShapeDef>normal</browShapeDef>
        <mouthShapeDef>normal</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
      </li>
      <li><!--add 嘴巴微笑 眼球出現愛心 -->
        <duration>120</duration>
		<headOffset>(0.0,0,-0.00375)</headOffset><!--add -->
		<lidShapeDef>normal</lidShapeDef>
		<eyeballShapeDef>heart</eyeballShapeDef>
        <browShapeDef>normal</browShapeDef>
        <mouthShapeDef>smile</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
      </li>
	  <li><!--口型改為down、眼皮half、頭部下移-->
        <duration>240</duration>
        <browShapeDef>flat</browShapeDef>
		<headOffset>(0.0,0,-0.01)</headOffset><!--add -->
		<eyeballShapeDef>heart</eyeballShapeDef><!--add_heart -->
        <eyeballOffset>(0,0,0)</eyeballOffset><!--眼球が上に動く，元は0,0,-0.03 -->
        <mouthShapeDef>down</mouthShapeDef><!--元はnormal -->
		<mouthOffset>(0,0,-0.005)</mouthOffset><!--add -->
        <headShapeDef>blush</headShapeDef>
        <lidShapeDef>half</lidShapeDef><!--元はclose -->
      </li>
	  <li><!--口型改為open、眼皮半開、頭部更加上移-->
        <duration>360</duration>
        <browShapeDef>s-shaped</browShapeDef>
		<headOffset>(0,0,0.03)</headOffset><!--add -->
		<eyeballShapeDef>heart</eyeballShapeDef><!--add_heart -->
		<eyeballOffset>(0,0,0.023)</eyeballOffset><!--add眼球が上に動く，元は0(+朝左、-朝右),0(圖層調整),-0.03(+朝上、-朝下) -->
        <mouthShapeDef>open</mouthShapeDef><!--元はopen-->
		<mouthOffset>(0,0,-0.005)</mouthOffset><!--add -->
        <headShapeDef>blush</headShapeDef> 
        <lidShapeDef>normal</lidShapeDef>
      </li>
      <li><!--整組新增，模擬餘韻 -->
        <duration>180</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <headOffset>(0.0,0,0.01)</headOffset>
        <browOffset>(0.0,0,-0.005)</browOffset>
        <lidShapeDef>close</lidShapeDef>
        <lidOffset>(0.0,0,-0.001)</lidOffset>
        <eyeballOffset>(0.0,0,0.0075)</eyeballOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
      </li>
<!--  <li>
        <duration>240</duration>
        <browShapeDef>s-shaped</browShapeDef>
        <mouthShapeDef>open</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
        <lidShapeDef>close</lidShapeDef>
      </li>
      <li>
        <duration>240</duration>
        <browShapeDef>flat</browShapeDef>
        <eyeballOffset>(0,0,0.002)</eyeballOffset>
        <mouthShapeDef>open</mouthShapeDef>
        <headShapeDef>blush</headShapeDef>
        <lidShapeDef>half</lidShapeDef>
      </li> -->
    </animationFrames>
    <roopIntervalMin>0</roopIntervalMin>
    <roopIntervalMax>0</roopIntervalMax>
    <applyWhenStandingOnly>true</applyWhenStandingOnly>
    <targetJobs>
      <li>Lovin</li>
      <li>MLI_Jobs_MassLoveIn</li>
      <li>MLI_Jobs_SingleLoveIn</li>
    </targetJobs>
    <priority>10500</priority>
  </FacialAnimation.FaceAnimationDef>
</Defs>