  <Kiiro_MedicalAssistance.root.nodes.ExtraInspectStringAddOn-0.extraInspectString.slateRef>护卫</Kiiro_MedicalAssistance.root.nodes.ExtraInspectStringAddOn-0.extraInspectString.slateRef>
  <!-- EN: Patient -->
  <Kiiro_MedicalAssistance.root.nodes.ExtraInspectStringAddOn-1.extraInspectString.slateRef>病患</Kiiro_MedicalAssistance.root.nodes.ExtraInspectStringAddOn-1.extraInspectString.slateRef>
  
</LanguageData>