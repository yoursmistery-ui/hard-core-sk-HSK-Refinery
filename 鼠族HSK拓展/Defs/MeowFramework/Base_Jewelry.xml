	<ThingDef Name="Meow_JewelryBase" Abstract="True">
		<thingClass>Apparel</thingClass>
		<category>Item</category>
		<drawerType>MapMeshOnly</drawerType>
		<selectable>True</selectable>
		<pathCost>1</pathCost>
		<useHitPoints>True</useHitPoints>
		<techLevel>Medieval</techLevel>
		<graphicData>
			<onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.8</drawSize>
		</graphicData>
		<drawGUIOverlay>true</drawGUIOverlay>
		<statBases>
			<MaxHitPoints>75</MaxHitPoints>
			<WorkToMake>20000</WorkToMake>
			<Mass>0.01</Mass>
			<EquipDelay>0.1</EquipDelay>
			<Flammability>1</Flammability>
			<DeteriorationRate>2</DeteriorationRate>
			<Beauty>3</Beauty>
			<SellPriceFactor>1.2</SellPriceFactor>
		</statBases>
		<altitudeLayer>Item</altitudeLayer>
		<alwaysHaulable>True</alwaysHaulable>
		<tickerType>Never</tickerType>
		<burnableByRecipe>true</burnableByRecipe>
		<smeltable>true</smeltable>
		<comps>
			<li Class="CompProperties_Forbiddable" />
			<li>
				<compClass>CompColorable</compClass>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<recipeMaker>
			<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
			<workSkill>Crafting</workSkill>
			<effectWorking>Smith</effectWorking>
			<soundWorking>Recipe_Smith</soundWorking>
			<recipeUsers Inherit="false">
				<li>RK_FueledSmithy</li>
				<li>RK_ElectricSmithy</li>
			</recipeUsers>
			<unfinishedThingDef>UnfinishedJewelry</unfinishedThingDef>
			<skillRequirements>
				<Crafting>5</Crafting>
				<Artistic>3</Artistic>
			</skillRequirements>
		</recipeMaker>
		<thingCategories>
			<li>Meow_Jewelry</li>
		</thingCategories>
		<tradeTags Inherit="false">
			<li>RK_ExoticValuable</li>
			<li>Meow_Jewelry</li>
		</tradeTags>
		<apparel>
			<countsAsClothingForNudity>false</countsAsClothingForNudity>
			<careIfDamaged>false</careIfDamaged>
			<careIfWornByCorpse>false</careIfWornByCorpse>
			<scoreOffset>1</scoreOffset>
			<wearPerDay>0</wearPerDay>
			<tags>
				<li>Meow_Jewelry</li>
			</tags>
			<canBeDesiredForIdeo>false</canBeDesiredForIdeo>
			<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		</apparel>
		<tradeability>All</tradeability>
	</ThingDef>


