	<ThingDef ParentName="sbzSmallDisplayShelfBase">
		<defName>sbz_TextileRack</defName>
		<label>textile rack</label>
		<description>A textile rack that can hold up to 6 fabrics of various kinds.</description>
		<graphicData>
			<texPath>Things/Building/Storage/TextileRack/sbz_TextileRack</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(4,4)</drawSize>
			<drawRotated>false</drawRotated>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<rotatable>false</rotatable>
		<costStuffCount>40</costStuffCount>
		<uiIconScale>0.5</uiIconScale>
		<uiOrder>1140</uiOrder>
		<staticSunShadowHeight>0.35</staticSunShadowHeight>
		<stuffCategories Inherit="false">
			<li>Metallic</li>
		</stuffCategories>
		<researchPrerequisites Inherit="false">
			<li>Smithing</li>
		</researchPrerequisites>
		<building>
			<preventDeteriorationOnTop>true</preventDeteriorationOnTop>
			<ignoreStoredThingsBeauty>true</ignoreStoredThingsBeauty>
			<maxItemsInCell>6</maxItemsInCell>
			<fixedStorageSettings>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
						<li>Textiles</li>
					</categories>
				</filter>
			</fixedStorageSettings>
			<defaultStorageSettings>
				<priority>Preferred</priority>
				<filter>
					<disallowNotEverStorable>true</disallowNotEverStorable>
					<categories>
					</categories>
				</filter>
			</defaultStorageSettings>
			<paintable>true</paintable>
		</building>
	</ThingDef>

