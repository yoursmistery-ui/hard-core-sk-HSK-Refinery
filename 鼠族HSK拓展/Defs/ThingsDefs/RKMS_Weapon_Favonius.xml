				<armorPenetrationBlunt>4.2</armorPenetrationBlunt>
				<linkedBodyPartsGroup>Edge</linkedBodyPartsGroup>
			</li>
		</tools>
		<recipeMaker Inherit="False" IsNull="True" />
		<comps>
		</comps>
