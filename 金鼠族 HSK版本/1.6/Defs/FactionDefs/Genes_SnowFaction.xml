<?xml version="1.0" encoding="utf-8"?>
<Defs>
<FactionDef ParentName="RatkinFactionBase">
		<defName>Rakinia_SnowRatkin</defName>
		<label>雪原鼠族王国</label>
		<description>The Rakinia Kingdom, established by a large number of snow ratkin tribes in extremely cold regions, has a strong sense of territory but shows no concern for things in hot areas.</description>
		<colorSpectrum>
			<li>(0.72, 0.72, 0.72)</li>
		</colorSpectrum>
		<pawnSingular>Snow Ratkin</pawnSingular>
		<pawnsPlural>Snow Ratkins</pawnsPlural>
		<categoryTag>RatkinStory</categoryTag>
		<listOrderPriority>36</listOrderPriority>
		<settlementGenerationWeight>0.85</settlementGenerationWeight>
		<requiredCountAtGameStart>1</requiredCountAtGameStart>
		<maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
		<canMakeRandomly>true</canMakeRandomly>
		<leaderTitle>雪鼠领主</leaderTitle>
		<factionNameMaker>NamerFaction_RatkinKingdom_SnowRatkin</factionNameMaker>
		<settlementNameMaker>NamerSettlement_RatkinKingdom</settlementNameMaker>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<factionIconPath>Ui/Icons/Xenotypes/OAGene_SnowRatkin</factionIconPath>
		<techLevel>Industrial</techLevel>
		<melaninRange>0~0.22</melaninRange>
		<fixedLeaderKinds>
			<li>RatkinEliteSoldier</li>
		</fixedLeaderKinds>
		<backstoryCategories>
			<li>Offworld</li>
		</backstoryCategories>
		<xenotypeSet Inherit="False">
			<xenotypeChances>
				<RK_XenoType_Ratkin>0.20</RK_XenoType_Ratkin>
				<OAGene_SnowRatkin>0.80</OAGene_SnowRatkin>
			</xenotypeChances>
		</xenotypeSet>
		<pawnGroupMakers Inherit="False">
			<li>
				<kindDef>Combat</kindDef>
				<commonality>50</commonality>
				<options>
					<RatkinDefender>10</RatkinDefender>
					<RatkinSoldier>20</RatkinSoldier>
					<RatkinEliteSoldier>15</RatkinEliteSoldier>
					<RatkinEliteDefender>10</RatkinEliteDefender>
				</options>
			</li>
			<li>
				<kindDef>Combat</kindDef>
				<commonality>150</commonality>
				<options>
					<RatkinEliteSoldier>20</RatkinEliteSoldier>
					<RatkinEliteDefender>8</RatkinEliteDefender>
				</options>
			</li>
			<li>
				<kindDef>Combat</kindDef>
				<disallowedStrategies>
					<li>Siege</li>
				</disallowedStrategies>
				<commonality>30</commonality>
				<options>
					<RatkinSoldier>12</RatkinSoldier>
					<RatkinEliteSoldier>25</RatkinEliteSoldier>
					<RatkinEliteDefender>10</RatkinEliteDefender>
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<RatkinNoble>10</RatkinNoble>
					<RatkinColonist>20</RatkinColonist>
					<RatkinServant>15</RatkinServant>
					<RatkinEliteGuardener>15</RatkinEliteGuardener>
					<RatkinKnight>10</RatkinKnight>
					<RatkinPriest>10</RatkinPriest>
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<RatkinMerchant>15</RatkinMerchant>
					<RatkinNoble>8</RatkinNoble>
				</traders>
									<carriers>
						<Ratkin_KingHamster>6</Ratkin_KingHamster>
						<Horse_Wooly>4</Horse_Wooly>
						<Mammoth>2</Mammoth>
						<Bear_Polar>1</Bear_Polar>
					</carriers>
									<guards>
						<RatkinSoldier>20</RatkinSoldier>
						<RatkinDefender>20</RatkinDefender>
						<RatkinEliteSoldier>4</RatkinEliteSoldier>
					</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<RatkinNoble>3</RatkinNoble>
					<RatkinColonist>6</RatkinColonist>
					<RatkinServant>8</RatkinServant>
					<RatkinCombatant>5</RatkinCombatant>
					<RatkinSoldier>15</RatkinSoldier>
					<RatkinEliteSoldier>22</RatkinEliteSoldier>
					<RatkinPriest>3</RatkinPriest>
				</options>
			</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">
				<kindDef>Farmers</kindDef>				<!-- 农业工作站需要 -->
				<commonality>1</commonality>
				<options>
					<RatkinColonist>1</RatkinColonist>
				</options>
			</li>
		</pawnGroupMakers>
		<caravanTraderKinds Inherit="False">
			<li>RK_TraderKind_KingdomBulkGoods</li>
			<li>RK_TraderKind_KingdomHuntpack</li>
			<li>RK_TraderKind_KingdomCombatSupplier</li>
			
			<li>RK_TraderKind_KingdomExotic</li>
		</caravanTraderKinds>
		<visitorTraderKinds Inherit="False">
			<li>Visitor_Outlander_Standard</li>
		</visitorTraderKinds>
		<baseTraderKinds Inherit="False">
			<li>Base_Outlander_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>-55~20</allowedArrivalTemperatureRange>
		<requiredMemes Inherit="False">
			<li MayRequire="Ludeon.RimWorld.Ideology">Loyalist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">OAGene_TerritorialHegemony</li>
		</requiredMemes>
		<disallowedMemes Inherit="False">
			<li MayRequire="Ludeon.RimWorld.Ideology">Structure_Animist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<structureMemeWeights Inherit="False">
			<Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">1</Structure_TheistEmbodied>
			<Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">5</Structure_TheistAbstract>
			<Structure_Ideological MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Ideological>
			<Structure_Archist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Archist>
			<Structure_OriginChristian MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginChristian>
			<Structure_OriginIslamic MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginIslamic>
			<Structure_OriginHindu MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginHindu>
			<Structure_OriginBuddhist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_OriginBuddhist>
		</structureMemeWeights>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,35)</li>
				<li>(70, 50)</li>
				<li>(700, 100)</li>
				<li>(1300, 150)</li>
				<li>(100000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<apparelStuffFilter>
			<stuffCategoriesToAllow>
				<li>WeaponMetallic</li>
				<li>Fabric</li>
				<li>Leathery</li>
				<li>Woody</li>
			</stuffCategoriesToAllow>
		</apparelStuffFilter>
		<allowedCultures>
			<li>RK_Culture_Virtuard</li>
		</allowedCultures>
		<modExtensions>
			<li Class="OberoniaAurea_Frame.FactionTagsExtension">
				<factionTags>
					<li>RatkinKindom</li>
				</factionTags>
			</li>
		</modExtensions>
	</FactionDef>
</Defs>