<?xml version="1.0" encoding="utf-8" ?>
<Defs> 
	<PawnKindDef Name="RKBasePawnKind_Warlord" ParentName="RKBasePawnKind" Abstract="True">
		<defaultFactionType>Rakinia_Warlord</defaultFactionType>
		<!-- 2026-08-22: 军阀兵种显式指定鼠族异种人池(含鼠人/实验白鼠/废土鼠/田鼠),
		     不依赖 RKBasePawnKind 继承,确保军阀部队生成鼠族异种人。 -->
		<xenotypeSet Inherit="False">
			<xenotypeChances>
				<RK_XenoType_Ratkin MayRequire="Ludeon.RimWorld.Biotech">0.88</RK_XenoType_Ratkin>
				<Ratkin_Squirrel MayRequire="Ludeon.RimWorld.Biotech">0.024</Ratkin_Squirrel>
				<Ratkin_Hamster MayRequire="Ludeon.RimWorld.Biotech">0.016</Ratkin_Hamster>
				<Ratkin_LabRat MayRequire="Ludeon.RimWorld.Biotech">0.03</Ratkin_LabRat>
				<Ratkin_Waster MayRequire="Ludeon.RimWorld.Biotech">0.03</Ratkin_Waster>
				<Ratkin_Vole MayRequire="Ludeon.RimWorld.Biotech">0.02</Ratkin_Vole>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>	
	
	<PawnKindDef Name="RKCombatantBase_Warlord" ParentName="RKBasePawnKind_Warlord" Abstract="true">
		<isFighter>true</isFighter>	
	</PawnKindDef>	
	
	<!-- 贵族 -->
	<PawnKindDef ParentName="RKBasePawnKind_Warlord">
		<defName>RatkinWarlord</defName>
		<label>ratkin warlord</label>
		<combatPower>35</combatPower>
		<isFighter>true</isFighter>
		<maxPerGroup>1</maxPerGroup>
		<factionLeader>true</factionLeader>
		<initialResistanceRange>60~100</initialResistanceRange>
		<initialWillRange>5~10</initialWillRange>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RatkinNoble</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<itemQuality>Excellent</itemQuality>
		<apparelMoney>
			<min>2000</min>
			<max>3500</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_Noble</li>
			<li>RK_WWII</li>
		</apparelTags>
		<apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
		<weaponMoney>
			<min>1800</min>
			<max>3000</max>
		</weaponMoney>
		<weaponTags>
			<li>RK_Combatant</li>
			<li>RK_Shotgun</li>
			<li>RK_3TierWeapon</li>
			<li>RK_Rifle</li>
		</weaponTags>
		<inventoryOptions>
			<skipChance>0</skipChance>
			<subOptionsChooseOne>
				<li>
					<choiceChance>95</choiceChance>
					<thingDef>Silver</thingDef>
					<countRange>
						<min>300</min>
						<max>800</max>
					</countRange>
				</li>
				<li>
					<choiceChance>5</choiceChance>
					<thingDef>Gold</thingDef>
					<countRange>
						<min>100</min>
						<max>200</max>
					</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<trader>false</trader>
	</PawnKindDef>
	
