<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: kiiro merchant cash register -->
  <Kiiro_Cashier.label>綺羅商戶收銀臺</Kiiro_Cashier.label>
  <!-- EN: Where Kiiro Merchant trades.\n\nOnly placed indoors without any other cash registers. Binding merchant makes the room corresponding shop.\n\n After binding, assign a non-merchant colonist to interact with the bound merchant with right click on the cash register.\n\n Can be placed on a table. -->
  <Kiiro_Cashier.description>綺羅商戶們交易和結算的地方。\n\n只能放置在沒有其他收銀臺的室內，放置后繫結綺羅商戶可以使這個房間變成商戶對應的商舖型別。\n\n繫結完成後，選中非商戶的殖民者右鍵收銀臺可以與繫結的商戶互動。\n\n可以放置在桌面。</Kiiro_Cashier.description>
  <!-- EN: Bind a merchant. -->
  <Kiiro_Cashier.comps.CompAssignableToPawn_KiiroMerchant.noAssignablePawnsDesc>需要指定一個綺羅商戶。</Kiiro_Cashier.comps.CompAssignableToPawn_KiiroMerchant.noAssignablePawnsDesc>
  
</LanguageData>