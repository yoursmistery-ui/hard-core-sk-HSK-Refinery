<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 止血 Hediff -->
  <HediffDef>
    <defName>AutoBleedingControl</defName>
    <label>战斗医疗系统</label>
    <description>纳米纤维激活凝血机制，自动封闭伤口，开启修复治疗模式。</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
	<defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
    <stages>
      <li>
	    <statFactors>
          <IncomingDamageFactor>0.50</IncomingDamageFactor>
        </statFactors>
                <statOffsets>
                    <InjuryHealingFactor>1</InjuryHealingFactor> <!-- 愈合因子 -->
                </statOffsets>
                <totalBleedFactor>0.85</totalBleedFactor>        <!-- 失血量系数 -->
                <naturalHealingFactor>200</naturalHealingFactor> <!-- 自然愈合因子 -->
      </li>
    </stages>
	 <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
  </HediffDef>
  
    <HediffDef>
    <defName>gelusilingneng</defName>
    <label>圣光祝福</label>
    <description>鼠族修女的灵能圣光祝福，灵能之息缓缓治愈伤势</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
	<defaultLabelColor>(0.63,1,0.9)</defaultLabelColor>
