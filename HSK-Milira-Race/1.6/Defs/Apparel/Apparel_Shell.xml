<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef Name="Milira_ShellBase" ParentName="Milira_ApparelBase" Abstract="True">
		<statBases>
			<Mass>2.2</Mass>
			<EquipDelay>2.5</EquipDelay>
		</statBases>
		<apparel>
			<layers>
				<li>Shell</li>
			</layers>
			<shellRenderedBehindHead>true</shellRenderedBehindHead>
		</apparel>
		<thingCategories>
			<li>Milira_Apparel_Shell</li>
		</thingCategories>
	</ThingDef>

	<ThingDef Name="Milira_ShellBaseI" ParentName="Milira_ShellBase" Abstract="True">
		<recipeMaker>
			<researchPrerequisite>Milira_Apparel_I</researchPrerequisite>
			<recipeUsers>
				<li>Milira_TailoringBench</li>
			</recipeUsers>
		</recipeMaker>
		<apparel>
			<tags>
				<li>Milira_Shell</li>
			</tags>
		</apparel>
	</ThingDef>

	<ThingDef Name="Milira_ShellBaseII" ParentName="Milira_ShellBase" Abstract="True">
		<recipeMaker>
			<researchPrerequisite>Milira_Apparel_II</researchPrerequisite>
			<recipeUsers>
				<li>Milira_TailoringBench</li>
			</recipeUsers>
		</recipeMaker>
		<apparel>
			<tags>
				<li>Milira_Shell</li>
			</tags>
		</apparel>
	</ThingDef>


	<!--1级衣服-->

	<ThingDef ParentName="Milira_ShellBaseII">
		<defName>Milira_Dustcoat</defName>
		<label>Milira dust coat</label>
		<description>A thick coat that provides excellent protection against dust and sand while also offering good warmth.</description>
		<costStuffCount>140</costStuffCount>
		<stuffCategories>
			<li>Leathery</li>
		</stuffCategories>
		<graphicData>
			<texPath>Milira/Apparel/Shell/Dustcoat/Dustcoat</texPath>
		</graphicData>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToMake>12000</WorkToMake>
			<ArmorRating_Sharp>0.20</ArmorRating_Sharp>
			<ArmorRating_Blunt>0.10</ArmorRating_Blunt>
			<ArmorRating_Heat>0.30</ArmorRating_Heat>
			<StuffEffectMultiplierArmor>0.35</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.6</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.6</StuffEffectMultiplierInsulation_Heat>
		</statBases>
		<apparel>
			<useWornGraphicMask>false</useWornGraphicMask>
			<developmentalStageFilter>Child, Adult</developmentalStageFilter>
			<bodyPartGroups>
				<li>Torso</li>
				<li>Legs</li>
				<li>Arms</li>
				<li>Neck</li>
				<li>Shoulders</li>
				<li>Feet</li>
				<li>Hands</li>
				<li>Milira_Wings</li>
			</bodyPartGroups>
			<wornGraphicPath>Milira/Apparel/Shell/Dustcoat/Dustcoat</wornGraphicPath>
			<tags>
				<li>Milira_DailyWear</li>
				<li>Milira_Daily</li>
			</tags>
		</apparel>
		<equippedStatOffsets>
		</equippedStatOffsets>
	</ThingDef>


	<ThingDef ParentName="Milira_ShellBaseII">
		<defName>Milira_PlushCape</defName>
