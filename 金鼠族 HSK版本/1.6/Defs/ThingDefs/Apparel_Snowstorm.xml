<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="RK_ApparelMakeableBase">
        <defName>OAGene_SnowstormCloak</defName>
        <label>Rat Clan Wind and Snow Cloak</label>
        <description>A simple cloak only requires a considerable amount of material to provide sufficient warmth and is sturdy and reliable.</description>
        <graphicData>
            <texPath>Things/Apparel/OAGene_SnowstormCloak</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <stuffCategories>            <!-- 配方具体在RecipeDef中实现，但有stuff的Thing不写这个会导致没有原料属性 -->
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <recipeMaker Inherit="False" IsNull="True"/>
        <!-- 屏蔽原版配方 -->
        <techLevel>Medieval</techLevel>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToMake>2400</WorkToMake>
            <Mass>3</Mass>
            <StuffEffectMultiplierArmor>0.10</StuffEffectMultiplierArmor>
            <StuffEffectMultiplierInsulation_Cold>0.75</StuffEffectMultiplierInsulation_Cold>
            <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
            <Insulation_Cold>4</Insulation_Cold>
            <EquipDelay>3</EquipDelay>
        </statBases>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>
        <tradeability>Sellable</tradeability>
        <equippedStatOffsets>
            <SocialImpact>0.05</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <wornGraphicPath>Things/Apparel/OAGene_SnowstormCloak</wornGraphicPath>
            <layers>
                <li>Shell</li>
            </layers>
            <drawData>
                <defaultData>
                    <layer>30</layer>
                </defaultData>
            </drawData>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>Worker</li>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>OA_RK_Fengxue</li>
                <li>RoyalTier2</li>
                <li>RoyalTier5</li>
            </tags>
        </apparel>
    </ThingDef>

    <ThingDef ParentName="RK_HatMakeableBase">
        <defName>OAGene_SnowstormBarrette</defName>
        <label>Wind and snow hair accessories</label>
        <description>The hair accessory looks very exquisite, and the hanging ice crystals are occasionally blown by the wind, making a pleasant sound.</description>
        <graphicData>
            <texPath>Things/Apparel/OAGene_SnowstormBarrette</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <statBases>
            <WorkToMake>12000</WorkToMake>
            <Mass>0.25</Mass>
            <EquipDelay>0.75</EquipDelay>
            <Insulation_Cold>2</Insulation_Cold>
        </statBases>
        <generateCommonality>0</generateCommonality>
        <generateAllowChance>0</generateAllowChance>
        <tradeability>Sellable</tradeability>
        <equippedStatOffsets>
            <SocialImpact>0.15</SocialImpact>
            <TradePriceImprovement>0.05</TradePriceImprovement>
        </equippedStatOffsets>
        <recipeMaker Inherit="False" IsNull="True" />
        <apparel>
            <wornGraphicPath>Things/Apparel/OAGene_SnowstormBarrette</wornGraphicPath>
            <layers>
                <li>Overhead</li>
            </layers>
            <renderSkipFlags>
                <li>None</li>
            </renderSkipFlags>
            <bodyPartGroups>
                <li>UpperHead</li>
            </bodyPartGroups>
            <defaultOutfitTags>
                <li>Worker</li>
            </defaultOutfitTags>
            <tags>
                <li>OA_RK_Fengxue</li>
                <li>RoyalTier2</li>
                <li>RoyalTier5</li>
                <li>Royal</li>
                <li>RoyalTier6</li>
                <li>RoyalTier7</li>
            </tags>
        </apparel>
    </ThingDef>

</Defs>