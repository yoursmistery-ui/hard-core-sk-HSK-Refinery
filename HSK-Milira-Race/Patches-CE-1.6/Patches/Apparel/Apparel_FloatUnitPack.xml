<?xml version="1.0" encoding="utf-8"?>
<Patch>
<!--小型离子浮游单元背包-->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Milira_FloatUnitPack"]/statBases</xpath>
        <value>
            <Bulk>5</Bulk>
            <WornBulk>1</WornBulk>
        </value>
    </Operation>
<!--自律护盾浮游单元背包-->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="Milira_FloatUnitPack_Shield"]/statBases</xpath>
        <value>
            <Bulk>4</Bulk>
            <WornBulk>1</WornBulk>
        </value>
    </Operation>

</Patch>