<Patch>
  <!--Miho_DeployableHMG: 一级分类 MihoBuilding -> Security(并入 HSK 防御分类)-->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="Miho_DeployableHMG"]/designationCategory</xpath>
    <value>
      <designationCategory>Security</designationCategory>
    </value>
  </Operation>
