<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- 绮罗贴身层基础修改-重量 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_OnSkinBase"
		]/statBases/Mass</xpath>
		<value>
			<Mass>0.8</Mass>
		</value>
	</Operation>
	<!-- 绮罗贴身层基础修改-体积 -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[
		@Name="Kiiro_OnSkinBase"
		]/statBases</xpath>
		<value>
			<Bulk>1.5</Bulk>
			<WornBulk>1</WornBulk>
		</value>
	</Operation>

	<!-- 绮罗T恤衫 绮罗T恤衫（短款） 绮罗背心 绮罗水手服（款一） 绮罗水手服（款二） 绮罗可爱连帽衫  绮罗运动背心 绮罗针织毛衣 绮罗工作衬衫 的材料系数 -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
		defName="Kiiro_TShirt" or 
		defName="Kiiro_TShirtShort" or 
		defName="Kiiro_Waistcoat" or 
		defName="Kiiro_SailorSuit" or 
		defName="Kiiro_SailorSuitII" or 
		defName="Kiiro_Hoodie" or 
		defName="Kiiro_RunningShirt" or 
		defName="Kiiro_KnittedSweater" or 
		defName="Kiiro_WorkerShirt"
		]/statBases/StuffEffectMultiplierArmor</xpath>
		<value>
			<StuffEffectMultiplierArmor>2</StuffEffectMultiplierArmor>
		</value>
	</Operation>
	
