        <xpath>/Defs/ThingDef[defName="SD_2x1WoodDoor"]/statBases/WorkToBuild</xpath>
        <value><WorkToBuild>1300</WorkToBuild></value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="SD_2x1WoodDoor"]/costStuffCount</xpath>
        <value><costStuffCount>40</costStuffCount></value>
    </Operation>
