<LanguageData>
  
  <!-- EN:
    <li>questName->Laborers</li>
    <li>questDescription-></li>
  -->
  <Kiiro_LaborAssist.questDescriptionAndNameRules.rulesStrings>
    <li>questName->工作協助</li>
    <li>questDescription-></li>
  </Kiiro_LaborAssist.questDescriptionAndNameRules.rulesStrings>
  <!-- EN: Completing work assistance in {0}. -->
  <Kiiro_LaborAssist.root.nodes.ExtraInspectStringAddOn.extraInspectString.slateRef>于{0}后完成工作協助。</Kiiro_LaborAssist.root.nodes.ExtraInspectStringAddOn.extraInspectString.slateRef>
  <!-- EN: one day left: work assist -->
  <Kiiro_LaborAssist.root.nodes.Delay-1.node.label.slateRef>工作協助：最後一天</Kiiro_LaborAssist.root.nodes.Delay-1.node.label.slateRef>
  <!-- EN: The required work assist is only one day left. -->
  <Kiiro_LaborAssist.root.nodes.Delay-1.node.text.slateRef>工作協助的期限只剩下最後一天了。</Kiiro_LaborAssist.root.nodes.Delay-1.node.text.slateRef>
  <!-- EN: work assist completed -->
  <Kiiro_LaborAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.label.slateRef>工作協助已結束</Kiiro_LaborAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.label.slateRef>
  <!-- EN: The kiiros from [kiiro_settlement_label] completed work assist just now, and now leaving. -->
  <Kiiro_LaborAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.text.slateRef>來自[kiiro_settlement_label]的綺羅剛剛完成了工作協助，正在離開。</Kiiro_LaborAssist.root.nodes.GreaterOrEqual.node.node.nodes.AnyPawnAlive.node.text.slateRef>
  <!-- EN: worker died: {SUBJECT_definite} -->
  <Kiiro_LaborAssist.root.nodes.laborersDestroyed.node.nodes.Letter.label.slateRef>幫工死亡：{SUBJECT_definite}</Kiiro_LaborAssist.root.nodes.laborersDestroyed.node.nodes.Letter.label.slateRef>
  <!-- EN: A worker sent to you by [permitFaction_name] has died. Your goodwill with [permitFaction_name] has fallen by [goodwillPenaltyPawn]. -->
  <Kiiro_LaborAssist.root.nodes.laborersDestroyed.node.nodes.Letter.text.slateRef>一個[permitFaction_name]派來的幫工死了。你與[permitFaction_name]的關係下降了[goodwillPenaltyPawn]。</Kiiro_LaborAssist.root.nodes.laborersDestroyed.node.nodes.Letter.text.slateRef>
  <!-- EN: kiiro work assist suspended -->
  <Kiiro_LaborAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>綺羅工作協助中止</Kiiro_LaborAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.label.slateRef>
  <!-- EN: due to we are now hostile to kiiro, the required kiiro work assist was forced to suspend. -->
  <Kiiro_LaborAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>由於現在與綺羅族處於敵對關係，請求的工作協助被迫中止了。</Kiiro_LaborAssist.root.nodes.permitFactionBecameHostileToPlayer.node.nodes.Letter.text.slateRef>
  
</LanguageData>