        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKVictoria_Make_Crusadershead"]/ingredients</xpath>
        <value>
<ingredients>
                <li><filter><stuffCategoriesToAllow><li>Metallic</li></stuffCategoriesToAllow></filter><count>40</count></li>
                <li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>15</count></li>
                <li><filter><thingDefs><li>Cloth</li></thingDefs></filter><count>10</count></li>
                <li><filter><thingDefs><li>ComponentMedieval</li></thingDefs></filter><count>2</count></li>
</ingredients>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/RecipeDef[defName="RKHSKVictoria_Make_Crusadershead"]/fixedIngredientFilter</xpath>
        <value>
<fixedIngredientFilter>
