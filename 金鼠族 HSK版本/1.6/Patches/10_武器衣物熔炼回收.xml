    <!-- ────────── 衣物/装甲/头饰可熔炼(not(smeltable) 防重复) ────────── -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="OARatkin_ApparelBase" and not(smeltable)]</xpath>
        <value><smeltable>true</smeltable></value>
    </Operation>
    <!-- 配件(腰带/背包)不是衣物, 保持不可熔炼 -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[@Name="OARatkin_UtilityMakeableBase" and not(smeltable)]</xpath>
