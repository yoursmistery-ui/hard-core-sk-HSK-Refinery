    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="RK_ApronSkirtChildren"]/generateCommonality</xpath>
        <match Class="PatchOperationReplace">
            <xpath>Defs/ThingDef[defName="RK_ApronSkirtChildren"]/generateCommonality</xpath>
            <value><generateCommonality>0</generateCommonality></value>
        </match>
        <nomatch Class="PatchOperationAdd">
