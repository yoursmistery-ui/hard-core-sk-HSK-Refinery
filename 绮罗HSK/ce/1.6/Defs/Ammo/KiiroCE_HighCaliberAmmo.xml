	<!-- ==================== Ammo ========================== -->

	<ThingDef Class="CombatExtended.AmmoDef" Name="AmmoKiiroPTGuardianBase" ParentName="MediumAmmoBase" Abstract="True">
		<description>A type of High caliber ammunition developed by the Kiiro race for the prototype series of weapons. It has strong penetration but average power. It is commonly used on fixed machine guns when defending positions.</description>
		<statBases>
			<Mass>0.09</Mass>
			<Bulk>0.11</Bulk>
		</statBases>
		<tradeTags>
			<li>CE_AutoEnableTrade</li>
			<li>CE_AutoEnableCrafting</li>
		</tradeTags>
		<thingCategories>
			<li>AmmoKiiroPTGuardian</li>
		</thingCategories>
		<stackLimit>5000</stackLimit>
	</ThingDef>

