<?xml version="1.0" encoding="utf-8" ?>
<Patch>
  <!-- 
    Using robust hediff-based XPaths.
    This method targets the correct <li> node by its internal data (hediff),
    making it immune to Class attribute variations (short name vs. full namespace).
  -->

  <!-- Special Magnifier -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Miho_Apparel_Special_Magnifier"]/comps/li[hediff="Miho_Magnifier_Hediff"]</xpath>
    <value>
      <li Class="MihoOptimization.CompProperties_CauseHediff_Apparel_Optimized">
        <hediff>Miho_Magnifier_Hediff</hediff>
        <part>Head</part>
      </li>
    </value>
  </Operation>

