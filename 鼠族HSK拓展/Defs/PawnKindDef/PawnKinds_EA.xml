<Defs> 
	<!-- 白薔薇王國 -->

	<!-- 白薔薇軍官 -->
	<PawnKindDef ParentName="RKCombatantBase">
		<defName>WR_RatkinOfficer</defName>
		<label>White Rose Ratkin Officer</label>
		<race>Ratkin</race>
		<combatPower>35</combatPower>
		<isFighter>true</isFighter>
		<maxPerGroup>1</maxPerGroup>
		<factionLeader>true</factionLeader>
		<initialResistanceRange>60~100</initialResistanceRange>
		<initialWillRange>5~10</initialWillRange>
		<backstoryFiltersOverride>
			<li>
				<categories>
					<li>RatkinNoble</li>
				</categories>
			</li>
		</backstoryFiltersOverride>
		<itemQuality>Excellent</itemQuality>
		<apparelMoney>
			<min>2000</min>
			<max>3500</max>
		</apparelMoney>
		<apparelTags>
			<li>RK_WR_Officer</li>
		</apparelTags>
		<apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
		<weaponMoney>
			<min>1800</min>
			<max>3000</max>
		</weaponMoney>
		<weaponTags>
			<li>RK_RCG_Saber</li>
			<li>RK_WR_Rifle</li>
			<li>RK_WR_Pistol</li>
		</weaponTags>
		<inventoryOptions>
			<skipChance>0</skipChance>
			<subOptionsChooseOne>
				<li>
					<choiceChance>95</choiceChance>
					<thingDef>Silver</thingDef>
					<countRange>
						<min>300</min>
						<max>800</max>
					</countRange>
				</li>
				<li>
					<choiceChance>5</choiceChance>
					<thingDef>Gold</thingDef>
					<countRange>
						<min>100</min>
						<max>200</max>
					</countRange>
				</li>
			</subOptionsChooseOne>
		</inventoryOptions>
		<trader>false</trader>
	</PawnKindDef>

