        </stuffCategories>
        <equippedStatOffsets>
            <GeneralLaborSpeed>0.05</GeneralLaborSpeed>
            <SocialImpact>0.15</SocialImpact>
        </equippedStatOffsets>
        <apparel>
            <bodyPartGroups>
