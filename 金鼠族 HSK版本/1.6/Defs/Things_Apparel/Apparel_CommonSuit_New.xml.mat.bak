        <label>Oberonia Aurea Technical Officer Coat</label>
        <description>The Oberonia Aurea Palace is a coat specially developed for technical officials, with little consideration for practicality, but more emphasis on comfort and aesthetics when wearing it.</description>
        <graphicData>
            <texPath>Apparel/OA_RK_New_Windbreaker_D</texPath>
            <graphicClass>Graphic_Single</graphicClass>
