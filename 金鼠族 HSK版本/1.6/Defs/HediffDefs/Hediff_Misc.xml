<?xml version='1.0' encoding='utf-8'?>
<Defs>

    <HediffDef>
        <defName>OAGene_XenogermRepairing</defName>
        <label>Gene repair</label>
        <description>The character's genes have only recently undergone one gene repair, and in order to prevent the gene chain from collapsing due to excessive repair, gene repair cannot be performed again during this period.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>600000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>

<HediffDef>
        <defName>OAGene_Hediff_SnowstormStrugglers</defName>
        <label>难民心情</label>
        <description>隐藏状态，用于触发难民心情</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
        <comps>
            <li Class="OberoniaAureaGene.Snowstorm.HediffCompProperties_DisappearAfterSnowstorm">
                <checkInterval>2500</checkInterval>
            </li>
            <li Class="HediffCompProperties_ThoughtSetter">
                <thought>OAGene_Thought_SnowstormStrugglers</thought>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>OAGene_Hediff_SnowstormCultist</defName>
        <label>Windstorm Cultists</label>
        <description>We are born guilty, only the wind and snow can wash away the sins we carry. Praise the great, merciful, and omnipotent God of Storms</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <statOffsets>
                    <ComfyTemperatureMin>-40</ComfyTemperatureMin>
                    <PainShockThreshold>0.30</PainShockThreshold>
                </statOffsets>
                <statFactors>
                    <CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.2</CertaintyLossFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="OberoniaAureaGene.HediffCompProperties_SnowstormSpeech">
                <compClass>OberoniaAureaGene.Snowstorm.HediffComp_SnowstormCultistConvert</compClass>
                <speechRulePack>OAGene_SnowstormCultistSpeech</speechRulePack>
                <speechSection>1~6</speechSection>
                <speechInterval>2250~2750</speechInterval>
            </li>
        </comps>
    </HediffDef>

    <HediffDef>
        <defName>OAGene_Hediff_SpecialThrumbo</defName>
        <label>The Striking Beast in the Wind and Snow</label>
        <description>The willingness to survive in a snowstorm is much stronger than that of a normal percussion beast, as it actively self domesticates and seeks refuge.</description>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>0.10</offset>
                    </li>
                </capMods>
                <statOffsets>
                    <ComfyTemperatureMin>-25</ComfyTemperatureMin>
                    <PainShockThreshold>0.05</PainShockThreshold>
                </statOffsets>
            </li>
            <li>
                <label>狂暴</label>
                <minSeverity>2</minSeverity>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <postFactor>1.25</postFactor>
                    </li>
                    <li>
                        <capacity>Manipulation</capacity>
                        <postFactor>1.25</postFactor>
                    </li>
                </capMods>
                <statOffsets>
                    <ComfyTemperatureMin>-25</ComfyTemperatureMin>
                    <PainShockThreshold>0.15</PainShockThreshold>
                </statOffsets>
                
                
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>OAGene_Hediff_HideInSnowstorm</defName>
        <label>Hidden in the wind and snow</label>
        <hediffClass>HediffWithComps</hediffClass>
        <description>By utilizing extreme wind and snow to achieve the purpose of hiding oneself, this effect will be lost when under the roof.</description>
        <isBad>false</isBad>
        <scenarioCanAdd>false</scenarioCanAdd>
        <duplicationAllowed>false</duplicationAllowed>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Talking</capacity>
                        <setMax>0</setMax>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Invisibility">
                <visibleToPlayer>false</visibleToPlayer>
                <fadeDurationTicks>60</fadeDurationTicks>
                <recoverFromDisruptedTicks>180</recoverFromDisruptedTicks>
            </li>
            <li Class="OberoniaAureaGene.Snowstorm.HediffCompProperties_HideInSnowstorm" />
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>                
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
        </comps>
    </HediffDef>

    <HediffDef ParentName="DiseaseBase">
        <defName>OAGene_Hediff_IceCrystalFlowerSea</defName>
        <label>Low temperature frostbite (mild)</label>
        <description>Finger redness and swelling caused by prolonged exposure to low temperatures can temporarily affect operational ability.</description>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <capMods>
                    <li>
                        <capacity>Manipulation</capacity>
                        <offset>-0.1</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000~120000</disappearsAfterTicks>                
                <showRemainingTime>true</showRemainingTime>
                <canUseDecimalsShortForm>true</canUseDecimalsShortForm>
            </li>
        </comps>
    </HediffDef>

<HediffDef>
        <defName>OA_RK_ExtraStun</defName>
        <label>OA·额外眩晕</label>
        <description>OA_RK_ExtraStun</description>
        <hediffClass>HediffWithComps</hediffClass>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <becomeVisible>false</becomeVisible>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
            <li Class="OberoniaAurea.HediffCompProperties_ExtraStun">
                <extraStunTicks>300</extraStunTicks>
                <triggerDelay>60</triggerDelay>
            </li>
        </comps>
        <isBad>true</isBad>
    </HediffDef>

    <HediffDef>
        <defName>OARK_Hediff_ExplorationFatigue</defName>
        <label>体力耗竭</label>
        <description>体力耗竭。</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <statFactors>
                    <WorkSpeedGlobal>0.5</WorkSpeedGlobal>
                    <MoveSpeed>0.8</MoveSpeed>
                    <RestFallRateFactor>6</RestFallRateFactor>
                </statFactors>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <disappearsAfterTicks>60000</disappearsAfterTicks>
                <showRemainingTime>true</showRemainingTime>
            </li>
            <li Class="HediffCompProperties_DisappearsOnDeath" />
        </comps>
    </HediffDef>

    <HediffDef ParentName="DiseaseBase">
        <defName>OARK_Hediff_SeriousInjury</defName>
        <label>严重受伤</label>
        <description>该单位的心理与生理皆受到了严重的损伤，需要一定的时间来进行修养才能缓解。</description>
        <initialSeverity>1</initialSeverity>
        <isBad>true</isBad>
        <alwaysAllowMothball>true</alwaysAllowMothball>
        <alwaysAllowMothballCached>true</alwaysAllowMothballCached>
        <stages>
            <li>
                <label>缓和</label>
                <statFactors>
                    <InjuryHealingFactor>0.35</InjuryHealingFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.15</offset>
                    </li>
                </capMods>
            </li>
            <li>
                <label>重度</label>
                <minSeverity>0.6</minSeverity>
                <statFactors>
                    <InjuryHealingFactor>0.15</InjuryHealingFactor>
                </statFactors>
                <capMods>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.3</offset>
                    </li>
                </capMods>
            </li>
        </stages>
        <comps>
            <li Class="HediffCompProperties_SeverityPerDay">
                <severityPerDay>-0.2</severityPerDay>                
                <showDaysToRecover>true</showDaysToRecover>
            </li>
        </comps>
    </HediffDef>

</Defs>