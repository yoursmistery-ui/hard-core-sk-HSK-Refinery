<?xml version='1.0' encoding='utf-8'?>
<Defs>

		

		<ThingDef Name="TavOrganicProductBase" Abstract="True">
			<thingClass>ThingWithComps</thingClass>
			<category>Item</category>
			<drawerType>MapMeshOnly</drawerType>
			<useHitPoints>true</useHitPoints>
			<healthAffectsPrice>false</healthAffectsPrice>
			<selectable>true</selectable>
			<statBases>
				<MaxHitPoints>50</MaxHitPoints>
				<Flammability>0.3</Flammability>
				<Beauty>0</Beauty>
				<DeteriorationRate>1.6</DeteriorationRate>
			</statBases>
			<altitudeLayer>Item</altitudeLayer>
			<tickerType>Rare</tickerType>
			<socialPropernessMatters>true</socialPropernessMatters>
			<thingCategories>
				<li>FoodMeals</li>
			</thingCategories>
			<alwaysHaulable>true</alwaysHaulable>
			<comps>
				<li Class="CompProperties_Forbiddable" />
				<li Class="CompProperties_FoodPoisonable" />
			</comps>
			<pathCost>14</pathCost>
			<resourceReadoutPriority>Last</resourceReadoutPriority>
			<drawGUIOverlay>true</drawGUIOverlay>
			<uiIconForStackCount>1</uiIconForStackCount>
			<allowedArchonexusCount>200</allowedArchonexusCount>
		</ThingDef>

		

		<ThingDef ParentName="TavOrganicProductBase">
			<defName>TavCornDough</defName>
			<label>玉米面团</label>
			<description>生玉米面团。可以直接吃,但生吃并不美味。最适合用来烤制面包和包子。</description>
			<graphicData>
				<texPath>Things/Item/Food/TavCornDough</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
				<drawSize>1</drawSize>
			</graphicData>
			<statBases>
				<MarketValue>20</MarketValue>
				<Mass>0.44</Mass>
				<Nutrition>0.5</Nutrition>
				<MaxHitPoints>50</MaxHitPoints>
				<Flammability>0.1</Flammability>
				<DeteriorationRate>10</DeteriorationRate>
			</statBases>
			
			<thingCategories>
				<li>CookingSupplies</li>
			</thingCategories>
			<rotatable>false</rotatable>
			<stackLimit>25</stackLimit>
			<ingestible>
				<foodType>Plant</foodType>
				<preferability>DesperateOnlyForHumanlikes</preferability>
				<maxNumToIngestAtOnce>1</maxNumToIngestAtOnce>
				<defaultNumToIngestAtOnce>1</defaultNumToIngestAtOnce>
				<ingestEffect>EatVegetarian</ingestEffect>
				<ingestSound>RawVegetable_Eat</ingestSound>
			</ingestible>
			<comps>
				<li Class="CompProperties_Forbiddable" />
				<li Class="CompProperties_FoodPoisonable" />
			</comps>
		</ThingDef>

		

		<ThingDef ParentName="TavOrganicProductBase">
			<defName>TavMeatRice</defName>
			<label>肉饭</label>
			<description>用熟肉与松软的米饭拌成的丰盛菜肴。简单、顶饱,令人满足。</description>
			<graphicData>
				<texPath>Things/Item/Food/TavMeatRice</texPath>
				<graphicClass>Graphic_StackCount</graphicClass>
				<drawSize>1</drawSize>
			</graphicData>
			<statBases>
				<MarketValue>20</MarketValue>
				<Mass>0.44</Mass>
				<Nutrition>0.9</Nutrition>
				<MaxHitPoints>50</MaxHitPoints>
				<WorkToMake>300</WorkToMake>
			</statBases>
			<rotatable>false</rotatable>
			<stackLimit>10</stackLimit>
			<ingestible>
				<foodType>Meal, Meat</foodType>
				<preferability>MealSimple</preferability>
				<optimalityOffsetHumanlikes>16</optimalityOffsetHumanlikes>
				<tasteThought>Tav_AteHomeCookedMeal</tasteThought>
				<ingestEffect>EatMeat</ingestEffect>
				<ingestSound>Meal_Eat</ingestSound>
			</ingestible>
			<comps>
				<li Class="CompProperties_Rottable">
					<daysToRotStart>4</daysToRotStart>
					<rotDestroys>true</rotDestroys>
				</li>
				<li Class="CompProperties_Ingredients">
					<splitTransferableFoodKind>true</splitTransferableFoodKind>
				</li>
				<li Class="CompProperties_FoodPoisonable" />
			</comps>
		</ThingDef>

		

