    <!-- 来源: 44_VileAnyLeatherRecipes.xml -->
<Operation Class="PatchOperationAdd">
    <xpath>Defs</xpath>
    <value>
        <RecipeDef>
            <defName>BrineCure_AnyLeather</defName>
            <label>cure any leather</label>
            <jobString>Brine-curing hides.</jobString>
            <description>Skins and hides are submersed in salty water. The water must be paddled by hand, though it's much faster than dry curing. Cures any raw hide into its matching cured hide.</description>
            <uiIconThing>Hide_StockHideCured</uiIconThing>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>UncuredHides</li>
                        </categories>
                    </filter>
                    <count>1</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>UncuredHides</li>
                </categories>
            </fixedIngredientFilter>
            <products>
                <Hide_StockHideCured>1</Hide_StockHideCured>
            </products>
            <recipeUsers>
                <li>BriningStation</li>
            </recipeUsers>
            <workSpeedStat>TailoringSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <workAmount>200</workAmount>
        </RecipeDef>
        <RecipeDef>
            <defName>TanDrum_AnyLeather</defName>
            <label>tan any leather (x25)</label>
            <jobString>Tanning hides.</jobString>
            <description>Tan any raw or cured hide into 25 of its matching full-grain leather.</description>
            <uiIconThing>Leather_Plain</uiIconThing>
            <ingredients>
                <li>
                    <filter>
                        <categories>
                            <li>UncuredHides</li>
                            <li>CuredHides</li>
                        </categories>
                    </filter>
                    <count>5</count>
                </li>
                <li>
                    <filter>
                        <thingDefs>
                            <li>Chromium</li>
                        </thingDefs>
                    </filter>
                    <count>5</count>
                </li>
            </ingredients>
            <fixedIngredientFilter>
                <categories>
                    <li>UncuredHides</li>
                    <li>CuredHides</li>
                </categories>
            </fixedIngredientFilter>
            <products>
                <Leather_Plain>25</Leather_Plain>
            </products>
            <recipeUsers>
                <li>TanningDrum</li>
            </recipeUsers>
            <workSpeedStat>TailoringSpeed</workSpeedStat>
            <workSkill>Crafting</workSkill>
            <workAmount>800</workAmount>
        </RecipeDef>
    </value>
</Operation>

