	<ThingDef ParentName="Rustic_GrandSculptureBase">
		<defName>Rustic_RNGLarge2x2c</defName>
		<label>骰子神巨像</label>
		<description>地下帝国众多神祇之一。骰子神偶尔仁慈, 但多数时候冷酷无情——就像运气本身。</description>
		<castEdgeShadows>true</castEdgeShadows>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
			<texPath>Things/Building/Art/RNGLarge2x2</texPath>
			<drawSize>(4,4)</drawSize>
		</graphicData>
	</ThingDef>

	<ThingDef ParentName="Rustic_GrandSculptureBase">
		<defName>Rustic_RNG2x2c</defName>
		<label>骰子神方尖碑</label>
		<description>方尖碑顶刻着骰子神的徽记。信徒说:投下命运之石, 神自有裁断。</description>
		<castEdgeShadows>true</castEdgeShadows>
		<graphicData>
			<graphicClass>Graphic_Single</graphicClass>
