<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- HSK 本地适配(原 mod: Medieval Overhaul: Small Planting, 作者 GA-YUKI):
     thingClass 由 MedievalOverhaul.Building_PlanterBox 改为原版 Building_PlantGrower;
     DankPyon 研究/作物/sowTag/地面类型 替换为本环境等价物;
     种植箱研究 = 农业I(SewageSludgeComposting), 爬藤架研究 = 农业II(Cultivation_C1);
     材料: 移除 DankPyon_RawWood, 保留 金属/木材/石材; 造价沿用原作。 -->

<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>GYK_Post1x2c</defName>
		<label>post(1x2)</label>
		<description>A support post to let climbing plants grow effectively.</description>
		<thingClass>Building_PlantGrower</thingClass>
		<graphicData>
			<texPath>Things/Building/Post1x2</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,3)</drawSize>
		</graphicData>
		<statBases>
			<MaxHitPoints>45</MaxHitPoints>
			<WorkToBuild>170</WorkToBuild>
			<Flammability>1.0</Flammability>
			<Cleanliness>-3</Cleanliness>
			<Mass>6</Mass>
		</statBases>
		<altitudeLayer>FloorEmplacement</altitudeLayer>
		<size>(2,1)</size>
		<passability>PassThroughOnly</passability>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>12</costStuffCount>
		<fertility>0.8</fertility>
		<comps>
			<li Class="CompProperties_Forbiddable"/>
		</comps>
		<designationCategory>Production</designationCategory>
		<researchPrerequisites>
			<li>Cultivation_C1</li>
		</researchPrerequisites>
		<techLevel>Medieval</techLevel>
		<building>
            <defaultPlantToGrow>Plant_Hops</defaultPlantToGrow>
            <sowTag>Ground</sowTag>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
        </building>
		<terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
		<uiIconPath>Things/Building/Post1x2_south</uiIconPath>
	</ThingDef>

