		<workSkillLearnFactor>0.8</workSkillLearnFactor>
		<workSkill>Crafting</workSkill>
		<skillRequirements>
			<Crafting>4</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<categories>
						<li>SLDBar</li>
						<li>USLDBar</li>
					</categories>
				</filter>
				<count>11</count>
			</li>
			<li>
