<?xml version="1.0" encoding="utf-8" ?>
<!-- 合并自(保持原执行序): Ideo_BiosculpterPod_Patch.xml, Ideo_Precept_Patch.xml, Ideology_Patch.xml -->
<Patch><Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BiosculpterPod"]/comps/li[compClass = "CompBiosculpterPod_MedicCycle"]/durationDays</xpath>
        <value>
            <durationDays>4</durationDays>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BiosculpterPod"]/comps/li[compClass = "CompBiosculpterPod_RegenerationCycle"]/durationDays</xpath>
        <value>
            <durationDays>8.2</durationDays>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BiosculpterPod"]/comps/li[@Class="CompProperties_BiosculpterPod_AgeReversalCycle"]/durationDays</xpath>
        <value>
            <durationDays>5.6</durationDays>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="BiosculpterPod"]/comps/li[@Class="CompProperties_BiosculpterPod_PleasureCycle"]/durationDays</xpath>
        <value>
            <durationDays>2.2</durationDays>
        </value>
    </Operation><Operation Class="PatchOperationAdd">
        <xpath>Defs/PreceptDef[defName="Skullspike_Disapproved"]/conflictingMemes</xpath>
        <value>
            <li>OAGene_TerritorialHegemony</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
            <value>
                <li>OAGene_TerritorialHegemony</li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Respected" or defName="IdeoDiversity_Approved" or defName="IdeoDiversity_Exalted"]</xpath>
            <value>
                <conflictingMemes>
                    <li>OAGene_TerritorialHegemony</li>
                </conflictingMemes>
            </value>
        </nomatch>
    </Operation>


    <!--Operation Class="PatchOperationConditional">
        <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/PreceptDef[defName="IdeoDiversity_Exalted"]/conflictingMemes</xpath>
            <value>
                <li>OAGene_TerritorialHegemony</li>
            </value>
