<Patch>

    <!-- Milira_RayPistol 射线手枪-->

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_RayPistol"]/tools</xpath>
        <value>
            <tools>
                <li Class="CombatExtended.ToolCE">
                    <label>stock</label>
                    <capacities>
                        <li>Blunt</li>
                    </capacities>
                    <power>8</power>
                    <cooldownTime>1.7</cooldownTime>
                    <armorPenetrationBlunt>4.5</armorPenetrationBlunt>
                    <linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
                </li>
                <li Class="CombatExtended.ToolCE">
                    <label>barrel</label>
                    <capacities>
                        <li>Blunt</li>
                        <li>Poke</li>
                    </capacities>
                    <power>6</power>
                    <cooldownTime>1.7</cooldownTime>
                    <armorPenetrationBlunt>4</armorPenetrationBlunt>
                    <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
                </li>
            </tools>
        </value>
    </Operation>
    <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>Milira_RayPistol</defName>
        <statBases>
            <Bulk>1.4</Bulk>
            <SightsEfficiency>1</SightsEfficiency>
            <ShotSpread>0.01</ShotSpread>
            <SwayFactor>0.1</SwayFactor>
        </statBases>
        <Properties>
            <verbClass>MiliraCE.Verb_ShootCEChargable</verbClass>
            <hasStandardCommand>true</hasStandardCommand>
            <defaultProjectile>Bullet_MiliraRayPistol</defaultProjectile>
            <warmupTime>1.8</warmupTime>
            <range>10</range>
            <burstShotCount>1</burstShotCount>
            <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
            <soundCast>Milira_Shot_RayRifle</soundCast>
            <soundCastTail>GunTail_Heavy</soundCastTail>
            <muzzleFlashScale>8</muzzleFlashScale>
        </Properties>
        <AmmoUser>
            <magazineSize>15</magazineSize>
            <reloadTime>4</reloadTime>
            <ammoSet>AmmoSet_MiliraRayPistol</ammoSet>
            <chargedAmmoSet>AmmoSet_MiliraRayPistol</chargedAmmoSet>
        </AmmoUser>
        <FireModes>
            <aiAimMode>Snapshot</aiAimMode>
            <aiUseBurstMode>true</aiUseBurstMode>
            <aimedBurstShotCount>1</aimedBurstShotCount>
        </FireModes>
    </Operation>
    <Operation Class="PatchOperationRemove">
        <xpath>/Defs/ThingDef[defName="Milira_RayPistol"]/verbs/li[verbClass="AncotLibrary.Verb_ChargeShoot"]</xpath>
    </Operation>
    <Operation Class="PatchOperationAttributeSet">
        <xpath>/Defs/ThingDef[defName="Milira_RayPistol"]/comps/li[@Class="CombatExtended.CompProperties_AmmoUser"]</xpath>
        <attribute>Class</attribute>
        <value>MiliraCE.CompProperties_AmmoUserChargable</value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_RayPistol"]/comps/li[@Class="AncotLibrary.CompProperties_RangeWeaponVerbSwitch_EnergyPassive"]/verbProps</xpath>
        <value>
            <verbProps Class="CombatExtended.VerbPropertiesCE">
                <label>charged mode</label>
                <verbClass>MiliraCE.Verb_ShootCEChargable</verbClass>
                <isPrimary>true</isPrimary>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_MiliraRayPistol</defaultProjectile>
                <warmupTime>0.6</warmupTime>
                <range>10</range>
                <burstShotCount>3</burstShotCount>
                <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
                <soundCast>Milira_Shot_RayRifle</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>8</muzzleFlashScale>
            </verbProps>
        </value>
    </Operation>
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="Milira_RayPistol"]/comps/li[@Class="AncotLibrary.CompProperties_WeaponCharge"]/projectileCharged</xpath>
        <value>
            <projectileCharged>Bullet_MiliraRayPistol</projectileCharged>
        </value>
    </Operation>

