<?xml version="1.0" encoding="utf-8"?>
<Defs>
<!-- 乡村娱乐建筑(骰子杯/塔罗桌/战棋桌 + JoyGiver + JobDef)
     来源: Medieval Overhaul 1.6.2.2 纯原版类 def 移植(2026-08-27), 前缀统一改为 Rustic_,
     RawWood→Woody/WoodLog, Clay→SoftClay, Linen→Cloth, 研究 RusticFurniture→ComplexFurniture。
-->
<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>Rustic_CupAndDice</defName>
		<label>骰子杯</label>
		<description>骨骰与皮杯的赌运小戏, 消遣脑力的入门娱乐。</description>
		<graphicData>
			<texPath>Things/Building/Joy/CupAndDice</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<shadowData>
				<volume>(0.65, 0.25, 0.6)</volume>
				<offset>(0, 0, -0.15)</offset>
			</shadowData>
			<damageData>
				<rect>(0.09375,0.296875,0.796875,0.703125)</rect>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<altitudeLayer>Building</altitudeLayer>
		<rotatable>false</rotatable>
		<socialPropernessMatters>true</socialPropernessMatters>
		<fillPercent>0.40</fillPercent>
		<minTechLevelToBuild>Medieval</minTechLevelToBuild>
		<building>
			<joyKind>Gaming_Cerebral</joyKind>
		</building>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<statBases>
			<MaxHitPoints>100</MaxHitPoints>
			<WorkToBuild>7000</WorkToBuild>
			<Mass>5</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>4</Beauty>
			<JoyGainFactor>1</JoyGainFactor>
		</statBases>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>70</costStuffCount>
		<pathCost>30</pathCost>
		<passability>PassThroughOnly</passability>
		<designationCategory>Joy</designationCategory>
		<designationHotKey>Misc2</designationHotKey>
	</ThingDef>

	
<ThingDef ParentName="FurnitureWithQualityBase">
		<defName>Rustic_Tarocco</defName>
		<label>塔罗牌桌</label>
		<description>摊牌占卜的双人对局, 输赢都在牌面上。</description>
		<graphicData>
			<texPath>Things/Building/Joy/Tarocco</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>CutoutComplex</shaderType>
			<drawSize>(4,4)</drawSize>
			<shadowData>
				<volume>(1.6, 0.3, 1.6)</volume>
				<offset>(0, 0, -0.15)</offset>
			</shadowData>
		</graphicData>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<socialPropernessMatters>true</socialPropernessMatters>
		<fillPercent>0.40</fillPercent>
		<building>
			<joyKind>Gaming_Cerebral</joyKind>
			<buildingSizeCategory>Medium</buildingSizeCategory>
			<paintable>true</paintable>
		</building>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>10000</WorkToBuild>
			<Mass>30</Mass>
			<Flammability>1.0</Flammability>
			<Beauty>0</Beauty>
			<JoyGainFactor>1.3</JoyGainFactor>
		</statBases>
		<size>(2,2)</size>
		<stuffCategories>
			<li>Metallic</li>
			<li>Woody</li>
			<li>Stony</li>
		</stuffCategories>
		<costStuffCount>50</costStuffCount>
		<costList>
			<Cloth>50</Cloth>
			<WoodLog>25</WoodLog>
		</costList>
		<pathCost>42</pathCost>
		<passability>PassThroughOnly</passability>
		<designationCategory>Joy</designationCategory>
		<designationHotKey>Misc5</designationHotKey>
		<canOverlapZones>false</canOverlapZones>
		<researchPrerequisites>
			<li>ComplexFurniture</li>
		</researchPrerequisites>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<uiIconScale>0.9</uiIconScale>
	</ThingDef>

	
<ThingDef ParentName="FurnitureWithQualityBase">
