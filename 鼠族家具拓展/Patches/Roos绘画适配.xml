		</value>
	</Operation>

	<!-- ========== 4. 观赏适配: 画作基类补 building.joyKind=Art(同 Roos 画) ==========
	     ⚠️ 注意1: PatchOperation 的 XPath 只作用于字面 XML 树(Inherit 之前),
	     8 幅画的 <building> 节点定义在抽象基类 RKFC_RL_PaintBase 中, 子类无显式节点,
	     故必须加在基类上, 8 幅画经 ParentName 继承。
	     ⚠️ 注意2: 抽象基类用 Name 属性而非 defName, xpath 必须写 @Name。 -->
	<Operation Class="PatchOperationAdd" MayRequire="Rooboid.Paintings.Ex">
		<xpath>Defs/ThingDef[@Name="RKFC_RL_PaintBase"]/building</xpath>
		<value>
			<joyKind>Art</joyKind>
		</value>
	</Operation>
</Patch>
